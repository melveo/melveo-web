  .club-flow-stage__metrics dd {
    order: 1;
    margin: 0;
    color: var(--color-accent-primary);
    font-size: clamp(1.18rem, 1.8vw, 1.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 0 20px color-mix(in srgb, var(--color-accent-primary) 28%, transparent);
  }

  .club-flow-stage__metrics div:first-child dd {
    font-size: clamp(2.65rem, 5.4vw, 4.8rem);
    letter-spacing: -0.07em;
  }

  .club-flow-stage__action {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: clamp(1rem, 1.8vh, 1.25rem) 0 0;
    padding: 0.85rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent-primary) 16%, rgba(255, 255, 255, 0.08));
    border-radius: 1rem;
    background:
      linear-gradient(90deg, rgba(0, 240, 255, 0.08), rgba(255, 255, 255, 0.035)),
      rgba(255, 255, 255, 0.026);
    color: color-mix(in srgb, var(--color-text-primary) 88%, var(--color-accent-primary));
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .club-flow-stage__action::before {
    content: '';
    flex: 0 0 auto;
    width: 0.52rem;
    height: 0.52rem;
    border-radius: 999px;
    background: var(--color-accent-primary);
    box-shadow: 0 0 18px color-mix(in srgb, var(--color-accent-primary) 70%, transparent);
  }

  @media (min-width: 1180px) and (max-width: 1280px) {
    .club-flow-stage__layout {
      grid-template-columns: minmax(0, 1.02fr) minmax(24rem, 0.8fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 1179px) {
    .club-flow-stage {
      overflow: hidden;
    }

    /*
      Mobile redesign per user feedback 2026-05-01: each step card is
      the photo surface; the copy sits in a bottom shadow instead of a
      separate text block under a framed image.
    */
    .club-flow-stage__intro {
      /* Centred on mobile too — the rest of the page is centred so
         keeping ClubFlow left-aligned on phones broke the rhythm
         (user feedback 2026-05-01: "všechno na střed"). */
      text-align: center;
      padding: clamp(4rem, 10vw, 6rem) clamp(1rem, 4vw, 1.5rem) clamp(1.5rem, 4vw, 2.5rem);
    }

    .club-flow-stage__intro h2 {
      max-width: none;
      margin: 0 auto;
      font-size: clamp(2.25rem, 9vw, 3.25rem);
      line-height: 1.02;
      letter-spacing: -0.035em;
    }

    .club-flow-stage__intro > p:last-child {
      max-width: none;
      margin: 1rem auto 0;
      font-size: 1rem;
      line-height: 1.55;
    }

    .club-flow-stage__scroll {
      height: auto;
      min-height: 0;
      /* Carousel needs the rail to bleed to the screen edges so cards
         can snap with peek; padding handled INSIDE the rail via
         scroll-padding + per-card flex-basis math. Section keeps a
         small bottom pad for the dots. */
      padding: 0 0 clamp(3rem, 10vw, 5rem);
    }

    .club-flow-stage__pin {
      /*
        CRITICAL: must override `display: grid` from the desktop rule.
        Without this override the grid keeps a default auto-sized column
        which expands to its content's intrinsic width — and the
        carousel rail's children (cards × flex-basis var) want a much
        wider track than the viewport. The grid happily overflows,
        making the layout wider than the viewport and pushing the
        carousel off-screen. Switching to display: block constrains the
        layout to the pin's actual width.
      */
      display: block;
      position: relative;
      min-height: 0;
      padding: 0;
    }

    .club-flow-stage__layout {
      display: block;
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      min-height: 0;
      min-width: 0;
    }

    .club-flow-stage__right {
      /* Same reason as the pin override above — without min-width: 0
         flex/grid intrinsic-min-content would let the rail's wide
         flex children expand the right column. */
      display: block;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      min-height: 0;
    }

    .club-flow-stage__media-shell,
    .club-flow-stage__progress {
      display: none;
    }

    /*
      Apple App Store / Apple Music featured-shelf peek carousel
      (user request 2026-05-01: this needs to feel like the real Apple
      one, not just snap+peek).

      The pattern that makes Apple's version feel premium isn't only
      scroll-snap — it's the live scale + dim + parallax on cards as
      they move through the rail centre. Reference: the same trick
      used in App Store featured cards on iOS, and the technique
      Adam Argyle / Bramus Van Damme demonstrate in their scroll-
      driven-animations CodePen series. We compute it from scroll
      position with a JS scroll listener (rAF-throttled) so it works
      on every browser, including iOS Safari < 17.4 where scroll-
      driven CSS animations aren't available yet.

      Layout math (centred-snap variant — Apple's approach):
        - --carousel-card-width: min(85vw, 30rem) sets the card.
        - Rail uses padding-inline + scroll-padding-inline of
          calc(50% - card-width/2) on BOTH sides → phantom space so
          the first and last card can scroll-snap to centre cleanly.
        - Cards use scroll-snap-align: center.
        - At rest: the active card is fully centred with peek of the
          neighbour on each side (left + right). At scroll=0 the
          phantom-space mechanic provides matching visual gutters.
        - Edge fade mask on the rail softens the rail boundaries so
          the peeking card "fades into" the page rather than ending
          at a hard rectangle (App Store behaviour).
    */
    .club-flow-stage__cards {
      /*
        Switched from centre-snap to start-snap (user feedback
        2026-05-01: "ta karta nemusí byt tak zmenšená.. má více
        prostoru na levé straně takže šířka může byt zachovana").
        With centre-snap the symmetric padding put roughly equal
        empty space on each side of the active card, so to get any
        meaningful peek the card had to shrink. Start-snap pins the
        active card's leading edge to a small left inset (1 rem) and
        all the remaining viewport space lands on the right as peek
        — the card can stay wider AND the peek is plainly visible.

        Math at 393 px iPhone, card 80 vw:
          card width  = 314
          card 1 left = 16 (start-snap, leading inset)
          card 1 right = 330
          gap         = 16
          card 2 left = 346
          peek        = 47 px (~12 % of viewport)
        Compare with the previous centre-snap geometry: 85vw → 13 px
        peek (invisible), 70vw → 43 px peek but card too small.

        padding-inline-end auto-computed so the LAST card can also
        scroll-snap to the leading position (without enough trailing
        space in the rail, the browser snap can't reach the start
        anchor for the last card). Formula: 100 % minus card width
        minus the two 1 rem insets.
      */
      --carousel-card-width: min(80vw, 28rem);
      display: flex;
      flex-direction: row;
      gap: 1rem;
      min-height: 0;
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      /* iOS momentum — without this the swipe feels stiff compared to
         native iOS carousels. */
      -webkit-overflow-scrolling: touch;
      /* Hide native scrollbar (App Store / Apple Music don't show one
         under the rail). */
      scrollbar-width: none;
      -ms-overflow-style: none;
      /* Asymmetric padding: small leading inset (1 rem) so the card
         hugs the left edge with a hairline gutter, computed end
         padding so the last card can still snap to start without
         running out of trailing scroll space. */
      padding-inline-start: 1rem;
      padding-inline-end: calc(100% - var(--carousel-card-width) - 2rem);
      scroll-padding-inline-start: 1rem;
      /* Vertical headroom so cards' bottom shadow + cyan glow don't
         get clipped. */
      padding-block: 1rem clamp(1.5rem, 4vw, 2rem);
      /*
        Soft fade at the rail edges so peeking cards "dissolve" into
        the page. 3 % is gentle enough not to eat the visible peek.
      */
      mask-image: linear-gradient(
        90deg,
        transparent 0,
        black 3%,
        black 97%,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0,
        black 3%,
        black 97%,
        transparent 100%
      );
    }
    .club-flow-stage__cards::-webkit-scrollbar {
      display: none;
    }

    .club-flow-stage__card {
      /*
        --carousel-progress (0..1) and --carousel-distance (-1..+1)
        are written by the mobile carousel scroll handler in JS.
        Defaults of 0 mean "active / at rail centre" so SSR + first
        paint show every card at full size before JS attaches.
      */
      --carousel-progress: 0;
      --carousel-distance: 0;
      position: relative;
      inset: auto;
      flex: 0 0 var(--carousel-card-width);
      scroll-snap-align: start;
      /*
        scroll-snap-stop: normal (default) — fast flick can carry the
        rail past multiple snap points before the magnet catches the
        nearest one. Matches Apple App Store featured shelf: a strong
        swipe glides through 2–3 cards, a gentle one settles on the
        next. Was `always` initially (one-card-per-swipe lock) but
        that read as too rigid — user feedback 2026-05-01.
      */
      scroll-snap-stop: normal;
      border-radius: clamp(1.25rem, 5vw, 1.65rem);
      pointer-events: auto !important;
      /*
        Apple-feel scale + dim. Neighbours shrink toward 0.94 and dim
        toward 0.62 opacity / 0.82 brightness as their distance from
        rail centre approaches 1 (one card-width away). The transition
        catches any post-snap easing so the cards "settle" smoothly
        if scroll fires a final value after rAF stops.
      */
      transform: scale(calc(1 - 0.06 * var(--carousel-progress))) !important;
      opacity: calc(1 - 0.38 * var(--carousel-progress)) !important;
      filter: brightness(calc(1 - 0.18 * var(--carousel-progress)));
      transform-origin: center center;
      transition:
        transform 320ms cubic-bezier(0.32, 0.72, 0.24, 1),
        opacity 320ms cubic-bezier(0.32, 0.72, 0.24, 1),
        filter 320ms cubic-bezier(0.32, 0.72, 0.24, 1),
        box-shadow 320ms cubic-bezier(0.32, 0.72, 0.24, 1);
      will-change: transform, opacity;
      box-shadow:
        0 12px 36px rgba(0, 0, 0, 0.36),
        0 0 30px color-mix(in srgb, var(--color-accent-primary) 9%, transparent);
    }

    /* All step cards share the same baseline visual weight on mobile.
       The desktop active-card glow would make the image stack noisy. */
    .club-flow-stage__card.is-active {
      box-shadow:
        0 12px 36px rgba(0, 0, 0, 0.36),
        0 0 30px color-mix(in srgb, var(--color-accent-primary) 9%, transparent);
    }

    .club-flow-stage__card .glass-filter {
      backdrop-filter: blur(8px) saturate(160%);
      -webkit-backdrop-filter: blur(8px) saturate(160%);
      filter: url(#glass-lens) brightness(1.02);
    }

    .club-flow-stage__card.is-active .glass-overlay {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.02) 0%,
        rgba(255, 255, 255, 0.01) 55%,
        rgba(0, 240, 255, 0.02) 100%
      );
    }

    .club-flow-stage__card .glass-specular,
    .club-flow-stage__card.is-active .glass-specular {
      z-index: 6;
      box-shadow:
        inset 1px 1px 0 rgba(255, 255, 255, 0.26),
        inset 0 0 14px color-mix(in srgb, var(--color-accent-primary) 18%, transparent),
        inset -1px -1px 0 rgba(255, 255, 255, 0.06);
    }

    .club-flow-stage__card-panel {
      position: relative;
      min-height: clamp(30rem, 126vw, 38rem);
      justify-content: flex-end;
      overflow: hidden;
      padding: clamp(1rem, 4.2vw, 1.35rem);
      isolation: isolate;
    }

    .club-flow-stage__card-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        radial-gradient(
          circle at 72% 78%,
          color-mix(in srgb, var(--color-accent-primary) 28%, transparent),
          transparent 34%
        ),
        linear-gradient(
          180deg,
          rgba(5, 6, 8, 0.04) 0%,
          rgba(5, 6, 8, 0.12) 38%,
          rgba(5, 6, 8, 0.72) 70%,
          rgba(5, 6, 8, 0.95) 100%
        );
      pointer-events: none;
    }

    .club-flow-stage__card-panel::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      z-index: 1;
      height: 58%;
      background: linear-gradient(
        180deg,
        transparent 0%,
        color-mix(in srgb, var(--color-bg-tint) 34%, rgba(5, 6, 8, 0.9)) 100%
      );
      opacity: 0.72;
      pointer-events: none;
    }

    .club-flow-stage__card-photo {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      max-height: none;
      max-width: none;
      margin: 0;
      border-radius: inherit;
      object-fit: cover;
      filter: saturate(0.94) contrast(1.08) brightness(0.78);
      /*
        Parallax — photo translates opposite to its parent card's
        distance from rail centre. When the card is to the left of
        centre (--carousel-distance < 0) the photo shifts right within
        its frame, and vice versa. Combined with the 1.12× scale-up
        (which gives the translate room without revealing edges) this
        produces the 3D-depth feel Apple uses on App Store featured
        cards — the photo "lags behind" the card frame as you swipe.
      */
      transform: scale(1.12) translateX(calc(var(--carousel-distance, 0) * -8%));
      transition: transform 320ms cubic-bezier(0.32, 0.72, 0.24, 1);
      will-change: transform;
    }

    .club-flow-stage__card-topline,
    .club-flow-stage__card h3,
    .club-flow-stage__card-body,
    .club-flow-stage__metrics,
    .club-flow-stage__action {
      position: relative;
      z-index: 2;
    }

    .club-flow-stage__card-topline {
      margin: 0 0 clamp(0.8rem, 2.5vw, 1rem);
      padding-bottom: clamp(0.75rem, 2.4vw, 0.95rem);
      gap: clamp(0.75rem, 2.6vw, 1rem);
    }

    /* Mobile override redundant now — desktop chip styling above
       already scales via clamp(). Keeping the rule empty as a hook
       for any phone-specific tweak later. */
    .club-flow-stage__card-number {
      letter-spacing: 0.06em;
    }

    .club-flow-stage__card-kicker {
      font-size: clamp(0.76rem, 2.5vw, 0.86rem);
      letter-spacing: 0.02em;
      color: color-mix(in srgb, var(--color-text-secondary) 78%, var(--color-text-primary));
    }

    .club-flow-stage__card h3 {
      font-size: clamp(1.65rem, 7vw, 2.25rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
    }

    .club-flow-stage__card-body {
      max-width: none;
      margin-top: clamp(0.55rem, 2vw, 0.75rem);
      font-size: 0.95rem;
      line-height: 1.55;
      color: color-mix(in srgb, var(--color-text-secondary) 88%, var(--color-text-primary));
    }

    .club-flow-stage__metrics {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      margin-top: clamp(0.85rem, 3vw, 1rem);
    }

    .club-flow-stage__metrics div {
      min-height: 3.8rem;
      padding: 0.62rem 0.64rem;
      border-radius: 0.78rem;
      background:
        linear-gradient(180deg, rgba(0, 240, 255, 0.1), rgba(255, 255, 255, 0.025)),
        rgba(0, 0, 0, 0.2);
    }

    .club-flow-stage__metrics div:first-child {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 5.4rem;
      padding: 0.78rem 0.85rem;
    }

    .club-flow-stage__metrics dt {
      margin-top: 0.34rem;
      font-size: clamp(0.48rem, 1.62vw, 0.56rem);
      letter-spacing: 0.04em;
    }

    .club-flow-stage__metrics dd {
      font-size: clamp(1rem, 4vw, 1.25rem);
    }

    .club-flow-stage__metrics div:first-child dd {
      font-size: clamp(2rem, 10vw, 2.85rem);
    }

    .club-flow-stage__action {
      margin-top: clamp(0.75rem, 2.6vw, 0.95rem);
      padding: 0.68rem 0.78rem;
      border-radius: 0.9rem;
      font-size: 0.8rem;
      line-height: 1.3;
    }

    /*
      Mobile pagination dots — sit below the carousel rail. Each dot
      maps to one step. The active dot stretches into a cyan pill +
      glows; the rest are quiet white dots at low opacity. JS updates
      .is-active based on which card sits closest to the rail centre.
    */
    .club-flow-stage__mobile-dots {
      display: inline-flex;
      gap: 0.5rem;
      justify-content: center;
      align-items: center;
      width: 100%;
      margin-top: clamp(1rem, 3vw, 1.5rem);
      padding-inline: 1rem;
    }

    /*
      Each dot is a real <button> with a 44 × 22 px hit-target that
      wraps a small visible pip. Hit-target is invisible (transparent
      background, no border) but covers a finger-sized area so taps
      land reliably even on the 6 px / 22 px pip itself.
    */
    .club-flow-stage__mobile-dot {
      appearance: none;
      -webkit-appearance: none;
      background: transparent;
      border: 0;
      padding: 0.6rem 0.4rem;
      margin: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      -webkit-tap-highlight-color: transparent;
    }
    .club-flow-stage__mobile-dot:focus-visible {
      outline: 2px solid var(--color-accent-primary);
      outline-offset: 4px;
      border-radius: 999px;
    }

    .club-flow-stage__mobile-dot-pip {
      display: block;
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.22);
      transition:
        width 260ms cubic-bezier(0.4, 0, 0.2, 1),
        background 260ms ease,
        box-shadow 260ms ease;
    }

    .club-flow-stage__mobile-dot-pip.is-active {
      width: 1.4rem;
      background: var(--color-accent-primary);
      box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent-primary) 64%, transparent);
    }
  }

  @media (min-width: 700px) and (max-width: 1179px) {
    .club-flow-stage__intro {
      max-width: 78rem;
    }

    /*
      Tablet carousel — same start-snap mechanic, smaller card-width
      ratio so the right-side peek of the next card is generous
      (iPad portrait has plenty of width to spare). The padding-end
      formula auto-adjusts to give the last card enough trailing
      scroll space.
    */
    .club-flow-stage__cards {
      --carousel-card-width: min(62vw, 32rem);
      gap: 1.25rem;
    }

    .club-flow-stage__card-panel {
      min-height: clamp(25rem, 56vw, 31rem);
    }

    .club-flow-stage__card h3 {
      font-size: clamp(1.55rem, 3.8vw, 2.05rem);
    }

    .club-flow-stage__card-body {
      font-size: clamp(0.9rem, 1.8vw, 0.98rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .club-flow-stage__image,
    .club-flow-stage__card,
    .club-flow-stage__progress span,
    .club-flow-stage__hud-dots span {
      transition: none;
    }
  }
</style>

<script>
  // Cyan smoke field behind the section. It is decorative, so do not
  // load its canvas module during the initial hero pass. mountGlassSmoke
  // is idempotent (HANDLES WeakMap inside the module); calling it from
  // multiple sections is safe.
  async function startSmoke() {
    const { mountGlassSmoke } = await import('../scripts/glass-smoke');
    mountGlassSmoke();
  }

  function startSmokeWhenNear() {
    const smokeStage = document.querySelector<HTMLElement>('[data-club-flow-stage]');
    if (!smokeStage) return;

    const supportsObserver = 'IntersectionObserver' in globalThis;
    if (!supportsObserver) {
      globalThis.addEventListener('scroll', startSmoke, { once: true, passive: true });
      return;
    }

    const smokeObserver = new window.IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        smokeObserver.disconnect();
        startSmoke();
      },
      { rootMargin: '560px 0px' },
    );
    smokeObserver.observe(smokeStage);
  }
  startSmokeWhenNear();

  const mountedClubFlowStages = new WeakSet<HTMLElement>();

  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  function smoothstep(value: number) {
    const t = clamp(value, 0, 1);
    return t * t * (3 - 2 * t);
  }

  function magneticCursor(rawCursor: number, count: number) {
    if (count <= 1) return 0;

    const maxIndex = count - 1;
    if (rawCursor <= 0) return 0;
    if (rawCursor >= maxIndex) return maxIndex;

    const base = Math.min(Math.floor(rawCursor), maxIndex - 1);
    const local = rawCursor - base;
    const dwell = 0.24;

    if (local < dwell) return base;
    if (local > 1 - dwell) return base + 1;

    return base + smoothstep((local - dwell) / (1 - dwell * 2));
  }

  function mountClubFlowStage(stage: HTMLElement) {
    if (mountedClubFlowStages.has(stage)) return;
    mountedClubFlowStages.add(stage);

    const scrollArea = stage.querySelector<HTMLElement>('[data-club-flow-scroll]');
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('[data-club-flow-card]'));
    const images = Array.from(stage.querySelectorAll<HTMLElement>('[data-club-flow-image]'));
    const dots = Array.from(stage.querySelectorAll<HTMLElement>('[data-club-flow-dot]'));
    const mobileDots = Array.from(stage.querySelectorAll<HTMLElement>('[data-club-flow-mobile-dot]'));
    const cardsRail = stage.querySelector<HTMLElement>('[data-club-flow-cards]');
    const progressBar = stage.querySelector<HTMLElement>('.club-flow-stage__progress span');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 1180px)');

    if (!scrollArea || cards.length === 0) return;

    /*
      Mobile carousel — Apple App Store / Apple Music featured shelf
      feel. On every horizontal scroll of the rail, compute each card's
      signed distance from rail centre as a fraction of card-width:
        --carousel-distance: -1 (one card-width left of centre) to
                             +1 (one card-width right of centre)
        --carousel-progress: |distance| clamped to 1 (used for scale,
                             opacity, brightness — symmetric falloff)
      The CSS layer reads these vars to drive scale/opacity/brightness
      on the card frame and a parallax translateX on the inner photo.
      Active dot pagination uses the same nearest-card lookup.

      rAF-throttled. On desktop (>= 1180 px) the rail isn't a carousel
      so we early-exit cheaply.
    */
    let mobileFrame = 0;
    let mobileActiveIndex = 0;

    const updateMobileCarousel = () => {
      mobileFrame = 0;
      if (desktop.matches || !cardsRail || cards.length === 0) return;

      const railRect = cardsRail.getBoundingClientRect();
      // Start-snap anchor: the leading edge of the snapped (active)
      // card lands at scroll-padding-inline-start within the rail.
      // Read the resolved value live so any responsive breakpoint
      // change auto-updates without JS edits.
      const padStart = parseFloat(
        getComputedStyle(cardsRail).scrollPaddingInlineStart,
      ) || 16;
      const anchor = railRect.left + padStart;
      const referenceWidth = cards[0]?.offsetWidth || 1;

      let closestIndex = 0;
      let closestDistance = Infinity;

      cards.forEach((card, index) => {
        const cardRect = card.getBoundingClientRect();
        // Distance is measured from the card's LEADING edge to the
        // start-snap anchor. The active card has its leading edge at
        // the anchor → distance 0; one card-width to the right →
        // distance +1; one card-width to the left → distance -1.
        const signed = (cardRect.left - anchor) / referenceWidth;
        const clampedSigned = Math.max(-1.5, Math.min(1.5, signed));
        const progress = Math.min(1, Math.abs(clampedSigned));

        card.style.setProperty('--carousel-distance', clampedSigned.toFixed(3));
        card.style.setProperty('--carousel-progress', progress.toFixed(3));

        const absUnclamped = Math.abs(signed);
        if (absUnclamped < closestDistance) {
          closestDistance = absUnclamped;
          closestIndex = index;
        }
      });

      if (closestIndex !== mobileActiveIndex) {
        mobileActiveIndex = closestIndex;
        mobileDots.forEach((dot, index) => {
          // Toggle the visible pip's active class (the pip is the
          // span INSIDE the button — the button itself stays a
          // transparent hit-target).
          const pip = dot.querySelector('.club-flow-stage__mobile-dot-pip');
          pip?.classList.toggle('is-active', index === closestIndex);
          dot.setAttribute('aria-selected', index === closestIndex ? 'true' : 'false');
        });
        // Mirror active state onto card classes too — keeps any
        // .is-active-derived styling (e.g. specular glow) in sync
        // with the carousel's actual focus.
        cards.forEach((card, index) =>
          card.classList.toggle('is-active', index === closestIndex),
        );
      }
    };

    /*
      Click-to-navigate: tapping a dot scrolls the carousel rail to
      that card's snap position. Uses smooth scrolling so the user
      sees the magnet glide. Only wired when the rail is present
      (mobile carousel layout). Desktop early-exits because
      cardsRail is null on desktop — but it's not, the same rail
      element is just laid out differently. We early-exit via the
      desktop matchMedia check instead.
    */
    if (cardsRail) {
      mobileDots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          if (desktop.matches) return;
          const card = cards[index];
          if (!card) return;
          const padStart = parseFloat(
            getComputedStyle(cardsRail).scrollPaddingInlineStart,
          ) || 16;
          // Card.offsetLeft is the leading edge of the card relative
          // to the rail's content box. Subtract the scroll-padding
          // so the leading edge lands at the snap anchor.
          const target = card.offsetLeft - padStart;
          cardsRail.scrollTo({ left: target, behavior: 'smooth' });
        });
      });
    }

    const scheduleMobileCarousel = () => {
      if (mobileFrame) return;
      mobileFrame = window.requestAnimationFrame(updateMobileCarousel);
    };

    if (cardsRail) {
      cardsRail.addEventListener('scroll', scheduleMobileCarousel, { passive: true });
    }

    let frame = 0;
    let activeIndex = -1;
    let stageNearViewport = false;

    const resetForStackedLayout = () => {
      cards.forEach((card, index) => {
        card.style.removeProperty('--card-y');
        card.style.removeProperty('--card-scale');
        card.style.removeProperty('--card-opacity');
        card.classList.toggle('is-active', index === 0);
      });

      images.forEach((image, index) => {
        image.style.removeProperty('opacity');
        image.style.removeProperty('transform');
        image.classList.toggle('is-active', index === 0);
      });

      dots.forEach((dot, index) => dot.classList.toggle('is-active', index === 0));
      progressBar?.style.setProperty('transform', 'scaleY(0)');
      activeIndex = 0;
    };

    const update = () => {
      frame = 0;

      if (!desktop.matches) {
        resetForStackedLayout();
        return;
      }

      const rect = scrollArea.getBoundingClientRect();
      const maxScroll = Math.max(1, scrollArea.offsetHeight - window.innerHeight);
      const progress = reduceMotion.matches ? 0 : clamp(-rect.top / maxScroll, 0, 1);
      const rawCursor = progress * (cards.length - 1);
      const cursor = magneticCursor(rawCursor, cards.length);
      const nextActiveIndex = clamp(Math.round(cursor), 0, cards.length - 1);

      if (nextActiveIndex !== activeIndex) {
        activeIndex = nextActiveIndex;
        dots.forEach((dot, index) => dot.classList.toggle('is-active', index === activeIndex));
      }

      progressBar?.style.setProperty('transform', `scaleY(${progress})`);

      cards.forEach((card, index) => {
        const delta = index - cursor;
        const distance = Math.abs(delta);
        // Keep the stack clean, but do not dim the active proof card
        // so aggressively that the metrics become hard to scan during
        // the scroll crossfade.
        const y = clamp(delta * 52, -38, 64);
        const scale = 1 - Math.min(distance * 0.06, 0.14);
        const isNearest = index === nextActiveIndex;
        const opacity = isNearest ? 1 : distance > 0.55 ? 0 : Math.max(0, 1 - distance * 2.2);

        card.style.setProperty('--card-y', `${y}%`);
        card.style.setProperty('--card-scale', `${scale}`);
        card.style.setProperty('--card-opacity', `${opacity}`);
        card.style.zIndex = isNearest ? '2' : '1';
        card.classList.toggle('is-active', isNearest);
      });

      images.forEach((image, index) => {
        const distance = Math.abs(index - cursor);
        const opacity = Math.max(0, 1 - distance * 1.18);
        const scale = 1.035 + Math.min(distance * 0.025, 0.075);

        image.style.opacity = `${opacity}`;
        image.style.transform = `scale(${scale})`;
        image.classList.toggle('is-active', distance < 0.5);
      });
    };

    const schedule = () => {
      if (!stageNearViewport && desktop.matches) return;
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    const viewportObserver =
      'IntersectionObserver' in window
        ? new IntersectionObserver(
            (entries) => {
              stageNearViewport = Boolean(entries[0]?.isIntersecting);
              if (stageNearViewport) {
                schedule();
                scheduleMobileCarousel();
              }
            },
            { rootMargin: '1200px 0px' },
          )
        : null;

    if (viewportObserver) {
      viewportObserver.observe(stage);
    } else {
      stageNearViewport = true;
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('resize', scheduleMobileCarousel);
    reduceMotion.addEventListener?.('change', schedule);
    desktop.addEventListener?.('change', schedule);
    desktop.addEventListener?.('change', scheduleMobileCarousel);
    schedule();
    scheduleMobileCarousel();
  }

  function mountClubFlowStages() {
    document
      .querySelectorAll<HTMLElement>('[data-club-flow-stage]')
      .forEach((stage) => mountClubFlowStage(stage));
  }

  mountClubFlowStages();
  document.addEventListener('astro:page-load', mountClubFlowStages);
</script>
