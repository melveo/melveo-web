---
/**
 * OrbStage — Giomgio codepen abxGyQX, 1:1 port.
 *
 * Two stacked hero blocks. Primary on dark canvas with primary
 * heading; secondary absolutely overlaid with a brand-cyan gradient
 * background and a different heading. A radial-gradient mask reveals
 * the secondary block only inside a circle that follows the cursor.
 *
 * No text rotation — per user 2026-04-30. The "change" comes from
 * the cursor sweeping across the static secondary text.
 *
 * Smooth interpolation handled natively via @property + CSS transition
 * (codepen used GSAP for the lerp). See `src/scripts/orb-cursor.ts`
 * for the pointermove → --x / --y wiring.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="orb-wrapper" data-orb-wrapper>
  <!-- Primary hero — dark canvas, white primary text -->
  <div class="orb-hero">
    <h2 class="orb-heading">{t('orb.primary')}</h2>
  </div>

  <!-- Secondary hero — absolute overlay, cyan gradient bg, dark text,
       revealed only through radial mask centred at cursor. -->
  <div class="orb-hero orb-hero--secondary" aria-hidden="true" data-orb-secondary>
    <p class="orb-heading">{t('orb.secondary')}</p>
  </div>

  {/*
    Mobile-only tilt CTA — touch-controlled orb dragging conflicts
    with vertical scroll, so on phones we expose device orientation
    instead. Button requests the iOS 13+ permission on tap (Android +
    older iOS just enable directly). Hidden on cursor devices.
    The data-state attr toggles between "off" (CTA "Hni telefonem")
    and "on" (subtle confirmation "Náhni telefon"). */}
  <button
    type="button"
    class="orb-tilt-button"
    data-orb-tilt-toggle
    data-state="off"
    data-active-label={t('orb.tiltActive')}
    aria-pressed="false"
  >
    <span class="orb-tilt-button__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="6" y="2" width="12" height="20" rx="2.5"></rect>
        <circle cx="12" cy="18" r="0.6" fill="currentColor"></circle>
      </svg>
    </span>
    <span class="orb-tilt-button__label" data-orb-tilt-label>
      {t('orb.tiltCta')}
    </span>
  </button>
</section>

<script>
  import { mountOrbCursor } from '../scripts/orb-cursor';
  mountOrbCursor();
</script>

<style>
  /*
    Register --x / --y as proper percentage typed CSS properties so
    the browser can transition them smoothly. Without @property the
    custom-property values are opaque strings and the circle would
    snap rather than follow the cursor.
  */
  @property --x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 70%;
  }
  @property --y {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 50%;
  }

  .orb-wrapper {
    position: relative;
    width: 100%;
    border-top: 1px solid var(--color-stroke-base);
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .orb-hero {
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 5rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orb-hero--secondary {
    /* Position-locked overlay over the primary block. */
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    /*
      Glass-marble orb body — pure brand-cyan radial gradient that
      follows the cursor / device tilt (same --x / --y as the mask).
      Per user feedback 2026-05-01: "tu kouli více do našich barev"
      — dropped the white-spec stop, every stop is now in the cyan
      ramp:
        0 %    cyan-subtle     → bright cyan-white centre
        18 %   accent-primary  → brand cyan body
        55 %   cyan ↔ canvas   → deepening teal
        100 %  cyan ↔ canvas   → bottom-of-orb shadow
    */
    --x: 70%;
    --y: 50%;
    background: radial-gradient(
      circle at calc(var(--x) - 6%) calc(var(--y) - 6%),
      var(--color-accent-primary-subtle) 0%,
      var(--color-accent-primary) 18%,
      color-mix(in srgb, var(--color-accent-primary) 75%, var(--color-bg-canvas)) 55%,
      color-mix(in srgb, var(--color-accent-primary) 45%, var(--color-bg-canvas)) 100%
    );

    /*
      Dark text inside the circle. Codepen uses canvas-dark
      (rgb(9, 14, 23)); we use our canvas variable so it tracks if
      the brand canvas changes.
    */
    color: var(--color-bg-canvas);

    /*
      Radial mask — sharper rim per user feedback 2026-05-01 ("ne
      tak rozostřené kraje"). Was a 3 % feathered transition; now
      a 1 % feather so the orb has a crisp glass edge instead of
      a soft blob.
    */
    --mask: radial-gradient(
      circle at var(--x) var(--y),
      black 0%,
      black 25%,
      rgba(0, 0, 0, 0.4) 25.7%,
      transparent 26%
    );
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);

    /* Overlay shouldn't capture cursor events; pointermove lives on
       window. */
    pointer-events: none;

    /*
      Smoothness budget:
        - --x / --y are typed @property values so the browser can
          actually transition them (untyped custom props would snap)
        - cubic-bezier matches GSAP's sine.out feel from codepen
        - 0.4s reads as smoother than 0.3s when the underlying
          movement is sample-throttled to one rAF per frame
        - will-change: mask-image promotes this layer to its own
          compositor surface so mask updates don't re-paint the
          surrounding section
        - translate3d is the canonical "force GPU layer" hack for
          older WebKit (otherwise mask repaints can jank)
        - backface-visibility hidden helps Safari coalesce layers
    */
    transition:
      --x 0.48s cubic-bezier(0.39, 0.575, 0.565, 1),
      --y 0.48s cubic-bezier(0.39, 0.575, 0.565, 1);
    will-change: mask-image, -webkit-mask-image;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }

  .orb-heading {
    margin: 0;
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 8rem);
    line-height: 1;
    /* Limit horizontal width so the headline stays on one line
       inside the cursor circle (codepen uses max-width: fit-content
       + auto margins). */
    max-width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  /*
    Mobile-only tilt CTA — small frosted-glass pill anchored to the
    bottom of the orb section. Hidden on cursor devices (mouse can
    just hover); shown on coarse pointer (phones, tablets). Once the
    user grants orientation access, the button sticks around as a
    subtle "Tilt to move" pip so they remember the interaction model.
  */
  .orb-tilt-button {
    display: none;
  }

  @media (pointer: coarse) {
    .orb-tilt-button {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      position: absolute;
      bottom: clamp(1.5rem, 5vh, 3rem);
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      padding: 0.7rem 1.2rem;
      border: 1px solid rgba(0, 240, 255, 0.32);
      border-radius: 9999px;
      background: linear-gradient(
        180deg,
        rgba(0, 240, 255, 0.16) 0%,
        rgba(0, 240, 255, 0.05) 55%,
        rgba(255, 255, 255, 0.02) 100%
      );
      backdrop-filter: blur(14px) saturate(170%);
      -webkit-backdrop-filter: blur(14px) saturate(170%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        inset 0 0 0 1px rgba(0, 240, 255, 0.12),
        0 8px 22px -10px rgba(0, 240, 255, 0.4);
      color: var(--color-text-primary);
      font: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .orb-tilt-button[data-state='on'] {
      opacity: 0.7;
    }
    .orb-tilt-button:active {
      transform: translateX(-50%) scale(0.96);
    }
  }

  .orb-tilt-button__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: var(--color-accent-primary);
    /* Gentle wiggle so the user reads "tilt me" — only when off. */
    animation: orb-tilt-wiggle 1.6s ease-in-out infinite;
  }
  .orb-tilt-button[data-state='on'] .orb-tilt-button__icon {
    animation: none;
  }
  @keyframes orb-tilt-wiggle {
    0%, 100% { transform: rotate(-12deg); }
    50% { transform: rotate(12deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .orb-tilt-button__icon { animation: none; }
  }
</style>
