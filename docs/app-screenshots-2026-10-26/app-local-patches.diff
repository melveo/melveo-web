+    private func tapRosterRow(containing name: String, _ app: XCUIApplication) -> Bool {
+        let row = app.descendants(matching: .any).matching(NSPredicate(
+            format: "identifier BEGINSWITH %@ AND label CONTAINS %@", "teamRosterPlayer_", name)).firstMatch
+        for _ in 0..<4 where !(row.exists && row.isHittable) { app.swipeUp(velocity: .slow) }
+        if row.waitForExistence(timeout: 3), row.isHittable { row.tap(); return true }
+        return false
+    }
