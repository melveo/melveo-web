---
import { ui, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  current: Lang;
  /** Path to swap locale on. Default: current page path. */
  pathname?: string;
  /** Exact path of this page in the other locale when slugs differ. */
  alternatePath?: string;
  ariaLabel?: string;
}

const { current, pathname = Astro.url.pathname, alternatePath, ariaLabel } = Astro.props;
const t = useTranslations(current);

/**
 * Build the swapped path. Rules:
 *   - /cs/foo  → /en/foo
 *   - /en/foo  → /cs/foo
 *   - /        → /<other>/  (root redirect handled separately)
 */
function swap(path: string, fromLocale: Lang, toLocale: Lang): string {
  const prefix = `/${fromLocale}/`;
  if (path === `/${fromLocale}` || path === prefix.slice(0, -1)) {
    return `/${toLocale}/`;
  }
  if (path.startsWith(prefix)) {
    return `/${toLocale}/${path.slice(prefix.length)}`;
  }
  return `/${toLocale}/`;
}

const locales = Object.keys(ui) as Lang[];
---

<nav class="flex items-center gap-1 text-sm" aria-label={ariaLabel ?? t('help.localeAria')}>
  {
    locales.map((locale) => {
      const isCurrent = locale === current;
      const href = locale === current ? pathname : alternatePath ?? swap(pathname, current, locale);
      return (
        <a
          href={href}
          aria-current={isCurrent ? 'true' : undefined}
          class:list={[
            // min 44 × 44 tap target for phone — was 35×28 (audit 2026-05-01).
            'inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-2 rounded-md transition-colors',
            isCurrent
              ? 'text-[var(--color-text-primary)]'
              : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]',
          ]}
        >
          {locale.toUpperCase()}
        </a>
      );
    })
  }
</nav>
