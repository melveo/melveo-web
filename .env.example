# melveo-web env vars
#
# Copy to .env (gitignored) for local dev or set in Cloudflare Pages
# project settings for production. All variables prefixed with PUBLIC_
# are inlined at build time and shipped to the browser.

# --- Analytics (V4-F) ---

# Google Tag Manager container ID. Format: GTM-XXXXXXX
# Leave empty to skip GTM entirely (no <script> + no <noscript>).
# When set, GA4 + Meta Pixel + any future tags are managed via the
# GTM dashboard, not this repo. Default Consent Mode v2 = denied.
PUBLIC_GTM_CONTAINER_ID=

# Cloudflare Web Analytics token. Cookieless beacon, doesn't require
# user consent. Found in Cloudflare dashboard → Analytics →
# Web Analytics → site → "Click here for the snippet" — copy the
# token portion of the script's data-cf-beacon JSON.
PUBLIC_CF_ANALYTICS_TOKEN=
