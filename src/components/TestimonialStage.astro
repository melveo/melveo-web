---
/**
 * TestimonialStage — single quote pull from a real club coach.
 *
 * Two states controlled by the `placeholder` prop:
 *   - placeholder: true (default until first real pilot quote)
 *       Shows a soft "Citát bude doplněn po prvním pilotu" message
 *       in the same visual frame so the section's existence on the
 *       page is established now (no layout shift later when the
 *       quote arrives).
 *   - placeholder: false
 *       Renders the real quote + author + role from i18n keys
 *       `testimonial.quote / .author / .role`. To switch, just set
 *       `placeholder={false}` in Landing.astro.
 *
 * No JS, no fancy effects — credibility section should feel honest
 * and quiet, not flashy. One large blockquote, soft glass surface
 * underneath, attribution below.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** When true (default), shows a placeholder. Flip to false once a
   *  real quote is ready and `testimonial.quote / .author / .role`
   *  are filled in for both locales. */
  placeholder?: boolean;
}

const { lang, placeholder = true } = Astro.props;
const t = useTranslations(lang);

const quote = placeholder ? t('testimonial.placeholder') : t('testimonial.quote');
const author = placeholder
  ? t('testimonial.placeholderAuthor')
  : t('testimonial.author');
const role = placeholder ? '' : t('testimonial.role');
---

<section class="testimonial-stage" aria-labelledby="testimonial-heading">
  <div class="testimonial-stage__inner">
    <figure class="testimonial-stage__figure">
      <span class="testimonial-stage__quote-mark" aria-hidden="true">&ldquo;</span>
      <blockquote
        id="testimonial-heading"
        class:list={['testimonial-stage__quote', { 'is-placeholder': placeholder }]}
      >
        {quote}
      </blockquote>
      <figcaption class="testimonial-stage__caption">
        <span class="testimonial-stage__author">{author}</span>
        {role && (
          <>
            <span class="testimonial-stage__caption-divider" aria-hidden="true">·</span>
            <span class="testimonial-stage__role">{role}</span>
          </>
        )}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .testimonial-stage {
    position: relative;
    width: 100%;
    background: var(--color-bg-canvas);
    /* border-top removed 2026-05-17: no horizontal dividers between sections */
    overflow: hidden;
  }

  .testimonial-stage::before {
    /* Soft cyan halo behind the quote — matches the section family
       (gooey, particles, promise, faq all have a brand cyan radial
       to keep the visual rhythm). */
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--color-accent-primary) 8%, transparent),
      transparent 50%
    );
    pointer-events: none;
    z-index: 0;
  }

  .testimonial-stage__inner {
    position: relative;
    z-index: 1;
    max-width: 50rem;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 6.5rem) clamp(1.25rem, 5vw, 2rem);
    text-align: center;
  }

  .testimonial-stage__eyebrow {
    margin: 0 0 1.5rem;
    color: var(--color-accent-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  .testimonial-stage__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .testimonial-stage__quote-mark {
    /* Big decorative quote mark above the blockquote — visual cue
       that this is a citation. Cyan to match the eyebrow accent. */
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    line-height: 0.6;
    color: var(--color-accent-primary);
    opacity: 0.55;
  }

  .testimonial-stage__quote {
    margin: 0;
    font-size: clamp(1.15rem, 2.4vw, 1.65rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  .testimonial-stage__quote.is-placeholder {
    /* Placeholder reads dimmer + italic so it's clearly NOT a real
       quote yet — but still occupies the section so the layout is
       stable when the real quote drops in. */
    color: var(--color-text-secondary);
    font-style: italic;
    opacity: 0.7;
  }

  .testimonial-stage__caption {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .testimonial-stage__author {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .testimonial-stage__caption-divider {
    opacity: 0.5;
  }

  .testimonial-stage__role {
    font-weight: 400;
  }
</style>
