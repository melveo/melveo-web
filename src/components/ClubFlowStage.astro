      radial-gradient(circle at 72% 22%, color-mix(in srgb, var(--color-accent-primary) 24%, transparent), transparent 58%),
      linear-gradient(180deg, rgba(0, 240, 255, 0.12), rgba(255, 255, 255, 0.025)),
      rgba(0, 0, 0, 0.16);
  }

  .club-flow-stage__metrics dt {
    order: 2;
    margin: 0.5rem 0 0;
