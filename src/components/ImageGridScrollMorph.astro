---
/**
 * ImageGridScrollMorph — Kevin Gutowski codepen QwNZYzL.
 *
 * Direct re-implementation of the codepen source after the V4-D draft
 * missed the architecture. The trick is:
 *
 *   1. A 240vh-tall section with sticky inner content (.content)
 *      pinned at top:0 — gives 140vh of scroll runway while the
 *      grid stays visible.
 *   2. The grid is 5 columns × 3 rows (3 cols on mobile). Cells are
 *      placed via CSS subgrid on three "layer" wrappers + one absolute
 *      ".scaler" element at the centre cell.
 *   3. The scaler image animates `width` and `height` in PIXELS from
 *      viewport size DOWN to its natural grid-cell size as the user
 *      scrolls — different easings per axis (power2 width, power1
 *      height) for the codepen's signature asymmetric feel.
 *   4. Each layer has TWO scroll-linked animations:
 *        - opacity: holds at 0 until 55 % scroll, then 0 → 1
 *        - scale:   holds at 0 until 30 % scroll, then 0 → 1
 *      using progressively more aggressive easings per layer
 *      (power1, power3, power4) — outer edges feel slower, inner
 *      cells punch in.
 *
 * No headline above the grid (per user 2026-04-30 — "ten text pojme
 * scrollovat dej pryč"). The grid is the whole effect.
 *
 * Photos are the codepen's original Unsplash URLs as a starting set.
 * Swap to real Melveo iOS screenshots when available (Q6 deferred).
 */
---

<section class="image-grid-section" data-grid-section>
  <div class="content">
    <div class="grid">
      <!-- Layer 1: Outer edges (6 images, 3 left + 3 right) -->
      <div class="layer">
        <div>
          <img src="https://images.unsplash.com/photo-1463100099107-aa0980c362e6?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1556304044-0699e31c6a34?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1590330297626-d7aff25a0431?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1487222477894-8943e31ef7b2?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1488161628813-04466f872be2?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1565321590372-09331b9dd1eb?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Layer 2: Inner columns (6 images) -->
      <div class="layer">
        <div>
          <img src="https://images.unsplash.com/photo-1531525645387-7f14be1bdbbd?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1637414165749-9b3cd88b8271?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1699911251220-8e0de3b5ce88?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1667483629944-6414ad0648c5?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://plus.unsplash.com/premium_photo-1706078438060-d76ced26d8d5?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1525385444278-b7968e7e28dc?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Layer 3: Center column top + bottom (2 images) -->
      <div class="layer">
        <div>
          <img src="https://images.unsplash.com/reserve/LJIZlzHgQ7WPSh5KVTCB_Typewriter.jpg?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.0.3" alt="" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Scaler: starts viewport-sized, shrinks into the centre cell -->
      <div class="scaler">
        <img src="https://assets.codepen.io/605876/model-shades.jpg?format=auto&quality=100" alt="" decoding="async" />
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Subgrid trick + sticky content — direct port from the codepen.
    Comments mark anywhere we deviated.
  */

  .image-grid-section {
    /* 240vh runway — 1× viewport pinned + 140vh scroll budget for the
       morph to play out. Mobile gets a touch more height for the
       3-col layout. */
    position: relative;
    width: 100%;
    min-height: 240vh;
    background: var(--color-bg-canvas);
    border-top: 1px solid var(--color-stroke-base);
    overflow: clip;
  }

  .image-grid-section .content {
    min-height: 100vh;
    width: 100vw;
    position: sticky;
    top: 0;
    overflow: hidden;
    display: flex;
    place-items: center;
    align-content: center;
  }

  .image-grid-section .grid {
    --offset: 0;
    --container-width: 1600px;
    --gap: clamp(10px, 7.35vw, 80px);
    --gutter: 2rem;

    width: var(--container-width);
    max-width: calc(100% - (2 * var(--gutter)));
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(3, auto);
    gap: var(--gap);
    margin: 0 auto;
    align-content: center;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  @media (max-width: 600px) {
    .image-grid-section .grid {
      --gutter: 1rem;
      grid-template-columns: repeat(3, 1fr);
      --offset: -1;
    }
    /* Hide outer edges on mobile (3-col layout has no room for them) */
    .image-grid-section .grid > .layer:nth-of-type(1) {
      display: none;
    }
  }

  /* Layers spread across the full 5×3 (or 3×3 mobile) grid via subgrid */
  .image-grid-section .grid > .layer {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }

  /* Layer 1: outer edges — odd children → col 1, even → col -2 */
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-of-type(odd) {
    grid-column: 1;
  }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-of-type(even) {
    grid-column: -2;
  }

  /* Layer 2: inner columns — odd → col 2, even → col -3
     (offset shifts by -1 on mobile so col indexing collapses cleanly) */
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-of-type(odd) {
    grid-column: calc(2 + var(--offset));
  }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-of-type(even) {
    grid-column: calc(-3 - var(--offset));
  }

  /* Layer 3: center column top + bottom rows */
  .image-grid-section .grid > .layer:nth-of-type(3) > div:first-of-type {
    grid-column: calc(3 + var(--offset));
    grid-row: 1;
  }
  .image-grid-section .grid > .layer:nth-of-type(3) > div:last-of-type {
    grid-column: calc(3 + var(--offset));
    grid-row: -1;
  }

  .image-grid-section .grid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1rem;
    display: block;
  }

  /* Scaler container occupies the centre cell of the grid; its <img>
     is absolutely positioned so we can animate width/height in pixels
     while keeping the image perfectly centred. */
  .image-grid-section .grid .scaler {
    position: relative;
    grid-area: 2 / calc(3 + var(--offset));
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  .image-grid-section .scaler img {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    object-fit: cover;
    border-radius: 1rem;
    width: 100%;
    height: 100%;
  }

  /* Reduced-motion: drop the sticky/scroll dance. Show every cell in
     its final position, statically. */
  @media (prefers-reduced-motion: reduce) {
    .image-grid-section {
      min-height: auto;
    }
    .image-grid-section .content {
      position: relative;
      min-height: 80vh;
    }
    .image-grid-section .grid {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
    }
  }
</style>

<script>
  import { animate, scroll } from 'motion';

  /*
    Motion v12 keyframe-timing API note:
      - For keyframe positions within an animate() call use `times: [...]`,
        NOT `offset: [...]` (offset is reserved for scroll() target config).
      - Easing key is `ease`, NOT `easing` (Motion v11 used `easing`; the
        codepen we're porting from uses v11).
    Earlier versions of this file used the v11 names which Motion v12
    silently ignored, so the hold-pattern keyframes were treated as
    equally spaced and the per-axis easings dropped to defaults — that's
    why the scaler appeared to shrink immediately on scroll instead of
    holding at viewport size.
  */

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const section = document.querySelector<HTMLElement>('[data-grid-section]');
    const image = section?.querySelector<HTMLImageElement>('.scaler img');
    const layers = section?.querySelectorAll<HTMLElement>('.grid > .layer');

    if (section && image && layers && layers.length > 0) {
      // Wait one frame so layout has settled and the natural cell size is
      // measurable from a sibling layer image (which retains its CSS
      // 100%-of-cell sizing — the scaler image gets sized to viewport
      // immediately so we can't measure it ourselves).
      requestAnimationFrame(() => {
        // Natural cell width = same for all 15 cells (5-col grid). Use
        // any layer img as a measurement proxy for the scaler.
        const sample = section.querySelector<HTMLImageElement>('.layer img');
        const naturalWidth = sample?.offsetWidth ?? 280;
        const naturalHeight = sample?.offsetHeight ?? 350;

        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;

        // Cubic-bezier control points. Names match GSAP power easings
        // referenced by the codepen.
        const power1InOut = [0.42, 0, 0.58, 1] as const;
        const power2InOut = [0.65, 0, 0.35, 1] as const;
        const power3InOut = [0.76, 0, 0.24, 1] as const;
        const power4InOut = [0.87, 0, 0.13, 1] as const;
        const sineOut = [0.61, 1, 0.88, 1] as const;

        // ─── Scaler: hold at viewport, then shrink to natural ──────────
        //     Width AND height in a SINGLE animate() call. Splitting
        //     them into two scroll(animate()) registrations on the same
        //     element broke things — Motion v12 treats the second call
        //     as a takeover and cancels the first, which is why width
        //     stayed at its CSS default while height morphed to viewport.
        //     Using one combined call with shared options preserves
        //     both axes; we sacrifice the codepen's per-axis asymmetric
        //     easing (power2 width vs power1 height) for correctness.
        //     The asymmetry is recovered visually anyway because the
        //     start delta differs between width and height.
        scroll(
          animate(
            image,
            {
              width: [
                `${viewportWidth}px`,
                `${viewportWidth}px`,
                `${naturalWidth}px`,
              ],
              height: [
                `${viewportHeight}px`,
                `${viewportHeight}px`,
                `${naturalHeight}px`,
              ],
            },
            {
              times: [0, 0.15, 1],
              ease: power2InOut as any,
            },
          ),
          {
            target: section,
            offset: ['start start', 'end end'] as any,
          },
        );

        // ─── Each layer: opacity (hold→fade) + scale (hold→reveal) ─────
        const scaleEasings = [power1InOut, power3InOut, power4InOut];

        layers.forEach((layer, index) => {
          // Endpoint shifts per layer for a subtle cascade as in codepen.
          const endOffset = `${1 - index * 0.05} end`;

          // Opacity: invisible until 55 % progress, then fades 0 → 1
          scroll(
            animate(
              layer,
              { opacity: [0, 0, 1] },
              {
                times: [0, 0.55, 1],
                ease: sineOut as any,
              },
            ),
            {
              target: section,
              offset: ['start start', endOffset] as any,
            },
          );

          // Scale: held at 0 until 30 % progress, then springs to 1
          scroll(
            animate(
              layer,
              { scale: [0, 0, 1] },
              {
                times: [0, 0.3, 1],
                ease: scaleEasings[index] as any,
              },
            ),
            {
              target: section,
              offset: ['start start', endOffset] as any,
            },
          );
        });
      });
    }
  }
</script>
