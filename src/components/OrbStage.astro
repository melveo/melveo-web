---
/**
 * OrbStage — Giomgio codepen abxGyQX (V4-D4 v2).
 *
 * Re-implementation per user 2026-04-30: two stacked hero blocks at
 * 100vh, both centred. Primary block sits on the dark canvas with the
 * primary headline. Secondary block is absolutely overlaid on top
 * with a brand-cyan tinted gradient background and a different
 * headline; a radial-gradient mask reveals it only inside a circle
 * that follows the cursor.
 *
 * Original codepen used GSAP. We use Motion (already loaded) for the
 * smooth easing of the --x / --y CSS variables tied to the mask
 * position. Phrases rotate every few seconds so the secondary headline
 * cycles through "Pro hráče. / Pro trenéra. / Pro klub." (or EN).
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="orb-wrapper" data-orb-wrapper>
  <!-- Primary hero — dark canvas, primary text -->
  <div class="orb-hero">
    <h2 class="orb-heading">{t('orb.primary')}</h2>
  </div>

  <!-- Secondary hero — absolute overlay, gradient bg, rotating text,
       revealed only through radial mask centred at cursor.
       Phrases passed via data-attribute (JSON-encoded array) so the
       script can run as a clean ES module without `define:vars`,
       which had inconsistent behaviour with Astro 6 + type="module"
       in our hosting/bundling setup. -->
  <div class="orb-hero orb-hero--secondary" aria-hidden="true" data-orb-secondary>
    <p
      class="orb-heading"
      data-orb-rotate
      data-orb-phrases={JSON.stringify([
        t('orb.secondary1'),
        t('orb.secondary2'),
        t('orb.secondary3'),
      ])}
    >
      {t('orb.secondary1')}
    </p>
  </div>
</section>

<script>
  import { mountOrbCursor } from '../scripts/orb-cursor';
  mountOrbCursor();
</script>

<style>
  /*
    Register --x / --y as proper percentage typed CSS properties.
    Without this, browsers treat them as opaque strings and can't
    animate them — the circle would snap rather than follow the
    cursor smoothly. With @property + transition below we get
    native GPU-smooth interpolation without any JS lerp.
  */
  @property --x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 70%;
  }
  @property --y {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 50%;
  }

  .orb-wrapper {
    position: relative;
    width: 100%;
    /* Border-top to keep section bands consistent with siblings. */
    border-top: 1px solid var(--color-stroke-base);
  }

  .orb-hero {
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 5rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orb-hero--secondary {
    /* Position-locked overlay over the primary block. */
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    /* Brand-leaning gradient. Codepen used violet→mint→white; we
       lean into Melveo's cyan + a sandy warm so the reveal still feels
       distinct from the rest of the page (which is mostly cyan-on-black). */
    background: linear-gradient(45deg, #00f0ff, #b0702e, #ffffff);
    color: var(--color-bg-canvas);

    /* Radial mask — circle of brand-cyan tinted gradient revealed
       through the dark canvas. --x / --y are registered @property
       above (typed as percentage) so the transition below works.
       Default 70%/50% on first paint; pointermove updates inline. */
    --x: 70%;
    --y: 50%;
    --mask: radial-gradient(circle at var(--x) var(--y), black 22%, transparent 0);
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
    pointer-events: none;

    /* Smooth follow — browser interpolates --x / --y because they're
       registered as <percentage> via @property. */
    transition:
      --x 0.35s cubic-bezier(0.39, 0.575, 0.565, 1),
      --y 0.35s cubic-bezier(0.39, 0.575, 0.565, 1);
  }

  .orb-heading {
    margin: 0;
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 8rem);
    line-height: 1;
    /* Limit horizontal width so long Czech phrases stay on one line
       inside the cursor circle. */
    max-width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  .orb-hero--secondary .orb-heading {
    /* Force colour to canvas dark — readable against the gradient
       inside the cursor circle. */
    color: var(--color-bg-canvas);
  }

  @media (prefers-reduced-motion: reduce) {
    .orb-heading {
      transition: none;
    }
  }
</style>
