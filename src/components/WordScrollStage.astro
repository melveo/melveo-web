---
/**
 * WordScrollStage — close port of Daniel Haim's CodePen azmBEPL.
 *
 * Sticky prefix plus a page-scrolled word list with CSS
 * view-timeline brightening mapped to the Melveo palette.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const words = t('wordScroll.words').split('|');
const startIndex = 0;
const endIndex = words.length - 1;
const remainingSteps = Math.max(1, endIndex - startIndex);
const scrollFriction = 1.65;
const scrollDistance = `${remainingSteps * 6.09375 * scrollFriction}rem`;
const scrollDistanceTablet = `${remainingSteps * 5.4375 * scrollFriction}rem`;
const scrollDistanceMobile = `${remainingSteps * 5 * scrollFriction}rem`;
const scrollDistanceSmall = `${remainingSteps * 4.5 * scrollFriction}rem`;
// Phones size the type so the longest phrase fits one line.
const longestWord = Math.max(...words.map((word) => word.length));
const hueStart = 205;
const hueEnd = 178;
const hueStep = (hueEnd - hueStart) / Math.max(1, words.length - 1);
---

<section
  id="coach"
  class="word-scroll-stage"
  data-word-scroll-stage
  data-start-index={startIndex}
  data-end-index={endIndex}
  style={`--word-scroll-count: ${words.length}; --word-scroll-active-index: ${startIndex}; --word-scroll-distance: ${scrollDistance}; --word-scroll-distance-tablet: ${scrollDistanceTablet}; --word-scroll-distance-mobile: ${scrollDistanceMobile}; --word-scroll-distance-small: ${scrollDistanceSmall}; --word-scroll-longest: ${longestWord};`}
>
  <div class="word-scroll-stage__pin">
    <div class="word-scroll-stage__inner">
      <h2 class="word-scroll-stage__prefix">
        <span aria-hidden="true">{t('wordScroll.prefix')}&nbsp;</span>
        <span class="word-scroll-stage__sr-only">
          {t('wordScroll.screenReader')}
        </span>
      </h2>

      <div class="word-scroll-stage__list-viewport" aria-hidden="true">
        <ul class="word-scroll-stage__list">
          {words.map((word, index) => (
            <li
              class="word-scroll-stage__item"
              style={`--i: ${index}; --word-hue: ${hueStart + index * hueStep}; --word-distance: ${Math.abs(index - startIndex)}; --word-focus: ${index === startIndex ? 1 : 0};`}
            >
              <span class="glass-content word-scroll-stage__word">{word}</span>
            </li>
          ))}
        </ul>
        {/* Phones only: a fixed cyan lens the phrases scroll through. Its
            copy of the list is the dark in-box text; both lists share
            --word-scroll-active-index, so they move as one. */}
        <div class="word-scroll-stage__lens">
          <ul class="word-scroll-stage__lens-list">
            {words.map((word) => (
              <li class="word-scroll-stage__lens-item">{word}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .word-scroll-stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: calc(100vh + var(--word-scroll-distance));
    overflow: visible;
    /* border-top + border-bottom removed 2026-05-17: no horizontal dividers between sections */
    background: var(--color-bg-canvas);
    color: var(--color-text-primary);
    color-scheme: dark;
  }

  /*
    Background blur halos (::before cyan+amber, ::after cyan) removed
    2026-05-17 per user direction: section must be pure black, only
    the prefix + cycling word list remain. No ambient glow blobs
    behind the text.
  */

  .word-scroll-stage__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    z-index: 1;
  }

  .word-scroll-stage__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.24em;
    height: 100%;
    min-width: min-content;
    padding-inline: 1.5rem;
    /*
      4.5vw (was 5.6vw, 2026-06-10): the row "Coach knows + what to
      change in the plan" is ~21em wide; at 5.6vw it physically
      exceeded the viewport between ~1100–1600px and the longest
      phrase clipped at the right edge (visible since the cyan
      keyword box made the overflow obvious). 4.5vw keeps the row
      ≤ ~96vw across that band; the 4.875rem cap means large
      desktops are pixel-identical to before.
    */
    font-size: clamp(3.35rem, 4.5vw, 4.875rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .word-scroll-stage__prefix {
    flex: 0 0 auto;
    height: fit-content;
    margin: 0;
    font: inherit;
    background: linear-gradient(
      180deg,
      var(--color-text-primary) 42%,
      color-mix(in oklch, var(--color-bg-canvas), var(--color-text-primary) 38%) 100%
    );
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
    text-shadow: 0 14px 28px rgba(0, 0, 0, 0.34);
  }

  /*
    Viewport is sized to ONE line-height — this is the alignment
    anchor for the active word. We let the parent flex container's
    `align-items: center` line up the viewport with the prefix
    directly, so the two never drift apart regardless of how iOS
    Safari resolves the sticky pin's `100vh` against its dynamic
    visual viewport (URL-bar collapse on production caused the old
    `height: 100%; top: 50%` pattern to misalign the active word
    above the prefix baseline — fix 2026-05-01).

    Items above + below the active one still need to be visible
    (faded list flowing through the centre), so overflow stays
    `visible`.
  */
  .word-scroll-stage__list-viewport {
    position: relative;
    flex: 0 0 auto;
    height: 1.25em;
    align-self: center;
    min-width: 0;
    max-width: min(72vw, 58rem);
    overflow: visible;
  }

  /*
    List stays `position: relative` so it contributes to the viewport's
    intrinsic width (white-space: nowrap + width: max-content makes
    it size to the longest item). If we used position: absolute here
    the viewport would collapse to width 0 — its `flex: 0 0 auto`
    basis can't read the list's intrinsic size from absolute children.

    Vertical centring math:
      - viewport is 1.25em tall, flex-centred against the prefix
      - list is at top: 50% (= 0.625em from viewport top)
      - translateY shifts the list up by half-item + active_index items
      - active item lands with its centre at 0.625em from viewport top
        = exact viewport vertical centre
      - Items above + below the active one are visible because the
        viewport's overflow stays `visible`.
  */
  .word-scroll-stage__list {
    position: relative;
    top: 50%;
    left: 0;
    width: max-content;
    max-width: min(72vw, 58rem);
    transform: translate3d(
      0,
      calc(-0.625em - (var(--word-scroll-active-index) * 1.25em)),
      0
    );
    list-style: none;
    margin: 0;
    padding: 0;
    padding-left: 0;
    font: inherit;
    white-space: nowrap;
    will-change: transform;
  }

  .word-scroll-stage__item {
    position: relative;
    display: block;
    width: max-content;
    overflow: visible;
    border-radius: 0.34em;
    /*
      Kinetic keyword box (2026-06-10) — the focused word gets the
      brand-cyan highlight box with dark text: the exact motif the
      promo-video titles use ("Capture every [moment]"), so video and
      web speak one visual language. --word-focus is continuous (set
      per-frame by the scroll driver below), so the box breathes
      in/out with scroll instead of snapping. --word-boxed squares it
      so the box only blooms near full focus while opacity still
      ramps earlier. Constant padding ⇒ zero layout shift.
    */
    --word-boxed: calc(var(--word-focus, 0) * var(--word-focus, 0));
    padding-inline: 0.3em;
    margin-inline: -0.3em;
    /*
      No max-width clamp here (2026-06-10 fix): the text is nowrap, so
      the old min(72vw, 58rem) clamp never changed glyph layout — it
      only shrank THIS box, and once the box paints the cyan highlight
      the longest EN phrase ("what to change in the plan") visibly
      spilled past it. max-content lets the highlight hug the full
      phrase; the ≤860px media block below still re-clamps for mobile.
    */
    background: color-mix(
      in srgb,
      var(--color-accent-primary) calc(var(--word-boxed) * 92%),
      transparent
    );
    --word-accent: oklch(0.82 0.16 var(--word-hue));
    --word-accent-muted: color-mix(
      in oklch,
      var(--word-accent) 45%,
      var(--color-text-primary)
    );
    color: color-mix(
      in oklch,
      oklch(0.2 0.03 220) calc(var(--word-boxed) * 100%),
      var(--word-accent-muted)
    );
    opacity: clamp(0.62, calc(0.62 + (var(--word-focus) * 0.38)), 1);
    filter: brightness(clamp(0.9, calc(0.94 + (var(--word-focus) * 0.2)), 1.14));
    box-shadow: 0 0 calc(var(--word-boxed) * 26px)
      color-mix(in srgb, var(--color-accent-primary) 38%, transparent);
    transition: none;
    will-change: opacity, filter;
  }

  .word-scroll-stage__item:last-of-type {
    /* The closing line keeps its bespoke white-gradient finale — no box. */
    --word-boxed: 0;
    background: transparent;
    box-shadow: none;
    color: var(--color-text-primary);
  }

  .word-scroll-stage__item:last-of-type .word-scroll-stage__word {
    background: linear-gradient(
      var(--color-text-primary) 50%,
      color-mix(in oklch, var(--color-bg-canvas), var(--color-text-primary) 25%)
    );
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
  }

  .word-scroll-stage__item:hover {
    transform: none;
  }

  .word-scroll-stage__word {
    display: inline-block;
    flex: none;
    /*
      NO max-width here (2026-06-10, second fix): with nowrap the clamp
      never wrapped anything — it only shrank this span's BOX while the
      glyphs overflowed it invisibly. The parent item sizes itself
      max-content from THIS span's clamped box, so the cyan highlight
      ended ~1 character short of the phrase on viewports ≥ ~1730px
      (where the font hits its 4.875rem cap and the longest EN phrase
      exceeds 58rem). Box must always equal the real glyph run; the
      ≤860px media block below still constrains mobile.
    */
    overflow: visible;
    white-space: nowrap;
    /* Glow fades out as the cyan box blooms — dark text inside the box
       must stay crisp, the box-shadow on the item carries the glow. */
    text-shadow: 0 0 calc(30px * var(--word-focus) * (1 - var(--word-boxed, 0)))
      color-mix(in oklch, var(--word-accent) 46%, transparent);
  }

  .word-scroll-stage__lens {
    display: none;
  }

  .word-scroll-stage__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1100px) {
    .word-scroll-stage {
      --word-scroll-distance: var(--word-scroll-distance-tablet);
    }

    .word-scroll-stage__inner {
      /* 4.4vw (was 5.4vw) — same overflow fix for the 860–1100px band */
      font-size: clamp(2.75rem, 4.4vw, 4.2rem);
    }
  }

  /*
    Phones (2026-10-26): picker-wheel layout. The cyan lens sits fixed
    one row under the prefix; phrases scroll through it continuously
    (no stop-and-jump), the lens width follows the phrase in it, and
    the dark in-box text is a second copy of the list clipped by the
    lens. One dimmed row above, two below, soft-masked — nothing is
    cut by a hard edge and nothing passes through the prefix. Type is
    sized so the longest phrase fits one line (~0.56em per glyph).
  */
  @media (max-width: 860px) {
    .word-scroll-stage {
      --word-scroll-distance: var(--word-scroll-distance-mobile);
    }

    .word-scroll-stage__inner {
      flex-direction: column;
      gap: 0.1em;
      padding-inline: 1rem;
      font-size: clamp(
        1.25rem,
        calc((100vw - 2rem) / (var(--word-scroll-longest, 20) * 0.56 + 0.6)),
        2.6rem
      );
      line-height: 1.25;
      text-align: center;
    }

    .word-scroll-stage__prefix {
      line-height: 1.1;
    }

    .word-scroll-stage__list-viewport {
      container-type: inline-size;
      width: 100%;
      max-width: none;
      height: 5em;
      overflow: hidden;
      mask-image: linear-gradient(
        to bottom,
        transparent 0,
        rgba(0, 0, 0, 0.5) 0.6em,
        #000 1.25em,
        #000 2.5em,
        rgba(0, 0, 0, 0.55) 3.75em,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to bottom,
        transparent 0,
        rgba(0, 0, 0, 0.5) 0.6em,
        #000 1.25em,
        #000 2.5em,
        rgba(0, 0, 0, 0.55) 3.75em,
        transparent 100%
      );
    }

    .word-scroll-stage__list {
      top: 0;
      width: 100%;
      max-width: none;
      transform: translate3d(
        0,
        calc(1.25em - (var(--word-scroll-active-index) * 1.25em)),
        0
      );
    }

    .word-scroll-stage__item {
      --word-boxed: 0;
      width: fit-content;
      margin-inline: auto;
      text-align: center;
      background: transparent;
      box-shadow: none;
      opacity: clamp(0.25, calc(1 - var(--word-distance, 0) * 0.42), 1);
      filter: none;
      will-change: opacity;
    }

    .word-scroll-stage__word {
      text-shadow: none;
    }

    .word-scroll-stage__lens {
      display: block;
      position: absolute;
      top: 1.25em;
      left: 50%;
      width: var(--word-lens-width, 6em);
      height: 1.25em;
      overflow: hidden;
      border-radius: 0.34em;
      background: color-mix(in srgb, var(--color-accent-primary) 92%, transparent);
      box-shadow: 0 0 22px color-mix(in srgb, var(--color-accent-primary) 38%, transparent);
      transform: translateX(-50%);
      pointer-events: none;
    }

    .word-scroll-stage__lens-list {
      position: absolute;
      top: 0;
      left: 50%;
      width: 100cqw;
      margin: 0;
      padding: 0;
      list-style: none;
      color: oklch(0.2 0.03 220);
      white-space: nowrap;
      transform: translate3d(
        -50%,
        calc(var(--word-scroll-active-index) * -1.25em),
        0
      );
      will-change: transform;
    }

    .word-scroll-stage__lens-item {
      height: 1.25em;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word-scroll-stage__item {
      opacity: 0.72;
      filter: none;
    }
  }
</style>

<script>
  const clampWordScroll = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const mobileWordScroll = window.matchMedia('(max-width: 860px)');

  const updateWordScrollStages = () => {
    document.querySelectorAll<HTMLElement>('[data-word-scroll-stage]').forEach((root) => {
      const startIndex = Number(root.getAttribute('data-start-index') || 0);
      const endIndex = Number(root.getAttribute('data-end-index') || startIndex);
      const rect = root.getBoundingClientRect();
      const scrollableDistance = Math.max(1, root.offsetHeight - window.innerHeight);
      const progress = clampWordScroll(-rect.top / scrollableDistance, 0, 1);
      let activeIndex = startIndex + progress * (endIndex - startIndex);

      if (mobileWordScroll.matches) {
        /*
          Phones: continuous motion with a pull toward each phrase
          (35 % linear, 65 % smoothstep per slot) — it never stops
          dead, it slows while a phrase sits in the lens and crosses
          the lens edge quickly.
          The rendered index then eases toward that target per frame,
          so coarse touch-scroll steps still read as one glide.
        */
        const base = Math.floor(activeIndex);
        const f = activeIndex - base;
        const target = base + 0.35 * f + 0.65 * f * f * (3 - 2 * f);
        mobileTargets.set(root, target);
        return;
      }

      paintWordScroll(root, activeIndex);
    });

    if (mobileWordScroll.matches && !mobileGlideFrame) {
      mobileGlideFrame = window.requestAnimationFrame(glideMobileWordScroll);
    }
  };

  const paintWordScroll = (root: HTMLElement, activeIndex: number) => {
    root.style.setProperty('--word-scroll-active-index', activeIndex.toFixed(4));

    const items = root.querySelectorAll<HTMLElement>('.word-scroll-stage__item');
    items.forEach((item, index) => {
      const distance = Math.abs(index - activeIndex);
      const focus = clampWordScroll(1 - distance * 1.08, 0, 1);

      item.style.setProperty('--word-distance', distance.toFixed(4));
      item.style.setProperty('--word-focus', focus.toFixed(4));
    });

    if (mobileWordScroll.matches && items.length) {
      // Lens width follows the phrase in it.
      const base = clampWordScroll(Math.floor(activeIndex), 0, items.length - 1);
      const next = Math.min(base + 1, items.length - 1);
      const f = activeIndex - base;
      const widthOf = (item: HTMLElement) =>
        (item.querySelector<HTMLElement>('.word-scroll-stage__word')?.offsetWidth ?? 0) +
        parseFloat(getComputedStyle(item).fontSize) * 0.6;
      const width = widthOf(items[base]) * (1 - f) + widthOf(items[next]) * f;
      root.style.setProperty('--word-lens-width', `${width.toFixed(1)}px`);
    }
  };

  const mobileTargets = new Map<HTMLElement, number>();
  const mobileCurrent = new Map<HTMLElement, number>();
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let mobileGlideFrame = 0;

  const glideMobileWordScroll = () => {
    mobileGlideFrame = 0;
    let moving = false;

    mobileTargets.forEach((target, root) => {
      const current = mobileCurrent.get(root) ?? target;
      const next = reducedMotion.matches ? target : current + (target - current) * 0.22;
      const settled = Math.abs(target - next) < 0.001;
      const value = settled ? target : next;

      mobileCurrent.set(root, value);
      paintWordScroll(root, value);
      if (!settled) moving = true;
    });

    if (moving) mobileGlideFrame = window.requestAnimationFrame(glideMobileWordScroll);
  };

  let wordScrollFrame = 0;
  const queueWordScrollUpdate = () => {
    if (wordScrollFrame) return;

    wordScrollFrame = window.requestAnimationFrame(() => {
      wordScrollFrame = 0;
      updateWordScrollStages();
    });
  };

  updateWordScrollStages();
  window.addEventListener('scroll', queueWordScrollUpdate, { passive: true });
  window.addEventListener('resize', queueWordScrollUpdate);
  window.addEventListener('load', updateWordScrollStages, { once: true });
  document.addEventListener('astro:page-load', updateWordScrollStages);

  if ('fonts' in document) {
    document.fonts.ready.then(updateWordScrollStages);
  }
</script>
