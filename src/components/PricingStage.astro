---
/**
 * PricingStage — 4-tier plan cards with monthly/yearly toggle.
 *
 * Visual language matches the hero pill buttons:
 *   - rounded-pill toggle with cyan glow
 *   - glass-blur ghost cards (translucent + backdrop-filter + cyan stroke)
 *   - one "popular" card filled with the brand cyan
 *   - cyan accents on prices, features bullets, CTAs
 *
 * Monthly/yearly switch is CSS-driven: both prices are rendered, the
 * inactive one is hidden via `[data-period]` on the section root.
 * Toggle button just flips the data-attribute (one rAF, no reflow
 * cascade beyond the cards).
 *
 * Per-day price is featured big — clubs evaluate "X Kč denně" easier
 * than annual numbers. Per-month equivalent shown below for context.
 *
 * Pricing source: project_pilot_pricing memory + planning docs
 * 02_pricing_strategy + 15_billing_and_licensed_scopes (provided
 * by user 2026-04-30).
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Plan {
  id: string;
  name: string;
  badge: string | null;
  popular: boolean;
  free: boolean;
  /** Czech-format monthly price — already grouped with non-breaking spaces. */
  priceMonthly: number;
  priceYearly: number;
  perDayMonthly: number; // monthly price ÷ 30
  perDayYearly: number; // yearly price ÷ 365
  perMonthFromYearly: number; // yearly price ÷ 12 (the effective monthly when paying yearly)
  limits: { players: number; staff: number };
  features: string[];
  ctaLabel: string;
  ctaHref: string;
}

const ctaLabelPilot = t('pricing.ctaPilot');
const ctaLabelFree = t('pricing.ctaFree');

const featuresFreeCs = [
  'Pětiosý ranní check-in',
  'Plánování sessions',
  'Docházka + post-session RPE',
  'Základní coach board (today)',
  '1 tým × 1 sezóna',
];
const featuresFreeEn = [
  '5-axis morning check-in',
  'Session planning',
  'Attendance + post-session RPE',
  'Basic coach board (today)',
  '1 team × 1 season',
];

const featuresCoreCs = [
  'Vše z Free Starter',
  'Plný coach board s historií',
  'Agregovaná readiness týmu',
  'Privacy-by-design (doc 174)',
  'E-mail podpora',
];
const featuresCoreEn = [
  'Everything in Free Starter',
  'Full coach board with history',
  'Aggregate team readiness',
  'Privacy-by-design (doc 174)',
  'Email support',
];

const featuresLiveCs = [
  'Vše z Team Core',
  'Coach Board Live',
  'Realtime sledování zátěže',
  'Decision room během zápasu',
  'Match-day live mode',
  'Prioritní podpora',
];
const featuresLiveEn = [
  'Everything in Team Core',
  'Coach Board Live',
  'Realtime load tracking',
  'In-match decision room',
  'Match-day live mode',
  'Priority support',
];

const featuresIntelCs = [
  'Vše z Team Live',
  'Pokročilá analytika a periodizace',
  'PDF / CSV exporty',
  'Vlastní reporty',
  'Onboarding s konzultantem',
  'Dedikovaný account manager',
];
const featuresIntelEn = [
  'Everything in Team Live',
  'Advanced analytics + periodisation',
  'PDF / CSV exports',
  'Custom reports',
  'Onboarding with a consultant',
  'Dedicated account manager',
];

const mailto = (subject: string) =>
  `mailto:hello@melveo.app?subject=${encodeURIComponent(subject)}`;

const plans: Plan[] = [
  {
    id: 'free',
    name: 'Free Starter',
    badge: null,
    popular: false,
    free: true,
    priceMonthly: 0,
    priceYearly: 0,
    perDayMonthly: 0,
    perDayYearly: 0,
    perMonthFromYearly: 0,
    limits: { players: 8, staff: 2 },
    features: lang === 'cs' ? featuresFreeCs : featuresFreeEn,
    ctaLabel: ctaLabelFree,
    ctaHref: '#brzy',
  },
  {
    id: 'core',
    name: 'Team Core',
    badge: null,
    popular: false,
    free: false,
    priceMonthly: 1790,
    priceYearly: 17900,
    perDayMonthly: 60,
    perDayYearly: 49,
    perMonthFromYearly: 1492,
    limits: { players: 24, staff: 3 },
    features: lang === 'cs' ? featuresCoreCs : featuresCoreEn,
    ctaLabel: ctaLabelPilot,
    ctaHref: mailto(lang === 'cs' ? 'Zájem o Team Core' : 'Team Core enquiry'),
  },
  {
    id: 'live',
    name: 'Team Live',
    badge: null,
    popular: false,
    free: false,
    priceMonthly: 2990,
    priceYearly: 29900,
    perDayMonthly: 100,
    perDayYearly: 82,
    perMonthFromYearly: 2492,
    limits: { players: 24, staff: 6 },
    features: lang === 'cs' ? featuresLiveCs : featuresLiveEn,
    ctaLabel: ctaLabelPilot,
    ctaHref: mailto(lang === 'cs' ? 'Zájem o Team Live' : 'Team Live enquiry'),
  },
  {
    id: 'intelligence',
    name: 'Team Intelligence',
    badge: null,
    popular: false,
    free: false,
    priceMonthly: 4990,
    priceYearly: 49900,
    perDayMonthly: 166,
    perDayYearly: 137,
    perMonthFromYearly: 4158,
    limits: { players: 24, staff: 8 },
    features: lang === 'cs' ? featuresIntelCs : featuresIntelEn,
    ctaLabel: ctaLabelPilot,
    ctaHref: mailto(
      lang === 'cs' ? 'Zájem o Team Intelligence' : 'Team Intelligence enquiry',
    ),
  },
];

/** Format an integer with non-breaking thin spaces between thousands. */
function fmt(n: number): string {
  return n.toLocaleString('cs-CZ').replace(/ /g, ' ');
}

const limitsLabel = lang === 'cs' ? 'hráčů' : 'players';
const staffLabel = lang === 'cs' ? 'staff' : 'staff';
const currencyShort = lang === 'cs' ? 'Kč' : 'CZK';
---

<section
  class="pricing-stage"
  data-pricing-section
  data-period="yearly"
  aria-label={t('pricing.eyebrow')}
>
  <div class="pricing-inner">
    <header class="pricing-header">
      <p class="pricing-eyebrow">{t('pricing.eyebrow')}</p>
      <h2 class="pricing-headline">
        {t('pricing.headline')}<br />
        <span class="pricing-headline-accent">{t('pricing.headlineAccent')}</span>
      </h2>
      <p class="pricing-subline">{t('pricing.subline')}</p>

      {/*
        Twin-pill toggle — each button is its own glass pill that flips
        between the hero ghost-pill style (inactive) and the hero
        filled-cyan style (active). No sliding thumb to mis-align with
        unequal button widths (the −17 % badge made "Ročně" wider than
        "Měsíčně", and a 50 %-width thumb clipped the wider label).
      */}
      <div class="pricing-toggle" role="tablist" aria-label="Billing period">
        <button
          type="button"
          role="tab"
          data-period-set="monthly"
          aria-selected="false"
          class="pricing-toggle-btn"
        >
          {t('pricing.toggleMonthly')}
        </button>
        <button
          type="button"
          role="tab"
          data-period-set="yearly"
          aria-selected="true"
          class="pricing-toggle-btn pricing-toggle-btn--active"
        >
          <span class="pricing-toggle-label">{t('pricing.toggleYearly')}</span>
          <span class="pricing-toggle-savings">{t('pricing.toggleSavings')}</span>
        </button>
      </div>
    </header>

    {/*
      SVG displacement filter — referenced by .glass-filter on each
      pricing card. Sourced from the wprod codepen raVpwJL (glass
      morphism recipe) per user request 2026-05-01: "tak se na to
      podívej a zkus to napodobit jen prostě u nas v těch tmavých
      barvách". The filter feeds the filter input through a Gaussian
      blur of the alpha channel and then displaces source pixels by
      that blur — producing the "real glass" refraction halo at the
      edges of the card. Hidden so it never paints itself.
    */}
    <svg
      class="pricing-lens-defs"
      xmlns="http://www.w3.org/2000/svg"
      style="position:absolute;width:0;height:0;pointer-events:none;"
      aria-hidden="true"
    >
      <filter
        id="pricing-lens"
        x="0%"
        y="0%"
        width="100%"
        height="100%"
        filterUnits="objectBoundingBox"
      >
        <feComponentTransfer in="SourceAlpha" result="alpha">
          <feFuncA type="identity" />
        </feComponentTransfer>
        <feGaussianBlur in="alpha" stdDeviation="50" result="blur" />
        <feDisplacementMap
          in="SourceGraphic"
          in2="blur"
          scale="40"
          xChannelSelector="A"
          yChannelSelector="A"
        />
      </filter>
    </svg>

    <ul class="pricing-cards">
      {
        plans.map((plan) => (
          <li
            class:list={[
              'pricing-card',
              plan.free && 'pricing-card--free',
            ]}
            data-plan-id={plan.id}
          >
            {/*
              4-layer liquid-glass stack (wprod codepen recipe, dark-theme
              adapted):
                glass-filter   — backdrop-blur + url(#pricing-lens)
                                 displacement, refracts what's behind
                glass-overlay  — a translucent tint on top of the filter
                glass-specular — inset highlights for the rim "shine"
                glass-content  — the actual card body (header, price, CTA…)
              All four layers absolute-positioned and stacked via z-index;
              .glass-content is the only one that takes flow space.
            */}
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">

            <header class="pricing-card-header">
              <h3 class="pricing-card-name">{plan.name}</h3>
              <p class="pricing-card-limits">
                <strong>{plan.limits.players}</strong> {limitsLabel}{' '}
                <span class="pricing-dot">·</span>{' '}
                <strong>{plan.limits.staff}</strong> {staffLabel}
              </p>
            </header>

            <div class="pricing-card-price">
              {plan.free ? (
                <div class="pricing-price-block pricing-price-block--free">
                  <span class="pricing-price-day">0&nbsp;{currencyShort}</span>
                  <span class="pricing-price-suffix">{t('pricing.perDay')}</span>
                </div>
              ) : (
                <Fragment>
                  {/* MONTHLY view — visible when [data-period="monthly"] */}
                  <div class="pricing-price-block pricing-price-block--monthly">
                    <span class="pricing-price-day">
                      {fmt(plan.perDayMonthly)}&nbsp;{currencyShort}
                    </span>
                    <span class="pricing-price-suffix">{t('pricing.perDay')}</span>
                    <span class="pricing-price-secondary">
                      {fmt(plan.priceMonthly)}&nbsp;{currencyShort}{' '}
                      {t('pricing.perMonth')} · {t('pricing.billedMonthly')}
                    </span>
                  </div>

                  {/* YEARLY view — visible when [data-period="yearly"] (default) */}
                  <div class="pricing-price-block pricing-price-block--yearly">
                    <span class="pricing-price-day">
                      {fmt(plan.perDayYearly)}&nbsp;{currencyShort}
                    </span>
                    <span class="pricing-price-suffix">{t('pricing.perDay')}</span>
                    <span class="pricing-price-secondary">
                      {fmt(plan.perMonthFromYearly)}&nbsp;{currencyShort}{' '}
                      {t('pricing.perMonth')} · {t('pricing.billedYearly')}
                    </span>
                  </div>
                </Fragment>
              )}
            </div>

            {/* Pricing plan CTA — literally the hero-pill from the
                landing hero (App Store / Pilot buttons). Same class,
                same internal structure (shimmer + content layers).
                The pointer-tracking handler in Landing.astro's
                mountHeroButtons() picks these up for free because it
                queries .hero-pill across the whole document. */}
            <a class="hero-pill pricing-card-cta" href={plan.ctaHref}>
              <span class="hero-pill-shimmer" aria-hidden="true"></span>
              <span class="hero-pill-content">{plan.ctaLabel}</span>
            </a>

            <p class="pricing-card-included">{t('pricing.included')}</p>
            <ul class="pricing-card-features">
              {plan.features.map((feat) => (
                <li>
                  <svg
                    class="pricing-tick"
                    viewBox="0 0 16 16"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3.5 8.5l3 3 6-7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
            </div>{/* /.glass-content */}
          </li>
        ))
      }
    </ul>

    <div class="pricing-extras">
      <article class="pricing-extra">
        <h4>{t('pricing.athleteHeading')}</h4>
        <p>{t('pricing.athleteBody')}</p>
      </article>
      <article class="pricing-extra">
        <h4>{t('pricing.clubHeading')}</h4>
        <p>{t('pricing.clubBody')}</p>
      </article>
    </div>

    <p class="pricing-disclaimer">{t('pricing.disclaimer')}</p>
  </div>
</section>

<script>
  import { mountPricingToggle } from '../scripts/pricing-toggle';
  mountPricingToggle();
</script>

<style>
  .pricing-stage {
    position: relative;
    width: 100%;
    border-top: 1px solid var(--color-stroke-base);
    background: var(--color-bg-canvas);
    padding: clamp(4rem, 9vw, 8rem) clamp(1rem, 4vw, 3rem);
    overflow: hidden;
  }
  .pricing-stage::before {
    /* Subtle radial cyan glow behind the cards — same family as the
       hero halo, tuned dim. Doesn't compete with the headline. */
    content: '';
    position: absolute;
    inset: -10% 20% auto 20%;
    height: 60%;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 240, 255, 0.12),
      transparent 70%
    );
    pointer-events: none;
    filter: blur(40px);
  }

  .pricing-inner {
    position: relative;
    margin: 0 auto;
    max-width: 84rem;
  }

  /* ─── Header ─────────────────────────────────────────────────── */

  .pricing-header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .pricing-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
  }

  .pricing-headline {
    margin: 0;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    font-size: clamp(2.25rem, 5.5vw, 4.75rem);
    text-wrap: balance;
  }
  .pricing-headline-accent {
    color: var(--color-accent-primary);
  }

  .pricing-subline {
    margin: 1.25rem auto 0;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  @media (min-width: 640px) {
    .pricing-subline {
      font-size: 1.125rem;
    }
  }

  /* ─── Twin-pill toggle ─────────────────────────────────────────
     Each button is its own glass pill. Active state inherits the
     hero-pill--filled cyan look; inactive inherits hero-pill--ghost.
     No sliding thumb so unequal button widths (the −17 % badge makes
     "Ročně" wider than "Měsíčně") can't clip the active label. */

  .pricing-toggle {
    display: inline-flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 5px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.025);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 8px 28px -14px rgba(0, 0, 0, 0.5);
  }

  .pricing-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.1rem;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }
  .pricing-toggle-btn:hover {
    color: var(--color-text-primary);
    background: rgba(0, 240, 255, 0.06);
  }

  /* Active = filled cyan (matches .hero-pill--filled) */
  .pricing-toggle-btn--active,
  .pricing-toggle-btn[aria-selected='true'] {
    background: var(--color-accent-primary);
    color: var(--color-accent-primary-cta-fg);
    border-color: rgba(0, 240, 255, 0.6);
    box-shadow:
      0 8px 26px -10px rgba(0, 240, 255, 0.5),
      0 0 0 1px rgba(0, 240, 255, 0.35);
  }
  .pricing-toggle-btn--active:hover,
  .pricing-toggle-btn[aria-selected='true']:hover {
    background: var(--color-accent-primary-hover);
    color: var(--color-accent-primary-cta-fg);
  }

  .pricing-toggle-label {
    font-size: inherit;
  }

  .pricing-toggle-savings {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(0, 240, 255, 0.18);
    color: var(--color-accent-primary);
  }
  /* On the active (filled) variant the badge needs darker fill so
     it's still readable on the cyan button. */
  .pricing-toggle-btn--active .pricing-toggle-savings,
  .pricing-toggle-btn[aria-selected='true'] .pricing-toggle-savings {
    background: rgba(0, 16, 20, 0.18);
    color: var(--color-accent-primary-cta-fg);
  }

  /* ─── Cards grid ─────────────────────────────────────────────── */

  .pricing-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .pricing-cards {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 1100px) {
    .pricing-cards {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      align-items: stretch;
    }
  }

  /*
    ─── Liquid-glass card (4-layer recipe, dark-theme adapted) ─────
    Adapted from wprod codepen raVpwJL (the wallet-screenshot widget
    where the "search" / "home" pills look like real refracting glass).
    We use the same 4-layer stack:
      .glass-filter   — backdrop blur + url(#pricing-lens) displacement
                        (the SVG filter blurs alpha then uses it to
                        warp source pixels — gives the "real glass"
                        edge halo without a heavy WebGL backend).
      .glass-overlay  — translucent tint on top of the filter
      .glass-specular — inset rim highlights ("shine")
      .glass-content  — actual card body, sits on top via z-index
    The .pricing-card host is just a transparent rounded box that
    holds the four layers + sets the shadow envelope. */
  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1.75rem;
    background: transparent;
    color: var(--color-text-primary);
    overflow: hidden;
    /* Dual shadow per codepen — close drop shadow + soft far halo. */
    box-shadow:
      0 6px 6px rgba(0, 0, 0, 0.28),
      0 0 24px rgba(0, 0, 0, 0.18);
    transition:
      transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 2.2),
      box-shadow 0.4s ease;
    isolation: isolate;
  }

  /* Layers all share the same rounded inset — they tile the card. */
  .pricing-card .glass-filter,
  .pricing-card .glass-overlay,
  .pricing-card .glass-specular {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .pricing-card .glass-filter {
    z-index: 0;
    backdrop-filter: blur(8px) saturate(160%);
    -webkit-backdrop-filter: blur(8px) saturate(160%);
    /* Apple-style "lens" — referenced from <svg id="pricing-lens">.
       feDisplacementMap warps source pixels by alpha-blurred amount
       so card edges get the glass-edge halo. Kept paired with a
       small brightness boost so the subtle Melveo cyan glow behind
       the cards reads through the glass. */
    filter: url(#pricing-lens) brightness(1.06);
  }

  .pricing-card .glass-overlay {
    z-index: 1;
    /* On dark canvas the codepen's white 0.25 tint is too aggressive
       (cards look chalky). Drop to a faint white-with-cyan tint that
       barely exists but still reads as "frosted". */
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.05) 0%,
      rgba(255, 255, 255, 0.018) 60%,
      rgba(0, 240, 255, 0.012) 100%
    );
  }

  .pricing-card .glass-specular {
    z-index: 2;
    /* Top-left rim catches imaginary light → 1px white inset.
       Soft 6 px inner glow rounds the rim so it doesn't look like a
       hard outline. Both lighter than the codepen's 0.75 highlight
       because we're on a dark canvas — full 0.75 white reads as a
       harsh outline, not a glass shine. */
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 0 6px rgba(255, 255, 255, 0.1),
      inset -1px -1px 0 rgba(255, 255, 255, 0.04);
  }

  .pricing-card .glass-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.75rem 1.5rem 1.5rem;
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 10px 12px rgba(0, 0, 0, 0.32),
      0 24px 60px -16px rgba(0, 240, 255, 0.22),
      0 0 32px rgba(0, 0, 0, 0.18);
  }
  .pricing-card:hover .glass-specular {
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.32),
      inset 0 0 6px rgba(0, 240, 255, 0.22),
      inset -1px -1px 0 rgba(255, 255, 255, 0.06);
  }

  .pricing-card-header {
    margin-bottom: 1.5rem;
  }
  .pricing-card-name {
    margin: 0 0 0.4rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .pricing-card-limits {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  .pricing-card-limits strong {
    color: var(--color-text-primary);
  }
  .pricing-dot {
    color: var(--color-text-tertiary);
  }

  .pricing-card-price {
    margin-bottom: 1.5rem;
  }

  .pricing-price-block {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }
  .pricing-price-block--free {
    /* Always shown for the free plan regardless of toggle. */
  }
  .pricing-price-block--monthly,
  .pricing-price-block--yearly {
    display: none;
  }
  [data-pricing-section][data-period='monthly']
    .pricing-price-block--monthly {
    display: flex;
  }
  [data-pricing-section][data-period='yearly']
    .pricing-price-block--yearly {
