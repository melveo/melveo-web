---
/**
 * HeroScene — premium minimal background.
 *
 * 2026-05-16 redesign: dropped the WebGL metaballs canvas. User
 * direction was Linear-style minimal — typography as hero, no
 * competing visual layer. Now just three soft layered radial
 * gradients (cyan top-left, cyan bottom-right, ambient haze) plus
 * a subtle dot grid for premium texture. All static CSS, no JS,
 * no canvas, no rAF, no GPU shader compile.
 */
---

<div class="hero-scene-wrap" aria-hidden="true">
  <div class="hero-aurora" />
  <div class="hero-dot-grid" />
</div>

<style>
  .hero-scene-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    background: var(--color-bg-canvas);
  }

  /*
    Two soft cyan radial blooms — top-left + bottom-right — plus
    an ambient teal haze in the middle. Reads as quiet atmosphere
    without competing with the foreground copy.
  */
  .hero-aurora {
    position: absolute;
    inset: -10% -5%;
    background:
      radial-gradient(
        ellipse 60% 50% at 22% 28%,
        color-mix(in oklch, var(--color-accent-primary) 18%, transparent),
        transparent 65%
      ),
      radial-gradient(
        ellipse 55% 45% at 78% 78%,
        color-mix(in oklch, var(--color-accent-primary) 14%, transparent),
        transparent 60%
      ),
      radial-gradient(
        ellipse 80% 60% at 50% 60%,
        color-mix(in oklch, var(--color-accent-primary) 8%, transparent),
        transparent 70%
      );
    filter: blur(40px);
    opacity: 0.85;
  }

  /*
    Subtle dot grid — premium tech texture. 24px grid, 1px dots
    at 8 % white. Visible only where the aurora is dim, gives the
    surface depth without screaming.
  */
  .hero-dot-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.08) 1px,
      transparent 1.5px
    );
    background-size: 28px 28px;
    background-position: 0 0;
    mask-image: radial-gradient(
      ellipse 70% 70% at 50% 50%,
      black,
      transparent 85%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 70% 70% at 50% 50%,
      black,
      transparent 85%
    );
    opacity: 0.55;
  }

  @media (max-width: 520px) {
    .hero-aurora {
      opacity: 0.6;
      filter: blur(60px);
    }
    .hero-dot-grid {
      background-size: 22px 22px;
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-aurora,
    .hero-dot-grid {
      opacity: 0.45;
    }
  }
</style>
