---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";

/**
 * Stripe checkout success landing.
 *
 * Flow:
 *   1. iOS app's BillingRestrictedRootView shows "Vyžádat upgrade" CTA
 *      (per Apple §3.1.3(f) no Buy/Subscribe).
 *   2. Server sends an email with a checkout URL (Resend, see doc 174 G2).
 *   3. Owner / admin opens the link in a browser → Stripe Checkout.
 *   4. After payment Stripe redirects here.
 *   5. We render a static "thanks + open app" page.
 *   6. Universal Link `https://melveo.app/checkout/success?...` is
 *      registered in the AASA file → iOS opens the Melveo app directly.
 *      Android / desktop browsers see this page.
 *
 * Stripe webhook (separate path) is the authoritative event — this
 * page is purely for UX confirmation. Don't gate state on URL params.
 */

const sessionId = Astro.url.searchParams.get("session_id") ?? null;
---

<BaseLayout
  title="Děkujeme"
  description="Platba za pilot byla přijata. Nyní můžete otevřít aplikaci a spustit první trénink."
  canonical="/checkout/success/"
>
  <PageHeader />
  <section class="mx-auto max-w-2xl px-6 py-24 text-center">
    <div
      class="mx-auto mb-8 inline-flex h-20 w-20 items-center justify-center rounded-full bg-[var(--color-feedback-success)]/15 text-[var(--color-feedback-success)]"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-10 w-10"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">
      Děkujeme!
    </h1>
    <p class="mt-6 text-pretty text-lg text-[var(--color-text-secondary)]">
      Pilot je aktivní. Otevřete aplikaci Melveo na svém iPhonu nebo iPadu —
      přístup uvidíte ihned po obnovení.
    </p>

    {
      sessionId && (
        <p class="mt-4 text-xs text-[var(--color-text-tertiary)]">
          Reference: <code class="rounded bg-[var(--color-bg-surface)] px-2 py-1">{sessionId}</code>
        </p>
      )
    }

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <!-- Universal Link — iOS opens app directly, others land on this page. -->
      <a
        href="melveo://billing/refresh"
        class="inline-flex items-center justify-center rounded-xl bg-[var(--color-accent-primary)] px-6 py-3 text-base font-semibold text-[var(--color-accent-primary-cta-fg)] transition hover:bg-[var(--color-accent-primary-hover)]"
      >
        Otevřít Melveo
      </a>
      <a
        href="/"
        class="text-base font-medium text-[var(--color-text-primary)] hover:text-[var(--color-accent-primary)]"
      >
        Zpět na hlavní stránku
      </a>
    </div>

    <div
      class="mt-16 rounded-2xl border border-[var(--color-stroke-base)] bg-[var(--color-bg-surface)] p-8 text-left"
    >
      <h2 class="text-lg font-semibold">Co teď?</h2>
      <ol class="mt-4 space-y-3 text-[var(--color-text-secondary)]">
        <li class="flex gap-3">
          <span
            class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-[var(--color-accent-primary-subtle)] text-sm font-bold text-[var(--color-accent-primary-cta-fg)]"
            >1</span
          >
          <span>
            Otevřete aplikaci Melveo. Přístupový gate by měl zmizet do několika
            sekund (webhook synchronizuje předplatné).
          </span>
        </li>
        <li class="flex gap-3">
          <span
            class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-[var(--color-accent-primary-subtle)] text-sm font-bold text-[var(--color-accent-primary-cta-fg)]"
            >2</span
          >
          <span>Pozvěte hráče přes pozvánkový kód nebo QR — ze sekce „Členové".</span>
        </li>
        <li class="flex gap-3">
          <span
            class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-[var(--color-accent-primary-subtle)] text-sm font-bold text-[var(--color-accent-primary-cta-fg)]"
            >3</span
          >
          <span>Naplánujte první trénink a podívejte se na ranní readiness.</span>
        </li>
      </ol>
    </div>

    <p class="mt-12 text-sm text-[var(--color-text-secondary)]">
      Něco se nezobrazilo správně?
      <a
        href="mailto:hello@melveo.app"
        class="text-[var(--color-accent-primary)] hover:underline">hello@melveo.app</a
      >
    </p>
  </section>
</BaseLayout>
