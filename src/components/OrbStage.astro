---
/**
 * OrbStage — Giomgio codepen abxGyQX, 1:1 port.
 *
 * Two stacked hero blocks. Primary on dark canvas with primary
 * heading; secondary absolutely overlaid with a brand-cyan gradient
 * background and a different heading. A radial-gradient mask reveals
 * the secondary block only inside a circle that follows the cursor.
 *
 * No text rotation — per user 2026-04-30. The "change" comes from
 * the cursor sweeping across the static secondary text.
 *
 * Smooth interpolation handled natively via @property + CSS transition
 * (codepen used GSAP for the lerp). See `src/scripts/orb-cursor.ts`
 * for the pointermove → --x / --y wiring.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/*
  A11y structure (audit 2026-06-10): role="button" is not an allowed
  role on <section> (Lighthouse aria-allowed-role), so the landmark
  stays a plain section and the interactive role lives on an inner
  div, where it is valid. aria-labelledby lists the VISIBLE heading
  first so the accessible name starts with the on-screen label
  (fixes label-content-name-mismatch). Arrow keys move the reveal
  circle for keyboard users (handled in orb-cursor.ts).
*/}
<section class="orb-stage" aria-labelledby="orb-primary-heading">
  {/*
    aria-labelledby includes the secondary (visually masked) heading
    too — axe's label-content-name-mismatch requires every piece of
    visible text inside a role=button to appear in its accessible
    name, and the cyan reveal text is visible through the mask.
    Referencing an aria-hidden element from labelledby is valid; its
    text still joins the name computation.
    The interaction hint moved name → description (audit 2026-06-11):
    the visible hint pill has TWO wording variants (pointer/touch via
    `is-orb-touch`) while the name could only ever carry one of them,
    which read as a name/content mismatch. As a description it informs
    AT without constraining the name.
  */}
  <div
    class="orb-wrapper"
    data-orb-wrapper
    role="button"
    tabindex="0"
    aria-labelledby="orb-primary-heading orb-secondary-text"
    aria-describedby="orb-interaction-hint"
  >
    <p id="orb-interaction-hint" class="orb-sr-only">{t('orb.hintDesktop' as any)}</p>
    <!-- Primary hero — dark canvas, white primary text -->
    <div class="orb-hero">
      <h2 id="orb-primary-heading" class="orb-heading">{t('orb.primary')}</h2>
    </div>

    <!-- Secondary hero — absolute overlay, cyan gradient bg, dark text,
         revealed only through radial mask centred at cursor. -->
    <div class="orb-hero orb-hero--secondary" aria-hidden="true" data-orb-secondary>
      <p id="orb-secondary-text" class="orb-heading">{t('orb.secondary')}</p>
    </div>

    {/*
      Discoverability hint (2026-06-10) — almost nobody realised the
      section is interactive. A quiet pulsing pill names the gesture;
      orb-cursor.ts adds `is-orb-discovered` on the wrapper after the
      first manual interaction and the hint retires for good. The
      pointer/touch label variant is driven by the existing
      `is-orb-touch` class. aria-hidden: the same text already exists
      for AT in #orb-interaction-hint.
    */}
    <div class="orb-hint-pill" data-orb-hint aria-hidden="true">
      <span class="orb-hint-pill__ring"></span>
      <span class="orb-hint-pill__label orb-hint-pill__label--pointer">{t('orb.hintDesktop' as any)}</span>
      <span class="orb-hint-pill__label orb-hint-pill__label--touch">{t('orb.hintMobile' as any)}</span>
    </div>

  </div>
</section>

<script>
  import { mountOrbCursor } from '../scripts/orb-cursor';
  mountOrbCursor();
</script>

<style>
  /*
    Register --x / --y as proper percentage typed CSS properties so
    the browser can transition them smoothly. Without @property the
    custom-property values are opaque strings and the circle would
    snap rather than follow the cursor.
  */
  @property --x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 70%;
  }
  @property --y {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 50%;
  }

  .orb-wrapper {
    position: relative;
    width: 100%;
    --x: 70%;
    --y: 50%;
    contain: layout paint style;
    overflow-anchor: none;
    touch-action: pan-y;
    /* border-top removed 2026-05-17: no horizontal dividers between sections */
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
  }

  .orb-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .orb-hero {
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 5rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orb-hero--secondary {
    /* Position-locked overlay over the primary block. */
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    /*
      Glass-hexagon body — solid brand-cyan fill that follows the
      cursor on desktop and ambient auto-orbit on touch devices
      (same --x / --y as the clip-path).
      Updated 2026-05: replaced the circular orb with a hexagon clip
      so the reveal shape matches the hexagonal brand identity used
      throughout the rest of the site (input + Coach hexes).
    */
    --x: 70%;
    --y: 50%;
    background: var(--color-accent-primary);

    /*
      Dark text inside the hexagon — same canvas variable as before
      so it tracks any brand-bg change.
    */
    color: var(--color-bg-canvas);

    /*
      Hexagon-shaped reveal. Flat-top hexagon centred at (--x, --y)
      with "radius" 25vmin (matches the previous circular reveal so
      the heading still fits inside). Vertex math:
        right        = (x + R, y)
        bottom-right = (x + R/2, y + R*√3/2)
        bottom-left  = (x - R/2, y + R*√3/2)
        left         = (x - R, y)
        top-left     = (x - R/2, y - R*√3/2)
        top-right    = (x + R/2, y - R*√3/2)
      With R = 25vmin, √3/2 ≈ 0.866, so half-height = 21.65vmin.
      The clip-path transitions smoothly because --x and --y are
      typed @property percentages.
    */
    clip-path: polygon(
      calc(var(--x) + 25vmin) var(--y),
      calc(var(--x) + 12.5vmin) calc(var(--y) + 21.65vmin),
      calc(var(--x) - 12.5vmin) calc(var(--y) + 21.65vmin),
      calc(var(--x) - 25vmin) var(--y),
      calc(var(--x) - 12.5vmin) calc(var(--y) - 21.65vmin),
      calc(var(--x) + 12.5vmin) calc(var(--y) - 21.65vmin)
    );

    /* Overlay shouldn't capture cursor events; pointermove lives on
       window. */
    pointer-events: none;

    /*
      Smoothness budget — same logic as the previous circular orb,
      just transitioning the typed --x/--y now drives a clip-path
      polygon instead of a radial mask:
        - --x / --y are typed @property values so the browser can
          actually transition them (untyped custom props would snap)
        - cubic-bezier matches GSAP's sine.out feel from codepen
        - 0.4s reads as smoother than 0.3s when the underlying
          movement is sample-throttled to one rAF per frame
        - will-change is only enabled while the section is near the
          viewport via .is-orb-visible. Keeping a compositor surface
          alive for the whole page made scroll-heavy sections compete
          with the rest of the document after the user had moved on.
        - translate3d is the canonical "force GPU layer" hack for
          older WebKit (otherwise repaints can jank)
        - backface-visibility hidden helps Safari coalesce layers
    */
    transition:
      --x 0.48s cubic-bezier(0.39, 0.575, 0.565, 1),
      --y 0.48s cubic-bezier(0.39, 0.575, 0.565, 1);
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }

  .orb-wrapper.is-orb-hit {
    cursor: grab;
  }

  .orb-wrapper.is-orb-visible .orb-hero--secondary {
    will-change: clip-path;
  }

  /*
    Manual-mode interpolation — when the user has taken control
    (post click / tap) we tighten the transition so the orb tracks
    the pointer closely instead of trailing behind. In auto-orbit
    the 0.48s transition feels organic; when a finger is on it the
    same easing feels laggy.

    Class is added by mountOrbCursor() in src/scripts/orb-cursor.ts
    on the wrapper for the duration of manual mode.
  */
  .orb-wrapper.is-orb-manual {
    cursor: grab;
    touch-action: none;
  }
  .orb-wrapper.is-orb-manual:active {
    cursor: grabbing;
  }
  .orb-wrapper.is-orb-manual .orb-hero--secondary {
    transition:
      --x 0.12s ease-out,
      --y 0.12s ease-out;
  }

  .orb-heading {
    margin: 0;
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 8rem);
    line-height: 1;
    /* Limit horizontal width so the headline stays on one line
       inside the cursor circle (codepen uses max-width: fit-content
       + auto margins). */
    max-width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Discoverability hint pill ─────────────────────────────────── */
  .orb-hint-pill {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 5vh, 3rem);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    border: 1px solid rgba(0, 240, 255, 0.28);
    /* near-opaque: the translucent version blended with the cyan orb
       behind it into a teal that failed WCAG contrast (axe computes the
       effective backdrop). 0.92 keeps the glass look but pins contrast. */
    background: rgba(7, 10, 13, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    /* light tone — secondary grey failed WCAG contrast on the translucent
       dark pill (Lighthouse color-contrast, 2026-06-10) */
    color: #dbe7ee;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    pointer-events: none;
    z-index: 3;
    opacity: 0.92;
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .orb-hint-pill__ring {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent-primary);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    animation: orb-hint-pulse 1.9s ease-in-out infinite;
  }
  @keyframes orb-hint-pulse {
    0%, 100% { transform: scale(1); opacity: 0.7; }
    50% { transform: scale(1.45); opacity: 1; }
  }
  /* pointer vs touch label — driven by is-orb-touch from orb-cursor */
  .orb-hint-pill__label--touch { display: none; }
  .orb-wrapper.is-orb-touch .orb-hint-pill__label--pointer { display: none; }
  .orb-wrapper.is-orb-touch .orb-hint-pill__label--touch { display: inline; }
  /* retire forever once the user has interacted */
  .orb-wrapper.is-orb-discovered .orb-hint-pill {
    opacity: 0;
    transform: translateX(-50%) translateY(8px);
  }
  /* the cookie banner is fixed bottom-center too — while it's open,
     yield (first-visit overlap, audit 2026-06-10) */
  :global(body:has(#cookie-banner:not([data-banner-state='hidden']))) .orb-hint-pill {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .orb-hint-pill__ring { animation: none; }
    .orb-hint-pill { transition: none; }
  }

</style>
