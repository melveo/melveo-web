---
/**
 * ImageGridScrollMorph — Kevin Gutowski codepen QwNZYzL.
 *
 * Direct re-implementation of the codepen source after the V4-D draft
 * missed the architecture. The trick is:
 *
 *   1. A tall section with sticky inner content (.content)
 *      pinned at top:0 — gives a long scroll runway while the
 *      grid stays visible.
 *   2. The grid is 5 columns × 3 rows (3 cols on mobile). Cells are
 *      placed via CSS subgrid on three "layer" wrappers + one absolute
 *      ".scaler" element at the centre cell.
 *   3. The scaler image animates `width` and `height` in PIXELS from
 *      viewport size DOWN to its natural grid-cell size as the user
 *      scrolls — different easings per axis (power2 width, power1
 *      height) for the codepen's signature asymmetric feel.
 *   4. Each layer has TWO scroll-linked animations:
 *        - opacity: holds at 0 until 55 % scroll, then 0 → 1
 *        - scale:   holds at 0 until 30 % scroll, then 0 → 1
 *      using progressively more aggressive easings per layer
 *      (power1, power3, power4) — outer edges feel slower, inner
 *      cells punch in.
 *   5. Intro overlay (added 2026-05-01): brand wordmark + scroll-hint
 *      pill on top of the full-bleed scaler, fades out as scroll
 *      progresses. Tells the user "this is the start, scroll for
 *      more". Lives at z-index 3 above the grid.
 *
 * Photos are local Melveo sports/club assets; the center scaler keeps
 * the latest wide team briefing image as the primary visual.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="image-grid-section"
  data-grid-section
  data-glass-smoke
  data-glass-smoke-density="1.2"
>
  {/* Cyan smoke field behind the grid — same recipe + same component
      as the pricing section (glass-smoke.ts). Density bumped to 1.2×
      per user feedback 2026-05-01 ("více molekul"): the image grid
      has 14 cards and a lot of card surface, so the smoke needs a
      bit more presence than the pricing section to still register
      between cards. */}
  <canvas class="glass-smoke" data-glass-smoke-canvas aria-hidden="true"></canvas>

  <div class="content">
    {/*
      Intro overlay — sits on top of the full-bleed scaler photo for
      the first ~22 % of section scroll, fading out as the morph
      starts. Tells the user "this is the start, scroll for more".
      Brand wordmark + scroll-hint pill (same .hero-pill recipe as
      the App Store + Pricing CTAs). Smooth-scrolls past the section
      on click.
    */}
    {/* Black scroll-reveal layer — sits above the scaler photo and
        below the wordmark. Starts opaque-ish, fades to 0 across the
        first ~22 % of section scroll, so the photo "develops in" as
        the user scrolls. */}
    <div class="grid-intro-darken" data-grid-intro-darken aria-hidden="true"></div>

    <div class="grid-intro" data-grid-intro>
      <div class="grid-intro__center">
        {/* Brand wordmark — always lowercase visually (text-transform
            on the CSS rule + lowercase string). Single span, soft
            rounded display font (Outfit, --font-wordmark), minimal
            shadow per user feedback 2026-05-01: "glow bych z tama
            dal pryč". Eyebrow text removed too. */}
        <h2 class="grid-intro__wordmark">melveo</h2>
      </div>
      <button
        type="button"
        class="hero-pill grid-intro__pill"
        data-grid-intro-scroll
        aria-label={t('gridMorph.scrollHint')}
      >
        <span class="hero-pill-shimmer" aria-hidden="true"></span>
        <span class="hero-pill-content">
          {t('gridMorph.scrollHint')}
          <svg
            class="grid-intro__chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
    </div>

    <div class="grid">
      <!-- Layer 1: Outer edges (photos + tech cards, 3 left + 3 right) -->
      <div class="layer">
        <div>
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/coach-player-wide-crop.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              {/* Was team-sideline-wide.jpg (1672×941 landscape) but
                  cropped to 4:5 it showed only a narrow slice — looked
                  broken (user feedback 2026-05-01). Swapped for
                  team-huddle.jpg which is 1122×1402 portrait and fits
                  the cell cleanly. team-huddle does also appear in
                  Layer 2 row 5; the two slots sit on opposite layers
                  + opposite columns so the duplication isn't visually
                  jarring during the scroll-morph reveal. */}
              <img src="/images/melveo-grid/team-huddle.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          <article class="tech-card glass-card" aria-label="Docházka">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M9 4h6a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
                <path d="M16 5.5h2a2 2 0 0 1 2 2V19a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7.5a2 2 0 0 1 2-2h2" />
                <path d="M8.5 12.5l2 2 4-4.5" />
                <path d="M8.5 17.5h7" />
              </svg>
              <h3>Docházka</h3>
            </div>
          </article>
        </div>
        <div>
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/player-mobile.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/equipment-detail.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          <article class="tech-card glass-card" aria-label="Komunikace">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8l-4 3.5V17H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" />
                <path d="M8 9.5h8M8 12.5h5" />
              </svg>
              <h3>Komunikace</h3>
            </div>
          </article>
        </div>
      </div>

      <!-- Layer 2: Inner columns (mixed photos + tech cards) -->
      <div class="layer">
        <div>
          <article class="tech-card tech-card--security glass-card" aria-label="Bezpečnost">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M7 10V8a5 5 0 0 1 10 0v2" />
                <rect class="security-lock__body" x="4.5" y="10" width="15" height="11" rx="2.4" />
                <circle class="security-lock__pin" cx="12" cy="14.7" r="1.1" />
                <path d="M12 15.8v2.4" />
              </svg>
              <h3>Bezpečnost</h3>
            </div>
          </article>
        </div>
        <div>
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/coach-player-review.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/coach-field-tablet.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          <article class="tech-card tech-card--schedule glass-card" aria-label="Schedule">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3.5" y="5" width="17" height="15.5" rx="2.4" />
                <path d="M3.5 9.5h17" />
                <path d="M8 3.5v3M16 3.5v3" />
                <circle cx="8.4" cy="13.5" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="12" cy="13.5" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="15.6" cy="13.5" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="8.4" cy="17" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="12" cy="17" r="0.9" fill="currentColor" stroke="none" />
              </svg>
              <h3>Schedule</h3>
            </div>
          </article>
        </div>
        <div>
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/team-huddle.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/coach-player-close.jpg" alt="" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
      </div>

      <!-- Layer 3: Center column top + bottom cards -->
      <div class="layer">
        <div>
          <article class="tech-card glass-card" aria-label="Statistiky">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon tech-card__icon--filled" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3.5" y="13" width="3.6" height="7.5" rx="1.1" />
                <rect x="10.2" y="7" width="3.6" height="13.5" rx="1.1" />
                <rect x="16.9" y="10" width="3.6" height="10.5" rx="1.1" />
                <path d="M3 20.5h18" stroke-width="1.4" />
              </svg>
              <h3>Statistiky</h3>
            </div>
