---
/**
 * ImageGridScrollMorph — Kevin Gutowski codepen QwNZYzL.
 *
 * Direct re-implementation of the codepen source after the V4-D draft
 * missed the architecture. The trick is:
 *
 *   1. A tall section with sticky inner content (.content)
 *      pinned at top:0 — gives a long scroll runway while the
 *      grid stays visible.
 *   2. The grid is 5 columns × 3 rows (3 cols on mobile). Cells are
 *      placed via CSS subgrid on three "layer" wrappers + one absolute
 *      ".scaler" element at the centre cell.
 *   3. The scaler image animates `width` and `height` in PIXELS from
 *      viewport size DOWN to its natural grid-cell size as the user
 *      scrolls — different easings per axis (power2 width, power1
 *      height) for the codepen's signature asymmetric feel.
 *   4. Each layer has TWO scroll-linked animations:
 *        - opacity: holds at 0 until 55 % scroll, then 0 → 1
 *        - scale:   holds at 0 until 30 % scroll, then 0 → 1
 *      using progressively more aggressive easings per layer
 *      (power1, power3, power4) — outer edges feel slower, inner
 *      cells punch in.
 *
 * No headline above the grid (per user 2026-04-30 — "ten text pojme
 * scrollovat dej pryč"). The grid is the whole effect.
 *
 * Photos are local Melveo sports/club assets; the center scaler keeps
 * the latest wide team briefing image as the primary visual.
 */
---

<section class="image-grid-section" data-grid-section>
  <div class="content">
    <div class="grid">
      <!-- Layer 1: Outer edges (photos + tech cards, 3 left + 3 right) -->
      <div class="layer">
        <div>
          <img src="/images/melveo-grid/coach-player-wide-crop.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="/images/melveo-grid/team-sideline-wide.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <article class="tech-card" aria-label="Docházka">
            <svg class="tech-card__icon" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M48 98l28 28 68-76" />
              <path d="M42 42h108v108H42z" />
            </svg>
            <h3>Docházka</h3>
            <p>Účast, absence i pozdní příchody jsou pro tým jasně dohledatelné.</p>
          </article>
        </div>
        <div>
          <img src="/images/melveo-grid/player-mobile.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="/images/melveo-grid/equipment-detail.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <article class="tech-card" aria-label="Komunikace">
            <svg class="tech-card__icon" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M42 58h108v72H92l-30 24v-24H42z" />
              <path d="M68 84h56M68 106h34" />
            </svg>
            <h3>Komunikace</h3>
            <p>Změny, zprávy a pokyny zůstanou u správného týmu.</p>
          </article>
        </div>
      </div>

      <!-- Layer 2: Inner columns (mixed photos + tech cards) -->
      <div class="layer">
        <div>
          <article class="tech-card tech-card--security" aria-label="Bezpečnost">
            <svg class="tech-card__icon tech-card__icon--security-lock" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path class="security-lock__shackle" d="M62 82V66c0-21.5 14.7-38 34-38s34 16.5 34 38v16" />
              <rect class="security-lock__body" x="42" y="78" width="108" height="84" rx="24" />
              <circle class="security-lock__pin" cx="96" cy="113" r="8" />
              <path class="security-lock__slot" d="M96 122v20" />
            </svg>
            <h3>Bezpečnost</h3>
            <p>Vaše data jsou chráněná, oddělená podle rolí a pod kontrolou.</p>
          </article>
        </div>
        <div>
          <img src="/images/melveo-grid/coach-player-review.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="/images/melveo-grid/coach-field-tablet.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <article class="tech-card tech-card--schedule" aria-label="Schedule">
            <svg class="tech-card__icon" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M56 42v22m80-22v22M38 74h116M54 54h84c8.837 0 16 7.163 16 16v76c0 8.837-7.163 16-16 16H54c-8.837 0-16-7.163-16-16V70c0-8.837 7.163-16 16-16z" />
              <path d="M64 104h26m-26 28h50m18-28h4" />
            </svg>
            <h3>Schedule</h3>
            <p>Tréninky, sessions a změny jsou v jednom přehledu pro celý tým.</p>
          </article>
        </div>
        <div>
          <img src="/images/melveo-grid/team-huddle.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div>
          <img src="/images/melveo-grid/coach-player-close.jpg" alt="" loading="lazy" decoding="async" />
        </div>
      </div>

      <!-- Layer 3: Center column top + bottom cards -->
      <div class="layer">
        <div>
          <article class="tech-card" aria-label="Statistiky">
            <svg class="tech-card__icon" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M38 150h116" />
              <path d="M56 128V92m40 36V62m40 66V80" />
              <path d="M50 74l32 20 30-42 30 18" />
            </svg>
            <h3>Statistiky</h3>
            <p>Z výkonu, docházky a zátěže vzniká přehled, který trenér použije hned.</p>
          </article>
        </div>
        <div>
          <article class="tech-card" aria-label="Role">
            <svg class="tech-card__icon" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M72 82a24 24 0 1 0 0-48 24 24 0 0 0 0 48zM120 92a20 20 0 1 0 0-40 20 20 0 0 0 0 40z" />
              <path d="M36 154c4-26 18-44 36-44s32 18 36 44M104 154c3-20 14-34 30-34 13 0 23 10 28 27" />
            </svg>
            <h3>Role</h3>
            <p>Hráč, trenér i vedení vidí jen to, co opravdu potřebují.</p>
          </article>
        </div>
      </div>

      <!-- Scaler: starts viewport-sized, shrinks into the centre cell -->
      <div class="scaler">
        <img src="/images/melveo-grid/team-briefing-wide.jpg" alt="" decoding="async" />
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Subgrid trick + sticky content — direct port from the codepen.
    Comments mark anywhere we deviated.
  */

  .image-grid-section {
    /* 620vh desktop runway — 1× viewport pinned + 520vh scroll
       budget. The extra height stretches the scaler's shrink phase
       across more scroll, so the user has to keep scrolling for
       longer to see the morph from full-bleed photo to grid.
       Combined with the `'82% end'` scroll offset (animation
       completes at 82 % of section), this leaves the last ~112vh
       as rest where the fully formed grid sits before the next
       section arrives.

       Mobile gets a shorter runway (430vh) because:
         a) Each "vh" on mobile is a smaller absolute pixel count,
            so 620vh of scroll feels endless on a 6.5" screen.
         b) Mobile only has 9 cells visible (3 cols × 3 rows; the
            outer-edge layer is hidden by media query), so there's
            less to "fade in" — animation can finish sooner. */
    position: relative;
    width: 100%;
    min-height: 620vh;
    background: var(--color-bg-canvas);
    border-top: 1px solid var(--color-stroke-base);
    overflow: clip;
  }

  @media (max-width: 768px) {
    .image-grid-section {
      min-height: 430vh;
    }
  }

  .image-grid-section .content {
    min-height: 100vh;
    width: 100vw;
    position: sticky;
    top: 0;
    overflow: hidden;
    display: flex;
    place-items: center;
    align-content: center;
  }

  .image-grid-section .grid {
    --offset: 0;
    --container-width: 1600px;
    --gap: clamp(10px, 7.35vw, 80px);
    --gutter: 2rem;

    width: var(--container-width);
    max-width: calc(100% - (2 * var(--gutter)));
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(3, auto);
    gap: var(--gap);
    margin: 0 auto;
    align-content: center;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  @media (max-width: 600px) {
    .image-grid-section .grid {
      --gutter: 1rem;
      grid-template-columns: repeat(3, 1fr);
      --offset: -1;
    }
    /* Hide outer edges on mobile (3-col layout has no room for them) */
    .image-grid-section .grid > .layer:nth-of-type(1) {
      display: none;
    }
  }

  /* Layers spread across the full 5×3 (or 3×3 mobile) grid via subgrid */
  .image-grid-section .grid > .layer {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }

  /* Layer 1: outer edges — odd children → col 1, even → col -2 */
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-of-type(odd) {
    grid-column: 1;
  }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-of-type(even) {
    grid-column: -2;
  }

  /* Layer 2: inner columns — odd → col 2, even → col -3
     (offset shifts by -1 on mobile so col indexing collapses cleanly) */
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-of-type(odd) {
    grid-column: calc(2 + var(--offset));
  }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-of-type(even) {
    grid-column: calc(-3 - var(--offset));
  }

  /* Layer 3: center column top + bottom rows */
  .image-grid-section .grid > .layer:nth-of-type(3) > div:first-of-type {
    grid-column: calc(3 + var(--offset));
    grid-row: 1;
  }
  .image-grid-section .grid > .layer:nth-of-type(3) > div:last-of-type {
    grid-column: calc(3 + var(--offset));
    grid-row: -1;
  }

  .image-grid-section .grid img,
  .image-grid-section .tech-card {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 1rem;
    display: block;
  }

  .image-grid-section .grid img {
    object-fit: cover;
  }

  .image-grid-section .tech-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 1.2vw, 1rem);
    padding: clamp(1rem, 1.8vw, 1.55rem);
    border: 1px solid rgba(255, 255, 255, 0.11);
    background:
      radial-gradient(circle at 50% 18%, rgba(0, 240, 255, 0.16), transparent 42%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.018));
    color: var(--color-text-primary);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 24px 80px -42px rgba(0, 240, 255, 0.7);
  }

  .image-grid-section .tech-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), transparent 34%);
    opacity: 0.7;
    pointer-events: none;
  }

  .image-grid-section .tech-card::after {
    content: "";
    position: absolute;
    right: -22%;
    bottom: -18%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.2), transparent 68%);
    pointer-events: none;
  }

  .image-grid-section .tech-card > * {
    position: relative;
    z-index: 1;
  }

  .image-grid-section .tech-card__icon {
    width: clamp(3.7rem, 5.6vw, 5.8rem);
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--color-accent-primary);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter:
      drop-shadow(0 0 18px rgba(0, 240, 255, 0.38))
      drop-shadow(0 18px 32px rgba(0, 0, 0, 0.24));
  }

  .image-grid-section .tech-card__icon--security-lock {
    width: clamp(4.3rem, 6.4vw, 6.6rem);
    stroke-width: 9;
  }

  .image-grid-section .security-lock__body {
    fill: rgba(0, 240, 255, 0.08);
  }

  .image-grid-section .security-lock__pin {
    fill: var(--color-accent-primary);
    stroke: none;
  }

  .image-grid-section .security-lock__slot {
    stroke: var(--color-accent-primary);
    stroke-width: 10;
  }

  .image-grid-section .tech-card h3 {
    margin: 0;
    font-size: clamp(1.15rem, 2.2vw, 2rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
  }

  .image-grid-section .tech-card p {
    margin: 0;
    max-width: 14rem;
    font-size: clamp(0.72rem, 1vw, 0.9rem);
    line-height: 1.45;
    text-align: center;
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .image-grid-section .tech-card {
      padding: 0.62rem;
      border-radius: 0.8rem;
      gap: 0.5rem;
    }

    .image-grid-section .tech-card__icon {
      width: clamp(2.6rem, 13vw, 3.4rem);
      stroke-width: 11;
    }

    .image-grid-section .tech-card__icon--security-lock {
      width: clamp(3rem, 15vw, 4rem);
    }

    .image-grid-section .tech-card p {
      display: none;
    }

    .image-grid-section .tech-card h3 {
      font-size: clamp(0.82rem, 4.8vw, 1.15rem);
      line-height: 1;
    }
  }

  /* Scaler container occupies the centre cell of the grid; its <img>
     is absolutely positioned so we can animate width/height in pixels
     while keeping the image perfectly centred. */
  .image-grid-section .grid .scaler {
    position: relative;
    grid-area: 2 / calc(3 + var(--offset));
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  .image-grid-section .scaler img {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    object-fit: cover;
    border-radius: 1rem;
    width: 100%;
    height: 100%;
    /*
      CRITICAL: Tailwind preflight applies `img { max-width: 100% }`
      which would clamp the scaler to its grid-cell parent (~256px)
      even when JS sets inline width: 1700px. The animation looked
      like only height was working — width inline was being silently
      capped. Explicit override here lets the JS-driven pixel sizing
      run free across the whole viewport.
    */
    max-width: none;
    max-height: none;
  }

  /* Reduced-motion: drop the sticky/scroll dance. Show every cell in
     its final position, statically. */
  @media (prefers-reduced-motion: reduce) {
    .image-grid-section {
      min-height: auto;
    }
    .image-grid-section .content {
      position: relative;
      min-height: 80vh;
    }
    .image-grid-section .grid {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
    }
  }
</style>

<script>
  import { animate, scroll } from 'motion';

  /*
    Motion v12 keyframe-timing API note:
      - For keyframe positions within an animate() call use `times: [...]`,
        NOT `offset: [...]` (offset is reserved for scroll() target config).
      - Easing key is `ease`, NOT `easing` (Motion v11 used `easing`; the
        codepen we're porting from uses v11).
    Earlier versions of this file used the v11 names which Motion v12
    silently ignored, so the hold-pattern keyframes were treated as
    equally spaced and the per-axis easings dropped to defaults — that's
    why the scaler appeared to shrink immediately on scroll instead of
    holding at viewport size.
  */

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const section = document.querySelector<HTMLElement>('[data-grid-section]');
    const image = section?.querySelector<HTMLImageElement>('.scaler img');
    const layers = section?.querySelectorAll<HTMLElement>('.grid > .layer');

    if (section && image && layers && layers.length > 0) {
      // Wait one frame so layout has settled and we can measure the
      // .scaler container itself — it's `width:100%; height:100%` of
      // its grid cell, so its offsetWidth/Height equal the natural
      // cell dimensions exactly. Earlier versions measured a sibling
      // `.layer img` which could be at scale(0) by the time we ran
      // (Motion's scroll() pre-applies keyframe[0] on registration);
      // that gave wrong fallbacks and the scaler ended up oversized
      // relative to its neighbours.
      requestAnimationFrame(() => {
        const scalerEl = section.querySelector<HTMLElement>('.scaler');
        const naturalWidth = scalerEl?.offsetWidth ?? 280;
        const naturalHeight = scalerEl?.offsetHeight ?? 350;

        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;

        // Cubic-bezier control points. Names match GSAP power easings
        // referenced by the codepen.
        const power1InOut = [0.42, 0, 0.58, 1] as const;
        const power2InOut = [0.65, 0, 0.35, 1] as const;
        const power3InOut = [0.76, 0, 0.24, 1] as const;
        const power4InOut = [0.87, 0, 0.13, 1] as const;
        const sineOut = [0.61, 1, 0.88, 1] as const;
        const scrollCompletionRatio = 0.82;

        // ─── Scaler: hold at viewport, then shrink to natural ──────────
        //     Width AND height in a SINGLE animate() call. Splitting
        //     them into two scroll(animate()) registrations on the same
        //     element broke things — Motion v12 treats the second call
        //     as a takeover and cancels the first, which is why width
        //     stayed at its CSS default while height morphed to viewport.
        //     Using one combined call with shared options preserves
        //     both axes; we sacrifice the codepen's per-axis asymmetric
        //     easing (power2 width vs power1 height) for correctness.
        //     The asymmetry is recovered visually anyway because the
        //     start delta differs between width and height.
        scroll(
          animate(
            image,
            {
              width: [
                `${viewportWidth}px`,
                `${viewportWidth}px`,
                `${naturalWidth}px`,
              ],
              height: [
                `${viewportHeight}px`,
                `${viewportHeight}px`,
                `${naturalHeight}px`,
              ],
            },
            {
              times: [0, 0.18, 1],
              ease: power2InOut as any,
            },
          ),
          {
            target: section,
            // Animation completes at 82 % of section's scroll travel,
            // leaving the last 18 % as a "rest" runway where the fully
            // formed grid sits at its final state before the next
            // section arrives. Scaler + every layer end inside this
            // 0–82 % window so the grid is visually frozen for the
            // whole rest period.
            offset: ['start start', `${scrollCompletionRatio * 100}% end`] as any,
          },
        );

        // ─── Each layer: opacity (hold→fade) + scale (hold→reveal) ─────
        const scaleEasings = [power1InOut, power3InOut, power4InOut];

        layers.forEach((layer, index) => {
          // Endpoint shifts per layer for a subtle cascade. All layers
          // finish BEFORE the scaler's end (82 %) so the grid is fully
          // formed when the rest period begins. Outer edges (index 0)
          // end last; inner-most cells (index 2) finish earliest, same
          // ordering as codepen but compressed before the rest zone.
          const endOffset = `${scrollCompletionRatio - index * 0.055} end`;

          // Opacity: invisible until 60 % progress, then fades 0 → 1
          scroll(
            animate(
              layer,
              { opacity: [0, 0, 1] },
              {
                times: [0, 0.6, 1],
                ease: sineOut as any,
              },
            ),
            {
              target: section,
              offset: ['start start', endOffset] as any,
            },
          );

          // Scale: held at 0 until 36 % progress, then springs to 1
          scroll(
            animate(
              layer,
              { scale: [0, 0, 1] },
              {
                times: [0, 0.36, 1],
                ease: scaleEasings[index] as any,
              },
            ),
            {
              target: section,
              offset: ['start start', endOffset] as any,
            },
          );
        });
      });
    }
  }
</script>
