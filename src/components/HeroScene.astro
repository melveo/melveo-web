---
/**
 * HeroScene — WebGL metaballs shader + black SSR fallback.
 *
 * Behavior:
 *   - SSR renders a black fallback (visible on first paint +
 *     reduced-motion + JS-disabled clients), matching the CodePen body.
 *   - On client, after IntersectionObserver fires + reduced-motion
 *     check passes, mounts the custom metaballs shader over the canvas.
 *     SVG fallback fades out on mount.
 *   - Per PLAN.md §7.9: pause RAF on document.hidden, cap pixel ratio,
 *     reduce-motion stays SVG only.
 *
 * Bundle impact: no 3D runtime dependency in the hero; SVG fallback is
 * inline (~1kB).
 */
---

<div class="hero-scene-wrap" aria-hidden="true">
  <!-- SSR fallback — visible until JS mounts the scene -->
  <svg
    class="hero-fallback"
    viewBox="0 0 100 100"
    preserveAspectRatio="xMidYMid slice"
    role="presentation"
  >
    <defs>
    </defs>
    <rect width="100" height="100" fill="#000"/>
  </svg>

  <!-- WebGL metaballs canvas (mounted client-side) -->
  <canvas class="hero-canvas" data-hero-canvas></canvas>
</div>

<style>
  .hero-scene-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .hero-fallback,
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.6s ease;
  }

  .hero-canvas {
    opacity: 0;
  }

  .hero-canvas[data-mounted="true"] {
    opacity: 1;
  }

  .hero-canvas[data-mounted="true"] + .hero-fallback,
  .hero-scene-wrap[data-mounted="true"] .hero-fallback {
    opacity: 0;
  }

</style>

<script>
  const wrap = document.querySelector<HTMLDivElement>('.hero-scene-wrap');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && canvas && !prefersReducedMotion) {
    // Lazy-init only after the hero is in viewport. On a /cs/ root visit
    // this fires immediately, then waits for idle before loading WebGL.
    const obs = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (!entry?.isIntersecting) return;
      obs.disconnect();

      // Defer to idle to avoid LCP impact
      const start = async () => {
        const { mountHeroScene } = await import('../scripts/hero-scene');
        const handle = mountHeroScene({ canvas });
        if (!handle) return;
        canvas.setAttribute('data-mounted', 'true');
        wrap.setAttribute('data-mounted', 'true');
        // Expose dispose for HMR (Vite calls this on hot reload)
        if (import.meta.hot) {
          import.meta.hot.dispose(() => handle.dispose());
        }
      };

      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(start, { timeout: 1500 });
      } else {
        setTimeout(start, 100);
      }
    });

    obs.observe(wrap);
  }
</script>
