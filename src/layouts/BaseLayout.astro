---
/**
 * BaseLayout — fullwidth, indie-iOS-app style.
 *
 * No max-width container; pages render edge-to-edge. Content padding
 * is handled per-section. Header is intentionally absent on the
 * landing — the wordmark sits inside the hero. Privacy/Terms pages
 * use their own constrained article width.
 *
 * Apple App Store discipline (docs/planning/15 §"Apple-safe"):
 * the iOS companion app must never see Buy/Subscribe CTAs. The web
 * surface is allowed and required to host the App Store badge,
 * pilot enquiry email, and legal pages.
 */

interface Props {
  title: string;
  description?: string;
  /** Path-only URL used for canonical + OG tags. Trailing slash optional. */
  canonical?: string;
  /** Override the default OG image. */
  ogImage?: string;
  /** When true, render the minimal landing footer (default).
   *  Privacy/Terms pages set this false to render an even lighter footer. */
  showLandingFooter?: boolean;
}

const {
  title,
  description = "Melveo — chytřejší tréninky a zdravější hráči pro kluby, trenéry i hráče.",
  canonical,
  ogImage = "/og-default.png",
  showLandingFooter = true,
} = Astro.props;

const fullTitle = title === "Melveo" ? title : `${title} — Melveo`;
const canonicalUrl = canonical
  ? new URL(canonical, Astro.site).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- OG / Twitter -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-[var(--color-bg-canvas)] text-[var(--color-text-primary)]">
    <slot />

    {
      showLandingFooter && (
        <footer class="border-t border-[var(--color-stroke-base)]/60">
          <div class="flex flex-col items-center gap-4 px-6 py-10 text-center text-sm text-[var(--color-text-tertiary)] sm:flex-row sm:justify-center sm:gap-8">
            <span>© 2026 Melveo</span>
            <a
              href="mailto:hello@melveo.app"
              class="transition-colors hover:text-[var(--color-text-primary)]"
            >
              hello@melveo.app
            </a>
            <a
              href="/privacy"
              class="transition-colors hover:text-[var(--color-text-primary)]"
            >
              Ochrana soukromí
            </a>
            <a
              href="/terms"
              class="transition-colors hover:text-[var(--color-text-primary)]"
            >
              Podmínky
            </a>
          </div>
        </footer>
      )
    }
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
