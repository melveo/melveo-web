---
/**
 * Landing — shared body of the home page across locales.
 *
 * Reference DNA: fey.com + raycast.com (per PLAN.md §3).
 * Each section is its own full-bleed stage; no outer max-width
 * container. Strings come from src/i18n/ui.ts via t() helper.
 *
 * V4 enhancements (Three.js hero, codepen effects, etc.) will land
 * in subsequent commits per V4-C / V4-D phases. This component is
 * the V3 layout wrapped in a locale-aware shell.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from './HeroScene.astro';
import ImageGridScrollMorph from './ImageGridScrollMorph.astro';
import GooeyStage from './GooeyStage.astro';
import WordScrollStage from './WordScrollStage.astro';
import ClubFlowStage from './ClubFlowStage.astro';
import OrbStage from './OrbStage.astro';
import ParticleStatementStage from './ParticleStatementStage.astro';
import PromiseStage from './PromiseStage.astro';
import PricingStage from './PricingStage.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const feedbackItems =
  lang === 'cs'
    ? [
        {
          input: 'Check-in hráče',
          output: 'Signál pro dnešní zátěž, regeneraci a riziko přetížení.',
        },
        {
          input: 'Docházka + RPE',
          output: 'Přehled účasti a zatížení týmu po každé session.',
        },
        {
          input: 'Sessions',
          output: 'Konkrétní feedback pro trenéra před dalším tréninkem.',
        },
      ]
    : [
        {
          input: 'Player check-in',
          output: 'A signal for today’s load, recovery, and overload risk.',
        },
        {
          input: 'Attendance + RPE',
          output: 'A clear view of team presence and load after every session.',
        },
        {
          input: 'Sessions',
          output: 'Concrete coaching feedback before the next training.',
        },
      ];
---

<BaseLayout title="Melveo" lang={lang}>
  <!-- ============================================================== -->
  <!-- HERO — pitch-black, full viewport, prism shader, claim, CTA    -->
  <!-- ============================================================== -->
  <section class="relative isolate flex min-h-screen w-full flex-col overflow-hidden bg-[var(--color-bg-canvas)]">
    <HeroScene />

    <header class="relative z-10 flex w-full items-center justify-between px-6 pt-6 sm:px-12 sm:pt-10">
      <a
        href={`/${lang}/`}
        class="melveo-wordmark text-xl tracking-tight text-[var(--color-text-primary)]"
      >
        melveo
      </a>
      <a
        href="mailto:hello@melveo.app"
        class="hidden text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)] sm:inline"
      >
        {t('nav.contact')}
      </a>
    </header>

    <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 pb-8 pt-24 text-center sm:pt-32">
      <p class="mb-8 text-xs font-semibold uppercase tracking-[0.4em] text-[var(--color-accent-primary)]">
        {t('hero.eyebrow')}
      </p>

      <h1
        class="text-balance font-bold leading-[0.95] tracking-tight text-[var(--color-text-primary)]"
        style="font-size: clamp(3rem, 8.5vw, 8.5rem); letter-spacing: -0.04em;"
      >
        {t('hero.headlinePrefix')}{' '}
        <span
          class="text-[var(--color-accent-primary)]"
          data-rotate-word
          aria-live="polite"
        >
          {lang === 'cs' ? 'tréninky' : 'trainings'}
        </span>{t('hero.headlineSuffix')}
      </h1>

      <p class="mx-auto mt-10 max-w-[36rem] text-pretty text-lg font-medium text-[var(--color-text-primary)] sm:text-xl">
        {t('hero.subline')}
      </p>

      <div class="hero-cta-row">
        <a
          href="mailto:hello@melveo.app?subject=App%20Store%20notification"
          aria-label={t('hero.cta.appstore')}
          class="hero-pill hero-pill--filled"
        >
          <span class="hero-pill-shimmer" aria-hidden="true"></span>
          <span class="hero-pill-content">
            {/* Apple logo glyph in inline SVG so we control colour */}
            <svg
              class="hero-pill-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
            </svg>
            <span class="hero-pill-text">
              <span class="hero-pill-eyebrow">
                {lang === 'cs' ? 'Stáhnout v' : 'Download on the'}
              </span>
              <span class="hero-pill-title">App Store</span>
            </span>
          </span>
        </a>
        <a
          href={`mailto:hello@melveo.app?subject=${encodeURIComponent(
            lang === 'cs' ? 'Zájem o pilot' : 'Pilot enquiry'
          )}`}
          class="hero-pill hero-pill--ghost"
        >
          <span class="hero-pill-shimmer" aria-hidden="true"></span>
          <span class="hero-pill-content">{t('hero.cta.pilot')}</span>
        </a>
      </div>
    </div>

  </section>

  <!-- ============================================================== -->
  <!-- STAGE 2 + 3 — Scroll-linked image grid morph                    -->
  <!--               (Kevin Gutowski codepen QwNZYzL)                  -->
  <!-- ============================================================== -->
  <ImageGridScrollMorph lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 3.5 — Gooey metaball (Ahmad Awais codepen)                -->
  <!-- ============================================================== -->
  <GooeyStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 3.75 — Scroll-linked word highlight (Daniel Haim codepen) -->
  <!-- ============================================================== -->
  <WordScrollStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 4 — Sticky club workflow                                  -->
  <!-- ============================================================== -->
  <ClubFlowStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 5 — Glass orb + rotating text (Giomgio codepen)           -->
  <!-- ============================================================== -->
  <OrbStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 5.5 — Particles statement (Ahmad Awais codepen)           -->
  <!-- ============================================================== -->
  <ParticleStatementStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 6.25 — Billing-promise mini bridge (gooey-family)         -->
  <!--               "Klub platí. Hráč nikdy."                         -->
  <!-- ============================================================== -->
  <PromiseStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 6.5 — Pricing                                             -->
  <!-- ============================================================== -->
  <PricingStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 7 — Data feedback promise                                 -->
  <!-- ============================================================== -->
  <section class="feedback-stage">
    <div class="halo-cyan feedback-stage__halo"></div>

    <div class="feedback-stage__inner">
      <div class="feedback-stage__copy">
        <p class="feedback-stage__eyebrow">
          {t('privacy.eyebrow')}
        </p>
        <h2 class="feedback-stage__headline">
          {t('privacy.headlineLine1')}<br />
          <span>{t('privacy.headlineLine2')}</span>
        </h2>
        <p class="feedback-stage__body">
          {t('privacy.body')}
        </p>
      </div>

      <div class="feedback-stage__flow" aria-label={lang === 'cs' ? 'Vstupy a výstupy v Melveo' : 'Inputs and outputs in Melveo'}>
        {feedbackItems.map((item) => (
          <article class="feedback-card glass-card">
            <span class="glass-filter" aria-hidden="true"></span>
            <span class="glass-overlay" aria-hidden="true"></span>
            <span class="glass-specular" aria-hidden="true"></span>
            <div class="glass-content">
              <span class="feedback-card__label">
                {lang === 'cs' ? 'Vstup' : 'Input'}
              </span>
              <h3 class="feedback-card__input">{item.input}</h3>
              <span class="feedback-card__divider" aria-hidden="true"></span>
              <span class="feedback-card__label feedback-card__label--out">
                {lang === 'cs' ? 'Výstup' : 'Output'}
              </span>
              <p class="feedback-card__output">{item.output}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- STAGE 9 — Pilot CTA                                             -->
  <!--   Quiet closing section — no smoke backdrop, no pill button.    -->
  <!--   Per user 2026-05-01: the email is the only thing that         -->
  <!--   needs to dominate. Headline + body are tiny eyebrows above    -->
  <!--   it; everything else is removed.                               -->
  <!-- ============================================================== -->
  <section class="pilot-cta-stage">
    <div class="pilot-cta-stage__inner">
      <h2 class="pilot-cta-stage__headline">
        {t('pilot.headline')}
      </h2>
      <p class="pilot-cta-stage__body">
        {t('pilot.body')}
      </p>
      <a
        href={`mailto:${t('pilot.email')}`}
        class="pilot-cta-stage__email"
        aria-label={lang === 'cs' ? 'Napsat na ' + t('pilot.email') : 'Email ' + t('pilot.email')}
      >
        {t('pilot.email')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .feedback-stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: hidden;
    border-top: 1px solid var(--color-stroke-base);
    background: var(--color-bg-canvas);
  }

  .feedback-stage__halo {
    opacity: 0.45;
    inset: 4% auto auto 50%;
  }

  /*
    Centred layout (was a 2-col left/right grid on desktop). Per user
    feedback 2026-05-01: "všechny sekce situované na střed… i ty
    tabulky." Headline + body stack centred at the top, then a 3-col
    grid of feedback cards centred below.
  */
  .feedback-stage__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    width: min(100% - 2rem, 78rem);
    margin: 0 auto;
    padding: clamp(6rem, 12vw, 10rem) 0;
    text-align: center;
  }

  .feedback-stage__copy {
    text-align: center;
    max-width: 56rem;
  }

  .feedback-stage__eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    color: var(--color-accent-primary);
  }

  .feedback-stage__headline {
    margin: 0;
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    font-size: clamp(2.6rem, 6vw, 6rem);
    text-wrap: balance;
  }

  .feedback-stage__headline span {
    color: var(--color-accent-primary);
  }

  .feedback-stage__body {
    margin: 1.5rem auto 0;
    max-width: 42rem;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Cards in a centred grid — single column on phones, multi-column
     on tablets+ so the three input/output pairs read as a row. */
  .feedback-stage__flow {
    display: grid;
    gap: 1rem;
    width: 100%;
    max-width: 72rem;
  }
  @media (min-width: 720px) {
    .feedback-stage__flow {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  /*
    Feedback card — premium "input → output" layout with no arrow
    (per user 2026-05-01: "ty šipky jsou zbytečné"). Stack format:
       Vstup           ← cyan caps eyebrow
       Title           ← input subject, primary-text
       ─────           ← hairline cyan divider
       Výstup          ← cyan caps eyebrow
       Body sentence   ← output description, soft secondary
    Same .glass-card recipe as pricing for visual cohesion.
  */
  .feedback-card .glass-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.55rem;
    padding: clamp(1.5rem, 2vw, 1.85rem);
  }

  .feedback-card__label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
  }

  .feedback-card__label--out {
    margin-top: 0.25rem;
  }

  .feedback-card__input {
    margin: 0;
    font-size: clamp(1.2rem, 1.9vw, 1.55rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
  }

  /* Hairline cyan divider — replaces the old arrow. Reads as a
     soft gradient line so it has the brand glow without
     dominating the card. */
  .feedback-card__divider {
    display: block;
    width: 100%;
    height: 1px;
    margin: 0.85rem 0 0.25rem;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-accent-primary) 55%, transparent) 30%,
      color-mix(in srgb, var(--color-accent-primary) 55%, transparent) 70%,
      transparent
    );
  }

  .feedback-card__output {
    margin: 0;
    max-width: 30rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-text-secondary) 92%, var(--color-text-primary));
    text-wrap: pretty;
  }

  /*
    Pilot CTA — quiet closing footer. No smoke, no pill button, no
    decorative cyan halo (user 2026-05-01: "možná bych tam nedával
    ani to pozadí, hlavní věc je ten firemní e-mail jako největší
    co tam je"). Headline + body are tiny eyebrows above the email,
    which is the focal element of the whole page closing.
  */
  .pilot-cta-stage {
    position: relative;
    width: 100%;
    border-top: 1px solid var(--color-stroke-base);
    background: var(--color-bg-canvas);
  }

  .pilot-cta-stage__inner {
    width: min(100% - 2rem, 64rem);
    margin: 0 auto;
    padding: clamp(5.5rem, 11vw, 9rem) 0;
    text-align: center;
  }

  /* Headline + body are now eyebrow-scale labels above the email,
     not the focal copy. Reads as "Pojďme to spustit. / Krátký
     e-mail stačí." */
  .pilot-cta-stage__headline {
    margin: 0;
    font-weight: 600;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
  }

  .pilot-cta-stage__body {
    margin: 0.85rem auto 0;
    max-width: 32rem;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /*
    Email = the largest, brightest thing on the closing footer. Brand
    cyan, display weight, scales up to ~7 rem on big screens so it
    reads as the page's last word. Animated underline on hover.
  */
  .pilot-cta-stage__email {
    display: inline-block;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.85rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-accent-primary);
    text-decoration: none;
    text-shadow: 0 0 36px color-mix(in srgb, var(--color-accent-primary) 28%, transparent);
    background-image: linear-gradient(
      90deg,
      var(--color-accent-primary),
      var(--color-accent-primary)
    );
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 2px;
    transition: background-size 0.4s cubic-bezier(0.39, 0.575, 0.565, 1);
  }
  .pilot-cta-stage__email:hover,
  .pilot-cta-stage__email:focus-visible {
    background-size: 100% 2px;
  }
  .pilot-cta-stage__email:focus-visible {
    outline: 2px solid var(--color-accent-primary-subtle);
    outline-offset: 8px;
    border-radius: 6px;
  }

  /* Feedback section is centred at all viewports now (see
     .feedback-stage__inner above) — no @media override needed. */

  /*
    Hero rotating word — wrap so y-translate during cycle stays within
    the line. Typewriter version writes characters in-place via
    `el.textContent = ...`, so no slide-shell needed — just a small
    caret to mark the typing position.
  */
  [data-rotate-word] {
    display: inline-block;
    /* Trailing caret while typing — subtle blinking bar */
    border-right: 0.05em solid currentColor;
    margin-right: -0.05em;
    animation: caret-blink 1.05s steps(2) infinite;
  }

  @keyframes caret-blink {
    50% { border-right-color: transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-rotate-word] {
      animation: none;
      border-right: 0;
      margin-right: 0;
    }
  }

  /*
    Hero CTA row — CodePen glass-button mechanics adapted to Melveo
    colours. Both buttons share the same animated border and shimmer.
  */
  .hero-cta-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .hero-cta-row {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  /* .hero-pill recipe lives in src/styles/global.css so any component
     can reuse it (notably PricingStage's plan CTAs per user request
     2026-05-01: "úplně přesně takové tlačítka jako v Hero"). The
     pointer-tracking handler below in mountHeroButtons() runs on every
     .hero-pill in the DOM, so pricing CTAs get the same effect for
     free as long as they live on the same page. */
</style>

<script>
  import { mountRotateWord } from '../scripts/rotate-word';
  import { mountTextReveal } from '../scripts/text-reveal';

  function mountHeroButtons() {
    document.querySelectorAll<HTMLElement>('.hero-pill').forEach((button) => {
      button.addEventListener('pointermove', (event) => {
        const rect = button.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;
        button.style.setProperty('--x', `${x}%`);
        button.style.setProperty('--y', `${y}%`);
      });
    });
  }

  // Defer to idle so hero LCP is unaffected
  function init() {
    mountHeroButtons();
    mountRotateWord();
    mountTextReveal();
  }

  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(init, { timeout: 1500 });
  } else {
    setTimeout(init, 200);
  }
</script>
