---
/**
 * OrbStage — Giomgio codepen abxGyQX, 1:1 port.
 *
 * Two stacked hero blocks. Primary on dark canvas with primary
 * heading; secondary absolutely overlaid with a brand-cyan gradient
 * background and a different heading. A radial-gradient mask reveals
 * the secondary block only inside a circle that follows the cursor.
 *
 * No text rotation — per user 2026-04-30. The "change" comes from
 * the cursor sweeping across the static secondary text.
 *
 * Smooth interpolation handled natively via @property + CSS transition
 * (codepen used GSAP for the lerp). See `src/scripts/orb-cursor.ts`
 * for the pointermove → --x / --y wiring.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="orb-wrapper" data-orb-wrapper>
  <!-- Primary hero — dark canvas, white primary text -->
  <div class="orb-hero">
    <h2 class="orb-heading">{t('orb.primary')}</h2>
  </div>

  <!-- Secondary hero — absolute overlay, cyan gradient bg, dark text,
       revealed only through radial mask centred at cursor. -->
  <div class="orb-hero orb-hero--secondary" aria-hidden="true" data-orb-secondary>
    <p class="orb-heading">{t('orb.secondary')}</p>
  </div>

</section>

<script>
  import { mountOrbCursor } from '../scripts/orb-cursor';
  mountOrbCursor();
</script>

<style>
  /*
    Register --x / --y as proper percentage typed CSS properties so
    the browser can transition them smoothly. Without @property the
    custom-property values are opaque strings and the circle would
    snap rather than follow the cursor.
  */
  @property --x {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 70%;
  }
  @property --y {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 50%;
  }

  .orb-wrapper {
    position: relative;
    width: 100%;
    border-top: 1px solid var(--color-stroke-base);
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
  }

  .orb-hero {
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 5rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orb-hero--secondary {
    /* Position-locked overlay over the primary block. */
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    /*
      Glass-hexagon body — pure brand-cyan radial gradient that
      follows the cursor on desktop and ambient auto-orbit on touch
      devices (same --x / --y as the clip-path).
      Updated 2026-05: replaced the circular orb with a hexagon clip
      so the reveal shape matches the hexagonal brand identity used
      throughout the rest of the site (input + Coach hexes).
    */
    --x: 70%;
    --y: 50%;
    background: radial-gradient(
      circle at calc(var(--x) - 6%) calc(var(--y) - 6%),
      var(--color-accent-primary-subtle) 0%,
      var(--color-accent-primary) 18%,
      color-mix(in srgb, var(--color-accent-primary) 75%, var(--color-bg-canvas)) 55%,
      color-mix(in srgb, var(--color-accent-primary) 45%, var(--color-bg-canvas)) 100%
    );

    /*
      Dark text inside the hexagon — same canvas variable as before
      so it tracks any brand-bg change.
    */
    color: var(--color-bg-canvas);

    /*
      Hexagon-shaped reveal. Flat-top hexagon centred at (--x, --y)
      with "radius" 25vmin (matches the previous circular reveal so
      the heading still fits inside). Vertex math:
        right        = (x + R, y)
        bottom-right = (x + R/2, y + R*√3/2)
        bottom-left  = (x - R/2, y + R*√3/2)
        left         = (x - R, y)
        top-left     = (x - R/2, y - R*√3/2)
        top-right    = (x + R/2, y - R*√3/2)
      With R = 25vmin, √3/2 ≈ 0.866, so half-height = 21.65vmin.
      The clip-path transitions smoothly because --x and --y are
      typed @property percentages.
    */
    clip-path: polygon(
      calc(var(--x) + 25vmin) var(--y),
      calc(var(--x) + 12.5vmin) calc(var(--y) + 21.65vmin),
      calc(var(--x) - 12.5vmin) calc(var(--y) + 21.65vmin),
      calc(var(--x) - 25vmin) var(--y),
      calc(var(--x) - 12.5vmin) calc(var(--y) - 21.65vmin),
      calc(var(--x) + 12.5vmin) calc(var(--y) - 21.65vmin)
    );

    /* Overlay shouldn't capture cursor events; pointermove lives on
       window. */
    pointer-events: none;

    /*
      Smoothness budget — same logic as the previous circular orb,
      just transitioning the typed --x/--y now drives a clip-path
      polygon instead of a radial mask:
        - --x / --y are typed @property values so the browser can
          actually transition them (untyped custom props would snap)
        - cubic-bezier matches GSAP's sine.out feel from codepen
        - 0.4s reads as smoother than 0.3s when the underlying
          movement is sample-throttled to one rAF per frame
        - will-change: clip-path promotes this layer to its own
          compositor surface so clip recomputes don't re-paint the
          surrounding section
        - translate3d is the canonical "force GPU layer" hack for
          older WebKit (otherwise repaints can jank)
        - backface-visibility hidden helps Safari coalesce layers
    */
    transition:
      --x 0.48s cubic-bezier(0.39, 0.575, 0.565, 1),
      --y 0.48s cubic-bezier(0.39, 0.575, 0.565, 1);
    will-change: clip-path;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }

  .orb-wrapper.is-orb-touch-dragging .orb-hero--secondary {
    transition:
      --x 0.12s ease-out,
      --y 0.12s ease-out;
  }

  .orb-heading {
    margin: 0;
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 8rem);
    line-height: 1;
    /* Limit horizontal width so the headline stays on one line
       inside the cursor circle (codepen uses max-width: fit-content
       + auto margins). */
    max-width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

</style>
