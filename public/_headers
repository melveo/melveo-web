# Cloudflare Pages headers config — V4-G
# Reference: https://developers.cloudflare.com/pages/configuration/headers/

# AASA file MUST be served as application/json + uncached (Apple AASA
# verifier rejects HTML / text). Cloudflare Pages defaults to a wrong
# MIME for files without extension, so we force it here.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: noindex

# Security baseline for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Cross-Origin-Opener-Policy — window isolation hygiene. Prevents
  # cross-origin window references via window.opener and removes the
  # Spectre-style leak vector. `same-origin` is the strictest option
  # that still works for normal browsing (we never share window
  # context with third parties). Added 2026-05-18.
  Cross-Origin-Opener-Policy: same-origin
  # Content-Security-Policy in Report-Only first. After ~2 weeks of
  # zero violation reports we'll promote to enforce mode (rename
  # header to `Content-Security-Policy`). The allowlist covers:
  #   - 'self' for our own assets
  #   - 'unsafe-inline' for the JSON-LD blocks + AnalyticsHead +
  #     rotating-word config and root locale-detect inline scripts
  #     (these would otherwise need nonces; deferred to a follow-up)
  #   - https://fonts.googleapis.com + https://fonts.gstatic.com for
  #     the Google Fonts stylesheet + font files
  #   - https://www.googletagmanager.com for GA / GTM if enabled
  #   - https://static.cloudflareinsights.com for the CF Web Analytics
  #     beacon (auto-injected when the zone-level analytics is on)
  # img-src includes data: for any inlined SVGs / icons.
  # frame-ancestors 'self' supersedes X-Frame-Options once enforce
  # mode is on — keep both during the report-only window so we don't
  # accidentally drop iframe-protection if CSP is mis-typed.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://api.melveo.app https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://static.cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Static assets — long cache + immutable (bundles are content-hashed)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images — long cache (filenames stable). If a photo needs to change,
# rename it with a version suffix (e.g. coach-hero-v2.jpg).
/images/*
  Cache-Control: public, max-age=2592000

# Favicons — week cache
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

/badges/*
  Cache-Control: public, max-age=86400

# OG images — moderate cache so we can refresh without bust.
# Both .jpg (compatibility) and .webp (modern crawlers) shipped.
/og-default.jpg
  Cache-Control: public, max-age=86400
/og-default.webp
  Cache-Control: public, max-age=86400

# Sitemap should refresh frequently
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-*.xml
  Cache-Control: public, max-age=3600
