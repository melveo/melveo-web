---
/**
 * OrbStage — Giomgio codepen abxGyQX (V4-D4 v2).
 *
 * Re-implementation per user 2026-04-30: two stacked hero blocks at
 * 100vh, both centred. Primary block sits on the dark canvas with the
 * primary headline. Secondary block is absolutely overlaid on top
 * with a brand-cyan tinted gradient background and a different
 * headline; a radial-gradient mask reveals it only inside a circle
 * that follows the cursor.
 *
 * Original codepen used GSAP. We use Motion (already loaded) for the
 * smooth easing of the --x / --y CSS variables tied to the mask
 * position. Phrases rotate every few seconds so the secondary headline
 * cycles through "Pro hráče. / Pro trenéra. / Pro klub." (or EN).
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="orb-wrapper" data-orb-wrapper>
  <!-- Primary hero — dark canvas, primary text -->
  <div class="orb-hero">
    <h2 class="orb-heading">{t('orb.primary')}</h2>
  </div>

  <!-- Secondary hero — absolute overlay, gradient bg, rotating text,
       revealed only through radial mask centred at cursor. -->
  <div class="orb-hero orb-hero--secondary" aria-hidden="true" data-orb-secondary>
    <p class="orb-heading" data-orb-rotate>
      {t('orb.secondary1')}
    </p>
  </div>
</section>

<script
  define:vars={{
    phrases: [t('orb.secondary1'), t('orb.secondary2'), t('orb.secondary3')],
  }}
  type="module"
>
  import { animate } from 'motion';

  const wrapper = document.querySelector('[data-orb-wrapper]');
  const secondary = document.querySelector('[data-orb-secondary]');
  const text = document.querySelector('[data-orb-rotate]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrapper && secondary && text) {
    /* ── Cursor-following mask ────────────────────────────────────
       Update --x / --y CSS variables on the secondary layer in
       response to mousemove. Motion smoothly eases the change so the
       circle "trails" the cursor instead of snapping. */
    if (!reduceMotion) {
      window.addEventListener(
        'pointermove',
        (event) => {
          const x = Math.round((event.clientX / window.innerWidth) * 100);
          const y = Math.round((event.clientY / window.innerHeight) * 100);
          animate(
            secondary,
            { '--x': `${x}%`, '--y': `${y}%` },
            { duration: 0.35, ease: [0.39, 0.575, 0.565, 1] },
          );
        },
        { passive: true },
      );
    } else {
      // Reduced motion: snap circle to a fixed pleasant spot.
      secondary.style.setProperty('--x', '70%');
      secondary.style.setProperty('--y', '50%');
    }

    /* ── Text rotation ────────────────────────────────────────────
       Cycle the secondary headline every 3.2 s with a small fade.
       Visible only inside the cursor mask. */
    if (!reduceMotion) {
      let idx = 0;
      const interval = setInterval(async () => {
        try {
          await animate(text, { opacity: [1, 0], y: [0, -16] }, { duration: 0.4 }).finished;
          idx = (idx + 1) % phrases.length;
          text.textContent = phrases[idx];
          await animate(text, { opacity: [0, 1], y: [16, 0] }, { duration: 0.5 }).finished;
        } catch {
          clearInterval(interval);
        }
      }, 3200);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) clearInterval(interval);
      });
    }
  }
</script>

<style>
  .orb-wrapper {
    position: relative;
    width: 100%;
    /* Border-top to keep section bands consistent with siblings. */
    border-top: 1px solid var(--color-stroke-base);
  }

  .orb-hero {
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 5rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .orb-hero--secondary {
    /* Position-locked overlay over the primary block. */
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    /* Brand-leaning gradient. Codepen used violet→mint→white; we
       lean into Melveo's cyan + a sandy warm so the reveal still feels
       distinct from the rest of the page (which is mostly cyan-on-black). */
    background: linear-gradient(45deg, #00f0ff, #b0702e, #ffffff);
    color: var(--color-bg-canvas);

    /* Radial mask — circle of brand-cyan tinted gradient revealed
       through the dark canvas. Default position 70% / 50% so the
       reveal is offset from the primary text on first paint. */
    --x: 70%;
    --y: 50%;
    --mask: radial-gradient(circle at var(--x) var(--y), black 22%, transparent 0);
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
    pointer-events: none;
  }

  .orb-heading {
    margin: 0;
    text-align: center;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 8rem);
    line-height: 1;
    /* Limit horizontal width so long Czech phrases stay on one line
       inside the cursor circle. */
    max-width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  .orb-hero--secondary .orb-heading {
    /* Force colour to canvas dark — readable against the gradient
       inside the cursor circle. */
    color: var(--color-bg-canvas);
  }

  @media (prefers-reduced-motion: reduce) {
    .orb-heading {
      transition: none;
    }
  }
</style>
