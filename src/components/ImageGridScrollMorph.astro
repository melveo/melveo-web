      </div>

      <!-- Scaler: starts viewport-sized, shrinks into the centre cell -->
      <div class="scaler">
        <img src="/images/melveo-grid/team-briefing-wide.jpg" alt="" decoding="async" />
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Subgrid trick + sticky content — direct port from the codepen.
    Comments mark anywhere we deviated.
  */

  .image-grid-section {
    /* 620vh desktop runway — 1× viewport pinned + 520vh scroll
       budget. The extra height stretches the scaler's shrink phase
       across more scroll, so the user has to keep scrolling for
       longer to see the morph from full-bleed photo to grid.
       Combined with the `'82% end'` scroll offset (animation
       completes at 82 % of section), this leaves the last ~112vh
       as rest where the fully formed grid sits before the next
       section arrives.

       Mobile gets a shorter runway (430vh) because:
         a) Each "vh" on mobile is a smaller absolute pixel count,
            so 620vh of scroll feels endless on a 6.5" screen.
         b) Mobile only has 9 cells visible (3 cols × 3 rows; the
            outer-edge layer is hidden by media query), so there's
            less to "fade in" — animation can finish sooner. */
    position: relative;
    width: 100%;
    min-height: 620vh;
    background: var(--color-bg-canvas);
    border-top: 1px solid var(--color-stroke-base);
    overflow: clip;
  }

  @media (max-width: 768px) {
    .image-grid-section {
      min-height: 430vh;
    }
  }

  /* Smoke canvas — same recipe as the pricing section. Sticks to the
     viewport so it covers the whole sticky-content area instead of
     the 620vh section bounding box (which would force the canvas to
     be enormous and stretch the puffs vertically). The smoke needs
     to live above the section background but below .content. */
  .image-grid-section .glass-smoke {
    position: sticky;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    margin-bottom: -100vh; /* take it out of normal flow so .content sits where it would naturally */
    pointer-events: none;
    z-index: 0;
    filter: saturate(120%) brightness(1.05);
    /* Soft fade at top + bottom so the smoke doesn't hard-cut against
       neighbouring sections. */
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  /* .content needs to sit above the smoke. Sticky positioning on
     siblings doesn't share a stacking context, so we lift it via
     z-index. */
  .image-grid-section .content {
    z-index: 1;
  }

  /* ─── Intro overlay ─────────────────────────────────────────────
     Pinned to the centre of the sticky .content. Stacking inside
     .content (which is z-index 1):
       .grid                  → z-index 1 (default)
       .grid-intro-darken     → z-index 2 (black layer over photo)
       .grid-intro            → z-index 3 (wordmark + pill on top)
     All three faded by Motion across the first 22 % of section scroll. */

  .image-grid-section .grid-intro-darken {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0.72);
    pointer-events: none;
  }

  .image-grid-section .grid-intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    text-align: center;
    pointer-events: none; /* re-enabled on the pill below */
  }

  /* Eyebrow + wordmark cluster — stays vertically centred even when
     the pill moves to the bottom (per user request 2026-05-01:
     "tlačítko scrollovat bych dal jakoby dolů doprostřed"). */
  .image-grid-section .grid-intro__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    max-width: min(92vw, 1400px);
  }

  /*
    Wordmark — half-section size, cyan-gradient fill, soft rounded
    display font. Single span, no glow — per user feedback 2026-05-01
    ("glow bych z tama dal pryč... potřebujeme nějaký lepší font aby
    nebyl takový ostrý, chce to takové jemně zaoblené hrany").

    Font: Outfit (loaded in BaseLayout, var --font-wordmark). Soft
    geometric sans with rounded terminals — the "m" no longer reads
    as sharp.

    Look: vertical gradient cyan-white → cyan → teal-deep via
    background-clip:text, hairline white text-stroke as a subtle
    rim etch, single dark drop-shadow ONLY (for legibility on the
    photo); no cyan halo / blur halo behind.

    Always lowercase via text-transform as a guard plus the
    lowercase string in the markup.
  */
  .image-grid-section .grid-intro__wordmark {
    position: relative;
    display: block;
    margin: 0;
    font-family: var(--font-wordmark);
    font-weight: 800;
    /* Half-the-section size per user request ("hodně větší, klidně
       přes půl sekce"). 30vw lands the lowercase glyphs at ~50 % of
       viewport height on most ratios. */
    font-size: clamp(7rem, 30vw, 24rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: lowercase;
    /* Vertical gradient: brighter cyan-white at top, deeper cyan at
       middle, dim teal at bottom — reads as a curved glass surface
       catching light without needing a glow halo. */
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.9) 0%,
      var(--color-accent-primary-subtle) 22%,
      var(--color-accent-primary) 55%,
      color-mix(in srgb, var(--color-accent-primary) 65%, var(--color-bg-canvas)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 0.5px rgba(255, 255, 255, 0.18);
    /* Single dark drop-shadow only — gives the wordmark separation
       from the photo without re-introducing the cyan halo. */
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.55));
  }

  /* Scroll-hint pill anchored to the bottom-centre of the overlay
     (was below the wordmark — moved per user request 2026-05-01).
     Pointer-events re-enabled here only; the rest of .grid-intro
     ignores clicks so the user can keep scrolling through it. */
  .image-grid-section .grid-intro__pill {
    position: absolute;
    bottom: clamp(2rem, 7vh, 5rem);
    left: 50%;
    transform: translateX(-50%);
    pointer-events: auto;
    padding-inline: 1.75rem;
    border: none;
    cursor: pointer;
    font: inherit;
  }

  .image-grid-section .grid-intro__chevron {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: var(--color-accent-primary);
    /* Bobbing animation hints "scroll downward" without copy. The
       motion is small (3 px) and slow (1.4 s) so it reads as a
       subtle nudge, not a distraction. */
    animation: grid-intro-chevron-bob 1.4s ease-in-out infinite;
  }

  @keyframes grid-intro-chevron-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-grid-section .grid-intro__chevron {
      animation: none;
    }
  }

  .image-grid-section .content {
    min-height: 100vh;
    width: 100vw;
    position: sticky;
    top: 0;
    overflow: hidden;
    display: flex;
    place-items: center;
    align-content: center;
  }

  .image-grid-section .grid {
    --offset: 0;
    --container-width: 1600px;
    --gap: clamp(10px, 7.35vw, 80px);
    --gutter: 2rem;

    width: var(--container-width);
    max-width: calc(100% - (2 * var(--gutter)));
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(3, auto);
    gap: var(--gap);
    margin: 0 auto;
    align-content: center;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  @media (max-width: 600px) {
    .image-grid-section .grid {
      --gutter: 1rem;
      grid-template-columns: repeat(3, 1fr);
      --offset: -1;
    }
    /* Hide outer edges on mobile (3-col layout has no room for them) */
    .image-grid-section .grid > .layer:nth-of-type(1) {
      display: none;
    }
  }

  /* Layers spread across the full 5×3 (or 3×3 mobile) grid via subgrid */
  .image-grid-section .grid > .layer {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }

  /* Layer 1: outer edges — odd children → col 1, even → col -2 */
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-of-type(odd) {
    grid-column: 1;
  }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-of-type(even) {
    grid-column: -2;
  }

  /* Layer 2: inner columns — odd → col 2, even → col -3
     (offset shifts by -1 on mobile so col indexing collapses cleanly) */
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-of-type(odd) {
    grid-column: calc(2 + var(--offset));
  }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-of-type(even) {
    grid-column: calc(-3 - var(--offset));
  }

  /* Layer 3: center column top + bottom rows */
  .image-grid-section .grid > .layer:nth-of-type(3) > div:first-of-type {
    grid-column: calc(3 + var(--offset));
    grid-row: 1;
  }
  .image-grid-section .grid > .layer:nth-of-type(3) > div:last-of-type {
    grid-column: calc(3 + var(--offset));
    grid-row: -1;
  }

  /* Both photos and tech cards are now .glass-card hosts → identical
     recipe (4 layers + dual drop shadow + specular rim). The radius
     is inherited from .glass-card (1.75 rem, same as pricing cards)
     per user request 2026-05-01: "úplně stejně jako v pricingu".
     The cell-fitting rules just give them their grid aspect ratio.

     NB: do NOT override `display` here. The global .glass-card rule
     sets `display: flex; flex-direction: column` so .glass-content
     (flex: 1) can fill the card and centre its children. An earlier
     `display: block` here clobbered that and pinned the icon+title
     to the top of the card (user feedback 2026-05-01: "není to na
     středu"). */
  .image-grid-section .grid-photo,
  .image-grid-section .tech-card {
    width: 100%;
    aspect-ratio: 4 / 5;
  }

  /* Glass cards in the grid don't lift on hover — they live inside
     the scroll-driven scale + opacity animation, so individual hover
     fires inconsistently and the lift conflicts with Motion's transform
     keyframes. Override the global .glass-card:hover to a no-op. */
  .image-grid-section .grid-photo.glass-card:hover,
  .image-grid-section .tech-card.glass-card:hover {
    transform: none;
  }

  /* Photo content is the <img> filling the .glass-content. Inherit
     border-radius so the image clips exactly to the card rim, and
     the .glass-content has no padding (photo is the frame). */
  .image-grid-section .grid-photo .glass-content {
    padding: 0;
    overflow: hidden;
    border-radius: inherit;
  }
  .image-grid-section .grid-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Tech card content layout — icon-first. The icon is the focal
     element (no chip/frame around it); the heading sits below as a
     bold display label. Body copy was dropped per user request — the
     card reads as a feature glyph instead of a paragraph. */
  .image-grid-section .tech-card .glass-content {
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: clamp(1.1rem, 1.8vw, 1.6rem);
    padding: clamp(1.25rem, 2vw, 1.85rem);
  }

  /* Soft cyan radial behind the icon area — emulates the icon "emitting
     light into the glass". Sits inside the .glass-content stacking
     context (z:3 on the parent), with z-index:0 so the icon + heading
     (default static) draw on top. Anchored to the upper third where
     the icon naturally lands. */
  .image-grid-section .tech-card .glass-content::before {
    content: '';
    position: absolute;
    top: 8%;
    left: 50%;
    width: 85%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    background: radial-gradient(
      circle,
      rgba(0, 240, 255, 0.22) 0%,
      rgba(0, 240, 255, 0.08) 35%,
      transparent 65%
    );
    filter: blur(14px);
    pointer-events: none;
    z-index: 0;
  }

  /*
    Icon — standalone, no chip/frame around it. Sits as the focal
    element of the card (per user feedback 2026-05-01: the small
    chip felt boxy, the icon should breathe). Heavy multi-layer glow
    chain so it reads as cyan emission — paired with the radial
    behind it (.glass-content::before) for a "glass lit from within"
    feel.
  */
  .image-grid-section .tech-card__icon {
    position: relative;
    z-index: 1;
    width: clamp(3.6rem, 6.2vw, 5.6rem);
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--color-accent-primary);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--color-accent-primary);
    /* Layered glow: tight inner halo (close cyan), broad outer halo
       (atmospheric cyan), and a dark drop-shadow for separation
       against the bright cyan radial behind. */
    filter:
      drop-shadow(0 0 4px rgba(0, 240, 255, 0.6))
      drop-shadow(0 0 14px rgba(0, 240, 255, 0.42))
      drop-shadow(0 0 28px rgba(0, 240, 255, 0.22))
      drop-shadow(0 6px 14px rgba(0, 0, 0, 0.35));
  }

  /* Filled icon (stats bars) — same stroke for any outline paths
     plus a fill on the rects. Defined per-icon by adding the
     --filled modifier on the <svg>. */
  .image-grid-section .tech-card__icon--filled rect {
    fill: var(--color-accent-primary);
    stroke: none;
  }

  /* Subtle cyan-tinted body for the lock so it doesn't look hollow */
  .image-grid-section .security-lock__body {
    fill: rgba(0, 240, 255, 0.1);
  }

  .image-grid-section .security-lock__pin {
    fill: var(--color-accent-primary);
    stroke: none;
  }

  /* Heading — display weight, tight tracking, soft cyan tint to echo
     the icon glow without overpowering it. The card now reads as
     icon → label, no body copy. */
  .image-grid-section .tech-card h3 {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.1vw, 1.95rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    text-align: center;
    color: var(--color-text-primary);
    text-shadow: 0 1px 12px rgba(0, 240, 255, 0.18);
  }

  @media (max-width: 640px) {
    /* On mobile cells are ~ 1/3 viewport wide, so 1.75 rem (28 px)
       reads as too round. Drop both photo + tech cards to 1.25 rem
       (still glassy, fits the smaller cell). */
    .image-grid-section .grid-photo,
    .image-grid-section .tech-card {
      border-radius: 1.25rem;
    }

    .image-grid-section .tech-card .glass-content {
      padding: 0.7rem;
      gap: 0.6rem;
    }

    .image-grid-section .tech-card__icon {
      width: clamp(2.6rem, 13vw, 3.6rem);
    }

    .image-grid-section .tech-card h3 {
      font-size: clamp(0.85rem, 4.8vw, 1.2rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }
  }

  /* Scaler container occupies the centre cell of the grid; its <img>
     is absolutely positioned so we can animate width/height in pixels
     while keeping the image perfectly centred. */
  .image-grid-section .grid .scaler {
    position: relative;
    grid-area: 2 / calc(3 + var(--offset));
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  .image-grid-section .scaler img {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    object-fit: cover;
    /* Match the .glass-card radius so the scaler photo lands cleanly
       into the grid frame at the end of the morph. */
    border-radius: 1.75rem;
    width: 100%;
    height: 100%;
    /*
      CRITICAL: Tailwind preflight applies `img { max-width: 100% }`
      which would clamp the scaler to its grid-cell parent (~256px)
      even when JS sets inline width: 1700px. The animation looked
      like only height was working — width inline was being silently
      capped. Explicit override here lets the JS-driven pixel sizing
      run free across the whole viewport.
    */
    max-width: none;
    max-height: none;
  }

  /* Reduced-motion: drop the sticky/scroll dance. Show every cell in
     its final position, statically. */
  @media (prefers-reduced-motion: reduce) {
    .image-grid-section {
      min-height: auto;
    }
    .image-grid-section .content {
      position: relative;
      min-height: 80vh;
    }
    .image-grid-section .grid {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
    }
  }
</style>

<script>
  import { animate, scroll } from 'motion';
  import { mountGlassSmoke } from '../scripts/glass-smoke';

  // Smoke field behind the grid — defer to idle so the scroll/Motion
  // setup below runs first. mountGlassSmoke scans for [data-glass-smoke]
  // sections so the same call also re-attaches new sections if the page
  // adds them later.
  function startSmoke() {
    mountGlassSmoke();
  }
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(startSmoke, { timeout: 1500 });
  } else {
    setTimeout(startSmoke, 250);
  }

  /*
    Motion v12 keyframe-timing API note:
      - For keyframe positions within an animate() call use `times: [...]`,
        NOT `offset: [...]` (offset is reserved for scroll() target config).
      - Easing key is `ease`, NOT `easing` (Motion v11 used `easing`; the
        codepen we're porting from uses v11).
    Earlier versions of this file used the v11 names which Motion v12
    silently ignored, so the hold-pattern keyframes were treated as
    equally spaced and the per-axis easings dropped to defaults — that's
    why the scaler appeared to shrink immediately on scroll instead of
    holding at viewport size.
  */

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const section = document.querySelector<HTMLElement>('[data-grid-section]');
    const image = section?.querySelector<HTMLImageElement>('.scaler img');
    const layers = section?.querySelectorAll<HTMLElement>('.grid > .layer');

    if (section && image && layers && layers.length > 0) {
      // Wait one frame so layout has settled and we can measure the
      // .scaler container itself — it's `width:100%; height:100%` of
      // its grid cell, so its offsetWidth/Height equal the natural
      // cell dimensions exactly. Earlier versions measured a sibling
      // `.layer img` which could be at scale(0) by the time we ran
      // (Motion's scroll() pre-applies keyframe[0] on registration);
      // that gave wrong fallbacks and the scaler ended up oversized
      // relative to its neighbours.
      requestAnimationFrame(() => {
        const scalerEl = section.querySelector<HTMLElement>('.scaler');
        const naturalWidth = scalerEl?.offsetWidth ?? 280;
        const naturalHeight = scalerEl?.offsetHeight ?? 350;

        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;

        // Cubic-bezier control points. Names match GSAP power easings
        // referenced by the codepen.
        const power1InOut = [0.42, 0, 0.58, 1] as const;
        const power2InOut = [0.65, 0, 0.35, 1] as const;
        const power3InOut = [0.76, 0, 0.24, 1] as const;
        const power4InOut = [0.87, 0, 0.13, 1] as const;
        const sineOut = [0.61, 1, 0.88, 1] as const;
        const scrollCompletionRatio = 0.82;

        // ─── Scaler: hold at viewport, then shrink to natural ──────────
        //     Width AND height in a SINGLE animate() call. Splitting
        //     them into two scroll(animate()) registrations on the same
        //     element broke things — Motion v12 treats the second call
        //     as a takeover and cancels the first, which is why width
        //     stayed at its CSS default while height morphed to viewport.
        //     Using one combined call with shared options preserves
        //     both axes; we sacrifice the codepen's per-axis asymmetric
        //     easing (power2 width vs power1 height) for correctness.
        //     The asymmetry is recovered visually anyway because the
        //     start delta differs between width and height.
        scroll(
          animate(
            image,
            {
              width: [
                `${viewportWidth}px`,
                `${viewportWidth}px`,
                `${naturalWidth}px`,
              ],
              height: [
                `${viewportHeight}px`,
                `${viewportHeight}px`,
                `${naturalHeight}px`,
              ],
            },
            {
              times: [0, 0.18, 1],
              ease: power2InOut as any,
            },
          ),
          {
            target: section,
            // Animation completes at 82 % of section's scroll travel,
            // leaving the last 18 % as a "rest" runway where the fully
            // formed grid sits at its final state before the next
            // section arrives. Scaler + every layer end inside this
            // 0–82 % window so the grid is visually frozen for the
            // whole rest period.
            offset: ['start start', `${scrollCompletionRatio * 100}% end`] as any,
          },
        );

        // ─── Each layer: opacity (hold→fade) + scale (hold→reveal) ─────
        const scaleEasings = [power1InOut, power3InOut, power4InOut];

        layers.forEach((layer, index) => {
          // Endpoint shifts per layer for a subtle cascade. All layers
          // finish BEFORE the scaler's end (82 %) so the grid is fully
          // formed when the rest period begins. Outer edges (index 0)
          // end last; inner-most cells (index 2) finish earliest, same
          // ordering as codepen but compressed before the rest zone.
          const endOffset = `${scrollCompletionRatio - index * 0.055} end`;

          // Opacity: invisible until 60 % progress, then fades 0 → 1
          scroll(
            animate(
              layer,
              { opacity: [0, 0, 1] },
              {
                times: [0, 0.6, 1],
                ease: sineOut as any,
              },
            ),
            {
              target: section,
              offset: ['start start', endOffset] as any,
            },
          );

          // Scale: held at 0 until 36 % progress, then springs to 1
          scroll(
            animate(
              layer,
              { scale: [0, 0, 1] },
              {
                times: [0, 0.36, 1],
                ease: scaleEasings[index] as any,
              },
            ),
            {
              target: section,
              offset: ['start start', endOffset] as any,
            },
          );
        });

        // ─── Intro overlay: hold full → fade out + drift up ─────────────
        //     Wordmark + scroll-pill stay at full opacity for the first
        //     ~8 % of the overlay's mapped scroll range (a hold pattern,
        //     mirroring the scaler's 18 % hold), then fade + drift up.
        //     Mapped scroll range is just the first 22 % of the section
        //     (offset 'start start' → '22% start'), so the full hold-and-
        //     fade plays inside that window and the overlay is invisible
        //     by the time the grid reveal kicks in.
        //
        //     Earlier version used times [0, 0.08, 0.22] across the full
        //     section scroll. Motion v12 didn't fully apply opacity when
        //     the times array stopped short of 1 — y animated to its
        //     final value but opacity stayed at 1. Standard 0..1 times
        //     plus a tighter scroll() offset works correctly.
        const intro = section.querySelector<HTMLElement>('[data-grid-intro]');
        if (intro) {
          scroll(
            animate(
              intro,
              { opacity: [1, 1, 0] },
              {
                times: [0, 0.36, 1],
                ease: power1InOut as any,
              },
            ),
            {
              target: section,
              offset: ['start start', '22% start'] as any,
            },
          );
          scroll(
            animate(
              intro,
              { y: ['0px', '0px', '-24px'] },
              {
                times: [0, 0.36, 1],
                ease: power1InOut as any,
              },
            ),
            {
              target: section,
              offset: ['start start', '22% start'] as any,
            },
          );
        }

        // ─── Black scroll-reveal: photo "develops in" ──────────────────
        //     The .grid-intro-darken layer sits over the scaler photo
        //     and fades from its initial 0.72 opacity down to 0. We
        //     stretch the fade across 0–28 % of the section (a touch
        //     longer than the wordmark's 22 %) so the photo keeps
        //     brightening for a moment after the wordmark has cleared
        //     — gives the morph a "reveal then shrink" rhythm.
        const darken = section.querySelector<HTMLElement>('[data-grid-intro-darken]');
        if (darken) {
          scroll(
            animate(
              darken,
              { opacity: [1, 0] },
              { ease: power1InOut as any },
            ),
            {
              target: section,
              offset: ['start start', '28% start'] as any,
            },
          );
        }
      });
    }
  }

  // Click handler for the scroll-hint pill — smooth-scroll past the
  // section so the user immediately sees the grid morph kick in.
  // Wired regardless of reduceMotion (the button is also a UX hint
  // about scroll direction, not just decorative).
  const introBtn = document.querySelector<HTMLButtonElement>('[data-grid-intro-scroll]');
  const sectionForBtn = document.querySelector<HTMLElement>('[data-grid-section]');
  if (introBtn && sectionForBtn) {
    introBtn.addEventListener('click', () => {
      // Scroll one viewport down — far enough that the scaler is well
      // into its shrink phase and the user can see "scrolling does
      // something". Don't jump to end-of-section: the user came here
      // to see the morph, not skip it.
      const targetY =
        sectionForBtn.getBoundingClientRect().top +
        window.scrollY +
        window.innerHeight * 1.2;
      window.scrollTo({
        top: targetY,
        behavior: 'smooth',
      });
    });
  }
</script>
