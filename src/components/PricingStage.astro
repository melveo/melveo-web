---
/**
 * PricingStage — 4-tier plan cards with monthly/yearly toggle.
 *
 * Visual language matches the hero pill buttons:
 *   - rounded-pill toggle with cyan glow
 *   - glass-blur ghost cards (translucent + backdrop-filter + cyan stroke)
 *   - one "popular" card filled with the brand cyan
 *   - cyan accents on prices, features bullets, CTAs
 *
 * Monthly/yearly switch is CSS-driven: both prices are rendered, the
 * inactive one is hidden via `[data-period]` on the section root.
 * Toggle button just flips the data-attribute (one rAF, no reflow
 * cascade beyond the cards).
 *
 * Full periodicity amount is featured big — monthly amount + "/měsíc"
 * suffix on the monthly card, yearly amount + "/rok" on the yearly card.
 * Previous iteration emphasised the daily price ("X Kč/den") with the
 * monthly as secondary text, but clubs budget in months/years anyway
 * (user feedback 2026-05-15). Effective monthly-equivalent is still
 * shown as small secondary text on the yearly card so the savings
 * vs the monthly plan are visible.
 *
 * Pricing source: project_pilot_pricing memory + planning docs
 * 02_pricing_strategy + 15_billing_and_licensed_scopes (provided
 * by user 2026-04-30).
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Plan {
  id: string;
  name: string;
  badge: string | null;
  popular: boolean;
  free: boolean;
  /** Czech-format monthly price — already grouped with non-breaking spaces. */
  priceMonthly: number;
  priceYearly: number;
  perDayMonthly: number; // monthly price ÷ 30
  perDayYearly: number; // yearly price ÷ 365
  perMonthFromYearly: number; // yearly price ÷ 12 (the effective monthly when paying yearly)
  limits: { players: number; staff: number };
  features: string[];
  ctaLabel: string;
  ctaHref: string;
}

const ctaLabelPilot = t('pricing.ctaPilot');
const ctaLabelFree = t('pricing.ctaFree');

const featuresFreeCs = [
  'Ranní wellness za 30 sekund',
  'Plánování sessions',
  'Docházka + post-session RPE',
  'Základní coach board (today)',
  'Test s menší skupinou do 8 hráčů',
];
const featuresFreeEn = [
  'Morning wellness in 30 seconds',
  'Session planning',
  'Attendance + post-session RPE',
  'Basic coach board (today)',
  'Small-group test with up to 8 players',
];

/*
  2026-08-06: Core / Live / Intelligence collapsed into a single paid plan
  at the former Intelligence price (owner decision). The three feature
  lists are merged here, deduplicated, with the "Vše z …" cross-references
  dropped — they only made sense while the tiers stacked on each other.
  Ordered everyday-first, so the reader meets what they will use daily
  before the analytics and onboarding lines.
*/
const featuresTeamCs = [
  'Vše z Free Starter',
  'Plný coach board s historií',
  'Agregovaná readiness týmu',
  'Role-based týmový kontext',
  'Coach Board Live',
  'Realtime sledování zátěže',
  'Vedení zápasu s živými tepy',
  'Pokročilá analytika a periodizace',
  'PDF / CSV exporty a vlastní reporty',
  'Onboarding s konzultantem a prioritní podpora',
];
const featuresTeamEn = [
  'Everything in Free Starter',
  'Full coach board with history',
  'Aggregate team readiness',
  'Role-based team context',
  'Coach Board Live',
  'Realtime load tracking',
  'Live match logging with heart rates',
  'Advanced analytics + periodisation',
  'PDF / CSV exports and custom reports',
  'Onboarding with a consultant and priority support',
];

const mailto = (subject: string) =>
  `mailto:hello@melveo.app?subject=${encodeURIComponent(subject)}`;

const plans: Plan[] = [
  {
    id: 'free',
    name: 'Free Starter',
    badge: null,
    popular: false,
    free: true,
    priceMonthly: 0,
    priceYearly: 0,
    perDayMonthly: 0,
    perDayYearly: 0,
    perMonthFromYearly: 0,
    limits: { players: 8, staff: 2 },
    features: lang === 'cs' ? featuresFreeCs : featuresFreeEn,
    ctaLabel: ctaLabelFree,
    ctaHref: '#contact',
  },
  {
    id: 'team',
    name: 'Melveo Team',
    badge: null,
    // The only paid card now, so it carries the filled brand-cyan treatment.
    popular: true,
    free: false,
    priceMonthly: 4990,
    priceYearly: 49900,
    perDayMonthly: 166,
    perDayYearly: 137,
    perMonthFromYearly: 4158,
    limits: { players: 24, staff: 8 },
    features: lang === 'cs' ? featuresTeamCs : featuresTeamEn,
    ctaLabel: ctaLabelPilot,
    ctaHref: mailto(lang === 'cs' ? 'Zájem o Melveo Team' : 'Melveo Team enquiry'),
  },
];

/** Format an integer with non-breaking thin spaces between thousands. */
function fmt(n: number): string {
  return n.toLocaleString('cs-CZ').replace(/ /g, ' ');
}

const limitsLabel = lang === 'cs' ? 'hráčů' : 'players';
const staffLabel = lang === 'cs' ? 'staff' : 'staff';
const currencyShort = lang === 'cs' ? 'Kč' : 'CZK';
---

<section
  id="pricing"
  class="pricing-stage"
  data-pricing-section
  data-glass-smoke
  data-period="yearly"
  aria-label={t('pricing.eyebrow')}
>
  {/*
    Cyan smoke field behind the pricing cards. The 4-layer glass-card
    recipe relies on having something colourful behind it to refract —
    on flat black canvas the displacement filter has nothing to bend.
    This canvas drops a slow drifting cyan fog (teolitto codepen
    KwOVvL pattern) so the cards finally read as real liquid glass.
    Mounted client-side from glass-smoke.ts via the [data-glass-smoke]
    attribute on the section.
  */}
  <canvas class="glass-smoke" data-glass-smoke-canvas aria-hidden="true"></canvas>

  <div class="pricing-inner">
    <header class="pricing-header">
      <h2 class="pricing-headline">
        {t('pricing.headline')}<br />
        <span class="pricing-headline-accent">{t('pricing.headlineAccent')}</span>
      </h2>
      <p class="pricing-subline">{t('pricing.subline')}</p>
      {/*
        No VAT note on purpose (owner decision 2026-06-10): the company
        is currently not VAT-registered so prices are simply final, and
        we don't surface tax wording on the landing at all. If that ever
        changes, `pricing.vatNote` in ui.ts still holds the prepared
        strings — render it here as
        `<p class="pricing-vat-note">{t('pricing.vatNote')}</p>` and
        compute actual VAT in checkout (Stripe Tax / MoR), never as a
        price toggle (correct rate depends on buyer country + VAT ID).
      */}

      {/*
        Twin-pill toggle — each button is its own glass pill that flips
        between the hero ghost-pill style (inactive) and the hero
        filled-cyan style (active). No sliding thumb to mis-align with
        unequal button widths (the −17 % badge made "Ročně" wider than
        "Měsíčně", and a 50 %-width thumb clipped the wider label).
      */}
      <div class="pricing-toggle" role="tablist" aria-label="Billing period">
        <span class="pricing-toggle-thumb" aria-hidden="true"></span>
        <button
          type="button"
          role="tab"
          data-period-set="monthly"
          aria-selected="false"
          class="pricing-toggle-btn"
        >
          {t('pricing.toggleMonthly')}
        </button>
        <button
          type="button"
          role="tab"
          data-period-set="yearly"
          aria-selected="true"
          class="pricing-toggle-btn pricing-toggle-btn--active"
        >
          <span class="pricing-toggle-label">{t('pricing.toggleYearly')}</span>
          <span class="pricing-toggle-savings">{t('pricing.toggleSavings')}</span>
        </button>
      </div>
    </header>

    {/* Global #glass-lens displacement filter is mounted in BaseLayout
        (single instance, used by every .glass-card across the page). */}

    <ul class="pricing-cards">
      {
        plans.map((plan) => (
          <li
            class:list={[
              'pricing-card glass-card',
              plan.free && 'pricing-card--free',
            ]}
            data-plan-id={plan.id}
          >
            {/*
              4-layer liquid-glass stack (wprod codepen recipe, dark-theme
              adapted):
                glass-filter   — backdrop-blur + url(#pricing-lens)
                                 displacement, refracts what's behind
                glass-overlay  — a translucent tint on top of the filter
                glass-specular — inset highlights for the rim "shine"
                glass-content  — the actual card body (header, price, CTA…)
              All four layers absolute-positioned and stacked via z-index;
              .glass-content is the only one that takes flow space.
            */}
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">

            <header class="pricing-card-header">
              <h3 class="pricing-card-name">{plan.name}</h3>
              <p class="pricing-card-limits">
                <strong>{plan.limits.players}</strong> {limitsLabel}{' '}
                <span class="pricing-dot">·</span>{' '}
                <strong>{plan.limits.staff}</strong> {staffLabel}
              </p>
            </header>

            {/*
              Pricing display — full periodicity amount, no per-day.
              Earlier iteration featured the daily price big with the
              monthly amount as secondary text, but clubs budget in
              monthly/yearly terms anyway and the daily framing felt
              misleading (user feedback 2026-05-15: "dejme tam roční
              a měsíční ceny, nikoliv denní").

              Monthly card: 1 790 Kč / měsíc · Účtováno měsíčně
              Yearly card:  17 900 Kč / rok · ~ 1 492 Kč / měsíc

              Same `pricing-price-day` class name kept so the
              :nth-child sizing rules still apply — it's a styling
              hook now, not a literal "per-day" label.
            */}
            <div class="pricing-card-price">
              {plan.free ? (
                <div class="pricing-price-block pricing-price-block--free">
                  <span class="pricing-price-day">{t('pricing.free')}</span>
                </div>
              ) : (
                <Fragment>
                  {/* MONTHLY view — visible when [data-period="monthly"] */}
                  <div class="pricing-price-block pricing-price-block--monthly">
                    <span class="pricing-price-day">
                      <span class="pricing-amount" data-amount={plan.priceMonthly}>{fmt(plan.priceMonthly)}</span>&nbsp;<span class="pricing-currency">{currencyShort}</span>
                    </span>
                    <span class="pricing-price-suffix">{t('pricing.perMonth')}</span>
                    <span class="pricing-price-secondary">
                      {t('pricing.billedMonthly')}
                    </span>
                  </div>

                  {/* YEARLY view — visible when [data-period="yearly"] (default) */}
                  <div class="pricing-price-block pricing-price-block--yearly">
                    <span class="pricing-price-day">
                      <span class="pricing-amount" data-amount={plan.priceYearly}>{fmt(plan.priceYearly)}</span>&nbsp;<span class="pricing-currency">{currencyShort}</span>
                    </span>
                    <span class="pricing-price-suffix">{t('pricing.perYear')}</span>
                    <span class="pricing-price-secondary">
                      ~ {fmt(plan.perMonthFromYearly)}&nbsp;{currencyShort}{' '}
                      {t('pricing.perMonth')} · {t('pricing.billedYearly')}
                    </span>
                  </div>
                </Fragment>
              )}
            </div>

            {/* Pricing plan CTA — literally the hero-pill from the
                landing hero (App Store / Pilot buttons). Same class,
                same internal structure (shimmer + content layers).
                The pointer-tracking handler in Landing.astro's
                mountHeroButtons() picks these up for free because it
                queries .hero-pill across the whole document. */}
            <a class="hero-pill pricing-card-cta" href={plan.ctaHref}>
              <span class="hero-pill-shimmer" aria-hidden="true"></span>
              <span class="hero-pill-content">{plan.ctaLabel}</span>
            </a>

            <ul class="pricing-card-features">
              {plan.features.map((feat) => (
                <li>
                  <svg
                    class="pricing-tick"
                    viewBox="0 0 16 16"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M3.5 8.5l3 3 6-7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
            </div>{/* /.glass-content */}
          </li>
        ))
      }
    </ul>

    <div class="pricing-extras">
      <article class="pricing-extra glass-card glass-card--compact">
        <span class="glass-filter" aria-hidden="true" />
        <span class="glass-overlay" aria-hidden="true" />
        <span class="glass-specular" aria-hidden="true" />
        <div class="glass-content">
          <h4>{t('pricing.athleteHeading')}</h4>
          <p>{t('pricing.athleteBody')}</p>
        </div>
      </article>
      <article class="pricing-extra glass-card glass-card--compact">
        <span class="glass-filter" aria-hidden="true" />
        <span class="glass-overlay" aria-hidden="true" />
        <span class="glass-specular" aria-hidden="true" />
        <div class="glass-content">
          <h4>{t('pricing.clubHeading')}</h4>
          <p>{t('pricing.clubBody')}</p>
        </div>
      </article>
    </div>

    <p class="pricing-disclaimer">{t('pricing.disclaimer')}</p>
  </div>
</section>

<script>
  import { mountPricingToggle } from '../scripts/pricing-toggle';
  mountPricingToggle();

  // Smoke is decorative; keep its canvas module out of the initial hero
  // load and start it only when pricing is getting close.
  async function startSmoke() {
    const { mountGlassSmoke } = await import('../scripts/glass-smoke');
    mountGlassSmoke();
  }

  function startSmokeWhenNear() {
    const pricingStage = document.querySelector<HTMLElement>('.pricing-stage');
    if (!pricingStage) return;

    const supportsObserver = 'IntersectionObserver' in globalThis;
    if (!supportsObserver) {
      globalThis.addEventListener('scroll', startSmoke, { once: true, passive: true });
      return;
    }

    const smokeObserver = new window.IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        smokeObserver.disconnect();
        startSmoke();
      },
      { rootMargin: '560px 0px' },
    );
    smokeObserver.observe(pricingStage);
  }
  startSmokeWhenNear();
</script>

<style>
  .pricing-stage {
    position: relative;
    width: 100%;
    /* border-top removed 2026-05-17: no horizontal dividers between sections */
    background: var(--color-bg-canvas);
    padding: clamp(4rem, 9vw, 8rem) clamp(1rem, 4vw, 3rem);
    overflow: hidden;
  }
  .pricing-stage::before {
    /* Subtle radial cyan glow behind the cards — same family as the
       hero halo, tuned dim. Doesn't compete with the headline. Sits
       above the smoke canvas so the brightest cyan stays centred. */
    content: '';
    position: absolute;
    inset: -10% 20% auto 20%;
    height: 60%;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 240, 255, 0.12),
      transparent 70%
    );
    pointer-events: none;
    filter: blur(40px);
    z-index: 1;
  }

  /* Smoke field canvas — full-section, behind everything.
     Positioned absolutely so the section's normal flow ignores it.
     Painted in glass-smoke.ts. */
  .glass-smoke {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    /* Slight extra saturation/contrast on the canvas itself helps the
       cyan smoke read against the dark canvas without us needing to
       crank per-puff alpha. */
    filter: saturate(120%) brightness(1.05);
    /* Soft fade at top + bottom so the smoke doesn't hard-cut against
       the previous/next stage borders. */
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  .pricing-inner {
    position: relative;
    margin: 0 auto;
    max-width: 84rem;
    z-index: 2;
  }

  /* ─── Header ─────────────────────────────────────────────────── */

  .pricing-header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .pricing-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
  }

  .pricing-headline {
    margin: 0;
    max-width: min(100%, 56rem);
    margin-inline: auto;
    padding-inline: 1rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    font-size: clamp(2rem, 4.6vw, 4rem);
    text-wrap: balance;
  }
  .pricing-headline-accent {
    color: var(--color-accent-primary);
  }

  .pricing-subline {
    margin: 1.25rem auto 0;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  @media (min-width: 640px) {
    .pricing-subline {
      font-size: 1.125rem;
    }
  }

  /* Tax footnote — quieter than the subline so it reads as legal
     fine print, not as a second selling line. */
  .pricing-vat-note {
    margin: 0.5rem auto 0;
    max-width: 38rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    opacity: 0.72;
    text-wrap: pretty;
  }

  /* ─── Twin-pill toggle ─────────────────────────────────────────
     Each button is its own glass pill. Active state inherits the
     hero-pill--filled cyan look; inactive inherits hero-pill--ghost.
     No sliding thumb so unequal button widths (the −17 % badge makes
     "Ročně" wider than "Měsíčně") can't clip the active label. */

  .pricing-toggle {
    --toggle-x: 5px;
    --toggle-w: 0px;
    position: relative;
    display: inline-flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 5px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.025);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 8px 28px -14px rgba(0, 0, 0, 0.5);
  }

  .pricing-toggle-thumb {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: var(--toggle-w);
    border-radius: 9999px;
    background: var(--color-accent-primary);
    border: 1px solid rgba(0, 240, 255, 0.62);
    box-shadow:
      0 10px 30px -12px rgba(0, 240, 255, 0.62),
      0 0 0 1px rgba(0, 240, 255, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.36);
    transform: translateX(var(--toggle-x));
    transition:
      transform 0.48s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.48s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
    pointer-events: none;
    z-index: 0;
  }

  .pricing-toggle-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    /* Min 44 px tap target for phone — was 41 px (audit 2026-05-01). */
    min-height: 44px;
    gap: 0.45rem;
    padding: 0.65rem 1.15rem;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }
  .pricing-toggle-btn:hover {
    color: var(--color-text-primary);
    background: rgba(0, 240, 255, 0.06);
  }

  /* Active = filled cyan (matches .hero-pill--filled) */
  .pricing-toggle-btn--active,
  .pricing-toggle-btn[aria-selected='true'] {
    background: var(--color-accent-primary);
    color: var(--color-accent-primary-cta-fg);
    border-color: rgba(0, 240, 255, 0.6);
    box-shadow:
      0 8px 26px -10px rgba(0, 240, 255, 0.5),
      0 0 0 1px rgba(0, 240, 255, 0.35);
  }
  .pricing-toggle-btn--active:hover,
  .pricing-toggle-btn[aria-selected='true']:hover {
    background: var(--color-accent-primary-hover);
    color: var(--color-accent-primary-cta-fg);
  }

  .pricing-toggle--ready .pricing-toggle-btn--active,
  .pricing-toggle--ready .pricing-toggle-btn[aria-selected='true'] {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .pricing-toggle--ready .pricing-toggle-btn--active:hover,
  .pricing-toggle--ready .pricing-toggle-btn[aria-selected='true']:hover {
    background: transparent;
  }

  .pricing-toggle-label {
    font-size: inherit;
  }

  .pricing-toggle-savings {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(0, 240, 255, 0.18);
    color: var(--color-accent-primary);
  }
  /* On the active (filled) variant the badge needs darker fill so
     it's still readable on the cyan button. */
  .pricing-toggle-btn--active .pricing-toggle-savings,
  .pricing-toggle-btn[aria-selected='true'] .pricing-toggle-savings {
    background: rgba(0, 16, 20, 0.18);
    color: var(--color-accent-primary-cta-fg);
  }

  /* One-shot pop when the user switches TO yearly — the saving is the
     selling point of that click, so it celebrates briefly. Class is
     added in pricing-toggle.ts and removed on animationend; never
     plays for reduced-motion users (JS gate). */
  .pricing-toggle-savings.is-pop {
    animation: pricing-badge-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes pricing-badge-pop {
    0% { transform: scale(1); }
    35% { transform: scale(1.28); }
    100% { transform: scale(1); }
  }

  /* ─── Cards grid ─────────────────────────────────────────────── */

  .pricing-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .pricing-cards {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 1100px) {
    .pricing-cards {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      align-items: stretch;
    }
  }

  /* Pricing card uses the global .glass-card recipe (all 4 layers +
     hover defined in src/styles/global.css). The component-local rule
     here only contributes pricing-specific padding inside .glass-content. */
  .pricing-card .glass-content {
    padding: 1.75rem 1.5rem 1.5rem;
  }

  /*
    Spotlight border (2026-06-10) — a cyan ring segment that follows the
    cursor across each card. Implemented as a masked overlay: the radial
    gradient is centred on --mx/--my (set rAF-batched in
    pricing-toggle.ts) and the mask keeps only a 1.5px border band, so
    it reads as the card edge lighting up near the pointer. Hidden until
    the section is hovered; costs one composited layer per card, nothing
    on coarse-pointer devices (JS never sets the vars there).
  */
  .pricing-card {
    position: relative;
  }
  .pricing-card::after {
