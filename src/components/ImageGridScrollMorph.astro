<style>
  /*
    Subgrid trick + sticky content — direct port from the codepen.
    Comments mark anywhere we deviated.
  */

  .image-grid-section {
    /*
      Runway: 230vh desktop / 190vh mobile = 1 viewport pinned +
      a compact scroll budget. Shortened 2026-05-15 after visual
      review: the image already settled into the centre hex, but
      the sticky section still had a long inert tail before the
      Data → Feedback section arrived. Keep enough runway for the
      full-bleed photo → honeycomb transformation, but remove the
      dead scroll pause after the honeycomb is assembled.
    */
    position: relative;
    width: 100%;
    min-height: 215vh;
    background: var(--color-bg-canvas);
    border-top: 1px solid var(--color-stroke-base);
    overflow: clip;
  }

  @media (max-width: 1024px) {
    .image-grid-section {
      min-height: 175vh;
    }
  }

  /* Smoke canvas — same recipe as the pricing section. Sticks to the
     viewport so it covers the whole sticky-content area instead of
     the 620vh section bounding box (which would force the canvas to
     be enormous and stretch the puffs vertically). The smoke needs
     to live above the section background but below .content. */
  .image-grid-section .glass-smoke {
    position: sticky;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    margin-bottom: -100vh;
    pointer-events: none;
    z-index: 0;
    filter: saturate(120%) brightness(1.05);
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  /* .content needs to sit above the smoke. Sticky positioning on
     siblings doesn't share a stacking context, so we lift it via
     z-index. */
  .image-grid-section .content {
    z-index: 1;
  }

  /* ─── Intro overlay ─────────────────────────────────────────────
     Pinned to the centre of the sticky .content. Stacking inside
     .content (which is z-index 1):
       .grid                  → z-index 1 (default)
       .grid-intro-darken     → z-index 2 (black layer over photo)
       .grid-intro            → z-index 3 (wordmark + pill on top)
     All three faded by Motion across the first 22 % of section scroll. */

  .image-grid-section .grid-intro-darken {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0.72);
    pointer-events: none;
  }

  .image-grid-section .grid-intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    text-align: center;
    pointer-events: none; /* re-enabled on the pill below */
  }

  /* Eyebrow + wordmark cluster — stays vertically centred even when
     the pill moves to the bottom (per user request 2026-05-01:
     "tlačítko scrollovat bych dal jakoby dolů doprostřed"). */
  .image-grid-section .grid-intro__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    max-width: min(92vw, 1400px);
  }

  /*
    Wordmark — half-section size, solid brand cyan, soft round font,
    subtle glass treatment. Per user feedback 2026-05-01:
      - "celý bez gradientu v naší primární barvě" → solid cyan,
        no background-clip:text gradient
      - "trošku glass efektu" → keep just enough specular touch to
        read as glass (no halo, no glow)
      - Font: Open Sans for the rounded "m"

    Glass effect comes from layered text-shadows:
      - 1 px white inset on top → reads as light catching the top
        rim of curved glass
      - 1 px dark inset on bottom → reads as the bottom shadow of
        the glass relief
      - Hairline white text-stroke on the rim
    No cyan glow / halo — explicitly removed.

    Single dark drop-shadow on filter for legibility against the
    photo (the photo behind starts at 28 % brightness, fully
    revealed by the time the wordmark is gone).

    Always lowercase via text-transform as a guard plus the
    lowercase string in the markup.
  */
  .image-grid-section .grid-intro__wordmark {
    position: relative;
    display: block;
    max-width: 92vw;
    margin: 0;
    font-family: var(--font-wordmark);
    font-weight: 700;
    /* Half-the-section size on desktop ("hodně větší, klidně přes půl
       sekce"). On phones the 30 vw multiplier was rendering the
       lowercase "melveo" wider than the screen — the 2.5 px text-stroke
       extends every glyph and the bold weight is wide. Tighter mobile
       cap so it stays within the safe inset. */
    font-size: clamp(4rem, 22vw, 26rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    color: var(--color-accent-primary);
    /* Faux extra-bold via cyan-on-cyan text-stroke (Quicksand caps at
       700 on Google Fonts; user 2026-05-01 asked for chunkier glyphs).
       Stroke extends ~half its width outside the glyph outline, so a
       2.5 px cyan stroke matched to the fill effectively thickens
       every limb of the 700 weight by ~1.2 px. paint-order keeps the
       stroke under the fill so the inner glyph stays sharp at the
       brand-cyan it should be. */
    -webkit-text-stroke: 2.5px var(--color-accent-primary);
    paint-order: stroke fill;
    /* Glass relief: tiny white catch on the top edge + tiny dark
       on the bottom. Reads as a curved glass face without any halo. */
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.35),
      0 -1px 0 rgba(0, 0, 0, 0.35),
      0 2px 0 rgba(255, 255, 255, 0.08);
    /* Dark drop-shadow only — separation from the photo. */
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.55));
  }

  /* Scroll-hint pill anchored to the bottom-centre of the overlay
     (was below the wordmark — moved per user request 2026-05-01).
     Pointer-events re-enabled here only; the rest of .grid-intro
     ignores clicks so the user can keep scrolling through it. */
  .image-grid-section .grid-intro__pill {
    position: absolute;
    bottom: clamp(2rem, 7vh, 5rem);
    left: 50%;
    transform: translateX(-50%);
    pointer-events: auto;
    padding-inline: 1.75rem;
    border: none;
    cursor: pointer;
    font: inherit;
  }

  .image-grid-section .grid-intro__chevron {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: var(--color-accent-primary);
    /* Bobbing animation hints "scroll downward" without copy. The
       motion is small (3 px) and slow (1.4 s) so it reads as a
       subtle nudge, not a distraction. */
    animation: grid-intro-chevron-bob 1.4s ease-in-out infinite;
  }

  @keyframes grid-intro-chevron-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-grid-section .grid-intro__chevron {
      animation: none;
    }
  }

  .image-grid-section .content {
    /*
      Use dvh (dynamic viewport height) instead of vh so the sticky
      pin's height ALWAYS matches the currently visible viewport. On
      iOS Safari + Chrome mobile, `100vh` resolves to the LARGEST
      possible viewport (URL bar collapsed = 852 px on iPhone 14 Pro)
      while the actually-visible area is only 700 px when the URL
      bar is shown. Using `vh` therefore made .content 152 px taller
      than visible, so the photo (sized to .content) extended past
      the visible area, leaving an empty band at the top of the
      pinned section (user feedback 2026-05-01: "ta sekce jakoby
      posunutá dolů"). dvh adapts to the current visible viewport
      and the photo always fills the visible area exactly. Falls
      back to `vh` on browsers without dvh support (iOS < 15.4).
    */
    min-height: 100vh;
    min-height: 100dvh;
    width: 100vw;
    position: sticky;
    top: 0;
    overflow: hidden;
    display: flex;
    place-items: center;
    align-content: center;
  }

  .image-grid-section .grid {
    /*
      Final state is a real point-top honeycomb, not a rectangular
      grid. Hex coordinates follow the same geometry as the reference
      CodePens:

        - same-row neighbours: one full hex width apart;
        - next row: half a hex width sideways and 75% hex height down.

      With 14 surrounding cells + the scaler this becomes a symmetric
      diamond: 1 / 4 / 5 / 4 / 1. The main photo is the centre hex.
    */
    --gutter: clamp(0.125rem, 0.35vw, 0.5rem);
    --hex-clip: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    --hex-gap: clamp(4px, 0.28vw, 8px);
    --hex-w: clamp(6.6rem, min(calc(var(--available-w) * 0.126), calc(var(--available-h) * 0.218)), 18.5rem);
    --hex-h: calc(var(--hex-w) / 0.8660254038);
    --available-w: calc(100vw - (2 * var(--gutter)));
    --available-h: calc(100vh - (2 * var(--gutter)));
    --available-h: calc(100dvh - (2 * var(--gutter)));
    /* True honeycomb adjacency: resize the hexagons themselves, never
       fake the fill by pushing cells apart. Horizontal neighbours share
       vertical sides; the next row shifts by half a cell and 75% height. */
    --hex-x-step: calc(var(--hex-w) + var(--hex-gap));
    --hex-y-step: calc((var(--hex-h) * 0.75) + var(--hex-gap));
    --honeycomb-width: calc((var(--hex-x-step) * 7) + var(--hex-w));
    --honeycomb-height: calc((var(--hex-y-step) * 4) + var(--hex-h));

    width: var(--honeycomb-width);
    height: var(--honeycomb-height);
    max-width: var(--available-w);
    max-height: var(--available-h);
    margin: 0 auto;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    overflow: visible;
    contain: layout style;
  }

  /*
    Layer opacity driven by a single CSS variable (--reveal-progress
    set by JS via Motion on the section). Each layer has its own
    --reveal-offset; the opacity is clamped 0..1 from progress
    advancing past the offset. One scroll observer in JS now
    drives all 5 layer reveals — was 5 observers each ticking the
    main thread every scroll frame.
  */
  @property --reveal-progress {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .image-grid-section .grid > .layer {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    opacity: clamp(0, calc((var(--reveal-progress, 0) - var(--reveal-offset, 0)) * 6), 1);
    will-change: opacity;
  }
  .image-grid-section .grid > .layer:nth-of-type(5) { --reveal-offset: 0; }
  .image-grid-section .grid > .layer:nth-of-type(4) { --reveal-offset: 0.04; }
  .image-grid-section .grid > .layer:nth-of-type(3) { --reveal-offset: 0.08; }
  .image-grid-section .grid > .layer:nth-of-type(2) { --reveal-offset: 0.12; }
  .image-grid-section .grid > .layer:nth-of-type(1) { --reveal-offset: 0.14; }

  .image-grid-section .grid > .layer > div,
  .image-grid-section .grid > .scaler {
    position: absolute;
    left: calc(50% + (var(--hx, 0) * var(--hex-x-step)));
    top: calc(50% + (var(--hr, 0) * var(--hex-y-step)));
    width: var(--hex-w);
    height: var(--hex-h);
    min-height: 0;
    min-width: 0;
    translate: -50% -50%;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .image-grid-section .grid > .layer > div {
    opacity: 0;
    transform-origin: 50% 50%;
    contain: layout paint;
  }

  .image-grid-section .grid > .scaler {
    contain: layout style;
  }

  /* Landscape/default map: wider 5-row honeycomb, 7 / 8 / 7 / 8 / 7.
     This fills desktop and tablet landscape viewports far better than
     the old tall diamond while keeping every hex adjacent. */
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(1) { --hx: -3; --hr: 0; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(2) { --hx: -2.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(3) { --hx: -1.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(4) { --hx: 1.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(5) { --hx: 2.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(6) { --hx: 3; --hr: 0; }

  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(1) { --hx: -0.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(2) { --hx: 0.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(3) { --hx: -2; --hr: 0; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(4) { --hx: -0.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(5) { --hx: 0.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(6) { --hx: 2; --hr: 0; }

  .image-grid-section .grid > .layer:nth-of-type(3) > div:first-of-type { --hx: -1; --hr: 0; }
  .image-grid-section .grid > .layer:nth-of-type(3) > div:last-of-type { --hx: 1; --hr: 0; }

  .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(1) { --hx: -2.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(2) { --hx: -1.5; --hr: -1; }
