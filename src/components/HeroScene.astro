---
/**
 * HeroScene — "Lines & Sparks" canvas animation.
 *
 * Port of towc's CodePen mJzOWJ. Lines fan out from canvas centre
 * rotating ±60°, leave a hue-shifting trail with random sparks.
 * Mounts lazily on intersection so a user that bounces before the
 * hero is in view never compiles the rAF loop.
 */
---

<div class="hero-scene-wrap" aria-hidden="true">
  <canvas class="hero-canvas" data-hero-canvas></canvas>
</div>

<style>
  .hero-scene-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    background: #000;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .hero-canvas[data-mounted="true"] {
    opacity: 1;
  }

  /*
    The lines+sparks canvas already reads as quiet motion on its
    own — no opacity reduction needed on phone (it's mostly black
    with thin colourful traces, not a solid blob).
  */
</style>

<script>
  const wrap = document.querySelector<HTMLDivElement>('.hero-scene-wrap');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');

  if (wrap && canvas) {
    let mounted = false;
    let handle: { dispose: () => void } | null = null;

    const start = async () => {
      if (mounted) return;
      mounted = true;
      const { mountHeroLines } = await import('../scripts/hero-lines');
      handle = mountHeroLines({ canvas });
      if (!handle) return;
      canvas.setAttribute('data-mounted', 'true');
      if (import.meta.hot) {
        import.meta.hot.dispose(() => handle?.dispose());
      }
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        start();
      });
      observer.observe(wrap);
    } else {
      start();
    }
  }
</script>
