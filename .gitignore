# Finder "Copy" duplicates — file " 2.md" / " 2.png" AND whole
# directory " 2/" copies. Recurring noise from macOS Finder when
# items get accidentally duplicated.
* 2.*
* 2/
*\ 2
*\ 3.*
*\ 3/

