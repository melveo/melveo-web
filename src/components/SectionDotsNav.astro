---
/**
 * SectionDotsNav — fixed right-edge section dots + top scroll progress.
 *
 * Added 2026-06-10 (animation/UX pass): the landing is ~10 000 px tall
 * with no wayfinding. Desktop (≥1100px, hover-capable) gets a quiet
 * column of anchor dots with labels on hover; everyone gets a 2px cyan
 * scroll-progress hairline along the top.
 *
 * Progress bar is pure CSS via `animation-timeline: scroll(root)` —
 * compositor-driven, zero JS per frame (the first scroll-driven-
 * animations migration; older browsers simply don't show the bar).
 * Dot active state: rAF scroll handler picks the section containing
 * the viewport centre (deterministic both directions) + bottom override.
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const sections = [
  { id: 'top', label: t('sectionNav.top' as any) },
  { id: 'app', label: t('sectionNav.app' as any) },
  { id: 'data-feedback', label: t('sectionNav.data' as any) },
  { id: 'coach', label: t('sectionNav.coach' as any) },
  { id: 'video', label: t('sectionNav.video' as any) },
  { id: 'pricing', label: t('sectionNav.pricing' as any) },
  { id: 'faq', label: t('sectionNav.faq' as any) },
  { id: 'contact', label: t('sectionNav.contact' as any) },
];
---

<div class="scroll-progress" aria-hidden="true"></div>

<nav class="section-dots" aria-label={t('sectionNav.label' as any)} data-section-dots>
  <ul>
    {sections.map((s) => (
      <li>
        <a href={`#${s.id}`} data-dot-for={s.id}>
          <span class="section-dots__dot" aria-hidden="true"></span>
          <span class="section-dots__label">{s.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* ── Scroll progress hairline ─────────────────────────────────── */
  .scroll-progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      z-index: 60;
      pointer-events: none;
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-accent-primary) 55%, transparent),
        var(--color-accent-primary)
      );
      box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent-primary) 45%, transparent);
      transform-origin: 0 50%;
      transform: scaleX(0);
      animation: scroll-progress-grow linear both;
      animation-timeline: scroll(root);
    }
    @keyframes scroll-progress-grow {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-progress {
      display: none;
    }
  }

  /* ── Section dots ─────────────────────────────────────────────── */
  .section-dots {
    display: none;
  }
  @media (min-width: 1100px) and (hover: hover) {
    .section-dots {
      display: block;
      position: fixed;
      right: clamp(0.9rem, 1.6vw, 1.6rem);
      top: 50%;
      transform: translateY(-50%);
      z-index: 50;
    }
  }
  .section-dots ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .section-dots a {
    display: flex;
    align-items: center;
    flex-direction: row-reverse;
    gap: 0.6rem;
    text-decoration: none;
    padding: 0.15rem;
  }
  .section-dots__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    transition:
      background 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }
  .section-dots__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    background: rgba(10, 14, 18, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    padding: 0.22rem 0.66rem;
    opacity: 0;
    transform: translateX(4px);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
    pointer-events: none;
    white-space: nowrap;
  }
  .section-dots a:hover .section-dots__label,
  .section-dots a:focus-visible .section-dots__label {
    opacity: 1;
    transform: translateX(0);
  }
  .section-dots a:hover .section-dots__dot {
    background: rgba(255, 255, 255, 0.5);
  }
  .section-dots a:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
    border-radius: 999px;
  }
  .section-dots a[aria-current='true'] .section-dots__dot {
    background: var(--color-accent-primary);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent-primary) 60%, transparent);
    transform: scale(1.25);
  }
  @media (prefers-reduced-motion: reduce) {
    .section-dots__dot,
    .section-dots__label {
      transition: none;
    }
  }
</style>

<script>
  function mountSectionDots() {
    const nav = document.querySelector<HTMLElement>('[data-section-dots]');
    if (!nav) return;
    const links = new Map<string, HTMLAnchorElement>();
    nav.querySelectorAll<HTMLAnchorElement>('a[data-dot-for]').forEach((a) => {
      links.set(a.dataset.dotFor!, a);
    });

    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));
    // hide dots whose section doesn't exist on this page
    links.forEach((a, id) => {
      if (!document.getElementById(id)) a.parentElement!.style.display = 'none';
    });
    if (targets.length === 0) return;

    const setActive = (id: string) => {
      links.forEach((a, key) => {
        if (key === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };

    /*
      Active-dot driver v2 (2026-06-10): originally an IntersectionObserver
      on a viewport-centre band — but IO only reports CROSSINGS. The FAQ
      section kept intersecting the band while the bottom-override held
      the last dot, so scrolling back UP never re-fired FAQ and the dot
      jumped contact → pricing. Now a single rAF-throttled scroll handler
      computes "which section contains the viewport centre" directly —
      deterministic in both directions, and the bottom-override is just
      a branch of the same pass. 8 getBoundingClientRect calls per
      scrolled frame is negligible.
    */
    const lastId = targets[targets.length - 1].id;
    let currentId = '';
    const update = () => {
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 24;
      let nextId = currentId;
      if (atBottom) {
        nextId = lastId;
      } else {
        const center = window.innerHeight / 2;
        for (const el of targets) {
          const rect = el.getBoundingClientRect();
          if (rect.top <= center && rect.bottom > center) {
            nextId = el.id;
            break;
          }
        }
      }
      if (nextId !== currentId) {
        currentId = nextId;
        setActive(nextId);
      }
    };

    let raf = 0;
    const queue = () => {
      if (raf === 0) {
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue, { passive: true });
    update();
  }

  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(mountSectionDots, { timeout: 2000 });
  } else {
    setTimeout(mountSectionDots, 300);
  }
</script>
