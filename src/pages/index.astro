---
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * Landing — fullwidth, single page, indie-iOS-app style.
 *
 * Reference patterns: flighty.app, mercury.fm, culturedcode.com/things,
 * bear-writer.com — single hero, App Store badge, one screenshot, three
 * tight features, footer. No marketing grid, no testimonials, no pricing
 * teaser (App Store handles consumer install; pilot enquiry goes through
 * hello@melveo.app for clubs).
 */
---

<BaseLayout
  title="Melveo"
  description="Chytřejší tréninky a zdravější hráči. Aplikace pro sportovní kluby."
>
  <!-- ============================================================== -->
  <!-- HERO — full viewport, dominant claim + App Store badge          -->
  <!-- ============================================================== -->
  <section
    class="relative flex min-h-screen w-full flex-col overflow-hidden bg-[var(--color-bg-canvas)]"
  >
    <!-- Brand glow halo — subtle, behind text -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-1/4 left-1/2 h-[120vh] w-[120vh] -translate-x-1/2 rounded-full opacity-[0.18] blur-3xl"
      style="background: radial-gradient(circle, var(--color-accent-primary) 0%, transparent 60%);"
    >
    </div>

    <!-- Wordmark in top-left, no nav -->
    <header class="relative z-10 px-6 pt-8 sm:px-10 sm:pt-10">
      <a
        href="/"
        class="inline-block text-xl font-semibold tracking-tight text-[var(--color-text-primary)]"
      >
        melveo
      </a>
    </header>

    <!-- Hero content -->
    <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 pb-24 pt-16 text-center sm:pb-32">
      <h1
        class="text-balance text-5xl font-bold leading-[1.05] tracking-tight text-[var(--color-text-primary)] sm:text-7xl lg:text-[5.5rem]"
      >
        Chytřejší tréninky,<br />
        <span class="text-[var(--color-accent-primary)]">zdravější hráči.</span>
      </h1>

      <p
        class="mx-auto mt-8 max-w-xl text-pretty text-lg text-[var(--color-text-secondary)] sm:text-xl"
      >
        Aplikace pro sportovní kluby — wellness, sessions, coach board.
      </p>

      <!-- App Store badge. Replace src once Apple Dev account exists +
           App Store listing is live. The placeholder uses the official
           Apple SVG; until the listing is approved, link href stays
           on a fallback "soon" anchor. -->
      <div class="mt-12">
        <a
          href="#brzy"
          aria-label="Stáhnout v App Store"
          class="inline-block transition-transform duration-200 hover:scale-[1.03]"
        >
          <img
            src="/badges/app-store-cs.svg"
            alt="Stáhnout v App Store"
            class="h-14 w-auto sm:h-16"
            width="200"
            height="60"
          />
        </a>
      </div>

      <p
        id="brzy"
        class="mt-6 text-sm text-[var(--color-text-tertiary)]"
      >
        TestFlight beta startuje brzy ·
        <a
          href="mailto:hello@melveo.app?subject=Mám%20zájem%20o%20pilot"
          class="text-[var(--color-accent-primary)] transition-opacity hover:opacity-80"
        >
          hello@melveo.app
        </a>
      </p>
    </div>

    <!-- Screenshot mock — full bleed, anchored to bottom -->
    <div class="relative z-10 mx-auto w-full max-w-3xl px-6 pb-16 sm:pb-24">
      <div
        class="relative aspect-[9/16] overflow-hidden rounded-[2.5rem] border border-[var(--color-stroke-base)] bg-[var(--color-bg-surface)] shadow-[0_24px_80px_-24px_rgba(0,240,255,0.25)] sm:aspect-[3/4] sm:rounded-[3rem]"
      >
        <!-- Placeholder until real iOS screenshot lands. Aspect picked
             to match a 6.7" iPhone hero shot in portrait, with a soft
             gradient that hints at the brand-cyan readiness UI. -->
        <div
          class="flex h-full w-full flex-col items-center justify-center bg-gradient-to-br from-[var(--color-accent-primary-subtle)]/20 via-[var(--color-bg-tint)]/40 to-[var(--color-bg-canvas)] p-12"
        >
          <div class="text-center">
            <p
              class="text-xs uppercase tracking-[0.3em] text-[var(--color-text-tertiary)]"
            >
              Náhled aplikace
            </p>
            <p class="mt-3 text-base text-[var(--color-text-secondary)]">
              Screenshot zveřejníme po finalizaci UX.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- SHORT FEATURES — 3 řádky, 1 řádek per features                  -->
  <!-- ============================================================== -->
  <section
    class="w-full border-t border-[var(--color-stroke-base)]/60 bg-[var(--color-bg-surface)]"
  >
    <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
      <div class="grid gap-12 sm:grid-cols-3 sm:gap-16">
        <div>
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
          >
            Ráno
          </p>
          <h3 class="text-xl font-semibold text-[var(--color-text-primary)]">
            Pětiosý check-in
          </h3>
          <p class="mt-3 text-[var(--color-text-secondary)]">
            Hráč vyplní za 30 sekund. Trenér vidí tým — nikdy individuální
            čísla.
          </p>
        </div>

        <div>
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
          >
            Trénink
          </p>
          <h3 class="text-xl font-semibold text-[var(--color-text-primary)]">
            Sessions a docházka
          </h3>
          <p class="mt-3 text-[var(--color-text-secondary)]">
            Plánuj, zaznamenej účast, měř zátěž. Bez Excelu, bez WhatsAppu.
          </p>
        </div>

        <div>
          <p
            class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
          >
            Coach Board
          </p>
          <h3 class="text-xl font-semibold text-[var(--color-text-primary)]">
            Připravený předem
          </h3>
          <p class="mt-3 text-[var(--color-text-secondary)]">
            Než přijedeš na hřiště, víš co tým potřebuje. Jeden pohled,
            jasná volba.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- CONTACT — single line for clubs                                 -->
  <!-- ============================================================== -->
  <section
    class="w-full border-t border-[var(--color-stroke-base)]/60 bg-[var(--color-bg-canvas)]"
  >
    <div
      class="mx-auto flex max-w-3xl flex-col items-center px-6 py-20 text-center sm:py-24"
    >
      <h2
        class="text-balance text-3xl font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl"
      >
        Klub a chcete pilot?
      </h2>
      <p class="mt-4 max-w-md text-[var(--color-text-secondary)]">
        Napište nám, krátce zavoláme, do 14 dní spustíte první trénink.
      </p>
      <a
        href="mailto:hello@melveo.app?subject=Mám%20zájem%20o%20pilot"
        class="mt-8 inline-flex items-center gap-2 text-2xl font-semibold tracking-tight text-[var(--color-accent-primary)] transition-opacity hover:opacity-80 sm:text-3xl"
      >
        hello@melveo.app
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
