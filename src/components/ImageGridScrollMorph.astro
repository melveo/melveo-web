---
/**
 * ImageGridScrollMorph — Kevin Gutowski codepen QwNZYzL.
 *
 * Direct re-implementation of the codepen source after the V4-D draft
 * missed the architecture. The trick is:
 *
 *   1. A tall section with sticky inner content (.content)
 *      pinned at top:0 — gives a long scroll runway while the
 *      grid stays visible.
 *   2. The grid is 5 columns × 3 rows (3 cols on mobile). Cells are
 *      placed via CSS subgrid on three "layer" wrappers + one absolute
 *      ".scaler" element at the centre cell.
 *   3. The scaler image animates `width` and `height` in PIXELS from
 *      viewport size DOWN to its natural grid-cell size as the user
 *      scrolls — different easings per axis (power2 width, power1
 *      height) for the codepen's signature asymmetric feel.
 *   4. Each layer has TWO scroll-linked animations:
 *        - opacity: holds at 0 until 55 % scroll, then 0 → 1
 *        - scale:   holds at 0 until 30 % scroll, then 0 → 1
 *      using progressively more aggressive easings per layer
 *      (power1, power3, power4) — outer edges feel slower, inner
 *      cells punch in.
 *   5. Intro overlay (added 2026-05-01): brand wordmark + scroll-hint
 *      pill on top of the full-bleed scaler, fades out as scroll
 *      progresses. Tells the user "this is the start, scroll for
 *      more". Lives at z-index 3 above the grid.
 *
 * Photos are local Melveo sports/club assets; the center scaler keeps
 * the latest wide team briefing image as the primary visual.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

---

<section
  class="image-grid-section"
  data-grid-section
>
  {/* Static cyan atmosphere behind the grid. This used to be the
      runtime glass-smoke canvas, but the honeycomb already owns the
      scroll budget; a CSS field keeps the same mood without a large
      canvas repaint during the morph. */}
  <canvas class="glass-smoke" data-glass-smoke-canvas aria-hidden="true"></canvas>

  <div class="content">
    {/*
      Intro overlay — sits on top of the full-bleed scaler photo for
      the first ~22 % of section scroll, fading out as the morph
      starts. Tells the user "this is the start, scroll for more".
      Brand wordmark + scroll-hint pill (same .hero-pill recipe as
      the App Store + Pricing CTAs). Smooth-scrolls past the section
      on click.
    */}
    {/* Black scroll-reveal layer — sits above the scaler photo and
        below the wordmark. Starts opaque-ish, fades to 0 across the
        first ~22 % of section scroll, so the photo "develops in" as
        the user scrolls. */}
    <div class="grid-intro-darken" data-grid-intro-darken aria-hidden="true"></div>

    <div class="grid-intro" data-grid-intro>
      <div class="grid-intro__center">
        {/* Brand wordmark — always lowercase visually (text-transform
            on the CSS rule + lowercase string). Single span, soft
            rounded display font (Outfit, --font-wordmark), minimal
            shadow per user feedback 2026-05-01: "glow bych z tama
            dal pryč". Eyebrow text removed too. */}
        <h2 class="grid-intro__wordmark">melveo</h2>
      </div>
      <button
        type="button"
        class="hero-pill grid-intro__pill"
        data-grid-intro-scroll
        aria-label={t('gridMorph.scrollHint')}
      >
        <span class="hero-pill-shimmer" aria-hidden="true"></span>
        <span class="hero-pill-content">
          {t('gridMorph.scrollHint')}
          <svg
            class="grid-intro__chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </button>
    </div>

    {/*
      Grid composition (15 cells = 8 cards + 6 photos + 1 scaler) —
      user feedback 2026-05-01: previous 6 generic cards
      (Attendance / Communication / Security / Schedule / Stats /
      Team) didn't tell the visitor anything Melveo-specific. Replaced
      with 8 product-feature cards that walk the daily flow:
        morning ritual:   5osý check-in
        training:         Sessions, Docházka, Zátěž & RPE
        coach reaction:   Coach board, Regenerace, Rozhodnutí
        billing/privacy:  Privacy hráče
      The card-to-photo ratio bumped from 6:8 to 8:6 — roughly half
      of the grid is now product information, half human/sport feel.

      Mobile (3×5) layout view (P=photo, C=card, S=scaler):
        Row 1: P C P    (coach-wide / 5osý / team-huddle)
        Row 2: C P C    (Sessions / coach-rev / Zátěž)
        Row 3: C S C    (Regenerace / SCALER / Rozhodnutí)
        Row 4: P C P    (coach-tab / Coach board / equipment)
        Row 5: C P C    (Docházka / player-mobile / Privacy)
    */}
    <div class="grid">
      <!-- Layer 1 — outer edges (mobile rows 1 + 5). 3 cards + 3 photos. -->
      <div class="layer">
        <div>
          {/* mobile row 1 col 1 */}
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/thumbs/coach-player-wide-crop-thumb.webp?v=2026-05-19" alt="" width="360" height="450" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          {/* mobile row 1 col 2 — 5osý check-in (flagship daily ritual) */}
          <article class="tech-card glass-card" aria-label={t('gridCard.checkin')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                {/* Pentagon (5 vertices) representing the 5 check-in
                    axes: energy, sleep, soreness, mood, motivation.
                    Five spokes from the centre dot to each vertex. */}
                <path d="M12 4 L19.6 9.5 L16.7 18.5 L7.3 18.5 L4.4 9.5 Z" />
                <line x1="12" y1="13" x2="12" y2="4" />
                <line x1="12" y1="13" x2="19.6" y2="9.5" />
                <line x1="12" y1="13" x2="16.7" y2="18.5" />
                <line x1="12" y1="13" x2="7.3" y2="18.5" />
                <line x1="12" y1="13" x2="4.4" y2="9.5" />
                <circle cx="12" cy="13" r="1.4" fill="currentColor" stroke="none" />
              </svg>
              <h3>{t('gridCard.checkin')}</h3>
            </div>
          </article>
        </div>
        <div>
          {/* mobile row 1 col 3 */}
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/thumbs/team-huddle-thumb.webp?v=2026-05-19" alt="" width="360" height="450" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          {/* mobile row 5 col 1 — Docházka */}
          <article class="tech-card glass-card" aria-label={t('gridCard.attendance')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M9 4h6a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
                <path d="M16 5.5h2a2 2 0 0 1 2 2V19a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7.5a2 2 0 0 1 2-2h2" />
                <path d="M8.5 12.5l2 2 4-4.5" />
                <path d="M8.5 17.5h7" />
              </svg>
              <h3>{t('gridCard.attendance')}</h3>
            </div>
          </article>
        </div>
        <div>
          {/* mobile row 5 col 2 */}
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/thumbs/player-mobile-thumb.webp?v=2026-05-19" alt="" width="360" height="450" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          {/* mobile row 5 col 3 — Privacy hráče (unique billing story) */}
          <article class="tech-card tech-card--security glass-card" aria-label={t('gridCard.privacy')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M7 10V8a5 5 0 0 1 10 0v2" />
                <rect class="security-lock__body" x="4.5" y="10" width="15" height="11" rx="2.4" />
                <circle class="security-lock__pin" cx="12" cy="14.7" r="1.1" />
                <path d="M12 15.8v2.4" />
              </svg>
              <h3>{t('gridCard.privacy')}</h3>
            </div>
          </article>
        </div>
      </div>

      <!-- Layer 2 — inner cols (mobile rows 2 + 4). 3 cards + 3 photos. -->
      <div class="layer">
        <div>
          {/* mobile row 2 col 1 — Sessions */}
          <article class="tech-card tech-card--schedule glass-card" aria-label={t('gridCard.sessions')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3.5" y="5" width="17" height="15.5" rx="2.4" />
                <path d="M3.5 9.5h17" />
                <path d="M8 3.5v3M16 3.5v3" />
                <circle cx="8.4" cy="13.5" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="12" cy="13.5" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="15.6" cy="13.5" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="8.4" cy="17" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="12" cy="17" r="0.9" fill="currentColor" stroke="none" />
              </svg>
              <h3>{t('gridCard.sessions')}</h3>
            </div>
          </article>
        </div>
        <div>
          {/* mobile row 2 col 2 */}
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/thumbs/coach-player-review-thumb.webp?v=2026-05-19" alt="" width="360" height="450" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          {/* mobile row 2 col 3 — Zátěž & RPE (post-session intensity) */}
          <article class="tech-card glass-card" aria-label={t('gridCard.load')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon tech-card__icon--filled" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="3.5" y="13" width="3.6" height="7.5" rx="1.1" />
                <rect x="10.2" y="7" width="3.6" height="13.5" rx="1.1" />
                <rect x="16.9" y="10" width="3.6" height="10.5" rx="1.1" />
                <path d="M3 20.5h18" stroke-width="1.4" />
              </svg>
              <h3>{t('gridCard.load')}</h3>
            </div>
          </article>
        </div>
        <div>
          {/* mobile row 4 col 1 */}
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/thumbs/coach-field-tablet-thumb.webp?v=2026-05-19" alt="" width="360" height="450" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
        <div>
          {/* mobile row 4 col 2 — Coach board (real-time team context) */}
          <article class="tech-card glass-card" aria-label={t('gridCard.coachBoard')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                {/* Dashboard frame + 4 panels with the bottom-left tile
                    filled to suggest "live data" / active panel. Two
                    HUD dots top-left echo the actual coach board UI. */}
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <path d="M3 9.5h18" />
                <path d="M12 9.5v10.5" />
                <circle cx="6" cy="6.7" r="0.7" fill="currentColor" stroke="none" />
                <circle cx="9" cy="6.7" r="0.7" fill="currentColor" stroke="none" />
                <rect x="5" y="11.7" width="5.4" height="6.3" rx="1" fill="currentColor" stroke="none" />
              </svg>
              <h3>{t('gridCard.coachBoard')}</h3>
            </div>
          </article>
        </div>
        <div>
          {/* mobile row 4 col 3 */}
          <figure class="grid-photo glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <img src="/images/melveo-grid/thumbs/equipment-detail-thumb.webp?v=2026-05-19" alt="" width="360" height="450" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
      </div>

      <!-- Layer 3 — flanks the centre scaler (mobile row 3, cols 1+3). 2 cards. -->
      <div class="layer">
        <div>
          {/* row 3 col 1 — Regenerace (recovery signals) */}
          <article class="tech-card glass-card" aria-label={t('gridCard.recovery')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                {/* Two stacked sine waves — top wave is the "active"
                    recovery curve, lower wave is fainter (settled
                    state). Reads as "recovery trend / sleep curve". */}
                <path d="M3 11c2-3.5 4-3.5 6 0s4 3.5 6 0 4-3.5 6 0" />
                <path d="M3 17c2-2 4-2 6 0s4 2 6 0 4-2 6 0" opacity="0.55" />
              </svg>
              <h3>{t('gridCard.recovery')}</h3>
            </div>
          </article>
        </div>
        <div>
          {/* row 3 col 3 — Rozhodnutí (data → coach decision) */}
          <article class="tech-card glass-card" aria-label={t('gridCard.decisions')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                {/* Decision-tree fork — single source on the left
                    branches into 3 outcomes (load up / hold / down).
                    Filled source dot, hollow outcome dots. */}
                <circle cx="5" cy="12" r="1.7" fill="currentColor" stroke="none" />
                <path d="M6.7 12 L13 6" />
                <path d="M6.7 12 L19 12" />
                <path d="M6.7 12 L13 18" />
                <circle cx="14" cy="6" r="1.6" />
                <circle cx="20" cy="12" r="1.6" />
                <circle cx="14" cy="18" r="1.6" />
              </svg>
              <h3>{t('gridCard.decisions')}</h3>
            </div>
          </article>
        </div>
      </div>

      <!-- Layer 4 — desktop-only outer expansion ring. Adds more product
           proof on wide screens while mobile keeps the tighter 15-cell
           honeycomb for readability. -->
      <div class="layer layer--desktop-extra" aria-hidden="false">
        <div>
          <article class="tech-card glass-card" aria-label={t('gridCard.wellness')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 13c2.4-5.5 5.1-5.5 8 0s5.6 5.5 8 0" />
                <path d="M6 18c2-3.2 4-3.2 6 0s4 3.2 6 0" opacity="0.55" />
                <circle cx="12" cy="7" r="2.2" />
              </svg>
              <h3>{t('gridCard.wellness')}</h3>
            </div>
          </article>
        </div>
        <div>
          <article class="tech-card glass-card" aria-label={t('gridCard.sessionsPlan')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="4" y="4.5" width="16" height="15" rx="2.3" />
                <path d="M8 8h8M8 12h8M8 16h5" />
                <path d="M16.5 14.5l1.5 1.5 2.5-3" />
              </svg>
              <h3>{t('gridCard.sessionsPlan')}</h3>
            </div>
          </article>
        </div>
        <div>
          <article class="tech-card glass-card" aria-label={t('gridCard.watchlist')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 4l9 16H3L12 4z" />
                <path d="M12 9v5" />
                <circle cx="12" cy="17.4" r="0.9" fill="currentColor" stroke="none" />
              </svg>
              <h3>{t('gridCard.watchlist')}</h3>
            </div>
          </article>
        </div>
        <div>
          <article class="tech-card glass-card" aria-label={t('gridCard.reports')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon tech-card__icon--filled" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="5" y="12.5" width="3" height="6.5" rx="0.9" />
                <rect x="10.5" y="8" width="3" height="11" rx="0.9" />
                <rect x="16" y="10.5" width="3" height="8.5" rx="0.9" />
                <path d="M4 19.5h16" stroke-width="1.4" />
                <path d="M5 6h14" />
              </svg>
              <h3>{t('gridCard.reports')}</h3>
            </div>
          </article>
        </div>
        <div>
          <article class="tech-card glass-card" aria-label={t('gridCard.roles')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="8" cy="8" r="2.5" />
                <circle cx="16" cy="8" r="2.5" />
                <path d="M4.5 18c.6-3 2.2-4.6 3.5-4.6s2.9 1.6 3.5 4.6" />
                <path d="M12.5 18c.6-3 2.2-4.6 3.5-4.6s2.9 1.6 3.5 4.6" />
              </svg>
              <h3>{t('gridCard.roles')}</h3>
            </div>
          </article>
        </div>
        <div>
          <article class="tech-card glass-card" aria-label={t('gridCard.context')}>
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              <svg class="tech-card__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="12" cy="12" r="7.5" />
                <path d="M12 4.5v15M4.5 12h15" />
                <path d="M7.2 6.5c2.7 2 6.9 2 9.6 0M7.2 17.5c2.7-2 6.9-2 9.6 0" />
              </svg>
              <h3>{t('gridCard.context')}</h3>
            </div>
          </article>
        </div>
      </div>

      <!-- Layer 5 — radius-3 perimeter. These 16 cells complete a true
           4 / 5 / 6 / 7 / 6 / 5 / 4 honeycomb on every viewport. -->
      <div class="layer layer--desktop-extra layer--outer-ring" aria-hidden="false">
        <div><figure class="grid-photo glass-card" aria-hidden="true"><span class="glass-filter" aria-hidden="true" /><span class="glass-overlay" aria-hidden="true" /><span class="glass-specular" aria-hidden="true" /><div class="glass-content"><img src="/images/melveo-grid/thumbs/player-portrait-thumb.webp?v=2026-05-19" alt="" width="360" height="450" loading="lazy" decoding="async" /></div></figure></div>
        <div><article class="tech-card tech-card--outer glass-card" aria-label={t('gridCard.mood' as any)}><span class="glass-filter" aria-hidden="true" /><span class="glass-overlay" aria-hidden="true" /><span class="glass-specular" aria-hidden="true" /><div class="glass-content"><svg class="tech-card__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.4" /><path d="M8.8 10h.1M15.1 10h.1" /><path d="M8.6 14.2c1.7 1.8 5.1 1.8 6.8 0" /></svg><h3>{t('gridCard.mood' as any)}</h3></div></article></div>
