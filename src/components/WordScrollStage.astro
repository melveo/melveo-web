---
/**
 * WordScrollStage — close port of Daniel Haim's CodePen azmBEPL.
 *
 * Sticky prefix plus a page-scrolled word list with CSS
 * view-timeline brightening mapped to the Melveo palette.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const words = t('wordScroll.words').split('|');
const startIndex = 0;
const endIndex = words.length - 1;
const remainingSteps = Math.max(1, endIndex - startIndex);
const scrollFriction = 4;
const scrollDistance = `${remainingSteps * 6.09375 * scrollFriction}rem`;
const scrollDistanceTablet = `${remainingSteps * 5.4375 * scrollFriction}rem`;
const scrollDistanceMobile = `${remainingSteps * 3.125 * scrollFriction}rem`;
const scrollDistanceSmall = `${remainingSteps * 2.375 * scrollFriction}rem`;
const hueStart = 205;
const hueEnd = 178;
const hueStep = (hueEnd - hueStart) / Math.max(1, words.length - 1);
---

<section
  class="word-scroll-stage"
  data-word-scroll-stage
  data-start-index={startIndex}
  data-end-index={endIndex}
  style={`--word-scroll-count: ${words.length}; --word-scroll-active-index: ${startIndex}; --word-scroll-distance: ${scrollDistance}; --word-scroll-distance-tablet: ${scrollDistanceTablet}; --word-scroll-distance-mobile: ${scrollDistanceMobile}; --word-scroll-distance-small: ${scrollDistanceSmall};`}
>
  <div class="word-scroll-stage__pin">
    <div class="word-scroll-stage__inner">
      <h2 class="word-scroll-stage__prefix">
        <span aria-hidden="true">{t('wordScroll.prefix')}&nbsp;</span>
        <span class="word-scroll-stage__sr-only">
          {t('wordScroll.screenReader')}
        </span>
      </h2>

      <div class="word-scroll-stage__list-viewport" aria-hidden="true">
        <ul class="word-scroll-stage__list">
          {words.map((word, index) => (
            <li
              class="word-scroll-stage__item glass-card glass-card--compact"
              style={`--i: ${index}; --word-hue: ${hueStart + index * hueStep}; --word-distance: ${Math.abs(index - startIndex)}; --word-focus: ${index === startIndex ? 1 : 0};`}
            >
              <span class="glass-filter" aria-hidden="true"></span>
              <span class="glass-overlay" aria-hidden="true"></span>
              <span class="glass-specular" aria-hidden="true"></span>
              <span class="glass-content word-scroll-stage__word">{word}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .word-scroll-stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: calc(100vh + var(--word-scroll-distance));
    overflow: visible;
    border-top: 1px solid var(--color-stroke-base);
    border-bottom: 1px solid var(--color-stroke-base);
    background: var(--color-bg-canvas);
    color: var(--color-text-primary);
    color-scheme: dark;
  }

  .word-scroll-stage::before,
  .word-scroll-stage::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }

  .word-scroll-stage::before {
    inset: 12% 10% auto 10%;
    height: 42%;
    background:
      radial-gradient(circle at 42% 52%, rgba(0, 240, 255, 0.18), transparent 34%),
      radial-gradient(circle at 58% 48%, rgba(176, 112, 46, 0.09), transparent 38%);
    filter: blur(48px);
    opacity: 0.72;
  }

  .word-scroll-stage::after {
    inset: auto 18% 12% 18%;
    height: 22%;
    background: radial-gradient(circle, rgba(0, 240, 255, 0.1), transparent 62%);
    filter: blur(42px);
    opacity: 0.55;
  }

  .word-scroll-stage__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    z-index: 1;
  }

  .word-scroll-stage__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.24em;
    height: 100%;
    min-width: min-content;
    padding-inline: 1.5rem;
    font-size: 4.875rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .word-scroll-stage__prefix {
    flex: 0 0 auto;
    height: fit-content;
    margin: 0;
    font: inherit;
    background: linear-gradient(
      180deg,
      var(--color-text-primary) 42%,
      color-mix(in oklch, var(--color-bg-canvas), var(--color-text-primary) 38%) 100%
    );
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
    text-shadow: 0 14px 28px rgba(0, 0, 0, 0.34);
  }

  .word-scroll-stage__list-viewport {
    position: relative;
    flex: 0 0 auto;
    height: 100%;
    min-width: 0;
  }

  .word-scroll-stage__list {
    position: relative;
    top: 50%;
    left: 0;
    width: max-content;
    transform: translate3d(
      0,
      calc(-0.625em - (var(--word-scroll-active-index) * 1.25em)),
      0
    );
    list-style: none;
    margin: 0;
    padding: 0;
    padding-left: 0;
    font: inherit;
    white-space: nowrap;
    will-change: transform;
  }

  .word-scroll-stage__item {
    position: relative;
    display: block;
    width: max-content;
    overflow: visible;
    border-radius: 0.34em;
    background: transparent;
    --word-accent: oklch(0.82 0.16 var(--word-hue));
    --word-accent-muted: color-mix(
      in oklch,
      var(--word-accent) 62%,
      var(--color-text-primary)
    );
    color: var(--word-accent-muted);
    opacity: clamp(0.16, calc(0.2 + (var(--word-focus) * 0.8)), 1);
    filter: brightness(clamp(0.9, calc(0.94 + (var(--word-focus) * 0.2)), 1.14));
    box-shadow:
      0 10px 44px color-mix(in oklch, var(--word-accent) calc(var(--word-focus) * 32%), transparent),
      0 4px 16px rgba(0, 0, 0, calc(var(--word-focus) * 0.2));
    transition: none;
    will-change: opacity, filter, box-shadow;
  }

  .word-scroll-stage__item:last-of-type {
    background: transparent;
    color: var(--color-text-primary);
  }

  .word-scroll-stage__item:last-of-type .word-scroll-stage__word {
    background: linear-gradient(
      var(--color-text-primary) 50%,
      color-mix(in oklch, var(--color-bg-canvas), var(--color-text-primary) 25%)
    );
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
  }

  .word-scroll-stage__item:hover {
    transform: none;
  }

  .word-scroll-stage__item .glass-filter,
  .word-scroll-stage__item .glass-overlay,
  .word-scroll-stage__item .glass-specular {
    inset: -0.08em -0.28em -0.12em;
    border-radius: inherit;
    opacity: var(--word-focus);
  }

  .word-scroll-stage__item .glass-filter {
    backdrop-filter: blur(12px) saturate(190%);
    -webkit-backdrop-filter: blur(12px) saturate(190%);
  }

  .word-scroll-stage__item .glass-overlay {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.095),
      color-mix(in oklch, var(--word-accent) 12%, transparent) 52%,
      rgba(255, 255, 255, 0.02)
    );
  }

  .word-scroll-stage__item .glass-specular {
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.34),
      inset 0 0 10px color-mix(in oklch, var(--word-accent) 30%, transparent),
      inset -1px -1px 0 rgba(255, 255, 255, 0.05);
  }

  .word-scroll-stage__word {
    display: inline-block;
    flex: none;
    text-shadow: 0 0 calc(30px * var(--word-focus)) color-mix(in oklch, var(--word-accent) 46%, transparent);
  }

  .word-scroll-stage__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1100px) {
    .word-scroll-stage {
      --word-scroll-distance: var(--word-scroll-distance-tablet);
    }

    .word-scroll-stage__inner {
      font-size: 4.35rem;
    }
  }

  @media (max-width: 780px) {
    .word-scroll-stage {
      --word-scroll-distance: var(--word-scroll-distance-mobile);
    }

    .word-scroll-stage__inner {
      gap: 0.18em;
      padding-inline: 1rem;
      font-size: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .word-scroll-stage {
      --word-scroll-distance: var(--word-scroll-distance-small);
    }

    .word-scroll-stage__inner {
      font-size: 1.9rem;
    }

    .word-scroll-stage__item .glass-filter,
    .word-scroll-stage__item .glass-overlay,
    .word-scroll-stage__item .glass-specular {
      inset: -0.08em -0.2em -0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word-scroll-stage__item {
      opacity: 0.72;
      filter: none;
    }
  }
</style>

<script>
  const clampWordScroll = (value, min, max) => Math.min(Math.max(value, min), max);

  const updateWordScrollStages = () => {
    document.querySelectorAll('[data-word-scroll-stage]').forEach((root) => {
      const startIndex = Number(root.getAttribute('data-start-index') || 0);
      const endIndex = Number(root.getAttribute('data-end-index') || startIndex);
      const rect = root.getBoundingClientRect();
      const scrollableDistance = Math.max(1, root.offsetHeight - window.innerHeight);
      const progress = clampWordScroll(-rect.top / scrollableDistance, 0, 1);
      const activeIndex = startIndex + progress * (endIndex - startIndex);

      root.style.setProperty('--word-scroll-active-index', activeIndex.toFixed(4));

      root.querySelectorAll('.word-scroll-stage__item').forEach((item, index) => {
        const distance = Math.abs(index - activeIndex);
        const focus = clampWordScroll(1 - distance * 1.08, 0, 1);

        item.style.setProperty('--word-distance', distance.toFixed(4));
        item.style.setProperty('--word-focus', focus.toFixed(4));
      });
    });
  };

  let wordScrollFrame = 0;
  const queueWordScrollUpdate = () => {
    if (wordScrollFrame) return;

    wordScrollFrame = window.requestAnimationFrame(() => {
      wordScrollFrame = 0;
      updateWordScrollStages();
    });
  };

  updateWordScrollStages();
  window.addEventListener('scroll', queueWordScrollUpdate, { passive: true });
  window.addEventListener('resize', queueWordScrollUpdate);
  window.addEventListener('load', updateWordScrollStages, { once: true });
  document.addEventListener('astro:page-load', updateWordScrollStages);

  if ('fonts' in document) {
    document.fonts.ready.then(updateWordScrollStages);
  }
</script>
