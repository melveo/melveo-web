---
/**
 * WordScrollStage — Daniel Haim CodePen azmBEPL-inspired section.
 *
 * The source pen uses a sticky text prefix plus a scroll-driven word
 * list where each item brightens as it crosses the viewport center.
 * This version keeps that interaction in native CSS and maps the
 * palette to Melveo cyan/teal/warm tokens.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const words = t('wordScroll.words').split('|');
const colors = [
  'var(--color-accent-primary)',
  'var(--color-accent-primary-hover)',
  'var(--color-accent-primary-subtle)',
  'var(--color-accent-warm-dark)',
];
---

<section class="word-scroll-stage" data-word-scroll-stage>
  <div class="word-scroll-stage__grid" aria-hidden="true"></div>
  <div class="word-scroll-stage__halo word-scroll-stage__halo--left" aria-hidden="true"></div>
  <div class="word-scroll-stage__halo word-scroll-stage__halo--right" aria-hidden="true"></div>

  <p class="word-scroll-stage__eyebrow">
    {t('wordScroll.eyebrow')}
  </p>

  <div class="word-scroll-stage__inner" style={`--word-scroll-count: ${words.length};`}>
    <h2 class="word-scroll-stage__prefix">
      <span aria-hidden="true">{t('wordScroll.prefix')}&nbsp;</span>
      <span class="word-scroll-stage__sr-only">
        {t('wordScroll.screenReader')}
      </span>
    </h2>

    <ul class="word-scroll-stage__list" aria-hidden="true">
      {words.map((word, index) => (
        <li
          class="word-scroll-stage__item"
          style={`--i: ${index}; --word-color: ${colors[index % colors.length]};`}
        >
          {word}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .word-scroll-stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: visible;
    border-top: 1px solid var(--color-stroke-base);
    background:
      radial-gradient(circle at 52% 50%, rgba(0, 240, 255, 0.13), transparent 34%),
      linear-gradient(180deg, var(--color-bg-canvas), #071014 48%, var(--color-bg-canvas));
  }

  .word-scroll-stage__grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at center, black 0 42%, transparent 76%);
  }

  .word-scroll-stage__halo {
    position: absolute;
    z-index: -2;
    width: 46rem;
    height: 46rem;
    border-radius: 999px;
    filter: blur(80px);
    opacity: 0.32;
    pointer-events: none;
  }

  .word-scroll-stage__halo--left {
    left: -18rem;
    top: 18%;
    background: color-mix(in srgb, var(--color-accent-primary) 44%, transparent);
  }

  .word-scroll-stage__halo--right {
    right: -20rem;
    bottom: 4%;
    background: color-mix(in srgb, var(--color-accent-warm-dark) 34%, transparent);
  }

  .word-scroll-stage__eyebrow {
    position: absolute;
    top: 5rem;
    left: 0;
    right: 0;
    z-index: 3;
    margin: 0;
    padding: 0 1.5rem;
    text-align: center;
    color: var(--color-accent-primary);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  .word-scroll-stage__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(0.3rem, 1.4vw, 1.35rem);
    padding-inline: 1.5rem;
    padding-bottom: 56vh;
    font-size: clamp(3rem, 8.6vw, 8.5rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .word-scroll-stage__prefix {
    position: sticky;
    top: calc(50vh - 0.49lh);
    height: fit-content;
    margin: 0;
    font: inherit;
    background: linear-gradient(
      180deg,
      var(--color-text-primary) 42%,
      color-mix(in srgb, var(--color-text-primary) 42%, var(--color-bg-canvas))
    );
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
  }

  .word-scroll-stage__list {
    list-style: none;
    margin: 0;
    padding: calc(50vh - 0.49lh) 0;
  }

  .word-scroll-stage__item {
    color: color-mix(in srgb, var(--word-color) 48%, var(--color-text-primary));
    opacity: 0.26;
    filter: brightness(0.72);
    will-change: opacity, filter, transform;
  }

  @supports (animation-timeline: view()) {
    .word-scroll-stage__item {
      animation-name: word-scroll-brighten;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-timeline: view();
      animation-range: cover calc(50% - 0.65lh) calc(50% + 0.65lh);
    }

    .word-scroll-stage__item:first-of-type {
      --word-scroll-start-opacity: 1;
    }

    .word-scroll-stage__item:last-of-type {
      --word-scroll-end-opacity: 1;
    }
  }

  @keyframes word-scroll-brighten {
    0% {
      opacity: var(--word-scroll-start-opacity, 0.24);
      filter: brightness(0.74);
      transform: translateY(0.06lh);
      text-shadow: none;
    }

    50% {
      opacity: 1;
      filter: brightness(1.18);
      transform: translateY(0);
      text-shadow: 0 0 38px color-mix(in srgb, var(--word-color) 40%, transparent);
    }

    100% {
      opacity: var(--word-scroll-end-opacity, 0.24);
      filter: brightness(0.74);
      transform: translateY(-0.06lh);
      text-shadow: none;
    }
  }

  .word-scroll-stage__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 780px) {
    .word-scroll-stage__eyebrow {
      top: 3rem;
      font-size: 0.68rem;
      letter-spacing: 0.34em;
    }

    .word-scroll-stage__inner {
      flex-direction: column;
      align-items: center;
      gap: 0.1rem;
      font-size: clamp(3.2rem, 15vw, 5.8rem);
      line-height: 0.94;
      text-align: center;
    }

    .word-scroll-stage__prefix {
      top: calc(30vh - 0.47lh);
    }

    .word-scroll-stage__list {
      padding-block: calc(44vh - 0.47lh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word-scroll-stage__item {
      animation: none;
      opacity: 0.72;
      filter: none;
      transform: none;
    }
  }
</style>
