---
/**
 * AnalyticsHead — V4-F.
 *
 * Goes inside <head>. Renders:
 *   1. Google Consent Mode v2 default state (denied) — must run BEFORE
 *      GTM container so deferred tags respect consent.
 *   2. GTM container snippet — only if PUBLIC_GTM_CONTAINER_ID env var
 *      is set. Empty during V4-F (Q22 deferred); becomes active when
 *      user provides the ID and re-deploys.
 *   3. Cloudflare Web Analytics beacon — cookieless, doesn't need
 *      consent. Token from PUBLIC_CF_ANALYTICS_TOKEN env var.
 *
 * Order matters: gtag('consent','default',...) must execute before
 * GTM loads any tags. We hand-author the snippet for that reason.
 *
 * ─────────────────────────────────────────────────────────────────
 * SETUP — How to enable Cloudflare Web Analytics on melveo.app
 * ─────────────────────────────────────────────────────────────────
 *   1. Cloudflare dashboard → Analytics & Logs → Web Analytics
 *   2. "Add a site" → enter melveo.app → "Done"
 *   3. Copy the JS Snippet token (the long hex string in
 *      `data-cf-beacon='{"token":"…"}'` of the generated snippet)
 *   4. Workers & Pages → melveo-web → Settings → Variables and
 *      Secrets → Add variable
 *      Name: PUBLIC_CF_ANALYTICS_TOKEN
 *      Value: <paste token>
 *      Type: Plaintext (must be PUBLIC_ prefixed so Astro inlines
 *      it at build time)
 *   5. Trigger a redeploy (push or "Retry build" in dashboard)
 *   6. Verify: view-source on melveo.app, search for
 *      "static.cloudflareinsights.com/beacon.min.js" — should be
 *      present with your token in data-cf-beacon.
 *
 * Cloudflare Web Analytics is COOKIELESS so does not require user
 * consent — it runs alongside the GDPR consent banner without
 * being gated by it. (GTM tags ARE gated via gtag('consent',...)
 * default-denied state above.)
 */

const gtmId = import.meta.env.PUBLIC_GTM_CONTAINER_ID ?? '';
/*
  CF Web Analytics token — created 2026-07-10 for hostname melveo.app
  (dashboard → Analytics → Web Analytics → melveo.app). Committed as
  the default because the token is public by design: it ships in the
  HTML of every page as the beacon identifier and grants no access
  to anything (dashboard data stays behind the CF login). The env
  var still takes precedence for stage/preview overrides.
*/
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN || 'b7c331a1455a45dd877d30c9a969f66e';
---

{/* Google Consent Mode v2 — default denied. Must run before GTM. */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500,
  });
  gtag('set', 'ads_data_redaction', true);
</script>

{
  gtmId && (
    <script is:inline define:vars={{ gtmId }}>
      {`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','${gtmId}');`}
    </script>
  )
}

{
  cfToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${cfToken}"}`}
    />
  )
}
