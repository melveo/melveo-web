---
/**
 * PricingStage — two tracks (player / coach), each a free plan plus its
 * own paid plan, with a monthly/yearly toggle (melveo-app#1246,
 * 2026-10-27).
 *
 * Model (melveo-app#1224): personal entitlements, not team licences.
 * A team is free to create and players are never charged per head.
 * Peak (player_plus, 9 €/month) and Gameplan (coach_pro, 90 €/month)
 * are separate products — neither includes the other.
 *
 * Feature lines only claim what the app ships today; capabilities that
 * exist on the server but have no app UI yet are listed as "Soon".
 * Paid plans are not on sale (no personal checkout exists), so their CTA
 * asks to be told at launch — never a Buy button.
 *
 * Yearly = 2 months free (−17 %). This is the owner's PROPOSAL from
 * 2026-10-27 and is not yet in Stripe or Supabase plan_prices. Prices
 * live in three places (see AGENTS.md); align all three before launch.
 *
 * Monthly/yearly switch is CSS-driven: both prices are rendered, the
 * inactive one is hidden via `[data-period]` on the section root
 * (pricing-toggle.ts flips it and rolls the amount).
 */

import { testFlightUrl, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
type Key = Parameters<typeof t>[0];

interface Plan {
  id: string;
  name: string;
  /** Monthly price in EUR; 0 = free plan. */
  monthly: number;
  features: Key[];
  soon: Key[];
}

interface Track {
  id: 'player' | 'coach';
  label: Key;
  plans: [Plan, Plan];
}

const tracks: Track[] = [
  {
    id: 'player',
    label: 'pricing.trackPlayer',
    plans: [
      {
        id: 'warmup',
        name: 'Warm-up',
        monthly: 0,
        features: ['pricing.warmup.f1', 'pricing.warmup.f2', 'pricing.warmup.f3', 'pricing.warmup.f4', 'pricing.warmup.f5'],
        soon: [],
      },
      {
        id: 'peak',
        name: 'Peak',
        monthly: 9,
        features: ['pricing.peak.f1'],
        soon: ['pricing.peak.soon1', 'pricing.peak.soon2'],
      },
    ],
  },
  {
    id: 'coach',
    label: 'pricing.trackCoach',
    plans: [
      {
        id: 'sideline',
        name: 'Sideline',
        monthly: 0,
        features: ['pricing.sideline.f1', 'pricing.sideline.f2', 'pricing.sideline.f3', 'pricing.sideline.f4', 'pricing.sideline.f5'],
        soon: [],
      },
      {
        id: 'gameplan',
        name: 'Gameplan',
        monthly: 90,
        features: ['pricing.gameplan.f1', 'pricing.gameplan.f2', 'pricing.gameplan.f3', 'pricing.gameplan.f4', 'pricing.gameplan.f5'],
        soon: ['pricing.gameplan.soon1'],
      },
    ],
  },
];

/** Yearly = 10 × monthly (2 months free). */
const YEARLY_MONTHS = 10;

const locale = lang === 'cs' ? 'cs-CZ' : 'en-GB';
const money = (n: number, decimals = 0) =>
  n
    .toLocaleString(locale, { minimumFractionDigits: decimals, maximumFractionDigits: decimals })
    .replace(/ /g, ' ');
/** Effective monthly when paying yearly, e.g. "7,50 €" / "€7.50". */
const perMonthFromYearly = (monthly: number) => {
  const value = (monthly * YEARLY_MONTHS) / 12;
  const amount = money(value, Number.isInteger(value) ? 0 : 2);
  return lang === 'cs' ? `${amount} €` : `€${amount}`;
};

const tagline = (plan: Plan) => t(`pricing.${plan.id}.tagline` as Key);
const notifyHref = (plan: Plan) =>
  `mailto:hello@melveo.app?subject=${encodeURIComponent(t('pricing.notifySubject').replace('{plan}', plan.name))}`;
---

<section
  id="pricing"
  class="pricing-stage"
  data-pricing-section
  data-glass-smoke
  data-period="monthly"
  aria-labelledby="pricing-heading"
>
  {/*
    Cyan smoke field behind the pricing cards. The 4-layer glass-card
    recipe relies on having something colourful behind it to refract —
    on flat black canvas the displacement filter has nothing to bend.
    Mounted client-side from glass-smoke.ts via [data-glass-smoke].
  */}
  <canvas class="glass-smoke" data-glass-smoke-canvas aria-hidden="true"></canvas>

  <div class="pricing-inner">
    <header class="pricing-header">
      <h2 id="pricing-heading" class="pricing-headline">
        {t('pricing.headline')}<br />
        <span class="pricing-headline-accent">{t('pricing.headlineAccent')}</span>
      </h2>
      <p class="pricing-subline">{t('pricing.subline')}</p>
      {/*
        No VAT note on purpose (owner decision 2026-06-10). If that ever
        changes, `pricing.vatNote` in ui.ts still holds the prepared
        strings; compute actual VAT in checkout, never as a price toggle.
      */}

      {/*
        Twin-pill toggle. Monthly is the default: it is the approved price,
        the yearly one is still a proposal.
      */}
      <div class="pricing-toggle" role="tablist" aria-label={t('pricing.toggleLabel')}>
        <span class="pricing-toggle-thumb" aria-hidden="true"></span>
        <button
          type="button"
          role="tab"
          data-period-set="monthly"
          aria-selected="true"
          class="pricing-toggle-btn pricing-toggle-btn--active"
        >
          {t('pricing.toggleMonthly')}
        </button>
        <button
          type="button"
          role="tab"
          data-period-set="yearly"
          aria-selected="false"
          class="pricing-toggle-btn"
        >
          <span class="pricing-toggle-label">{t('pricing.toggleYearly')}</span>
          <span class="pricing-toggle-savings">{t('pricing.toggleSavings')}</span>
        </button>
      </div>
    </header>

    <div class="pricing-tracks">
      {tracks.map((track) => (
        <section class="pricing-track" aria-labelledby={`pricing-track-${track.id}`}>
          <h3 id={`pricing-track-${track.id}`} class="pricing-track-label">{t(track.label)}</h3>
          <ul class="pricing-cards">
            {track.plans.map((plan) => {
              const free = plan.monthly === 0;
              const yearly = plan.monthly * YEARLY_MONTHS;
              return (
                <li
                  class:list={['pricing-card glass-card', free && 'pricing-card--free']}
                  data-plan-id={plan.id}
                >
                  {/* 4-layer liquid-glass stack (recipe in global.css). */}
                  <span class="glass-filter" aria-hidden="true" />
                  <span class="glass-overlay" aria-hidden="true" />
                  <span class="glass-specular" aria-hidden="true" />
                  <div class="glass-content">
                    <header class="pricing-card-header">
                      <h4 class="pricing-card-name">{plan.name}</h4>
                      <p class="pricing-card-tagline">{tagline(plan)}</p>
                    </header>

                    <div class="pricing-card-price">
                      {free ? (
                        <div class="pricing-price-block pricing-price-block--free">
                          <span class="pricing-price-day">{t('pricing.free')}</span>
                          <span class="pricing-price-secondary">{t('pricing.freeNote')}</span>
                        </div>
                      ) : (
                        <Fragment>
                          <div class="pricing-price-block pricing-price-block--monthly">
                            <span class="pricing-price-day">
                              {lang === 'en' && <span class="pricing-currency">€</span>}
                              <span class="pricing-amount" data-amount={plan.monthly}>{money(plan.monthly)}</span>
                              {lang === 'cs' && <Fragment>&nbsp;<span class="pricing-currency">€</span></Fragment>}
                            </span>
                            <span class="pricing-price-suffix">{t('pricing.perMonth')}</span>
                            <span class="pricing-price-secondary">{t('pricing.billedMonthly')}</span>
                          </div>
                          <div class="pricing-price-block pricing-price-block--yearly">
                            <span class="pricing-price-day">
                              {lang === 'en' && <span class="pricing-currency">€</span>}
                              <span class="pricing-amount" data-amount={yearly}>{money(yearly)}</span>
                              {lang === 'cs' && <Fragment>&nbsp;<span class="pricing-currency">€</span></Fragment>}
                            </span>
                            <span class="pricing-price-suffix">{t('pricing.perYear')}</span>
                            <span class="pricing-price-secondary">
                              {t('pricing.perMonthEffective').replace('{amount}', perMonthFromYearly(plan.monthly))}
                            </span>
                          </div>
                        </Fragment>
                      )}
                    </div>

                    {/* Free plans go to the verified TestFlight beta. Paid plans
                        are not on sale yet, so they only ask to be told at
                        launch — no fake Buy button. */}
                    <a
                      class:list={['hero-pill pricing-card-cta', !free && 'pricing-card-cta--primary']}
                      href={free ? testFlightUrl : notifyHref(plan)}
                      {...(free ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      <span class="hero-pill-shimmer" aria-hidden="true"></span>
                      <span class="hero-pill-content">{free ? t('pricing.ctaFree') : t('pricing.ctaNotify')}</span>
                    </a>

                    <ul class="pricing-card-features">
                      {plan.features.map((feat) => (
                        <li>
                          <svg class="pricing-tick" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3.5 8.5l3 3 6-7" />
                          </svg>
                          <span>{t(feat)}</span>
                        </li>
                      ))}
                      {plan.soon.map((feat) => (
                        <li class="pricing-card-soon">
                          <span class="pricing-soon-tag">{t('pricing.soon')}</span>
                          <span>{t(feat)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <p class="pricing-separate">{t('pricing.separate')}</p>
    <p class="pricing-disclaimer">{t('pricing.disclaimer')}</p>
  </div>
</section>

<script>
  import { mountPricingToggle } from '../scripts/pricing-toggle';
  mountPricingToggle();

  // Smoke is decorative; keep its canvas module out of the initial hero
  // load and start it only when pricing is getting close.
  async function startSmoke() {
    const { mountGlassSmoke } = await import('../scripts/glass-smoke');
    mountGlassSmoke();
  }

  function startSmokeWhenNear() {
    const pricingStage = document.querySelector<HTMLElement>('.pricing-stage');
    if (!pricingStage) return;

    const supportsObserver = 'IntersectionObserver' in globalThis;
    if (!supportsObserver) {
      globalThis.addEventListener('scroll', startSmoke, { once: true, passive: true });
      return;
    }

    const smokeObserver = new window.IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        smokeObserver.disconnect();
        startSmoke();
      },
      { rootMargin: '560px 0px' },
    );
    smokeObserver.observe(pricingStage);
  }
  startSmokeWhenNear();
</script>

<style>
  .pricing-stage {
    position: relative;
    width: 100%;
    /* border-top removed 2026-05-17: no horizontal dividers between sections */
    background: var(--color-bg-canvas);
    padding: clamp(4rem, 9vw, 8rem) clamp(1rem, 4vw, 3rem);
    overflow: hidden;
  }
  .pricing-stage::before {
    /* Subtle radial cyan glow behind the cards — same family as the
       hero halo, tuned dim. Doesn't compete with the headline. Sits
       above the smoke canvas so the brightest cyan stays centred. */
    content: '';
    position: absolute;
    inset: -10% 20% auto 20%;
    height: 60%;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 240, 255, 0.12),
      transparent 70%
    );
    pointer-events: none;
    filter: blur(40px);
    z-index: 1;
  }

  /* Smoke field canvas — full-section, behind everything.
     Positioned absolutely so the section's normal flow ignores it.
     Painted in glass-smoke.ts. */
  .glass-smoke {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    /* Slight extra saturation/contrast on the canvas itself helps the
       cyan smoke read against the dark canvas without us needing to
       crank per-puff alpha. */
    filter: saturate(120%) brightness(1.05);
    /* Soft fade at top + bottom so the smoke doesn't hard-cut against
       the previous/next stage borders. */
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  .pricing-inner {
    position: relative;
    margin: 0 auto;
    max-width: 84rem;
    z-index: 2;
  }

  /* ─── Header ─────────────────────────────────────────────────── */

  .pricing-header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .pricing-eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
  }

  .pricing-headline {
    margin: 0;
    max-width: min(100%, 56rem);
    margin-inline: auto;
    padding-inline: 1rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    font-size: clamp(2rem, 4.6vw, 4rem);
    text-wrap: balance;
  }
  .pricing-headline-accent {
    color: var(--color-accent-primary);
  }

  .pricing-subline {
    margin: 1.25rem auto 0;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  @media (min-width: 640px) {
    .pricing-subline {
      font-size: 1.125rem;
    }
  }

  /* Tax footnote — quieter than the subline so it reads as legal
     fine print, not as a second selling line. */
  .pricing-vat-note {
    margin: 0.5rem auto 0;
    max-width: 38rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    opacity: 0.72;
    text-wrap: pretty;
  }

  /* ─── Twin-pill toggle ─────────────────────────────────────────
     Each button is its own glass pill. Active state inherits the
     hero-pill--filled cyan look; inactive inherits hero-pill--ghost.
     No sliding thumb so unequal button widths (the −17 % badge makes
     "Ročně" wider than "Měsíčně") can't clip the active label. */

  .pricing-toggle {
    --toggle-x: 5px;
    --toggle-w: 0px;
    position: relative;
    display: inline-flex;
    align-items: stretch;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 5px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.025);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 8px 28px -14px rgba(0, 0, 0, 0.5);
  }

  .pricing-toggle-thumb {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 0;
    width: var(--toggle-w);
    border-radius: 9999px;
    background: var(--color-accent-primary);
    border: 1px solid rgba(0, 240, 255, 0.62);
    box-shadow:
      0 10px 30px -12px rgba(0, 240, 255, 0.62),
      0 0 0 1px rgba(0, 240, 255, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.36);
    transform: translateX(var(--toggle-x));
    transition:
      transform 0.48s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.48s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
    pointer-events: none;
    z-index: 0;
  }

  .pricing-toggle-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    /* Min 44 px tap target for phone — was 41 px (audit 2026-05-01). */
    min-height: 44px;
    gap: 0.45rem;
    padding: 0.65rem 1.15rem;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }
  .pricing-toggle-btn:hover {
    color: var(--color-text-primary);
    background: rgba(0, 240, 255, 0.06);
  }

  /* Active = filled cyan (matches .hero-pill--filled) */
  .pricing-toggle-btn--active,
  .pricing-toggle-btn[aria-selected='true'] {
    background: var(--color-accent-primary);
    color: var(--color-accent-primary-cta-fg);
    border-color: rgba(0, 240, 255, 0.6);
    box-shadow:
      0 8px 26px -10px rgba(0, 240, 255, 0.5),
      0 0 0 1px rgba(0, 240, 255, 0.35);
  }
  .pricing-toggle-btn--active:hover,
  .pricing-toggle-btn[aria-selected='true']:hover {
    background: var(--color-accent-primary-hover);
    color: var(--color-accent-primary-cta-fg);
  }

  .pricing-toggle--ready .pricing-toggle-btn--active,
  .pricing-toggle--ready .pricing-toggle-btn[aria-selected='true'] {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .pricing-toggle--ready .pricing-toggle-btn--active:hover,
  .pricing-toggle--ready .pricing-toggle-btn[aria-selected='true']:hover {
    background: transparent;
  }

  .pricing-toggle-label {
    font-size: inherit;
  }

  .pricing-toggle-savings {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: rgba(0, 240, 255, 0.18);
    color: var(--color-accent-primary);
  }
  /* On the active (filled) variant the badge needs darker fill so
     it's still readable on the cyan button. */
  .pricing-toggle-btn--active .pricing-toggle-savings,
  .pricing-toggle-btn[aria-selected='true'] .pricing-toggle-savings {
    background: rgba(0, 16, 20, 0.18);
    color: var(--color-accent-primary-cta-fg);
  }

  /* One-shot pop when the user switches TO yearly — the saving is the
     selling point of that click, so it celebrates briefly. Class is
     added in pricing-toggle.ts and removed on animationend; never
     plays for reduced-motion users (JS gate). */
  .pricing-toggle-savings.is-pop {
    animation: pricing-badge-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes pricing-badge-pop {
    0% { transform: scale(1); }
    35% { transform: scale(1.28); }
    100% { transform: scale(1); }
  }

  /* ─── Tracks + cards grid ───────────────────────────────────────
     Phone: one column. Tablet: tracks stacked, two cards per track.
     Desktop: both tracks side by side, four cards in a row. */

  .pricing-tracks {
    display: grid;
    gap: clamp(2rem, 4vw, 2.5rem) 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1100px) {
    .pricing-tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pricing-track-label {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    text-align: center;
  }

  .pricing-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .pricing-cards {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  /* Pricing card uses the global .glass-card recipe (all 4 layers +
     hover defined in src/styles/global.css). The component-local rule
     here only contributes pricing-specific padding inside .glass-content. */
  .pricing-card .glass-content {
    padding: 1.75rem 1.5rem 1.5rem;
    /* Column so the free card's closing line can be pushed to the bottom
       edge with margin-top:auto once the cards stretch to equal height. */
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /*
    Spotlight border (2026-06-10) — a cyan ring segment that follows the
    cursor across each card. Implemented as a masked overlay: the radial
    gradient is centred on --mx/--my (set rAF-batched in
    pricing-toggle.ts) and the mask keeps only a 1.5px border band, so
    it reads as the card edge lighting up near the pointer. Hidden until
    the section is hovered; costs one composited layer per card, nothing
    on coarse-pointer devices (JS never sets the vars there).
  */
  .pricing-card {
    position: relative;
  }
  .pricing-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    padding: 1.5px;
    background: radial-gradient(
      220px circle at var(--mx, 50%) var(--my, 50%),
      rgba(0, 240, 255, 0.55),
      rgba(0, 240, 255, 0.12) 38%,
      transparent 70%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .pricing-cards:hover .pricing-card::after {
      opacity: 1;
    }
  }

  .pricing-card-header {
    margin-bottom: 1.5rem;
  }
  .pricing-card-name {
    margin: 0 0 0.4rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .pricing-card-tagline {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    /* Two lines reserved so prices line up across the row. */
    min-height: 2.9em;
  }

  .pricing-card-price {
    margin-bottom: 1.5rem;
  }

  /* Currency deliberately smaller than the amount (owner 2026-06-10) —
     the number is the message, "Kč" is a unit. */
  .pricing-currency {
    font-size: 0.55em;
    font-weight: 700;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }

  .pricing-price-block {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }
  .pricing-card-price {
    position: relative;
    min-height: 4.65rem;
  }

  .pricing-card:not(.pricing-card--free) .pricing-price-block--monthly,
  .pricing-card:not(.pricing-card--free) .pricing-price-block--yearly {
    display: flex;
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    opacity: 0;
    transform: translateY(0.55rem) scale(0.985);
    filter: blur(2px);
