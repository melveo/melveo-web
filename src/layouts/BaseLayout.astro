---
/**
 * BaseLayout — fullwidth, indie-iOS-app style, locale-aware.
 *
 * No max-width container; pages render edge-to-edge. Content padding
 * is handled per-section. Header is intentionally absent on the
 * landing — the wordmark sits inside the hero. Privacy/Terms pages
 * use their own constrained article width.
 *
 * Locale-aware: takes `lang` prop, renders correct hreflang + footer
 * + canonical with locale prefix. URL strategy per PLAN.md §16.5:
 * /cs/ canonical for Czech, /en/ for English, root / is a client-side
 * redirect that reads navigator.language.
 *
 * Apple App Store discipline (docs/planning/15 §"Apple-safe"):
 * the iOS companion app must never see Buy/Subscribe CTAs. The web
 * surface is allowed and required to host the App Store badge,
 * pilot enquiry email, and legal pages.
 */

import { useTranslations, type Lang } from '../i18n/ui';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import AnalyticsBody from '../components/AnalyticsBody.astro';

interface Props {
  title: string;
  description?: string;
  /** Locale of the page. Required so footer + hreflang render correctly. */
  lang: Lang;
  /** Path-only URL used for canonical + OG tags. Trailing slash optional. */
  canonical?: string;
  /** Override the default OG image. */
  ogImage?: string;
  /** When true, render the minimal landing footer (default).
   *  Privacy/Terms pages set this false to render an even lighter footer. */
  showLandingFooter?: boolean;
  /** Hide utility / transaction pages from search indexes. */
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  canonical,
  ogImage = '/og-melveo-wordmark-2026-06-01.jpg',
  showLandingFooter = true,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);

const defaultDescription =
  lang === 'cs'
    ? 'Melveo propojí wellness, readiness a zátěž hráčů do jednoho přehledu. Trenér ráno ví, kdo je připravený, koho šetřit a co změnit v plánu. Vyzkoušejte pilot.'
    : 'Melveo turns player wellness, readiness and load into one clear view. Coaches know who is ready, who to rest and what to change — before training starts.';

const finalDescription = description ?? defaultDescription;

const fullTitle =
  title === 'Melveo'
    ? lang === 'cs'
      ? 'Melveo — hráčské signály do rozhodnutí trenéra'
      : 'Melveo — athlete signals into coach decisions'
    : `${title} — Melveo`;
const canonicalUrl = canonical
  ? new URL(canonical, Astro.site).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();

// hreflang alternates — derived from current path
const otherLang: Lang = lang === 'cs' ? 'en' : 'cs';
const currentPathWithoutLocale = Astro.url.pathname.replace(/^\/(cs|en)/, '') || '/';
const altUrls = {
  cs: new URL(`/cs${currentPathWithoutLocale}`, Astro.site).toString(),
  en: new URL(`/en${currentPathWithoutLocale}`, Astro.site).toString(),
  default: new URL(`/cs${currentPathWithoutLocale}`, Astro.site).toString(),
};
---

<!doctype html>
<html lang={lang === 'cs' ? 'cs' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />

    {/* Browser-chrome theming — matches the dark canvas brand colour
        so the iOS Safari URL bar / Android Chrome system bar tints
        with the page (audit 2026-05-03). */}
    <meta name="theme-color" content="#06090f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#06090f" />

    {/* iOS home-screen / PWA-ish behaviour — when a user adds the
        site to their home screen, this controls the launch chrome. */}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Melveo" />

    {/* Disable iOS's "tappable" autolinking on phone-shaped numbers
        in copy (some pricing strings get mistaken for phone numbers
        and turn blue + clickable on iOS Safari). */}
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />

    {/*
      Favicon set — light-silver Melveo "M" icon. Includes a cache-
      bust query param to force browsers off any stale older favicon
      they may have pinned at /favicon.ico. Update the value whenever
      the icon visuals change.
      Perf (audit 2026-06-11): the PNG icon link used to point at the
      1024×1024 master (115 KB downloaded by every cold visit just for
      a tab icon). Now 192px for rel=icon, 180px for apple-touch-icon
      (Apple's documented size), and favicon.ico re-packed 48/32/16
      (32→15 KB). The 1024 master stays only as the OG/manifest source.
    */}
    <link rel="icon" type="image/svg+xml" href="/app-icon-melveo.svg?v=2026-05-15d" />
    <link rel="icon" type="image/png" href="/app-icon-192.png?v=2026-06-11" sizes="192x192" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2026-06-11" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico?v=2026-06-11" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2026-06-11" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest?v=2026-06-11" />
    <link rel="canonical" href={canonicalUrl} />
    {/*
      Inter `latin` carries the base A–Z glyphs, `latin-ext` only the
      diacritics (č ě ř ž …). Czech headlines therefore need BOTH
      subsets before the hero headline can take its final paint —
      preloading only ext left the latin file to late CSS discovery
      and pushed mobile LCP to ~6s (audit 2026-06-10).
    */}
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {lang === 'cs' && (
      <link
        rel="preload"
        href="/fonts/inter-latin-ext-wght-normal.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}

    {/*
      Two-font stack — see docs/fonts.md for the full rationale.

      Brand wordmark (Comfortaa) — applied to .melveo-wordmark + the
        hero headline. Identified 2026-05-15 from the brand apparel /
        downloads: rounded geometric sans with the signature lowercase
        "l" that carries a small bottom curl (Quicksand's straight "l"
        was the visible mismatch). Weights 500/600/700.

      Body sans (Inter) — applied via --font-sans to everything else
        (paragraphs, UI labels, buttons, pricing cards). Inter is the
        de-facto SaaS body font in 2026 — Vercel, Linear, Notion,
        GitHub Next, Stripe… all use it. Highly readable on screens,
        excellent at small sizes, broad Czech diacritic support.
        Weights 400/500/600/700.
    */}
    {/*
      Fonts (Inter Variable + Comfortaa Variable) are self-hosted via
      /public/fonts and declared in src/styles/global.css so we ship
      only the CS/EN latin + latin-ext subsets the landing page needs.
      No <link rel="preconnect"> or <link rel="stylesheet">
      to fonts.googleapis.com needed; that hop was costing ~50–80 ms
      cold-cache RTT plus a CSP allowlist entry. Audit 2026-05-18.
    */}

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="cs" href={altUrls.cs} />
    <link rel="alternate" hreflang="en" href={altUrls.en} />
    <link rel="alternate" hreflang="x-default" href={altUrls.default} />

    <title>{fullTitle}</title>
    <meta name="description" content={finalDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- OG / Twitter -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Melveo" />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta property="og:locale:alternate" content={otherLang === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta name="twitter:image:alt" content={fullTitle} />

    {/* JSON-LD — SoftwareApplication schema for App Store discoverability */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Melveo',
        applicationCategory: 'SportsApplication',
        operatingSystem: 'iOS, iPadOS',
        description: finalDescription,
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'CZK',
        },
        publisher: {
          '@type': 'Organization',
          name: 'QUIX Global s.r.o.',
          identifier: '22466444',
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Příčná 1892/4',
            addressLocality: 'Praha',
            postalCode: '11000',
            addressCountry: 'CZ',
          },
          email: 'hello@melveo.app',
          url: 'https://melveo.app',
        },
        inLanguage: lang === 'cs' ? 'cs-CZ' : 'en-US',
        url: canonicalUrl,
      })}
    />

    <AnalyticsHead />
  </head>
  <body class="min-h-screen bg-[var(--color-bg-canvas)] text-[var(--color-text-primary)]">
    <AnalyticsBody />
    {/* Skip link — first focusable element; visible only on keyboard
        focus. Lets keyboard/AT users jump straight past the header
        to the content (a11y audit 2026-07-10). */}
    <a href="#main-content" class="skip-link">
      {lang === 'cs' ? 'Přeskočit na obsah' : 'Skip to content'}
    </a>
    <main id="main-content">
      <slot />
    </main>
    <CookieBanner lang={lang} />

    {
      showLandingFooter && (
        <footer class="border-t border-[var(--color-stroke-base)]/60">
          {/* Footer links use inline-flex + min-height: 44px for phone
              tap-target compliance (audit 2026-05-01) — was 20 px row
              height, well under 44 px guideline. py-2 gives 8 px above
              + below the 14 px text → 30 px content + padding = 46 px
              total clickable height. */}
          <div class="flex flex-col items-center gap-4 px-6 py-10 text-center text-sm text-[var(--color-text-secondary)] sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-8 sm:gap-y-4">
            <span>{t('footer.copyright')}</span>
            <a
              href={`/${lang}/privacy/`}
              class="inline-flex items-center min-h-[44px] py-2 transition-colors hover:text-[var(--color-text-primary)]"
            >
              {t('footer.privacy')}
            </a>
            <a
              href={`/${lang}/terms/`}
              class="inline-flex items-center min-h-[44px] py-2 transition-colors hover:text-[var(--color-text-primary)]"
            >
              {t('footer.terms')}
            </a>
            <button
              type="button"
              data-cookie-reopen
              class="inline-flex items-center min-h-[44px] py-2 bg-transparent border-0 cursor-pointer text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)] font-inherit text-inherit"
            >
              {t('footer.cookieSettings')}
            </button>
            <LocaleSwitcher current={lang} />
          </div>
        </footer>
      )
    }

    {/*
      Global SVG displacement filter — referenced by .glass-card .glass-filter
      from any section that uses the liquid-glass recipe (pricing cards,
      pricing extras, image-grid tech cards). Put once at body root so
      every component can use it via filter: url(#glass-lens) without
      duplicating the SVG.

      feComponentTransfer → feGaussianBlur on alpha → feDisplacementMap:
      blurs the alpha channel and uses it to warp source pixels. The
      effect is a soft refraction halo at element edges — what makes the
      card actually read as glass instead of just a translucent rectangle.
    */}
    <svg
      class="glass-lens-defs"
      xmlns="http://www.w3.org/2000/svg"
      style="position:absolute;width:0;height:0;pointer-events:none;"
      aria-hidden="true"
    >
      <filter
        id="glass-lens"
        x="0%"
        y="0%"
        width="100%"
        height="100%"
        filterUnits="objectBoundingBox"
      >
        <feComponentTransfer in="SourceAlpha" result="alpha">
          <feFuncA type="identity" />
        </feComponentTransfer>
        <feGaussianBlur in="alpha" stdDeviation="50" result="blur" />
        <feDisplacementMap
          in="SourceGraphic"
          in2="blur"
          scale="40"
          xChannelSelector="A"
          yChannelSelector="A"
        />
      </filter>
    </svg>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

<script>
  // Footer "Cookie nastavení" → re-open banner.
  import { reopenBanner } from '../scripts/consent';

  document.querySelectorAll<HTMLButtonElement>('[data-cookie-reopen]').forEach((btn) => {
    btn.addEventListener('click', () => reopenBanner());
  });
</script>
