---
import { useTranslations, type Lang } from '../i18n/ui';

/**
 * CookieBanner — Aaron Iker style (V4-E).
 *
 * Bottom slide-up sheet, blur backdrop, 3 buttons: Reject / Customize /
 * Accept. Customize panel toggles analytics + marketing categories.
 *
 * Per PLAN.md §7.8.
 */

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="cookie-banner" data-banner-state="hidden" role="dialog" aria-labelledby="cookie-banner-title" aria-describedby="cookie-banner-body">
  <div class="banner-shell">
    <div class="banner-icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 109.94 11.05A4 4 0 0117.5 9a4 4 0 01-4-4 10 10 0 00-1.5-3z"/>
        <circle cx="9" cy="11" r="1"/>
        <circle cx="14" cy="14" r="1"/>
        <circle cx="11" cy="16.5" r="0.8"/>
        <circle cx="15.5" cy="9.5" r="0.8"/>
      </svg>
    </div>

    <div class="banner-body">
      <h3 id="cookie-banner-title" class="banner-title">{t('cookie.title')}</h3>
      <p id="cookie-banner-body" class="banner-text">
        {t('cookie.body')}
        {' '}
        <a href={`/${lang}/privacy/`}>{t('cookie.privacy')}</a>.
      </p>
    </div>

    <div class="banner-actions">
      <button type="button" data-consent-action="reject" class="btn btn-ghost">
        {t('cookie.reject')}
      </button>
      <button type="button" data-consent-action="customize" class="btn btn-ghost" aria-expanded="false" aria-controls="cookie-customize-panel">
        {t('cookie.customize')}
      </button>
      <button type="button" data-consent-action="accept" class="btn btn-primary">
        {t('cookie.accept')}
      </button>
    </div>

    <div id="cookie-customize-panel" class="banner-customize" hidden>
      <label class="banner-toggle">
        <input type="checkbox" disabled checked aria-disabled="true" />
        <span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
        <span class="toggle-label">
          <strong>{lang === 'cs' ? 'Nezbytné' : 'Necessary'}</strong>
          <em>{lang === 'cs' ? 'Vždy aktivní — bez nich web nefunguje.' : 'Always on — required for the site to work.'}</em>
        </span>
      </label>
      <label class="banner-toggle">
        <input type="checkbox" data-consent-cat="analytics" />
        <span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
        <span class="toggle-label">
          <strong>{lang === 'cs' ? 'Statistiky' : 'Analytics'}</strong>
          <em>{lang === 'cs' ? 'Anonymizované návštěvnost (Google Analytics, Cloudflare).' : 'Anonymized usage (Google Analytics, Cloudflare).'}</em>
        </span>
      </label>
      <label class="banner-toggle">
        <input type="checkbox" data-consent-cat="marketing" />
        <span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
        <span class="toggle-label">
          <strong>{lang === 'cs' ? 'Marketing' : 'Marketing'}</strong>
          <em>{lang === 'cs' ? 'Reklamní pixely (Meta) — pomáhá nám oslovit relevantní kluby.' : 'Ad pixels (Meta) — helps us reach relevant clubs.'}</em>
        </span>
      </label>
      <div class="banner-customize-actions">
        <button type="button" data-consent-action="save" class="btn btn-primary">
          {lang === 'cs' ? 'Uložit volbu' : 'Save selection'}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #cookie-banner {
    position: fixed;
    inset: auto 0 1.5rem 0;
    margin: 0 auto;
    padding: 0 1rem;
    /* Narrower on phones (was 40rem cap with no min — covered ~60 %
       of mobile viewport including stacked buttons). User feedback
       2026-05-03: should not eat the hero on first load. */
    max-width: min(34rem, calc(100vw - 1.5rem));
    /* Honour iPhone home-indicator safe area so the banner sits
       above it instead of underneath. */
    padding-bottom: env(safe-area-inset-bottom, 0);
    z-index: 100;
    transform: translateY(140%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }
  #cookie-banner[data-banner-state="visible"] {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .banner-shell {
    background: rgba(15, 17, 22, 0.92);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.25rem;
    padding: 1.25rem 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "icon body"
      "actions actions"
      "panel panel";
    gap: 0.75rem 1rem;
    box-shadow: 0 30px 80px -16px rgba(0, 0, 0, 0.6);
    color: var(--color-text-primary);
  }

  .banner-icon {
    grid-area: icon;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    color: var(--color-accent-primary);
    flex-shrink: 0;
  }
  .banner-icon svg {
    width: 100%;
    height: 100%;
  }

  .banner-body {
    grid-area: body;
  }
  .banner-title {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .banner-text {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .banner-text a {
    color: var(--color-accent-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .banner-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn {
    border: 0;
    border-radius: 0.75rem;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .btn-ghost {
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-primary);
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .btn-primary {
    background: var(--color-accent-primary);
    color: var(--color-accent-primary-cta-fg);
  }
  .btn-primary:hover {
    background: var(--color-accent-primary-hover);
  }

  .banner-customize {
    grid-area: panel;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .banner-toggle {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.875rem;
    cursor: pointer;
  }
  .banner-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .toggle-track {
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    position: relative;
    transition: background 0.15s ease;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: white;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .banner-toggle input:checked + .toggle-track {
    background: var(--color-accent-primary);
  }
  .banner-toggle input:checked + .toggle-track .toggle-thumb {
    transform: translateX(1rem);
    background: var(--color-accent-primary-cta-fg);
  }
  .banner-toggle input:disabled + .toggle-track {
    background: rgba(0, 240, 255, 0.5);
    opacity: 0.7;
  }

  .toggle-label strong {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .toggle-label em {
    display: block;
    font-style: normal;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin-top: 0.125rem;
  }

  .banner-customize-actions {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 480px) {
    #cookie-banner {
      inset: auto 0 0.45rem 0;
      max-width: min(30rem, calc(100vw - 0.75rem));
      padding-inline: 0.375rem;
    }
    /* Compact card on mobile — smaller padding + smaller fonts so
       the banner is unobtrusive (was a tall card with stacked
       buttons that ate ~50 % of the viewport on first load). */
    .banner-shell {
      padding: 0.7rem 0.72rem 0.82rem;
      gap: 0.42rem 0.62rem;
      grid-template-areas:
        "icon body"
        "actions actions"
        "panel panel";
      border-radius: 1rem;
    }
    .banner-icon {
      width: 1.45rem;
      height: 1.45rem;
    }
    .banner-title {
      font-size: 0.82rem;
      margin-bottom: 0.12rem;
    }
    .banner-text {
      font-size: 0.72rem;
      line-height: 1.32;
    }
    /* Keep buttons HORIZONTAL on phones (was column-stacking, which
       added ~120 px of height). Tighter buttons + ellipsis-prone
       sizing keeps three buttons in one row on viewports ≥ 360 px. */
    .banner-actions {
      flex-direction: row;
      gap: 0.3rem;
    }
    .banner-actions .btn {
      flex: 1 1 0;
      width: auto;
      min-height: 2.2rem;
      padding: 0.45rem 0.48rem;
      font-size: 0.72rem;
      white-space: nowrap;
      border-radius: 0.65rem;
    }
    .banner-customize {
      max-height: min(34vh, 16rem);
      overflow: auto;
      padding-top: 0.62rem;
      gap: 0.6rem;
      overscroll-behavior: contain;
    }
    .banner-toggle {
      gap: 0.55rem;
    }
    .toggle-track {
      width: 2rem;
      height: 1.12rem;
    }
    .toggle-thumb {
      width: 0.88rem;
      height: 0.88rem;
    }
    .banner-toggle input:checked + .toggle-track .toggle-thumb {
      transform: translateX(0.88rem);
    }
    .toggle-label strong {
      font-size: 0.78rem;
    }
    .toggle-label em {
      font-size: 0.68rem;
      line-height: 1.25;
    }
  }
</style>

<script>
  import { loadConsent, saveConsent } from '../scripts/consent';

  const banner = document.querySelector<HTMLElement>('#cookie-banner');
  if (banner) {
    const customizePanel = banner.querySelector<HTMLElement>('#cookie-customize-panel');
    const customizeBtn = banner.querySelector<HTMLButtonElement>('[data-consent-action="customize"]');
    const analyticsToggle = banner.querySelector<HTMLInputElement>('[data-consent-cat="analytics"]');
    const marketingToggle = banner.querySelector<HTMLInputElement>('[data-consent-cat="marketing"]');

    function showBanner() {
      // Reveal AFTER the user has had a chance to see the hero clean.
      // Wait for either of:
      //   - first scroll event (user has engaged), OR
      //   - 4 s timeout (user is reading, hero already absorbed)
      // Whichever fires first, then defer one more idle tick so we
      // don't compete with whatever rAF / animation is running.
      // User feedback 2026-05-03: previous behaviour showed the
      // banner during initial paint, eating ~50 % of the hero.
      const reveal = () => {
        banner!.dataset.bannerState = 'visible';
      };
      let revealed = false;
      const safeReveal = () => {
        if (revealed) return;
        revealed = true;
        if ('requestIdleCallback' in window) {
          (window as any).requestIdleCallback(reveal, { timeout: 600 });
        } else {
          setTimeout(reveal, 60);
        }
      };
      window.addEventListener('scroll', safeReveal, { once: true, passive: true });
      setTimeout(safeReveal, 4000);
    }

    function hideBanner() {
      banner!.dataset.bannerState = 'hidden';
    }

    function expandCustomize() {
      if (customizePanel && customizeBtn) {
        customizePanel.hidden = false;
        customizeBtn.setAttribute('aria-expanded', 'true');
      }
    }

    // Show on first visit / version mismatch
    if (!loadConsent()) {
      showBanner();
    }

    // Re-open from footer link
    window.addEventListener('melveo-consent-reopen', () => {
      // Pre-populate toggles from existing state if any
      const current = loadConsent();
      if (analyticsToggle) analyticsToggle.checked = current?.analytics ?? false;
      if (marketingToggle) marketingToggle.checked = current?.marketing ?? false;
      showBanner();
    });

    banner.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-consent-action]');
      if (!btn) return;
      const action = btn.dataset.consentAction;

      if (action === 'accept') {
        saveConsent({ analytics: true, marketing: true });
        hideBanner();
      } else if (action === 'reject') {
        saveConsent({ analytics: false, marketing: false });
        hideBanner();
      } else if (action === 'customize') {
        expandCustomize();
      } else if (action === 'save') {
        saveConsent({
          analytics: !!analyticsToggle?.checked,
          marketing: !!marketingToggle?.checked,
        });
        hideBanner();
      }
    });
  }
</script>
