---
/**
 * Root locale detector — redirects to /cs/ or /en/ based on browser
 * Accept-Language. Static SSR fallback uses meta refresh to /cs/.
 *
 * Per PLAN.md §16.5: when /cs/ is canonical (prefixDefaultLocale: true)
 * the root path needs an explicit page; this is it.
 *
 * Implementation order:
 *   1. <meta http-equiv="refresh"> sends crawlers + JS-disabled
 *      browsers to /cs/ as a safe default.
 *   2. Inline <script> reads navigator.languages, picks the best
 *      match, replaces window.location before the meta refresh
 *      fires (~0.1s window).
 *
 * Cloudflare Pages will respect the redirect; Apple bots see
 * meta refresh (acceptable for non-AASA paths).
 */

const supportedLocales = ['cs', 'en'] as const;
type Locale = (typeof supportedLocales)[number];

// Default fallback (no JS / SSR view)
const fallbackLocale: Locale = 'cs';
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Melveo</title>
    <meta name="description" content="Melveo — chytřejší tréninky, zdravější hráči." />
    {/* Same cache-busted favicon set as BaseLayout — keep in sync. */}
    <link rel="icon" type="image/svg+xml" href="/app-icon-melveo.svg?v=2026-05-15d" />
    <link rel="icon" type="image/png" href="/app-icon-melveo.png?v=2026-05-15d" sizes="1024x1024" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2026-05-15d" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico?v=2026-05-15d" />
    <link rel="apple-touch-icon" href="/app-icon-melveo.png?v=2026-05-15d" sizes="1024x1024" />
    <link rel="manifest" href="/site.webmanifest?v=2026-05-15d" />
    <link rel="canonical" href="https://melveo.app/cs/" />

    <meta property="og:title" content="Melveo" />
    <meta property="og:description" content="Melveo — chytřejší tréninky, zdravější hráči." />
    <meta property="og:url" content="https://melveo.app/cs/" />
    <meta property="og:image" content="https://melveo.app/og-default.jpg" />
    <meta property="og:image:alt" content="Melveo" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Melveo" />
    <meta property="og:locale" content="cs_CZ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Melveo" />
    <meta name="twitter:description" content="Melveo — chytřejší tréninky, zdravější hráči." />
    <meta name="twitter:image" content="https://melveo.app/og-default.jpg" />
    <meta name="twitter:image:alt" content="Melveo" />

    <!-- Wordmark font — same Quicksand load as BaseLayout. The user
         only sees this page for ~0.1s before the redirect, so the
         font may not finish downloading; fallback to Inter / system
         is fine. Mirrored for consistency with the rest of the site
         and so search-bot snapshots render the wordmark in brand. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap"
    />

    <!-- hreflang for crawlers landing on root -->
    <link rel="alternate" hreflang="cs" href="https://melveo.app/cs/" />
    <link rel="alternate" hreflang="en" href="https://melveo.app/en/" />
    <link rel="alternate" hreflang="x-default" href="https://melveo.app/cs/" />

    <meta http-equiv="refresh" content={`0; url=/${fallbackLocale}/`} />

    <script is:inline define:vars={{ supportedLocales, fallbackLocale }}>
      // Pick best matching locale from navigator.languages
      const langs = navigator.languages ?? [navigator.language ?? 'cs'];
      let target = fallbackLocale;
      outer: for (const l of langs) {
        const lower = l.toLowerCase();
        for (const supported of supportedLocales) {
          if (lower === supported || lower.startsWith(supported + '-')) {
            target = supported;
            break outer;
          }
        }
      }
      // Replace so back button doesn't return here
      window.location.replace(`/${target}/`);
    </script>

    <style>
      body {
        margin: 0;
        background: #050608;
        color: #f5feff;
        font-family: -apple-system, BlinkMacSystemFont, "Inter", system-ui, sans-serif;
        display: grid;
        place-items: center;
        min-height: 100vh;
      }
      .shell {
        text-align: center;
        opacity: 0.6;
      }
      .wordmark {
        font-family: "Quicksand", "Inter", -apple-system, system-ui, sans-serif;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        text-transform: lowercase;
        margin-bottom: 0.5rem;
      }
      .hint a {
        color: #00f0ff;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <div class="wordmark">melveo</div>
      <div class="hint">
        <a href="/cs/">Pokračovat / Continue</a>
      </div>
    </div>
  </body>
</html>
