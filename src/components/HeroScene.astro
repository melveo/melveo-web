---
/**
 * HeroScene — WebGL metaballs shader + black SSR fallback.
 *
 * Behavior:
 *   - SSR renders a black fallback for the short moment before client JS.
 *   - On client, as soon as the hero is in viewport, mount the custom
 *     metaballs shader. No SVG preview, no CSS replacement layer.
 *   - Per PLAN.md §7.9: pause RAF on document.hidden, cap pixel ratio,
 *     reduce-motion stays fallback only.
 */
---

<div class="hero-scene-wrap" aria-hidden="true">
  <svg
    class="hero-fallback"
    viewBox="0 0 100 100"
    preserveAspectRatio="xMidYMid slice"
    role="presentation"
  >
    <rect width="100" height="100" fill="#000" />
  </svg>

  <canvas class="hero-canvas" data-hero-canvas></canvas>
</div>

<style>
  .hero-scene-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .hero-fallback,
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.45s ease;
  }

  .hero-canvas {
    opacity: 0;
  }

  .hero-canvas[data-mounted="true"] {
    opacity: 1;
  }

  .hero-scene-wrap[data-mounted="true"] .hero-fallback {
    opacity: 0;
  }

  /*
    Reduce blob dominance on phone — at small viewports the
    metaballs were covering most of the screen behind hero copy
    (user feedback 2026-05-16: "na telefonu asi méně té hmoty").
    Drop opacity so headline + keyword pills + CTAs stay the
    focal layer; blob still reads as background atmosphere.
  */
  @media (max-width: 520px) {
    .hero-canvas[data-mounted="true"] {
      opacity: 0.55;
    }
  }
</style>

<script>
  const wrap = document.querySelector<HTMLDivElement>('.hero-scene-wrap');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wrap && canvas && !prefersReducedMotion) {
    let started = false;

    const start = async () => {
      if (started) return;
      started = true;

      const { mountHeroScene } = await import('../scripts/hero-scene');
      const handle = mountHeroScene({ canvas });
      if (!handle) return;

      canvas.setAttribute('data-mounted', 'true');
      wrap.setAttribute('data-mounted', 'true');

      if (import.meta.hot) {
        import.meta.hot.dispose(() => handle.dispose());
      }
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        start();
      });

      observer.observe(wrap);
    } else {
      start();
    }
  }
</script>
