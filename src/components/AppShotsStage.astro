---
/**
 * AppShotsStage — three iPhone-frame screenshots of the Melveo app.
 *
 * Currently placeholder state: 3 empty phone frames in the correct
 * sizes + positions, with "Snímek bude doplněn" text inside. When
 * the user provides real PNG/WEBP files (1080×2340 portrait iOS
 * mockups), drop them into /public/images/app-shots/ as:
 *   - check-in.webp
 *   - sessions.webp
 *   - coach-board.webp
 * then set `placeholder={false}` in Landing.astro and the same
 * frames render the real images.
 *
 * Design intent (added 2026-05-03):
 *   - Three phone frames in a row on desktop, single column on
 *     mobile.
 *   - Centre frame slightly larger + on top (z-index) so it reads
 *     as the "hero" shot. Same Apple App Store featured-app
 *     pattern.
 *   - Subtle parallax-like rotation on side frames so the trio
 *     reads as a perspective view, not a flat strip.
 *   - Phone-frame chrome rendered via CSS (border-radius +
 *     gradient + notch) so we don't ship an image just for the
 *     bezel.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** When true (default), renders the empty phone-frame placeholder.
   *  Flip to false once real screenshots are in /public/images/app-shots/. */
  placeholder?: boolean;
}

const { lang, placeholder = true } = Astro.props;
const t = useTranslations(lang);

const shots = [
  {
    title: t('appShots.shot1Title'),
    caption: t('appShots.shot1Caption'),
    image: '/images/app-shots/check-in.webp',
    alt:
      lang === 'cs'
        ? 'Ranní wellness obrazovka v iOS appce Melveo.'
        : 'Morning wellness screen in the Melveo iOS app.',
  },
  {
    title: t('appShots.shot2Title'),
    caption: t('appShots.shot2Caption'),
    image: '/images/app-shots/sessions.webp',
    alt:
      lang === 'cs'
        ? 'Sessions plán obrazovka v iOS appce Melveo.'
        : 'Sessions plan screen in the Melveo iOS app.',
  },
  {
    title: t('appShots.shot3Title'),
    caption: t('appShots.shot3Caption'),
    image: '/images/app-shots/coach-board.webp',
    alt:
      lang === 'cs'
        ? 'Coach board obrazovka v iOS appce Melveo.'
        : 'Coach board screen in the Melveo iOS app.',
  },
];
---

<section class="app-shots-stage" aria-labelledby="app-shots-heading">
  <div class="app-shots-stage__intro">
    <h2 id="app-shots-heading" class="app-shots-stage__headline">
      {t('appShots.headline')}
    </h2>
    <p class="app-shots-stage__body">{t('appShots.body')}</p>
  </div>

  <ul class="app-shots-stage__grid" role="list">
    {shots.map((shot, index) => (
      <li class:list={['app-shots-stage__cell', `app-shots-stage__cell--${index + 1}`]}>
        <figure class="app-shots-stage__phone">
          {/* Phone frame chrome — 4-layer recipe:
                outer bezel  = the .app-shots-stage__phone container
                screen       = .app-shots-stage__screen (rounded inner)
                notch        = .app-shots-stage__notch (Dynamic Island)
                content      = real img OR placeholder text
          */}
          <div class="app-shots-stage__bezel" aria-hidden="true"></div>
          <div class="app-shots-stage__screen">
            {placeholder ? (
              <div class="app-shots-stage__placeholder">
                <span class="app-shots-stage__placeholder-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <path d="M21 15l-5-5L5 21" />
                  </svg>
                </span>
                <span class="app-shots-stage__placeholder-text">
                  {t('appShots.placeholder')}
                </span>
              </div>
            ) : (
              <img
                src={shot.image}
                alt={shot.alt}
                width="540"
                height="1170"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="app-shots-stage__notch" aria-hidden="true"></div>
          <figcaption class="app-shots-stage__caption">
            <span class="app-shots-stage__caption-title">{shot.title}</span>
            <span class="app-shots-stage__caption-text">{shot.caption}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .app-shots-stage {
    position: relative;
    width: 100%;
    background: var(--color-bg-canvas);
    /* border-top removed 2026-05-17: no horizontal dividers between sections */
    overflow: hidden;
    padding: clamp(4rem, 8vw, 6.5rem) 0 clamp(4rem, 8vw, 6.5rem);
  }

  .app-shots-stage::before {
    /* Subtle cyan halo across the top — visual handoff from the
       previous section. */
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: radial-gradient(
      ellipse at 50% 0%,
      color-mix(in srgb, var(--color-accent-primary) 12%, transparent),
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .app-shots-stage__intro {
    position: relative;
    z-index: 1;
    max-width: 50rem;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
    padding: 0 clamp(1rem, 4vw, 2rem);
    text-align: center;
  }

  .app-shots-stage__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  .app-shots-stage__headline {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .app-shots-stage__body {
    margin: 0 auto;
    max-width: 38rem;
    color: var(--color-text-secondary);
    font-size: clamp(0.95rem, 1.5vw, 1.125rem);
    line-height: 1.6;
  }

  .app-shots-stage__grid {
    list-style: none;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
    max-width: 78rem;
    display: grid;
    /* Three columns on tablet+ — same proportion gives the centre
       phone its featured spot. Mobile stacks. */
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    justify-items: center;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 720px) {
    .app-shots-stage__grid {
      grid-template-columns: 1fr 1.15fr 1fr;
    }
  }

  .app-shots-stage__cell {
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
  }

  /*
    Subtle perspective: side phones are slightly tilted + scaled
    down. Centre phone full-size, no tilt — the "featured" shot.
    Disabled on mobile (single column) so all three read uniformly.
  */
  @media (min-width: 720px) {
    .app-shots-stage__cell--1 .app-shots-stage__phone {
      transform: rotate(-4deg) scale(0.92);
      opacity: 0.92;
    }
    .app-shots-stage__cell--3 .app-shots-stage__phone {
      transform: rotate(4deg) scale(0.92);
      opacity: 0.92;
    }
  }

  /*
    Phone frame — 100% CSS, no images for the bezel itself.
    Aspect ratio matches iPhone 14 Pro (19.5:9 = roughly 9:19.5).
    Width clamps so the trio fits across viewports.
  */
  .app-shots-stage__phone {
    position: relative;
    margin: 0;
    width: clamp(13rem, 22vw, 17rem);
    aspect-ratio: 9 / 19.5;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 380ms cubic-bezier(0.32, 0.72, 0.24, 1);
  }
  @media (hover: hover) {
    .app-shots-stage__phone:hover {
      transform: scale(1.02);
    }
    .app-shots-stage__cell--1:hover .app-shots-stage__phone,
    .app-shots-stage__cell--3:hover .app-shots-stage__phone {
      transform: rotate(0deg) scale(0.96);
      opacity: 1;
    }
  }

  .app-shots-stage__bezel {
    position: absolute;
    inset: 0;
    /* iPhone 14 Pro bezel approximation — dark gradient + thin
       inner highlight so it reads as polished metal. */
    background:
      linear-gradient(
        145deg,
        rgba(70, 78, 92, 0.95) 0%,
        rgba(28, 32, 40, 1) 35%,
        rgba(20, 23, 28, 1) 65%,
        rgba(45, 52, 63, 0.95) 100%
      );
    border-radius: 14%;
    padding: 0;
    box-shadow:
      0 22px 60px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    pointer-events: none;
  }

  .app-shots-stage__screen {
    position: absolute;
    inset: 4%;
    border-radius: 11%;
    background: var(--color-bg-canvas);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .app-shots-stage__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .app-shots-stage__notch {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 32%;
    height: 3.6%;
    background: rgba(0, 0, 0, 0.92);
    border-radius: 999px;
    pointer-events: none;
    z-index: 2;
  }

  /*
    Placeholder content inside the screen — soft cyan tint, dashed
    border ring, image-icon glyph + label "Snímek bude doplněn".
    Same colour family as the rest of the page so the frame still
    reads as part of the design.
  */
  .app-shots-stage__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background:
      radial-gradient(
        circle at center,
        color-mix(in srgb, var(--color-accent-primary) 6%, transparent),
        transparent 70%
      ),
      var(--color-bg-canvas);
    color: color-mix(in srgb, var(--color-accent-primary) 50%, var(--color-text-secondary));
    text-align: center;
    padding: 1rem;
  }
  .app-shots-stage__placeholder-icon {
    display: inline-flex;
    color: var(--color-accent-primary);
    opacity: 0.6;
  }
  .app-shots-stage__placeholder-icon svg {
    width: 2.5rem;
    height: 2.5rem;
  }
  .app-shots-stage__placeholder-text {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    opacity: 0.8;
  }

  .app-shots-stage__caption {
    position: absolute;
    bottom: -4.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: max(100%, 14rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    /* Counter-rotate the caption back to upright when the parent
       phone is tilted. */
  }
  .app-shots-stage__cell--1 .app-shots-stage__caption {
    transform: translateX(-50%) rotate(4deg);
  }
  .app-shots-stage__cell--3 .app-shots-stage__caption {
    transform: translateX(-50%) rotate(-4deg);
  }
  @media (max-width: 720px) {
    .app-shots-stage__cell--1 .app-shots-stage__caption,
    .app-shots-stage__cell--3 .app-shots-stage__caption {
      transform: translateX(-50%);
    }
  }

  .app-shots-stage__caption-title {
    color: var(--color-text-primary);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .app-shots-stage__caption-text {
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  /* Reserve space for the captions hanging below each phone — without
     this the next section's top border kisses the caption text. */
  .app-shots-stage__grid {
    padding-bottom: 5.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .app-shots-stage__phone,
    .app-shots-stage__cell--1 .app-shots-stage__phone,
    .app-shots-stage__cell--3 .app-shots-stage__phone {
      transform: none;
      transition: none;
    }
  }
</style>
