---
/**
 * FeatureGridReveal — Kevin Gutowski codepen QwNZYzL (V4-D2).
 *
 * Sekce 2 per PLAN.md IA: place-where-photos-would-go now shows 6
 * abstract feature cards. Reveal triggered by IntersectionObserver
 * with stagger.
 *
 * Per user (rev.2 #5): "místo fotek funkce co to umí všechno"
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const features = [
  { icon: 'sun', titleKey: 'reveal.feature1.title', bodyKey: 'reveal.feature1.body' },
  { icon: 'calendar', titleKey: 'reveal.feature2.title', bodyKey: 'reveal.feature2.body' },
  { icon: 'board', titleKey: 'reveal.feature3.title', bodyKey: 'reveal.feature3.body' },
  { icon: 'gauge', titleKey: 'reveal.feature4.title', bodyKey: 'reveal.feature4.body' },
  { icon: 'pulse', titleKey: 'reveal.feature5.title', bodyKey: 'reveal.feature5.body' },
  { icon: 'shield', titleKey: 'reveal.feature6.title', bodyKey: 'reveal.feature6.body' },
] as const;

// Inline SVG icon paths (Lucide-style)
const icons: Record<string, string> = {
  sun: 'M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41',
  calendar: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z',
  board: 'M3 3h7v7H3zM14 3h7v7h-7zM14 14h7v7h-7zM3 14h7v7H3z',
  gauge: 'M12 14l4-4M3.34 19a10 10 0 1117.32 0',
  pulse: 'M3 12h4l3-9 4 18 3-9h4',
  shield: 'M12 22s-8-4-8-10V5l8-3 8 3v7c0 6-8 10-8 10z',
};
---

<section class="relative isolate w-full overflow-hidden border-t border-[var(--color-stroke-base)] bg-[var(--color-bg-surface)]" data-grid-stage>
  <div class="grid-overlay"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 py-24 sm:py-32 lg:py-40">
    <div class="mb-16 max-w-2xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.4em] text-[var(--color-accent-primary)]">
        {t('reveal.eyebrow')}
      </p>
      <h2
        class="text-balance font-bold leading-[1.05] tracking-tight text-[var(--color-text-primary)]"
        style="font-size: clamp(2.25rem, 5vw, 4.5rem); letter-spacing: -0.03em;"
      >
        {t('reveal.headline')}
      </h2>
      <p class="mt-6 max-w-md text-pretty text-lg text-[var(--color-text-secondary)]">
        {t('reveal.subline')}
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-grid-list>
      {
        features.map((f) => (
          <li class="reveal-tile rounded-2xl border border-[var(--color-stroke-base)] bg-[var(--color-bg-canvas)] p-7 transition-colors hover:border-[var(--color-accent-primary)]/40">
            <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-bg-surface-elevated)] text-[var(--color-accent-primary)]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5"
              >
                <path d={icons[f.icon]} />
              </svg>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-[var(--color-text-primary)]">
              {t(f.titleKey as any)}
            </h3>
            <p class="text-[var(--color-text-secondary)]">
              {t(f.bodyKey as any)}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reveal-tile {
    opacity: 0;
    transform: scale(0.92) translateY(24px);
  }

  .reveal-tile[data-revealed='true'] {
    opacity: 1;
    transform: scale(1) translateY(0);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-tile {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-grid-stage]');
  const tiles = document.querySelectorAll<HTMLElement>('[data-grid-list] .reveal-tile');

  if (stage && tiles.length > 0) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      tiles.forEach((t) => t.setAttribute('data-revealed', 'true'));
    } else {
      const obs = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry?.isIntersecting) return;
        obs.disconnect();
        tiles.forEach((tile, idx) => {
          setTimeout(() => tile.setAttribute('data-revealed', 'true'), idx * 80);
        });
      }, { threshold: 0.2 });

      obs.observe(stage);
    }
  }
</script>
