---
/**
 * Landing — shared body of the home page across locales.
 *
 * Reference DNA: fey.com + raycast.com (per PLAN.md §3).
 * Each section is its own full-bleed stage; no outer max-width
 * container. Strings come from src/i18n/ui.ts via t() helper.
 *
 * V4 enhancements (Three.js hero, codepen effects, etc.) will land
 * in subsequent commits per V4-C / V4-D phases. This component is
 * the V3 layout wrapped in a locale-aware shell.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from './HeroScene.astro';
import ImageGridScrollMorph from './ImageGridScrollMorph.astro';
import GooeyStage from './GooeyStage.astro';
import WordScrollStage from './WordScrollStage.astro';
import OrbStage from './OrbStage.astro';
import ParticleStatementStage from './ParticleStatementStage.astro';
import PricingStage from './PricingStage.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title="Melveo" lang={lang}>
  <!-- ============================================================== -->
  <!-- HERO — pitch-black, full viewport, prism shader, claim, CTA    -->
  <!-- ============================================================== -->
  <section class="relative isolate flex min-h-screen w-full flex-col overflow-hidden bg-[var(--color-bg-canvas)]">
    <HeroScene />

    <header class="relative z-10 flex w-full items-center justify-between px-6 pt-6 sm:px-12 sm:pt-10">
      <a href={`/${lang}/`} class="text-xl font-semibold tracking-tight text-[var(--color-text-primary)]">
        melveo
      </a>
      <a
        href="mailto:hello@melveo.app"
        class="hidden text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)] sm:inline"
      >
        {t('nav.contact')}
      </a>
    </header>

    <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 pb-8 pt-24 text-center sm:pt-32">
      <p class="mb-8 text-xs font-semibold uppercase tracking-[0.4em] text-[var(--color-accent-primary)]">
        {t('hero.eyebrow')}
      </p>

      <h1
        class="text-balance font-bold leading-[0.95] tracking-tight text-[var(--color-text-primary)]"
        style="font-size: clamp(3rem, 8.5vw, 8.5rem); letter-spacing: -0.04em;"
      >
        {t('hero.headlinePrefix')}{' '}
        <span
          class="text-[var(--color-accent-primary)]"
          data-rotate-word
          aria-live="polite"
        >
          {lang === 'cs' ? 'tréninky' : 'trainings'}
        </span>{t('hero.headlineSuffix')}
      </h1>

      <p class="mx-auto mt-10 max-w-[36rem] text-pretty text-lg text-[var(--color-text-secondary)] sm:text-xl">
        {t('hero.subline')}
      </p>

      <div class="hero-cta-row">
        <a
          href="#brzy"
          aria-label={t('hero.cta.appstore')}
          class="hero-pill hero-pill--filled"
        >
          <span class="hero-pill-shimmer" aria-hidden="true"></span>
          <span class="hero-pill-content">
            {/* Apple logo glyph in inline SVG so we control colour */}
            <svg
              class="hero-pill-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
            </svg>
            <span class="hero-pill-text">
              <span class="hero-pill-eyebrow">
                {lang === 'cs' ? 'Stáhnout v' : 'Download on the'}
              </span>
              <span class="hero-pill-title">App Store</span>
            </span>
          </span>
        </a>
        <a
          href={`mailto:hello@melveo.app?subject=${encodeURIComponent(
            lang === 'cs' ? 'Zájem o pilot' : 'Pilot enquiry'
          )}`}
          class="hero-pill hero-pill--ghost"
        >
          <span class="hero-pill-shimmer" aria-hidden="true"></span>
          <span class="hero-pill-content">{t('hero.cta.pilot')}</span>
        </a>
      </div>

      <p
        id="brzy"
        class="mt-8 text-xs uppercase tracking-[0.2em] text-[var(--color-text-tertiary)]"
      >
        {t('hero.beta')}
      </p>
    </div>

  </section>

  <!-- ============================================================== -->
  <!-- STAGE 2 + 3 — Scroll-linked image grid morph                    -->
  <!--               (Kevin Gutowski codepen QwNZYzL)                  -->
  <!-- ============================================================== -->
  <ImageGridScrollMorph lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 3.5 — Gooey metaball (Ahmad Awais codepen)                -->
  <!-- ============================================================== -->
  <GooeyStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 3.75 — Scroll-linked word highlight (Daniel Haim codepen) -->
  <!-- ============================================================== -->
  <WordScrollStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 4 — Wellness                                              -->
  <!-- ============================================================== -->
  <section class="relative isolate w-full overflow-hidden border-t border-[var(--color-stroke-base)] bg-[var(--color-bg-surface)]">
    <div class="grid-overlay"></div>

    <div class="relative z-10 grid items-center gap-16 px-6 py-24 sm:px-12 sm:py-32 lg:grid-cols-2 lg:gap-24 lg:px-20 lg:py-40">
      <div>
        <p class="mb-6 text-xs font-semibold uppercase tracking-[0.4em] text-[var(--color-accent-primary)]">
          {t('wellness.eyebrow')}
        </p>
        <h2
          class="text-balance font-bold leading-[1.05] tracking-tight text-[var(--color-text-primary)]"
          style="font-size: clamp(2rem, 5vw, 4.5rem); letter-spacing: -0.03em;"
        >
          {t('wellness.headline')}
        </h2>
        <p class="mt-6 max-w-[28rem] text-pretty text-lg text-[var(--color-text-secondary)]">
          {t('wellness.body')}
        </p>
      </div>

      <div class="relative">
        <div
          class="aspect-[9/16] overflow-hidden rounded-[2.5rem] border border-[var(--color-stroke-emphasized)] bg-[var(--color-bg-canvas)] shadow-[0_40px_120px_-20px_rgba(0,240,255,0.15)]"
        >
          <div class="flex h-full w-full items-center justify-center bg-gradient-to-b from-[var(--color-bg-surface-elevated)] to-[var(--color-bg-canvas)]">
            <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-text-tertiary)]">
              Check-in
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- STAGE 5 — Glass orb + rotating text (Giomgio codepen)           -->
  <!-- ============================================================== -->
  <OrbStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 5.5 — Particles statement (Ahmad Awais codepen)           -->
  <!-- ============================================================== -->
  <ParticleStatementStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 6 — Sessions + Coach Board                                -->
  <!-- ============================================================== -->
  <section class="relative isolate w-full overflow-hidden border-t border-[var(--color-stroke-base)] bg-[var(--color-bg-canvas)]">
    <div class="halo-cyan" style="opacity: 0.4; inset: auto 0 -50% 50%;"></div>

    <div class="relative z-10 grid items-center gap-16 px-6 py-24 sm:px-12 sm:py-32 lg:grid-cols-2 lg:gap-24 lg:px-20 lg:py-40">
      <div class="lg:order-2">
        <p class="mb-6 text-xs font-semibold uppercase tracking-[0.4em] text-[var(--color-accent-primary)]">
          {t('sessions.eyebrow')}
        </p>
        <h2
          class="text-balance font-bold leading-[1.05] tracking-tight text-[var(--color-text-primary)]"
          style="font-size: clamp(2rem, 5vw, 4.5rem); letter-spacing: -0.03em;"
        >
          {t('sessions.headline')}
        </h2>
        <p class="mt-6 max-w-[28rem] text-pretty text-lg text-[var(--color-text-secondary)]">
          {t('sessions.body')}
        </p>
      </div>

      <div class="relative lg:order-1">
        <div
          class="aspect-[4/5] overflow-hidden rounded-[2.5rem] border border-[var(--color-stroke-emphasized)] bg-[var(--color-bg-surface)] shadow-[0_40px_120px_-20px_rgba(0,240,255,0.12)]"
        >
          <div class="flex h-full w-full items-center justify-center bg-gradient-to-tr from-[var(--color-bg-surface)] to-[var(--color-bg-surface-elevated)]">
            <p class="text-xs uppercase tracking-[0.3em] text-[var(--color-text-tertiary)]">
              Sessions
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- STAGE 6.5 — Pricing                                             -->
  <!-- ============================================================== -->
  <PricingStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 7 — Privacy promise                                       -->
  <!-- ============================================================== -->
  <section class="relative isolate w-full overflow-hidden border-t border-[var(--color-stroke-base)] bg-[var(--color-bg-canvas)]">
    <div class="halo-cyan" style="opacity: 0.5;"></div>

    <div class="relative z-10 mx-auto max-w-[64rem] px-6 py-32 text-center sm:py-48">
      <p class="mb-6 text-xs font-semibold uppercase tracking-[0.4em] text-[var(--color-accent-primary)]">
        {t('privacy.eyebrow')}
      </p>
      <h2
        class="text-balance font-bold leading-[1.05] tracking-tight text-[var(--color-text-primary)]"
        style="font-size: clamp(2.5rem, 6vw, 6rem); letter-spacing: -0.04em;"
        data-text-reveal
      >
        {t('privacy.headlineLine1')}<br />
        <span class="text-[var(--color-accent-primary)]">
          {t('privacy.headlineLine2')}
        </span>
      </h2>
      <p class="mx-auto mt-8 max-w-[42rem] text-pretty text-lg text-[var(--color-text-secondary)] sm:text-xl">
        {t('privacy.body')}
      </p>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- STAGE 9 — Pilot CTA                                             -->
  <!-- ============================================================== -->
  <section class="relative isolate w-full overflow-hidden border-t border-[var(--color-stroke-base)] bg-[var(--color-bg-canvas)]">
    <div class="relative z-10 mx-auto max-w-[48rem] px-6 py-32 text-center sm:py-40">
      <h2
        class="text-balance font-bold leading-[1.05] tracking-tight text-[var(--color-text-primary)]"
        style="font-size: clamp(2rem, 4.5vw, 3.5rem); letter-spacing: -0.03em;"
      >
        {t('pilot.headline')}
      </h2>
      <p class="mt-6 max-w-[28rem] text-pretty text-lg text-[var(--color-text-secondary)] mx-auto">
        {t('pilot.body')}
      </p>
      <a
        href={`mailto:${t('pilot.email')}?subject=${encodeURIComponent(
          lang === 'cs' ? 'Mám zájem o pilot' : 'Pilot enquiry'
        )}`}
        class="mt-12 inline-flex items-baseline gap-3 transition-opacity hover:opacity-70"
      >
        <span
          class="font-semibold tracking-tight text-[var(--color-accent-primary)]"
          style="font-size: clamp(1.75rem, 4vw, 3rem);"
        >
          {t('pilot.email')}
        </span>
        <span class="text-2xl text-[var(--color-accent-primary)]" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Hero rotating word — wrap so y-translate during cycle stays within
    the line. Typewriter version writes characters in-place via
    `el.textContent = ...`, so no slide-shell needed — just a small
    caret to mark the typing position.
  */
  [data-rotate-word] {
    display: inline-block;
    /* Trailing caret while typing — subtle blinking bar */
    border-right: 0.05em solid currentColor;
    margin-right: -0.05em;
    animation: caret-blink 1.05s steps(2) infinite;
  }

  @keyframes caret-blink {
    50% { border-right-color: transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-rotate-word] {
      animation: none;
      border-right: 0;
      margin-right: 0;
    }
  }

  /*
    Hero CTA row — CodePen glass-button mechanics adapted to Melveo
    colours. Both buttons share the same animated border and shimmer.
  */
  .hero-cta-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .hero-cta-row {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  .hero-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 12rem;
    overflow: hidden;
    border: 1.5px solid transparent;
    border-radius: 40px;
    padding: 1rem 2.5rem;
    color: var(--color-text-primary);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      background 0.5s ease;
    will-change: transform;
  }

  .hero-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.42) 0%,
      color-mix(in srgb, var(--color-accent-primary) 48%, transparent) 26%,
      color-mix(in srgb, var(--color-accent-primary-subtle) 46%, transparent) 52%,
      color-mix(in srgb, var(--color-accent-warm-dark) 42%, transparent) 76%,
      rgba(255, 255, 255, 0.42) 100%
    );
    background-size: 200% 200%;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.72;
    animation: border-flow 3s linear infinite;
    transition: opacity 0.5s ease;
  }

  .hero-pill::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--x, 50%) var(--y, 50%),
      rgba(255, 255, 255, 0.2) 0%,
      transparent 50%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .hero-pill:hover {
    transform: translateY(-3px) scale(1.02);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.05) 100%
    );
    box-shadow:
      0 12px 48px color-mix(in srgb, var(--color-accent-primary) 28%, transparent),
      0 0 80px color-mix(in srgb, var(--color-accent-primary-subtle) 18%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(255, 255, 255, 0.1);
  }

  .hero-pill:hover::before,
  .hero-pill:focus-visible::before {
    opacity: 1;
    animation-duration: 2s;
  }

  .hero-pill:hover::after,
  .hero-pill:focus-visible::after {
    opacity: 1;
  }

  .hero-pill:active {
    transform: translateY(-1px) scale(0.98);
    box-shadow:
      0 6px 24px color-mix(in srgb, var(--color-accent-primary) 22%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .hero-pill:focus-visible {
    outline: 2px solid var(--color-accent-primary-subtle);
    outline-offset: 4px;
  }

  .hero-pill-shimmer {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.1) 45%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0.1) 55%,
      transparent 100%
    );
    transform: rotate(30deg);
    animation: pill-shimmer 3s infinite;
    pointer-events: none;
  }

  .hero-pill:hover .hero-pill-shimmer {
    animation-duration: 1.5s;
  }

  .hero-pill-content {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
  }

  /* Apple glyph + stacked label inside filled pill */
  .hero-pill-icon {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }
  .hero-pill-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
  }
  .hero-pill-eyebrow {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    opacity: 0.75;
  }
  .hero-pill-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 0.1rem;
  }

  @keyframes border-flow {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }

  @keyframes pill-shimmer {
    0% { transform: translateX(-100%) rotate(30deg); }
    100% { transform: translateX(100%) rotate(30deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pill,
    .hero-pill::before,
    .hero-pill-shimmer {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { mountRotateWord } from '../scripts/rotate-word';
  import { mountTextReveal } from '../scripts/text-reveal';

  function mountHeroButtons() {
    document.querySelectorAll<HTMLElement>('.hero-pill').forEach((button) => {
      button.addEventListener('pointermove', (event) => {
        const rect = button.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;
        button.style.setProperty('--x', `${x}%`);
        button.style.setProperty('--y', `${y}%`);
      });
    });
  }

  // Defer to idle so hero LCP is unaffected
  function init() {
    mountHeroButtons();
    mountRotateWord();
    mountTextReveal();
  }

  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(init, { timeout: 1500 });
  } else {
    setTimeout(init, 200);
  }
</script>
