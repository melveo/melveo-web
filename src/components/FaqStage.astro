---
/**
 * FaqStage — collapsible Q&A list with light glass styling.
 *
 * Six questions covering the most common things a club / coach asks
 * before booking a pilot or downloading the app: who pays, check-in
 * mechanics, data privacy, supported sports, partial uptake, how to
 * start. Added 2026-05-03.
 *
 * Implementation:
 *   - Native <details>/<summary> — works without JS, fully accessible
 *     (keyboard navigable, AT-announced expand/collapse). HTML spec
 *     requires <summary> as the FIRST child of <details>, so we
 *     can NOT wrap it in the standard 4-layer .glass-card recipe
 *     here. Instead each <details> gets a self-contained glass-ish
 *     surface via backdrop-filter + border + radius applied on the
 *     element itself.
 *   - JSON-LD FAQPage schema below — Google + Bing render rich
 *     snippets in SERP for matching FAQ markup.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// 4 Q&A pairs (trimmed from 6 on 2026-05-15 per content audit —
// kept the four real objections: engagement, competition, missing
// data, privacy; dropped the time-cost + scope-of-org questions).
const items = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
];

// JSON-LD FAQPage schema — gets rich-result eligibility in SERPs.
// Schema.org spec: https://schema.org/FAQPage
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section id="faq" class="faq-stage" aria-labelledby="faq-heading">
  <div class="faq-stage__inner">
    <h2 id="faq-heading" class="faq-stage__headline">{t('faq.headline')}</h2>

    <ul class="faq-stage__list" role="list" data-faq-list>
      {items.map((item, index) => (
        <li class="faq-stage__item" style={`--i: ${index};`}>
          <details class="faq-stage__details">
            <summary class="faq-stage__summary">
              <span class="faq-stage__summary-text">{item.q}</span>
              <svg
                class="faq-stage__chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p class="faq-stage__answer">{item.a}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />
</section>

<style>
  .faq-stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    background: var(--color-bg-canvas);
    /* border-top removed 2026-05-17: no horizontal dividers between sections */
  }

  .faq-stage__inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 6.5rem) clamp(1rem, 4vw, 2rem) clamp(4rem, 8vw, 6.5rem);
  }

  .faq-stage__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    text-align: center;
  }

  .faq-stage__headline {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: center;
  }

  .faq-stage__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }

  .faq-stage__item {
    /* Reset any list-derived margin */
    margin: 0;
    padding: 0;
  }

  /*
    Self-contained glass surface on the <details> — we can't use the
    standard 4-layer glass-card recipe here because <summary> must be
    the FIRST child of <details> per HTML spec, and the glass layers
    would push it down. Instead apply backdrop-blur + soft border +
    overlay gradient directly to the <details> via background + filter.
  */
  .faq-stage__details {
    position: relative;
    border-radius: 1.25rem;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.045) 0%,
      rgba(255, 255, 255, 0.025) 60%,
      rgba(0, 240, 255, 0.018) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    box-shadow:
      0 6px 18px rgba(0, 0, 0, 0.22),
      inset 1px 1px 0 rgba(255, 255, 255, 0.05);
    overflow: hidden;
    transition:
      border-color 220ms ease,
      box-shadow 220ms ease;
  }
  .faq-stage__details[open] {
    border-color: color-mix(in srgb, var(--color-accent-primary) 22%, transparent);
    box-shadow:
      0 8px 22px rgba(0, 0, 0, 0.28),
      0 0 24px color-mix(in srgb, var(--color-accent-primary) 14%, transparent),
      inset 1px 1px 0 rgba(255, 255, 255, 0.07);
  }

  .faq-stage__summary {
    /*
      Hide the native <summary> marker (▶ / ▼) across all browsers
      — we render our own chevron SVG instead.
    */
    list-style: none;
    cursor: pointer;
    padding: clamp(1rem, 2vw, 1.25rem) clamp(1.25rem, 2.5vw, 1.5rem);
    display: flex;
    align-items: center;
    gap: 1rem;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .faq-stage__summary::-webkit-details-marker {
    display: none;
  }
  .faq-stage__summary::marker {
    content: '';
  }
  .faq-stage__summary:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: -2px;
    border-radius: inherit;
  }

  .faq-stage__summary-text {
    flex: 1;
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-primary);
  }

  .faq-stage__chevron {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent-primary);
    transition: transform 280ms cubic-bezier(0.32, 0.72, 0.24, 1);
  }
  .faq-stage__details[open] .faq-stage__chevron {
    transform: rotate(180deg);
  }

  .faq-stage__answer {
    margin: 0;
    padding: 0 clamp(1.25rem, 2.5vw, 1.5rem) clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-secondary);
    font-size: clamp(0.9rem, 1.4vw, 1rem);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /*
    Smooth open/close (2026-06-10, v2) — animated from JS via the Web
    Animations API (see mountFaqAccordion below) because the CSS-only
    `interpolate-size` route only works in Chrome 131+; Safari/Firefox
    snapped, which read as aggressive. The answer still gets a small
    fade/slide tied to [open]; the height slide itself is WAAPI.
  */
  .faq-stage__answer {
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 240ms ease 70ms,
      transform 240ms cubic-bezier(0.32, 0.72, 0.24, 1) 70ms;
  }
  .faq-stage__details[open] .faq-stage__answer {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hover treatment — subtle border lift on cursor devices only.
     Touch devices skip the hover via @media (hover: hover). */
  @media (hover: hover) {
    .faq-stage__details:hover {
      border-color: rgba(255, 255, 255, 0.12);
    }
    .faq-stage__summary:hover .faq-stage__chevron {
      transform: scale(1.1);
    }
    .faq-stage__details[open] .faq-stage__summary:hover .faq-stage__chevron {
      transform: rotate(180deg) scale(1.1);
    }
  }

  /*
    Entrance reveal (2026-06-10) — items stagger up as the section
    scrolls into view. Armed by JS (`is-armed` on the list) so no-JS
    visitors always see the content; `is-revealed` releases the
    cascade. 70ms per item.
  */
  .faq-stage__list.is-armed .faq-stage__item {
    opacity: 0;
    transform: translateY(18px);
  }
  .faq-stage__list.is-armed.is-revealed .faq-stage__item {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.55s ease calc(var(--i, 0) * 70ms),
      transform 0.6s cubic-bezier(0.22, 0.9, 0.3, 1) calc(var(--i, 0) * 70ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-stage__chevron {
      transition: none;
    }
    .faq-stage__details {
      transition: none;
    }
    .faq-stage__answer {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .faq-stage__list.is-armed .faq-stage__item,
    .faq-stage__list.is-armed.is-revealed .faq-stage__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  /*
    WAAPI accordion (2026-06-10): intercept summary clicks and slide the
    <details> height open/closed. Works in every modern browser (unlike
    CSS interpolate-size). [open] stays set during the closing slide so
    the content remains rendered; it's removed on finish. Rapid clicks
    cancel the in-flight animation and reverse from the current height.
    Reduced-motion users keep the native instant toggle.
  */
  function mountFaqAccordion() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const EASE = 'cubic-bezier(0.32, 0.72, 0.24, 1)';
    document.querySelectorAll<HTMLElement>('.faq-stage__details').forEach((detailsEl) => {
      const details = detailsEl as HTMLDetailsElement;
      const summary = details.querySelector<HTMLElement>('summary');
      if (!summary) return;
      let anim: Animation | null = null;

      const slide = (from: number, to: number, onFinish?: () => void) => {
        anim?.cancel();
        details.style.overflow = 'clip';
        anim = details.animate(
          [{ height: `${from}px` }, { height: `${to}px` }],
          { duration: 340, easing: EASE },
        );
        anim.onfinish = () => {
          details.style.overflow = '';
          anim = null;
          onFinish?.();
        };
      };

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        const current = details.offsetHeight;
        if (!details.open) {
          details.open = true;
          const target = details.offsetHeight;
          slide(current, target);
        } else {
          // keep [open] during the slide so content stays rendered;
          // measure the collapsed height by reading the summary box.
          const target =
            summary.offsetHeight +
            (details.offsetHeight - details.clientHeight); // borders
          slide(current, target, () => {
            details.open = false;
          });
        }
      });
    });
  }

  function mountFaqReveal() {
    const list = document.querySelector<HTMLElement>('[data-faq-list]');
    if (!list || !('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    list.classList.add('is-armed');
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        io.disconnect();
        list.classList.add('is-revealed');
      },
      { rootMargin: '-80px 0px', threshold: 0.1 },
    );
    io.observe(list);
  }
  function mountFaq() {
    mountFaqAccordion();
    mountFaqReveal();
  }
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(mountFaq, { timeout: 2000 });
  } else {
    setTimeout(mountFaq, 300);
  }
</script>
