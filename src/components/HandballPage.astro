---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, testFlightUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternatePath = lang === 'cs' ? '/en/handball/' : '/cs/hazena/';
const installPath = lang === 'cs' ? '/cs/napoveda/instalace/' : '/en/help/install/';
const contactUrl = `mailto:hello@melveo.app?subject=${encodeURIComponent(t('handball.contactSubject'))}`;
const features = [
  ['handball.f1Title', 'handball.f1Text'],
  ['handball.f2Title', 'handball.f2Text'],
  ['handball.f3Title', 'handball.f3Text'],
] as const;
---

<BaseLayout
  title={t('handball.metaTitle')}
  description={t('handball.metaDescription')}
  lang={lang}
  canonical={lang === 'cs' ? '/cs/hazena/' : '/en/handball/'}
  alternatePath={alternatePath}
>
  <div class="handball-page mx-auto max-w-6xl px-6 sm:px-10">
    <section class="handball-hero" aria-labelledby="handball-title">
      <div class="handball-intro">
        <p class="text-sm font-semibold text-[var(--color-accent-primary)]">{t('handball.eyebrow')}</p>
        <h1 id="handball-title" class="mt-3 text-balance font-semibold tracking-tight">{t('handball.title')}</h1>
      </div>

      <img
        class="handball-map"
        src="/handball/shot-map.png"
        width="700"
        height="790"
        alt={t('handball.imageAlt')}
        loading="eager"
      />

      <div class="handball-details">
        <p class="handball-lead text-pretty text-[var(--color-text-secondary)]">{t('handball.lead')}</p>
        <div class="mt-5">
          <a class="hero-pill handball-primary" href={testFlightUrl} target="_blank" rel="noopener">
            <span class="hero-pill-content">{t('handball.ctaPrimary')}</span>
          </a>
          <div class="handball-install flex flex-wrap items-center gap-x-2 text-xs text-[var(--color-text-secondary)]">
            <p>{t('handball.ctaPrimaryNote')}</p>
            <a href={installPath}>{t('handball.installHelp')}</a>
          </div>
          <a class="handball-contact inline-flex min-h-[44px] items-center text-sm" href={contactUrl}>
            {t('handball.ctaSecondary')}
          </a>
        </div>
      </div>
    </section>

    <div class="grid gap-8 border-t border-[var(--color-stroke-emphasized)] py-10 md:grid-cols-3 md:py-14">
      {features.map(([title, text]) => (
        <section>
          <h2 class="text-lg font-semibold tracking-tight">{t(title)}</h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-secondary)]">{t(text)}</p>
        </section>
      ))}
    </div>

    <div class="handball-closing border-t border-[var(--color-stroke-emphasized)] py-8 text-sm">
      <p>{t('handball.closing')}</p>
      <div class="mt-2 flex flex-wrap gap-x-6">
        <a href={`/${lang}/#pricing`}>{t('handball.pricingLink')}</a>
        <a href="https://www.instagram.com/melveo.app/" target="_blank" rel="noopener">
          {t('handball.instagramLink')}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .handball-hero {
    display: grid;
    gap: 1.25rem;
    padding-block: 1.5rem 2.5rem;
  }
  .handball-intro h1 {
    font-size: clamp(1.875rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .handball-map {
    display: block;
    width: auto;
    height: 11rem;
    max-width: 100%;
    object-fit: contain;
    justify-self: center;
  }
  .handball-lead {
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .handball-primary {
    width: 100%;
    background: var(--color-accent-primary);
    color: var(--color-accent-primary-cta-fg);
    white-space: normal;
  }
  .handball-primary:hover {
    background: var(--color-accent-primary-hover);
  }
  .handball-install {
    margin-top: 0.25rem;
  }
  .handball-install a,
  .handball-closing a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .handball-install a,
  .handball-contact,
  .handball-closing a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .handball-page a:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 4px;
  }
  @media (min-width: 48rem) {
    .handball-hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-content: center;
      column-gap: 3rem;
      row-gap: 1.5rem;
      padding-block: 4rem;
      min-height: 42rem;
    }
    .handball-intro {
      align-self: end;
    }
    .handball-map {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
      width: 100%;
      height: auto;
    }
    .handball-details {
      grid-column: 1;
      align-self: start;
    }
    .handball-lead {
      font-size: 1rem;
      line-height: 1.7;
    }
    .handball-primary {
      width: auto;
    }
  }
</style>
