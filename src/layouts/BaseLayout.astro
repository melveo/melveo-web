---
/**
 * BaseLayout — fullwidth, indie-iOS-app style, locale-aware.
 *
 * No max-width container; pages render edge-to-edge. Content padding
 * is handled per-section. Header is intentionally absent on the
 * landing — the wordmark sits inside the hero. Privacy/Terms pages
 * use their own constrained article width.
 *
 * Locale-aware: takes `lang` prop, renders correct hreflang + footer
 * + canonical with locale prefix. URL strategy per PLAN.md §16.5:
 * /cs/ canonical for Czech, /en/ for English, root / is a client-side
 * redirect that reads navigator.language.
 *
 * Apple App Store discipline (docs/planning/15 §"Apple-safe"):
 * the iOS companion app must never see Buy/Subscribe CTAs. The web
 * surface is allowed and required to host the App Store badge,
 * pilot enquiry email, and legal pages.
 */

import { useTranslations, type Lang, ui } from '../i18n/ui';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AnalyticsHead from '../components/AnalyticsHead.astro';
import AnalyticsBody from '../components/AnalyticsBody.astro';

interface Props {
  title: string;
  description?: string;
  /** Locale of the page. Required so footer + hreflang render correctly. */
  lang: Lang;
  /** Path-only URL used for canonical + OG tags. Trailing slash optional. */
  canonical?: string;
  /** Override the default OG image. */
  ogImage?: string;
  /** When true, render the minimal landing footer (default).
   *  Privacy/Terms pages set this false to render an even lighter footer. */
  showLandingFooter?: boolean;
}

const {
  title,
  description,
  lang,
  canonical,
  ogImage = '/og-default.png',
  showLandingFooter = true,
} = Astro.props;

const t = useTranslations(lang);

const defaultDescription =
  lang === 'cs'
    ? 'Melveo — chytřejší tréninky a zdravější hráči pro kluby, trenéry i hráče.'
    : 'Melveo — smarter trainings and healthier players. App for sports clubs.';

const finalDescription = description ?? defaultDescription;

const fullTitle = title === 'Melveo' ? title : `${title} — Melveo`;
const canonicalUrl = canonical
  ? new URL(canonical, Astro.site).toString()
  : new URL(Astro.url.pathname, Astro.site).toString();

// hreflang alternates — derived from current path
const otherLang: Lang = lang === 'cs' ? 'en' : 'cs';
const currentPathWithoutLocale = Astro.url.pathname.replace(/^\/(cs|en)/, '') || '/';
const altUrls = {
  cs: new URL(`/cs${currentPathWithoutLocale}`, Astro.site).toString(),
  en: new URL(`/en${currentPathWithoutLocale}`, Astro.site).toString(),
  default: new URL('/', Astro.site).toString(),
};
---

<!doctype html>
<html lang={lang === 'cs' ? 'cs' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    {/* Brand wordmark font — Quicksand (rounded geometric sans, every
        terminal is a soft circle including the lowercase 'm').
        Picked over Inter / Outfit / Open Sans per user feedback
        2026-05-01: "asi bych šel do toho Quicksand fontu na všech
        názvech melveo". Applied via --font-wordmark in global.css to
        every visible "melveo" mark across the site (header logo,
        intro overlay wordmark, index page wordmark). */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap"
    />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="cs" href={altUrls.cs} />
    <link rel="alternate" hreflang="en" href={altUrls.en} />
    <link rel="alternate" hreflang="x-default" href={altUrls.default} />

    <title>{fullTitle}</title>
    <meta name="description" content={finalDescription} />

    <!-- OG / Twitter -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta property="og:locale:alternate" content={otherLang === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={finalDescription} />

    {/* JSON-LD — SoftwareApplication schema for App Store discoverability */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Melveo',
        applicationCategory: 'SportsApplication',
        operatingSystem: 'iOS, iPadOS',
        description: finalDescription,
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'CZK',
        },
        publisher: {
          '@type': 'Organization',
          name: 'QUIX Global s.r.o.',
          identifier: '22466444',
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Příčná 1892/4',
            addressLocality: 'Praha',
            postalCode: '11000',
            addressCountry: 'CZ',
          },
          email: 'hello@melveo.app',
          url: 'https://melveo.app',
        },
        inLanguage: lang === 'cs' ? 'cs-CZ' : 'en-US',
        url: canonicalUrl,
      })}
    />

    <AnalyticsHead />
  </head>
  <body class="min-h-screen bg-[var(--color-bg-canvas)] text-[var(--color-text-primary)]">
    <AnalyticsBody />
    <slot />
    <CookieBanner lang={lang} />

    {
      showLandingFooter && (
        <footer class="border-t border-[var(--color-stroke-base)]/60">
          <div class="flex flex-col items-center gap-4 px-6 py-10 text-center text-sm text-[var(--color-text-tertiary)] sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-8 sm:gap-y-4">
            <span>{t('footer.copyright')}</span>
            <a
              href="mailto:hello@melveo.app"
              class="transition-colors hover:text-[var(--color-text-primary)]"
            >
              hello@melveo.app
            </a>
            <a
              href={`/${lang}/privacy`}
              class="transition-colors hover:text-[var(--color-text-primary)]"
            >
              {t('footer.privacy')}
            </a>
            <a
              href={`/${lang}/terms`}
              class="transition-colors hover:text-[var(--color-text-primary)]"
            >
              {t('footer.terms')}
            </a>
            <button
              type="button"
              data-cookie-reopen
              class="bg-transparent border-0 cursor-pointer text-[var(--color-text-tertiary)] transition-colors hover:text-[var(--color-text-primary)] p-0 font-inherit text-inherit"
            >
              {t('footer.cookieSettings')}
            </button>
            <LocaleSwitcher current={lang} />
          </div>
        </footer>
      )
    }

    {/*
      Global SVG displacement filter — referenced by .glass-card .glass-filter
      from any section that uses the liquid-glass recipe (pricing cards,
      pricing extras, image-grid tech cards). Put once at body root so
      every component can use it via filter: url(#glass-lens) without
      duplicating the SVG.

      feComponentTransfer → feGaussianBlur on alpha → feDisplacementMap:
      blurs the alpha channel and uses it to warp source pixels. The
      effect is a soft refraction halo at element edges — what makes the
      card actually read as glass instead of just a translucent rectangle.
    */}
    <svg
      class="glass-lens-defs"
      xmlns="http://www.w3.org/2000/svg"
      style="position:absolute;width:0;height:0;pointer-events:none;"
      aria-hidden="true"
    >
      <filter
        id="glass-lens"
        x="0%"
        y="0%"
        width="100%"
        height="100%"
        filterUnits="objectBoundingBox"
      >
        <feComponentTransfer in="SourceAlpha" result="alpha">
          <feFuncA type="identity" />
        </feComponentTransfer>
        <feGaussianBlur in="alpha" stdDeviation="50" result="blur" />
        <feDisplacementMap
          in="SourceGraphic"
          in2="blur"
          scale="40"
          xChannelSelector="A"
          yChannelSelector="A"
        />
      </filter>
    </svg>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>

<script>
  // Footer "Cookie nastavení" → re-open banner.
  import { reopenBanner } from '../scripts/consent';

  document.querySelectorAll<HTMLButtonElement>('[data-cookie-reopen]').forEach((btn) => {
    btn.addEventListener('click', () => reopenBanner());
  });
</script>
