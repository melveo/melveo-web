---
/**
 * WordScrollStage — close port of Daniel Haim's CodePen azmBEPL.
 *
 * Sticky prefix plus a page-scrolled word list with CSS
 * view-timeline brightening mapped to the Melveo palette.
 */

import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const words = t('wordScroll.words').split('|');
const startIndex = 0;
const endIndex = words.length - 1;
const remainingSteps = Math.max(1, endIndex - startIndex);
const scrollFriction = 1.65;
const scrollDistance = `${remainingSteps * 6.09375 * scrollFriction}rem`;
const scrollDistanceTablet = `${remainingSteps * 5.4375 * scrollFriction}rem`;
const scrollDistanceMobile = `${remainingSteps * 3.125 * scrollFriction}rem`;
const scrollDistanceSmall = `${remainingSteps * 2.375 * scrollFriction}rem`;
const hueStart = 205;
const hueEnd = 178;
const hueStep = (hueEnd - hueStart) / Math.max(1, words.length - 1);
---

<section
  class="word-scroll-stage"
  data-word-scroll-stage
  data-start-index={startIndex}
  data-end-index={endIndex}
  style={`--word-scroll-count: ${words.length}; --word-scroll-active-index: ${startIndex}; --word-scroll-distance: ${scrollDistance}; --word-scroll-distance-tablet: ${scrollDistanceTablet}; --word-scroll-distance-mobile: ${scrollDistanceMobile}; --word-scroll-distance-small: ${scrollDistanceSmall};`}
>
  <div class="word-scroll-stage__pin">
    <div class="word-scroll-stage__inner">
      <h2 class="word-scroll-stage__prefix">
        <span aria-hidden="true">{t('wordScroll.prefix')}&nbsp;</span>
        <span class="word-scroll-stage__sr-only">
          {t('wordScroll.screenReader')}
        </span>
      </h2>

      <div class="word-scroll-stage__list-viewport" aria-hidden="true">
        <ul class="word-scroll-stage__list">
          {words.map((word, index) => (
            <li
              class="word-scroll-stage__item"
              style={`--i: ${index}; --word-hue: ${hueStart + index * hueStep}; --word-distance: ${Math.abs(index - startIndex)}; --word-focus: ${index === startIndex ? 1 : 0};`}
            >
              <span class="glass-content word-scroll-stage__word">{word}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .word-scroll-stage {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: calc(100vh + var(--word-scroll-distance));
    overflow: visible;
    /* border-top + border-bottom removed 2026-05-17: no horizontal dividers between sections */
    background: var(--color-bg-canvas);
    color: var(--color-text-primary);
    color-scheme: dark;
  }

  /*
    Background blur halos (::before cyan+amber, ::after cyan) removed
    2026-05-17 per user direction: section must be pure black, only
    the prefix + cycling word list remain. No ambient glow blobs
    behind the text.
  */

  .word-scroll-stage__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    z-index: 1;
  }

  .word-scroll-stage__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.24em;
    height: 100%;
    min-width: min-content;
    padding-inline: 1.5rem;
    font-size: clamp(3.35rem, 5.6vw, 4.875rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .word-scroll-stage__prefix {
    flex: 0 0 auto;
    height: fit-content;
    margin: 0;
    font: inherit;
    background: linear-gradient(
      180deg,
      var(--color-text-primary) 42%,
      color-mix(in oklch, var(--color-bg-canvas), var(--color-text-primary) 38%) 100%
    );
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
    text-shadow: 0 14px 28px rgba(0, 0, 0, 0.34);
  }

  /*
    Viewport is sized to ONE line-height — this is the alignment
    anchor for the active word. We let the parent flex container's
    `align-items: center` line up the viewport with the prefix
    directly, so the two never drift apart regardless of how iOS
    Safari resolves the sticky pin's `100vh` against its dynamic
    visual viewport (URL-bar collapse on production caused the old
    `height: 100%; top: 50%` pattern to misalign the active word
    above the prefix baseline — fix 2026-05-01).

    Items above + below the active one still need to be visible
    (faded list flowing through the centre), so overflow stays
    `visible`.
  */
  .word-scroll-stage__list-viewport {
    position: relative;
    flex: 0 0 auto;
    height: 1.25em;
    align-self: center;
    min-width: 0;
    max-width: min(72vw, 58rem);
    overflow: visible;
  }

  /*
    List stays `position: relative` so it contributes to the viewport's
    intrinsic width (white-space: nowrap + width: max-content makes
    it size to the longest item). If we used position: absolute here
    the viewport would collapse to width 0 — its `flex: 0 0 auto`
    basis can't read the list's intrinsic size from absolute children.

    Vertical centring math:
      - viewport is 1.25em tall, flex-centred against the prefix
      - list is at top: 50% (= 0.625em from viewport top)
      - translateY shifts the list up by half-item + active_index items
      - active item lands with its centre at 0.625em from viewport top
        = exact viewport vertical centre
      - Items above + below the active one are visible because the
        viewport's overflow stays `visible`.
  */
  .word-scroll-stage__list {
    position: relative;
    top: 50%;
    left: 0;
    width: max-content;
    max-width: min(72vw, 58rem);
    transform: translate3d(
      0,
      calc(-0.625em - (var(--word-scroll-active-index) * 1.25em)),
      0
    );
    list-style: none;
    margin: 0;
    padding: 0;
    padding-left: 0;
    font: inherit;
    white-space: nowrap;
    will-change: transform;
  }

  .word-scroll-stage__item {
    position: relative;
    display: block;
    width: max-content;
    max-width: min(72vw, 58rem);
    overflow: visible;
    border-radius: 0.34em;
    background: transparent;
    --word-accent: oklch(0.82 0.16 var(--word-hue));
    --word-accent-muted: color-mix(
      in oklch,
      var(--word-accent) 45%,
      var(--color-text-primary)
    );
    color: var(--word-accent-muted);
    opacity: clamp(0.62, calc(0.62 + (var(--word-focus) * 0.38)), 1);
    filter: brightness(clamp(0.9, calc(0.94 + (var(--word-focus) * 0.2)), 1.14));
    box-shadow: none;
    transition: none;
    will-change: opacity, filter;
  }

  .word-scroll-stage__item:last-of-type {
    background: transparent;
    color: var(--color-text-primary);
  }

  .word-scroll-stage__item:last-of-type .word-scroll-stage__word {
    background: linear-gradient(
      var(--color-text-primary) 50%,
      color-mix(in oklch, var(--color-bg-canvas), var(--color-text-primary) 25%)
    );
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
  }

  .word-scroll-stage__item:hover {
    transform: none;
  }

  .word-scroll-stage__word {
    display: inline-block;
    flex: none;
    max-width: min(72vw, 58rem);
    overflow: visible;
    white-space: nowrap;
    text-shadow: 0 0 calc(30px * var(--word-focus)) color-mix(in oklch, var(--word-accent) 46%, transparent);
  }

  .word-scroll-stage__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1100px) {
    .word-scroll-stage {
      --word-scroll-distance: var(--word-scroll-distance-tablet);
    }

    .word-scroll-stage__inner {
      font-size: clamp(2.75rem, 5.4vw, 4.2rem);
    }
  }

  /*
    Below 860px the prefix + word list can no longer share a row
    cleanly: long phrases ("rozhodnutí trenéra.", "what to change
    in the plan.") overflow the viewport's width cap and bleed
    horizontally through the pinned prefix, making it look as if
    the active word passes through "Trenér ví." / "Coach knows.".
    Stack them vertically and centre the list under the prefix.
  */
  @media (max-width: 860px) {
    .word-scroll-stage {
      --word-scroll-distance: var(--word-scroll-distance-mobile);
    }

    .word-scroll-stage__inner {
      flex-direction: column;
      gap: 0.22em;
      padding-inline: 1rem;
      font-size: clamp(2rem, 5.6vw, 2.85rem);
      line-height: 1.22;
      text-align: center;
    }

    .word-scroll-stage__prefix {
      line-height: 1.1;
    }

    /*
      In column mode the prefix sits above the viewport; if the
      viewport keeps `overflow: visible` (as on desktop) the faded
      items above the active one bleed upward and overlap the
      prefix line. Clip vertically so only the active word renders
      under the prefix — this is the real fix for the "Spojí gets
      centred and words pass through it" bug on phones.
    */
    .word-scroll-stage__list-viewport {
      width: 100%;
      max-width: 94vw;
      overflow: hidden;
    }

    .word-scroll-stage__list {
      width: 100%;
      max-width: 94vw;
      left: 50%;
      transform: translate3d(
        -50%,
        calc(-0.625em - (var(--word-scroll-active-index) * 1.25em)),
        0
      );
    }

    .word-scroll-stage__item,
    .word-scroll-stage__word {
      width: 100%;
      max-width: 94vw;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .word-scroll-stage {
      --word-scroll-distance: var(--word-scroll-distance-small);
    }

    .word-scroll-stage__inner {
      gap: 0.18em;
      font-size: clamp(1.25rem, 5.4vw, 1.85rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word-scroll-stage__item {
      opacity: 0.72;
      filter: none;
    }
  }
</style>

<script>
  const clampWordScroll = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const updateWordScrollStages = () => {
    document.querySelectorAll<HTMLElement>('[data-word-scroll-stage]').forEach((root) => {
      const startIndex = Number(root.getAttribute('data-start-index') || 0);
      const endIndex = Number(root.getAttribute('data-end-index') || startIndex);
      const rect = root.getBoundingClientRect();
      const scrollableDistance = Math.max(1, root.offsetHeight - window.innerHeight);
      const progress = clampWordScroll(-rect.top / scrollableDistance, 0, 1);
      const activeIndex = startIndex + progress * (endIndex - startIndex);

      root.style.setProperty('--word-scroll-active-index', activeIndex.toFixed(4));

      root.querySelectorAll<HTMLElement>('.word-scroll-stage__item').forEach((item, index) => {
        const distance = Math.abs(index - activeIndex);
        const focus = clampWordScroll(1 - distance * 1.08, 0, 1);

        item.style.setProperty('--word-distance', distance.toFixed(4));
        item.style.setProperty('--word-focus', focus.toFixed(4));
      });
    });
  };

  let wordScrollFrame = 0;
  const queueWordScrollUpdate = () => {
    if (wordScrollFrame) return;

    wordScrollFrame = window.requestAnimationFrame(() => {
      wordScrollFrame = 0;
      updateWordScrollStages();
    });
  };

  updateWordScrollStages();
  window.addEventListener('scroll', queueWordScrollUpdate, { passive: true });
  window.addEventListener('resize', queueWordScrollUpdate);
  window.addEventListener('load', updateWordScrollStages, { once: true });
  document.addEventListener('astro:page-load', updateWordScrollStages);

  if ('fonts' in document) {
    document.fonts.ready.then(updateWordScrollStages);
  }
</script>
