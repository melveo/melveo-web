---
/**
 * ContactStage — App Store launch notify form (single column, centered).
 *
 * Pilot inquiry path was removed 2026-05-04 (pricing pilot offering
 * sunset). What remains: single email field, "notify me at launch".
 * The bottom-of-page mailto stage continues to handle direct contact
 * for clubs that want to reach out before launch.
 *
 * POSTs to /api/lead → Worker → Resend → hello@melveo.app via the
 * `app-notify` lead type.
 */

import { type Lang } from '../i18n/ui';
import LeadFormNotify from './LeadFormNotify.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="contact-stage" aria-labelledby="contact-heading">
  <div class="contact-stage__intro">
    <p class="contact-stage__eyebrow">
      {lang === 'cs' ? 'KONTAKT' : 'GET IN TOUCH'}
    </p>
    <h2 id="contact-heading" class="contact-stage__headline">
      {lang === 'cs' ? 'Začněte tady.' : 'Start here.'}
    </h2>
    <p class="contact-stage__body">
      {lang === 'cs'
        ? 'Dáme ti vědět hned, jak Melveo dorazí do App Store.'
        : 'We\'ll let you know the moment Melveo hits the App Store.'}
    </p>
  </div>

  <div class="contact-stage__notify">
    <LeadFormNotify lang={lang} variant="card" />
  </div>
</section>

<style>
  .contact-stage {
    position: relative;
    width: 100%;
    background: var(--color-bg-canvas);
    border-top: 1px solid var(--color-stroke-base);
    padding: clamp(4rem, 8vw, 6.5rem) clamp(1rem, 4vw, 2rem);
    overflow: hidden;
  }

  .contact-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 30%,
      color-mix(in srgb, var(--color-accent-primary) 9%, transparent),
      transparent 55%
    );
    pointer-events: none;
    z-index: 0;
  }

  .contact-stage__intro {
    position: relative;
    z-index: 1;
    max-width: 50rem;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .contact-stage__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  .contact-stage__headline {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .contact-stage__body {
    margin: 0 auto;
    max-width: 38rem;
    color: var(--color-text-secondary);
    font-size: clamp(0.95rem, 1.5vw, 1.125rem);
    line-height: 1.6;
  }

  /* Single centered form — was a 2-col grid (notify + pilot) before
     2026-05-04 pilot removal. Now the notify form sits alone in a
     comfortable max-width container. */
  .contact-stage__notify {
    position: relative;
    z-index: 1;
    max-width: 32rem;
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }
</style>
