# Cloudflare Pages redirects config — V4-G
# Reference: https://developers.cloudflare.com/pages/configuration/redirects/
#
# Notes:
#   - Static index.astro at root already handles locale-detect via
#     <meta refresh> + JS. These rules cover edge cases / SEO redirects.
#   - We DON'T edge-redirect / based on Accept-Language because Astro's
#     SSR HTML lets us send hreflang signals to crawlers (better SEO
#     than a 302). Client-side detect handles the human visitor path.

# Old un-prefixed legal paths → CS (default lang) for any inbound links
# from before the i18n refactor.
/privacy             /cs/privacy             301
/terms               /cs/terms               301
/checkout/success    /cs/checkout/success    301

# Trailing slash normalization — Astro emits /cs/ already, but just
# in case some links omit the slash.
/cs                  /cs/                    301
/en                  /en/                    301

# Universal Link path for invite codes (forward to app or fallback to
# default landing). The AASA file declares /i/* as a Universal Link
# target — iOS opens the app directly. Browsers without the app see
# the homepage.
/i/*                 /cs/                    302

# Universal Link path for team QR join tokens (doc 414). Same handling as
# /i/* — AASA declares /j/* so iOS with the app opens it directly; browsers
# without the app fall back to the homepage instead of an empty 404 (which
# iOS otherwise treats as a file download).
/j/*                 /cs/                    302
