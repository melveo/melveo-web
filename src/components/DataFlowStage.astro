---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const signals = t('dataFlow.signals').split('|');
const decisions = t('dataFlow.decisions').split('|');

const nodes = [
  { x: '14%', y: '20%', size: 'lg', delay: '0.1s', label: signals[0] },
  { x: '34%', y: '13%', size: 'sm', delay: '1.9s', label: signals[1] },
  { x: '67%', y: '18%', size: 'md', delay: '3.3s', label: signals[2] },
  { x: '83%', y: '37%', size: 'sm', delay: '5.4s', label: signals[3] },
  { x: '61%', y: '55%', size: 'lg', delay: '7.1s', label: signals[4] },
  { x: '23%', y: '62%', size: 'md', delay: '8.8s', label: signals[5] },
  { x: '42%', y: '81%', size: 'sm', delay: '10.6s', label: signals[6] },
  { x: '76%', y: '76%', size: 'md', delay: '12.2s', label: signals[7] },
] as const;

const mobileSteps = [
  t('dataFlow.mobileStep1'),
  t('dataFlow.mobileStep2'),
  t('dataFlow.mobileStep3'),
] as const;
---

<section
  class="data-flow-stage"
  aria-labelledby="data-flow-title"
>
  <div class="data-flow-stage__grid" aria-hidden="true"></div>
  <div class="data-flow-stage__halo data-flow-stage__halo--left" aria-hidden="true"></div>
  <div class="data-flow-stage__halo data-flow-stage__halo--right" aria-hidden="true"></div>
  <svg class="data-flow-stage__neural-net" viewBox="0 0 1440 760" aria-hidden="true">
    <defs>
      <linearGradient id="neural-flow-line" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="rgba(0, 240, 255, 0)" />
        <stop offset="28%" stop-color="rgba(0, 240, 255, 0.28)" />
        <stop offset="54%" stop-color="rgba(205, 247, 251, 0.54)" />
        <stop offset="100%" stop-color="rgba(0, 240, 255, 0.06)" />
      </linearGradient>
      <radialGradient id="neural-node-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="rgba(205, 247, 251, 0.95)" />
        <stop offset="42%" stop-color="rgba(0, 240, 255, 0.46)" />
        <stop offset="100%" stop-color="rgba(0, 240, 255, 0)" />
      </radialGradient>
    </defs>
    <path class="data-flow-stage__neural-path data-flow-stage__neural-path--a" d="M34 501 C 161 395, 258 433, 381 351 S 604 281, 723 356 S 956 458, 1136 342 S 1336 246, 1438 292" />
    <path class="data-flow-stage__neural-path data-flow-stage__neural-path--b" d="M118 625 C 241 558, 297 607, 422 520 S 602 395, 764 445 S 996 582, 1192 494" />
    <path class="data-flow-stage__neural-path data-flow-stage__neural-path--c" d="M186 221 C 290 314, 365 244, 475 306 S 636 434, 755 371 S 946 201, 1112 270 S 1294 379, 1409 330" />
    <path class="data-flow-stage__neural-branch" d="M381 351 C 350 288, 314 250, 250 218" />
    <path class="data-flow-stage__neural-branch" d="M604 281 C 569 224, 520 193, 454 172" />
    <path class="data-flow-stage__neural-branch" d="M764 445 C 806 518, 864 552, 948 570" />
    <path class="data-flow-stage__neural-branch" d="M1136 342 C 1190 288, 1238 264, 1318 251" />
    <g class="data-flow-stage__neural-nodes">
      <circle cx="381" cy="351" r="6" />
      <circle cx="604" cy="281" r="5" />
      <circle cx="723" cy="356" r="9" />
      <circle cx="956" cy="458" r="5" />
      <circle cx="1136" cy="342" r="7" />
      <circle cx="422" cy="520" r="4.5" />
      <circle cx="764" cy="445" r="6" />
      <circle cx="1192" cy="494" r="5" />
    </g>
    <circle class="data-flow-stage__neural-signal data-flow-stage__neural-signal--a" r="10">
      <animateMotion dur="8.8s" repeatCount="indefinite" path="M34 501 C 161 395, 258 433, 381 351 S 604 281, 723 356 S 956 458, 1136 342 S 1336 246, 1438 292" />
    </circle>
    <circle class="data-flow-stage__neural-signal data-flow-stage__neural-signal--b" r="7">
      <animateMotion dur="11.4s" begin="1.7s" repeatCount="indefinite" path="M118 625 C 241 558, 297 607, 422 520 S 602 395, 764 445 S 996 582, 1192 494" />
    </circle>
    <circle class="data-flow-stage__neural-signal data-flow-stage__neural-signal--c" r="8">
      <animateMotion dur="10.2s" begin="3.4s" repeatCount="indefinite" path="M186 221 C 290 314, 365 244, 475 306 S 636 434, 755 371 S 946 201, 1112 270 S 1294 379, 1409 330" />
    </circle>
  </svg>

  <div class="data-flow-stage__inner">
    <div class="data-flow-stage__intro">
      <p class="data-flow-stage__eyebrow">{t('dataFlow.eyebrow')}</p>
      <h2 id="data-flow-title" class="data-flow-stage__headline">
        {t('dataFlow.headline')}
      </h2>
      <p class="data-flow-stage__body">
        {t('dataFlow.body')}
      </p>
    </div>

    <div
      class="data-flow-stage__map"
      aria-label={lang === 'cs' ? 'Vizualizace toku dat v Melveo' : 'Melveo data-flow visualization'}
    >
      <svg class="data-flow-stage__paths" viewBox="0 0 1200 440" aria-hidden="true">
        <defs>
          <linearGradient id="data-flow-line" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="rgba(0, 240, 255, 0.04)" />
            <stop offset="42%" stop-color="rgba(0, 240, 255, 0.72)" />
            <stop offset="100%" stop-color="rgba(205, 247, 251, 0.08)" />
          </linearGradient>
          <radialGradient id="data-flow-pulse" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="rgba(205, 247, 251, 0.95)" />
            <stop offset="58%" stop-color="rgba(0, 240, 255, 0.38)" />
            <stop offset="100%" stop-color="rgba(0, 240, 255, 0)" />
          </radialGradient>
        </defs>

        <path class="data-flow-stage__path data-flow-stage__path--one" d="M138 117 C 224 54, 319 89, 372 151 S 443 210, 496 191" />
        <path class="data-flow-stage__path data-flow-stage__path--two" d="M196 294 C 294 236, 361 282, 423 235 S 470 191, 515 218" />
        <path class="data-flow-stage__path data-flow-stage__path--three" d="M346 365 C 392 303, 434 284, 474 255 S 520 220, 557 235" />
        <path class="data-flow-stage__path data-flow-stage__path--out" d="M654 221 C 742 162, 824 209, 887 198 S 965 178, 1058 228" />
        <path class="data-flow-stage__path data-flow-stage__path--branch" d="M372 151 C 348 203, 330 235, 294 265" />
        <path class="data-flow-stage__path data-flow-stage__path--branch" d="M887 198 C 916 248, 953 281, 1015 304" />

        <circle class="data-flow-stage__synapse" cx="372" cy="151" r="5" />
        <circle class="data-flow-stage__synapse" cx="423" cy="235" r="4" />
        <circle class="data-flow-stage__synapse data-flow-stage__synapse--core" cx="557" cy="235" r="7" />
        <circle class="data-flow-stage__synapse" cx="887" cy="198" r="5" />
        <circle class="data-flow-stage__synapse" cx="1058" cy="228" r="6" />

        <circle class="data-flow-stage__packet data-flow-stage__packet--one" r="9">
          <animateMotion dur="7.8s" repeatCount="indefinite" path="M138 117 C 224 54, 319 89, 372 151 S 443 210, 496 191" />
        </circle>
        <circle class="data-flow-stage__packet data-flow-stage__packet--two" r="7">
          <animateMotion dur="9.5s" begin="1.6s" repeatCount="indefinite" path="M196 294 C 294 236, 361 282, 423 235 S 470 191, 515 218" />
        </circle>
        <circle class="data-flow-stage__packet data-flow-stage__packet--three" r="8">
          <animateMotion dur="8.7s" begin="3.1s" repeatCount="indefinite" path="M346 365 C 392 303, 434 284, 474 255 S 520 220, 557 235" />
        </circle>
        <circle class="data-flow-stage__packet data-flow-stage__packet--out" r="10">
          <animateMotion dur="7.2s" begin="0.8s" repeatCount="indefinite" path="M654 221 C 742 162, 824 209, 887 198 S 965 178, 1058 228" />
        </circle>
      </svg>

      <article class="data-flow-stage__panel data-flow-stage__players">
        <div class="data-flow-stage__panel-content">
          <div class="data-flow-stage__panel-head">
            <span class="data-flow-stage__panel-kicker">
              {lang === 'cs' ? '01 · vstupy' : '01 · inputs'}
            </span>
            <h3>{t('dataFlow.playersTitle')}</h3>
            <p>{t('dataFlow.playersBody')}</p>
          </div>

          <div class="data-flow-stage__field" aria-hidden="true">
            {nodes.map((node, index) => (
              <span
                class={`data-flow-stage__node data-flow-stage__node--${node.size}`}
                style={`--x: ${node.x}; --y: ${node.y}; --delay: ${node.delay};`}
              >
                <span class="data-flow-stage__node-core"></span>
                <span class="data-flow-stage__node-label">
                  {node.label}
                </span>
                {index % 3 === 0 && <span class="data-flow-stage__node-ring"></span>}
              </span>
            ))}
          </div>
        </div>
      </article>

      <article class="data-flow-stage__panel data-flow-stage__core">
        <div class="data-flow-stage__panel-content data-flow-stage__core-content">
          <span class="data-flow-stage__panel-kicker">
            {lang === 'cs' ? '02 · spojení' : '02 · merge'}
          </span>
          <div class="data-flow-stage__core-orb" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <h3>{t('dataFlow.coreTitle')}</h3>
          <p>{t('dataFlow.coreBody')}</p>
        </div>
      </article>

      <article class="data-flow-stage__panel data-flow-stage__coach">
        <div class="data-flow-stage__panel-content">
          <div class="data-flow-stage__panel-head">
            <span class="data-flow-stage__panel-kicker">
              {lang === 'cs' ? '03 · výstup' : '03 · output'}
            </span>
            <h3>{t('dataFlow.coachTitle')}</h3>
            <p>{t('dataFlow.coachBody')}</p>
          </div>

          <div class="data-flow-stage__decision-list">
            {decisions.map((decision, index) => (
              <span
                class="data-flow-stage__decision"
                style={`--delay: ${index * 1.65}s;`}
              >
                {decision}
              </span>
            ))}
          </div>
        </div>
      </article>
    </div>

    <div class="data-flow-stage__mobile-steps" aria-hidden="true">
      {mobileSteps.map((step, index) => (
        <div class="data-flow-stage__mobile-step">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{step}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .data-flow-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(6rem, 12vw, 10rem) 0;
    background:
      radial-gradient(circle at 17% 21%, color-mix(in srgb, var(--color-accent-primary) 16%, transparent), transparent 34rem),
      radial-gradient(circle at 82% 62%, color-mix(in srgb, var(--color-accent-warm-dark) 10%, transparent), transparent 30rem),
      linear-gradient(180deg, #020606 0%, #041112 50%, #020606 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .data-flow-stage__grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    opacity: 0.26;
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-accent-primary) 12%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-accent-primary) 12%, transparent) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: radial-gradient(circle at 50% 45%, black 0%, transparent 78%);
  }

  .data-flow-stage__halo {
    position: absolute;
    z-index: -2;
    width: 28rem;
    height: 28rem;
    border-radius: 999px;
    filter: blur(44px);
    opacity: 0.22;
    background: var(--color-accent-primary);
    animation: data-flow-halo 12s ease-in-out infinite alternate;
  }

  .data-flow-stage__halo--left {
    left: -9rem;
    top: 18%;
  }

  .data-flow-stage__halo--right {
    right: -11rem;
    bottom: 12%;
    animation-delay: -4s;
  }

  .data-flow-stage__neural-net {
    position: absolute;
    inset: 20% -4% auto;
    z-index: -1;
    width: 108%;
    height: min(62rem, 78%);
    overflow: visible;
    pointer-events: none;
    opacity: 0.78;
    mask-image: linear-gradient(180deg, transparent 0%, black 16%, black 82%, transparent 100%);
  }

  .data-flow-stage__neural-path,
  .data-flow-stage__neural-branch {
    fill: none;
    stroke: url(#neural-flow-line);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
    stroke-dasharray: 10 20;
    animation: data-flow-neural-dash 13s linear infinite;
  }

  .data-flow-stage__neural-path--b {
    animation-duration: 15.5s;
    animation-delay: -2.5s;
    opacity: 0.72;
  }

  .data-flow-stage__neural-path--c {
    animation-duration: 14.2s;
    animation-delay: -4.8s;
    opacity: 0.62;
  }

  .data-flow-stage__neural-branch {
    stroke-width: 0.95;
    stroke-dasharray: 4 15;
    opacity: 0.48;
    animation-duration: 17s;
  }

  .data-flow-stage__neural-nodes circle {
    fill: rgba(0, 240, 255, 0.9);
    filter: drop-shadow(0 0 16px color-mix(in srgb, var(--color-accent-primary) 54%, transparent));
    opacity: 0.66;
    transform-box: fill-box;
    transform-origin: center;
    animation: data-flow-synapse 6.4s ease-in-out infinite;
  }

  .data-flow-stage__neural-nodes circle:nth-child(2n) {
    animation-delay: -1.7s;
  }

  .data-flow-stage__neural-nodes circle:nth-child(3n) {
    animation-delay: -3.2s;
  }

  .data-flow-stage__neural-signal {
    fill: url(#neural-node-glow);
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--color-accent-primary) 70%, transparent));
    opacity: 0.88;
  }

  .data-flow-stage__inner {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, 86rem);
    margin-inline: auto;
  }

  .data-flow-stage__intro {
    max-width: 56rem;
    margin-inline: auto;
    text-align: center;
  }

  .data-flow-stage__eyebrow,
  .data-flow-stage__panel-kicker {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.44em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
  }

  .data-flow-stage__headline {
    margin: 1.1rem 0 0;
    font-size: clamp(2.45rem, 6.1vw, 5.9rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    color: var(--color-text-primary);
  }

  .data-flow-stage__body {
    max-width: 45rem;
    margin: 1.55rem auto 0;
    font-size: clamp(1rem, 1.55vw, 1.2rem);
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text-secondary) 88%, white);
  }

  .data-flow-stage__map {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(15rem, 0.72fr) minmax(0, 1.08fr);
    gap: clamp(1rem, 2.2vw, 1.5rem);
    align-items: stretch;
    margin-top: clamp(3rem, 6vw, 5.6rem);
  }

  .data-flow-stage__paths {
    position: absolute;
    inset: -1.8rem -1.5rem;
    z-index: 0;
    width: calc(100% + 3rem);
    height: calc(100% + 3.6rem);
    overflow: visible;
    pointer-events: none;
  }

  .data-flow-stage__path {
    fill: none;
    stroke: url(#data-flow-line);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 9 18;
    animation: data-flow-dash 8s linear infinite;
  }

  .data-flow-stage__path--two {
    animation-duration: 9.2s;
    animation-delay: -1.4s;
  }

  .data-flow-stage__path--three {
    animation-duration: 10s;
    animation-delay: -3.1s;
  }

  .data-flow-stage__path--out {
    stroke-width: 2.8;
    stroke-dasharray: 12 16;
    animation-duration: 7.3s;
  }

  .data-flow-stage__path--branch {
    stroke-width: 1.25;
    stroke-dasharray: 4 13;
    opacity: 0.48;
    animation-duration: 12s;
  }

  .data-flow-stage__synapse {
    fill: var(--color-accent-primary);
    stroke: color-mix(in srgb, var(--color-accent-primary-subtle) 72%, transparent);
    stroke-width: 1;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--color-accent-primary) 70%, transparent));
    opacity: 0.82;
    transform-box: fill-box;
    transform-origin: center;
    animation: data-flow-synapse 5.2s ease-in-out infinite;
  }

  .data-flow-stage__synapse--core {
    animation-delay: -1.8s;
  }

  .data-flow-stage__packet {
    fill: url(#data-flow-pulse);
    filter: drop-shadow(0 0 16px color-mix(in srgb, var(--color-accent-primary) 64%, transparent));
    opacity: 0.86;
  }

  .data-flow-stage__panel {
    z-index: 1;
    min-height: 27rem;
  }

  .data-flow-stage__panel-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(0.35rem, 1vw, 0.65rem);
  }

  .data-flow-stage__panel h3 {
    margin: 0.8rem 0 0;
    font-size: clamp(1.65rem, 2.7vw, 2.45rem);
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--color-text-primary);
  }

  .data-flow-stage__panel p {
    margin: 1rem 0 0;
    max-width: 26rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .data-flow-stage__field {
    position: relative;
    flex: 1;
    min-height: 18.5rem;
    margin-top: 1.35rem;
    border-radius: 1.15rem;
    background:
      radial-gradient(circle at 45% 45%, color-mix(in srgb, var(--color-accent-primary) 15%, transparent), transparent 54%),
      linear-gradient(135deg, rgba(0, 240, 255, 0.045), rgba(255, 255, 255, 0.01));
    border: 1px solid color-mix(in srgb, var(--color-accent-primary) 22%, transparent);
    box-shadow:
      0 0 42px color-mix(in srgb, var(--color-accent-primary) 9%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.055);
    overflow: hidden;
  }

  .data-flow-stage__field::before {
    background:
      linear-gradient(125deg, transparent 0 27%, color-mix(in srgb, var(--color-accent-primary) 18%, transparent) 27.5% 28%, transparent 28.5% 100%),
      linear-gradient(28deg, transparent 0 42%, color-mix(in srgb, var(--color-accent-primary) 13%, transparent) 42.5% 43%, transparent 43.5% 100%);
  }

  .data-flow-stage__field::before,
  .data-flow-stage__field::after {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent-primary) 14%, transparent);
    opacity: 0.54;
  }

  .data-flow-stage__field::after {
    inset: 27%;
    opacity: 0.3;
  }

  .data-flow-stage__node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    place-items: center;
    transform: translate(-50%, -50%);
    animation: data-flow-node 8.5s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .data-flow-stage__node--sm {
    --node-size: 0.72rem;
  }

  .data-flow-stage__node--md {
    --node-size: 0.9rem;
  }

  .data-flow-stage__node--lg {
    --node-size: 1.08rem;
  }

  .data-flow-stage__node-core {
    width: var(--node-size);
    height: var(--node-size);
    border-radius: 999px;
    background: var(--color-accent-primary);
    box-shadow:
      0 0 0 0 color-mix(in srgb, var(--color-accent-primary) 30%, transparent),
      0 0 22px color-mix(in srgb, var(--color-accent-primary) 62%, transparent);
  }

  .data-flow-stage__node-ring {
    position: absolute;
    width: calc(var(--node-size) * 3.8);
    height: calc(var(--node-size) * 3.8);
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent-primary) 24%, transparent);
    animation: data-flow-ring 8.5s ease-out infinite;
    animation-delay: var(--delay);
  }

  .data-flow-stage__node-label {
    position: absolute;
    left: 1.15rem;
    top: 50%;
    transform: translateY(-50%);
    width: max-content;
    max-width: 8.2rem;
    padding: 0.34rem 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent-primary) 20%, transparent);
    background: rgba(0, 15, 17, 0.64);
    color: color-mix(in srgb, var(--color-text-primary) 94%, var(--color-accent-primary));
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    opacity: 0;
    white-space: nowrap;
    animation: data-flow-label 8.5s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .data-flow-stage__core-content {
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
  }

  .data-flow-stage__core-content::before {
    content: '';
    position: absolute;
    inset: 10% 3%;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-primary) 16%, transparent), transparent 68%);
    filter: blur(18px);
  }

  .data-flow-stage__core-orb {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(8rem, 15vw, 11.5rem);
    aspect-ratio: 1;
    margin: 1.7rem auto 0.35rem;
    border-radius: 999px;
    background:
      radial-gradient(circle at 38% 28%, rgba(255, 255, 255, 0.82), transparent 12%),
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--color-accent-primary-subtle) 84%, white), var(--color-accent-primary) 38%, color-mix(in srgb, var(--color-accent-primary) 30%, black) 72%);
    box-shadow:
