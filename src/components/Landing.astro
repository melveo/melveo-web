---
/**
 * Landing — shared body of the home page across locales.
 *
 * Reference DNA: fey.com + raycast.com (per PLAN.md §3).
 * Each section is its own full-bleed stage; no outer max-width
 * container. Strings come from src/i18n/ui.ts via t() helper.
 *
 * V4 enhancements (Three.js hero, codepen effects, etc.) will land
 * in subsequent commits per V4-C / V4-D phases. This component is
 * the V3 layout wrapped in a locale-aware shell.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from './HeroScene.astro';
import ImageGridScrollMorph from './ImageGridScrollMorph.astro';
import GooeyStage from './GooeyStage.astro';
import WordScrollStage from './WordScrollStage.astro';
// ClubFlowStage (JEDEN DEN V KLUBU) removed 2026-05-15 per user
// request — section sat between WordScroll and OrbStage but was
// redundant with the data-flow narrative the rest of the page
// already tells.
import OrbStage from './OrbStage.astro';
import PromiseStage from './PromiseStage.astro';
import PricingStage from './PricingStage.astro';
import MelveoDataFlowHero from './MelveoDataFlowHero';
import FaqStage from './FaqStage.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title="Melveo" lang={lang}>
  <!-- ============================================================== -->
  <!-- HERO — pitch-black, full viewport, prism shader, claim, CTA    -->
  <!-- ============================================================== -->
  <section class="relative isolate flex min-h-screen w-full flex-col overflow-hidden bg-[var(--color-bg-canvas)]">
    <HeroScene />

    <header class="relative z-10 flex w-full items-center justify-between px-6 pt-6 sm:px-12 sm:pt-10">
      <a
        href={`/${lang}/`}
        class="melveo-wordmark text-xl tracking-tight text-[var(--color-text-primary)]"
      >
        melveo
      </a>
      <a
        href="mailto:hello@melveo.app"
        class="hidden text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)] sm:inline"
      >
        {t('nav.contact')}
      </a>
    </header>

    {/*
      flex-1 + justify-center already vertically-centres the hero
      content within the remaining viewport-minus-header space, so
      the previous `pt-24 pb-8 sm:pt-32` tilted the whole stack
      visibly downward. User feedback 2026-05-01 — wanted the texts +
      CTAs more centred. Using a small SYMMETRIC py value gives a
      hairline safety margin (so the headline doesn't graze the
      header on very short viewports) while letting justify-center
      do the actual centring work.
    */}
    <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 py-6 text-center sm:py-10">
      <h1
        class="hero-headline leading-[0.95] tracking-tight text-[var(--color-text-primary)]"
      >
        <span class="hero-headline-static">
          <span>{t('hero.headlineLine1')}</span>
          <span>{t('hero.headlineLine2')}</span>
        </span>
        <span class="hero-rotate-cluster">
          <span class="hero-rotate-current">
            <span
              class="text-[var(--color-accent-primary)]"
              data-rotate-word
              data-rotate-words={t('hero.headlineRotations')}
              aria-live="polite"
            >
              {t('hero.headlineInitial')}
            </span><span class="hero-headline-dot" aria-hidden="true">{t('hero.headlineSuffix')}</span>
          </span>
        </span>
      </h1>

      <p class="hero-subline mx-auto mt-10 max-w-[38rem] text-pretty text-xl font-medium text-[var(--color-text-primary)] sm:text-2xl">
        {/*
          Subline supports inline pill chips via [[word]] markers.
          Split on the marker, render odd-indexed pieces as cyan
          tag pills. Lets us highlight feature terms (check-ins,
          wellness, load, match context) without losing flexibility
          in the i18n string itself.
        */}
        {t('hero.subline').split(/\[\[|\]\]/).map((part, i) =>
          i % 2 === 1 ? <span class="hero-keyword">{part}</span> : part
        )}
      </p>

      {/*
        CTA hierarchy 2026-05-16: flipped primary to "Kontakt / Get
        in touch" because the App Store button currently only opens
        an "app isn't on App Store yet" notice — misleading as a
        primary action. Mailto link is the honest primary path
        right now. App Store stays as secondary ghost button so the
        notify-me option remains visible without competing.
      */}
      <div class="hero-cta-row">
        <a
          href={`mailto:hello@melveo.app?subject=${encodeURIComponent(
            lang === 'cs' ? 'Kontakt — Melveo' : 'Melveo — get in touch'
          )}`}
          class="hero-pill hero-pill--filled"
        >
          <span class="hero-pill-shimmer" aria-hidden="true"></span>
          <span class="hero-pill-content">{t('hero.cta.pilot')}</span>
        </a>
        <a
          href="#contact"
          aria-label={t('hero.cta.appstore')}
          class="hero-pill hero-pill--ghost"
          data-appstore-notify
          data-notice={t('hero.appstoreNotice')}
        >
          <span class="hero-pill-shimmer" aria-hidden="true"></span>
          <span class="hero-pill-content">
            {/* Apple logo glyph in inline SVG so we control colour */}
            <svg
              class="hero-pill-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
            </svg>
            <span class="hero-pill-text">
              <span class="hero-pill-eyebrow">
                {lang === 'cs' ? 'Stáhnout v' : 'Download on the'}
              </span>
              <span class="hero-pill-title">App Store</span>
            </span>
          </span>
        </a>
      </div>
      <div class="appstore-toast" data-appstore-toast role="status" aria-live="polite" hidden></div>
    </div>

  </section>

  <!-- ============================================================== -->
  <!-- STAGE 2 + 3 — Scroll-linked image grid morph                    -->
  <!--               (Kevin Gutowski codepen QwNZYzL)                  -->
  <!-- ============================================================== -->
  <ImageGridScrollMorph lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 2.5 — Data → Feedback product story                      -->
  <!--   Keep high on page: explains player signals → melveo → coach  -->
  <!--   output before the more atmospheric sections continue.         -->
  <!-- ============================================================== -->
  <MelveoDataFlowHero lang={lang} client:visible />

  <!-- ============================================================== -->
  <!-- STAGE 3.5 — Gooey metaball (Ahmad Awais codepen)                -->
  <!-- ============================================================== -->
  <GooeyStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 3.75 — Scroll-linked word highlight (Daniel Haim codepen) -->
  <!-- ============================================================== -->
  <WordScrollStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 5 — Glass orb + rotating text (Giomgio codepen)           -->
  <!-- ============================================================== -->
  <OrbStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 6.5 — Billing-promise mini bridge (gooey-family)         -->
  <!--               "Klub platí. Hráč nikdy."                        -->
  <!--   Sits right before pricing as a positioning beat.             -->
  <!-- ============================================================== -->
  <PromiseStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 7 — Pricing                                               -->
  <!-- ============================================================== -->
  <PricingStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 6.75 — App screenshot showcase (HIDDEN 2026-05-04)         -->
  <!--   Per user direction: don't show "what the app looks like"      -->
  <!--   while we only have placeholder phone-frames. Showing empty    -->
  <!--   wireframes signals "nothing to show yet" — cleanest is to     -->
  <!--   hide the section until real iOS screenshots ship. Re-enable   -->
  <!--   by uncommenting + dropping PNG/WEBP into                      -->
  <!--   /public/images/app-shots/ + flipping placeholder={false}.     -->
  <!-- ============================================================== -->
  {/* <AppShotsStage lang={lang} placeholder={false} /> */}

  <!-- ============================================================== -->
  <!-- STAGE 7.5 — Customer testimonial (HIDDEN 2026-05-04)            -->
  <!--   Per user direction: no fake/anonymous quotes while we have   -->
  <!--   no real customers yet. The placeholder ("citát po prvním     -->
  <!--   pilotu") signalled "we have nothing"; an anonymous coach      -->
  <!--   quote would be deceptive. Cleanest = hide section entirely    -->
  <!--   until a real, attributable testimonial arrives. Re-enable     -->
  <!--   by uncommenting + setting placeholder={false} + filling       -->
  <!--   testimonial.quote / .author / .role for both locales.         -->
  <!-- ============================================================== -->
  {/* <TestimonialStage lang={lang} placeholder={false} /> */}

  <!-- ============================================================== -->
  <!-- STAGE 8 — FAQ (added 2026-05-03)                                -->
  <!--   Six common questions before pilot booking. Native            -->
  <!--   <details>/<summary> for accessibility + SEO FAQPage         -->
  <!--   schema for Google rich results.                              -->
  <!-- ============================================================== -->
  <FaqStage lang={lang} />

  <!-- ============================================================== -->
  <!-- STAGE 9 — Direct contact                                        -->
  <!--   Final page action. Keep this as the only bottom CTA: no       -->
  <!--   operator/company block and no duplicate notify form.           -->
  <!-- ============================================================== -->
  <section id="contact" class="pilot-cta-stage">
    <div class="pilot-cta-stage__inner">
      <p class="pilot-cta-stage__body">
        {t('pilot.body')}
      </p>
      <a
        href={`mailto:${t('pilot.email')}`}
        class="pilot-cta-stage__email"
        aria-label={lang === 'cs' ? 'Napsat na ' + t('pilot.email') : 'Email ' + t('pilot.email')}
      >
        {t('pilot.email')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Pilot CTA — quiet closing footer. No smoke, no pill button, no
    decorative cyan halo (user 2026-05-01: "možná bych tam nedával
    ani to pozadí, hlavní věc je ten firemní e-mail jako největší
    co tam je"). Headline + body are tiny eyebrows above the email,
    which is the focal element of the whole page closing.
  */
  .pilot-cta-stage {
    position: relative;
    width: 100%;
    border-top: 1px solid var(--color-stroke-base);
    background: var(--color-bg-canvas);
  }

  .pilot-cta-stage__inner {
    width: min(100% - 2rem, 64rem);
    margin: 0 auto;
    padding: clamp(5.5rem, 11vw, 9rem) 0;
    text-align: center;
  }

  /* Headline + body are now eyebrow-scale labels above the email,
     not the focal copy. Reads as "Pojďme to spustit. / Krátký
     e-mail stačí." */
  .pilot-cta-stage__headline {
    margin: 0;
    font-weight: 600;
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
  }

  .pilot-cta-stage__body {
    margin: 0.85rem auto 0;
    max-width: 32rem;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /*
    Email = the largest, brightest thing on the closing footer. Brand
    cyan, display weight, scales up to ~7 rem on big screens so it
    reads as the page's last word. Animated underline on hover.
  */
  .pilot-cta-stage__email {
    display: inline-block;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.85rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-accent-primary);
    text-decoration: none;
    text-shadow: 0 0 36px color-mix(in srgb, var(--color-accent-primary) 28%, transparent);
    background-image: linear-gradient(
      90deg,
      var(--color-accent-primary),
      var(--color-accent-primary)
    );
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 2px;
    transition: background-size 0.4s cubic-bezier(0.39, 0.575, 0.565, 1);
  }
  .pilot-cta-stage__email:hover,
  .pilot-cta-stage__email:focus-visible {
    background-size: 100% 2px;
  }
  .pilot-cta-stage__email:focus-visible {
    outline: 2px solid var(--color-accent-primary-subtle);
    outline-offset: 8px;
    border-radius: 6px;
  }

  /* Feedback section is centred at all viewports now (see
     .feedback-stage__inner above) — no @media override needed. */

  /*
    Hero rotating word — wrap so y-translate during cycle stays within
    the line. Typewriter version writes characters in-place via
    `el.textContent = ...`. The dot lives in the same isolated paint
    layer as the mutable word; otherwise Chromium can leave tiny
    white suffix-dot remnants while the large headline repaints.
  */
  .hero-headline {
    display: flex;
    width: min(100%, 76rem);
    max-width: calc(100vw - 2rem);
    flex-direction: column;
    align-items: center;
    gap: 0.03em;
    /*
      Hero headline uses the site display font (Inter) to match
      every other section heading — only the "melveo" wordmark
      (logo top-left + brand mark) stays in the Comfortaa/Quicksand
      family. Per user direction 2026-05-15: headline previously
      rode the wordmark face and looked like a second logo.
    */
    font-family: var(--font-display);
    font-weight: 700;
    /*
      Keep the hero claim as exactly two visual lines:
        1. static setup
        2. rotating outcome

      The previous 7vw sizing let the Czech setup line wrap at medium
      desktop widths ("Z hráčských signálů" / "vzniká" / outcome).
      Size now follows the viewport more conservatively instead of
      allowing a third line.
    */
    font-size: clamp(2.05rem, min(5.55vw, 10.5vh), 5.9rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
    /*
      Hero text sits over an animated particle / shader scene
      (HeroScene canvas). Without a backdrop the white text drifts
      into the cyan particles and becomes hard to read — user feedback
      2026-05-15 ("texty občas trošku splývají s pozadím"). A subtle
      dark text-shadow gives every glyph its own pseudo-stroke so the
      headline stays legible across whatever the canvas happens to be
      drawing behind it.
    */
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.55),
      0 4px 24px rgba(0, 0, 0, 0.45);
  }

  .hero-headline-static {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.18em;
    white-space: nowrap;
  }

  /* Subline gets the same shadow treatment as the headline so the
     full copy block reads as one legible unit over the canvas.
     User feedback 2026-05-16: tighter line-height + heavier shadow
     stack ("lépe graficky čitelné") so the copy reads sharply
     against the metaballs canvas on phone. */
  .hero-subline {
    line-height: 1.4;
    letter-spacing: -0.005em;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.75),
      0 2px 4px rgba(0, 0, 0, 0.55),
      0 4px 18px rgba(0, 0, 0, 0.5);
  }
  @media (max-width: 520px) {
    .hero-subline {
      line-height: 1.32;
    }
  }

  /*
    Highlighted keywords in the subline (check-ins, wellness, load,
    match context). User direction 2026-05-16: drop the capsule
    background entirely — just color the text in brand cyan + bold
    so the feature verbs scan as the action surface without looking
    like UI tags. Soft cyan text-shadow gives them a subtle glow
    against the dark background.
  */
  .hero-keyword {
    color: var(--color-accent-primary);
    font-weight: 600;
    text-shadow:
      0 0 12px color-mix(in oklch, var(--color-accent-primary) 22%, transparent),
      0 1px 2px rgba(0, 0, 0, 0.55);
  }

  .hero-rotate-cluster {
    display: inline-grid;
    min-height: 1.24em;
    justify-content: center;
    align-items: center;
    overflow: visible;
    white-space: nowrap;
    isolation: isolate;
    transform: translateZ(0);
  }

  .hero-rotate-cluster::before {
    content: attr(data-rotate-measure);
    grid-area: 1 / 1;
    visibility: hidden;
    padding-block: 0.16em 0.24em;
    line-height: 1.14;
    white-space: nowrap;
  }

  .hero-rotate-current {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: baseline;
    justify-self: center;
    white-space: nowrap;
  }

  [data-rotate-word] {
    display: inline-block;
    position: relative;
    padding-block: 0.16em 0.24em;
    line-height: 1.14;
    text-align: center;
    transform: translateZ(0);
  }

  [data-rotate-word]::after {
    content: none;
  }

  .hero-headline-dot {
    color: var(--color-text-primary);
    line-height: 1.14;
    padding-block: 0.16em 0.24em;
    transform: translateZ(0);
    opacity: 0.98;
    animation: hero-dot-pulse 1.05s ease-in-out infinite;
    text-shadow: 0 0 0.18em rgba(245, 254, 255, 0.42);
    will-change: opacity;
  }

  .hero-rotate-cluster[data-rotate-state='deleting'] .hero-headline-dot,
  .hero-rotate-cluster[data-rotate-state='idle'] .hero-headline-dot {
    opacity: 1;
    animation-duration: 0.72s;
  }

  @keyframes hero-dot-pulse {
    0%,
    100% {
      opacity: 0.42;
    }

    45%,
    70% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-rotate-word] {
      padding-right: 0;
    }

    .hero-headline-dot {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 520px) {
    .hero-headline {
      font-size: clamp(2rem, 8.4vw, 2.9rem);
      letter-spacing: -0.025em;
      line-height: 1;
    }

    .hero-headline-static {
      flex-direction: row;
      gap: 0.18em;
    }

    .hero-rotate-cluster {
      min-height: 1.34em;
    }

  }

  /*
    Hero CTA row — CodePen glass-button mechanics adapted to Melveo
    colours. Both buttons share the same animated border and shimmer.
  */
  /*
    CTA row — always side-by-side at every viewport per user
    direction 2026-05-16 ("ty 2 buttony budou vždy vedle sebe,
    at je to jakákoliv velikost device"). Phone needs flex-wrap
    safety: if combined pill widths exceed viewport, they wrap to
    next line instead of overflowing, but the default state keeps
    them in one row. Tighter gap on phone so two pills fit cleanly.
  */
  .hero-cta-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .hero-cta-row {
      gap: 1.5rem;
    }
  }

  /* .hero-pill recipe lives in src/styles/global.css so any component
     can reuse it (notably PricingStage's plan CTAs per user request
     2026-05-01: "úplně přesně takové tlačítka jako v Hero"). The
     pointer-tracking handler below in mountHeroButtons() runs on every
     .hero-pill in the DOM, so pricing CTAs get the same effect for
     free as long as they live on the same page. */

  .appstore-toast {
    position: fixed;
    left: 50%;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 80;
    width: min(calc(100% - 2rem), 28rem);
    transform: translate(-50%, 0);
    border: 1px solid color-mix(in srgb, var(--color-accent-primary) 24%, var(--color-stroke-emphasized));
    border-radius: 999px;
    padding: 0.9rem 1.15rem;
    background:
      linear-gradient(135deg, rgba(0, 240, 255, 0.16), rgba(255, 255, 255, 0.055)),
      rgba(5, 6, 8, 0.86);
    color: var(--color-text-primary);
    box-shadow:
      0 22px 70px rgba(0, 240, 255, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .appstore-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, -0.35rem);
  }

  .appstore-toast[hidden] {
    display: block;
    visibility: hidden;
  }

  @media (min-width: 640px) {
    .appstore-toast {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .appstore-toast {
      transition: none;
    }
  }
</style>

<script>
  import { mountRotateWord } from '../scripts/rotate-word';

  function mountHeroButtons() {
    document.querySelectorAll<HTMLElement>('.hero-pill').forEach((button) => {
      button.addEventListener('pointermove', (event) => {
        const rect = button.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;
        button.style.setProperty('--x', `${x}%`);
        button.style.setProperty('--y', `${y}%`);
      });
    });
  }

  function mountAppStoreNotifyCta() {
    const cta = document.querySelector<HTMLAnchorElement>('[data-appstore-notify]');
    const target = document.querySelector<HTMLElement>('#contact');
    const toast = document.querySelector<HTMLElement>('[data-appstore-toast]');
    let toastTimer: number | undefined;

    if (!cta || !toast) return;

    cta.addEventListener('click', (event) => {
      event.preventDefault();

      const message = cta.dataset.notice || '';
      toast.textContent = message;
      toast.hidden = false;
      requestAnimationFrame(() => toast.classList.add('is-visible'));

      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('is-visible');
        window.setTimeout(() => {
          toast.hidden = true;
        }, 240);
      }, 4200);

      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  function mountTextRevealWhenNeeded() {
    const targets = document.querySelectorAll<HTMLElement>('[data-text-reveal]');
    if (targets.length === 0) return;

    const load = async () => {
      const { mountTextReveal } = await import('../scripts/text-reveal');
      mountTextReveal();
    };

    if (!('IntersectionObserver' in window)) {
      globalThis.setTimeout(load, 2400);
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        load();
      },
      { rootMargin: '700px 0px' },
    );

    targets.forEach((target) => observer.observe(target));
  }

  // Defer to idle so hero LCP is unaffected
  function init() {
    mountHeroButtons();
    mountAppStoreNotifyCta();
    mountRotateWord();
    mountTextRevealWhenNeeded();
  }

  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(init, { timeout: 1500 });
  } else {
    setTimeout(init, 200);
  }
</script>
