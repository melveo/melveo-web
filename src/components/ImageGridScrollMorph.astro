<style>
  /*
    Subgrid trick + sticky content — direct port from the codepen.
    Comments mark anywhere we deviated.
  */

  .image-grid-section {
    /*
      Runway: extended 2026-05-18 after review. The morph was
      readable, but fast scrolling could make the full-bleed photo →
      centre hex → honeycomb reveal feel compressed. The JS below
      now spreads the phases across nearly the whole runway, so this
      extra height creates real animation time rather than a dead tail.
    */
    position: relative;
    width: 100%;
    min-height: 285vh;
    min-height: calc(var(--grid-stable-vh, 100svh) * 2.85);
    background: var(--color-bg-canvas);
    /* border-top removed 2026-05-17: no horizontal dividers between sections */
    overflow: clip;
    /*
      Chrome scroll anchoring can try to preserve the visual position
      of descendants while the centre image morphs from viewport-sized
      to hex-sized and while Motion scroll observers are detached. That
      can pull the page back toward this section after the user has
      already scrolled on, which feels like global page jank. This
      section intentionally controls its own scroll illusion, so opt it
      out of anchoring.
    */
    overflow-anchor: none;
    /*
      Perf 2026-05-17 (user-reported: whole site janks after
      passing through this section, even with Motion scroll
      observers properly torn down via IntersectionObserver).
      Root cause was Chrome continuing to composite the 30
      hexagons + sticky container per scroll-frame across the
      entire rest of the page, because the section stayed in
      the layout/render tree.

      `content-visibility: auto` tells Chrome to skip rendering
      (paint, layout for descendants, hit-test) entirely when
      the section is off-screen by more than ~50 % viewport.
      Combined with `contain-intrinsic-size` (so layout still
      reserves the section's space without measuring children)
      it removes the per-scroll composite cost end-to-end.

      285vh matches the min-height above so the placeholder
      size is exact; the mobile media query below adjusts to
      235vh for ≤1024 px.
    */
    content-visibility: auto;
    contain-intrinsic-size: 100vw 285vh;
  }

  .image-grid-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 8% 22%, rgba(0, 240, 255, 0.16), transparent 16rem),
      radial-gradient(circle at 24% 78%, rgba(0, 240, 255, 0.14), transparent 20rem),
      radial-gradient(circle at 54% 18%, rgba(0, 240, 255, 0.12), transparent 18rem),
      radial-gradient(circle at 72% 66%, rgba(0, 240, 255, 0.16), transparent 22rem),
      radial-gradient(circle at 94% 34%, rgba(0, 240, 255, 0.13), transparent 17rem),
      linear-gradient(180deg, rgba(0, 240, 255, 0.02), transparent 35%, rgba(0, 240, 255, 0.035));
    opacity: 0.92;
  }

  @media (max-width: 1024px) {
    .image-grid-section {
      min-height: 235vh;
      min-height: calc(var(--grid-stable-vh, 100svh) * 2.35);
      /* Match content-visibility placeholder to the shorter
         tablet/mobile section height — otherwise Chrome reserves
         the desktop 215vh slot and the page below shifts. */
      contain-intrinsic-size: 100vw 235vh;
    }
  }

  /* The canvas element remains in markup for backwards compatibility
     with old snapshots, but this section now uses the static CSS
     atmosphere above instead of runtime smoke. */
  .image-grid-section .glass-smoke {
    display: none;
    pointer-events: none;
  }

  @media (max-width: 900px), (pointer: coarse) {
    .image-grid-section::before {
      background:
        radial-gradient(circle at 18% 18%, rgba(0, 240, 255, 0.13), transparent 11rem),
        radial-gradient(circle at 78% 28%, rgba(0, 240, 255, 0.12), transparent 10rem),
        radial-gradient(circle at 22% 76%, rgba(0, 240, 255, 0.14), transparent 12rem),
        radial-gradient(circle at 86% 82%, rgba(0, 240, 255, 0.11), transparent 10rem),
        linear-gradient(180deg, rgba(0, 240, 255, 0.02), transparent 42%, rgba(0, 240, 255, 0.035));
    }
  }

  /* .content needs to sit above the smoke. Sticky positioning on
     siblings doesn't share a stacking context, so we lift it via
     z-index. */
  .image-grid-section .content {
    z-index: 1;
  }

  /* ─── Intro overlay ─────────────────────────────────────────────
     Pinned to the centre of the sticky .content. Stacking inside
     .content (which is z-index 1):
       .grid                  → z-index 1 (default)
       .grid-intro-darken     → z-index 2 (black layer over photo)
       .grid-intro            → z-index 3 (wordmark + pill on top)
     All three faded by Motion across the first 22 % of section scroll. */

  .image-grid-section .grid-intro-darken {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: rgba(0, 0, 0, 0.72);
    pointer-events: none;
  }

  .image-grid-section .grid-intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    text-align: center;
    pointer-events: none; /* re-enabled on the pill below */
  }

  /* Eyebrow + wordmark cluster — stays vertically centred even when
     the pill moves to the bottom (per user request 2026-05-01:
     "tlačítko scrollovat bych dal jakoby dolů doprostřed"). */
  .image-grid-section .grid-intro__center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.5rem);
    max-width: min(92vw, 1400px);
  }

  /*
    Wordmark — half-section size, solid brand cyan, soft round font,
    subtle glass treatment. Per user feedback 2026-05-01:
      - "celý bez gradientu v naší primární barvě" → solid cyan,
        no background-clip:text gradient
      - "trošku glass efektu" → keep just enough specular touch to
        read as glass (no halo, no glow)
      - Font: Open Sans for the rounded "m"

    Glass effect comes from layered text-shadows:
      - 1 px white inset on top → reads as light catching the top
        rim of curved glass
      - 1 px dark inset on bottom → reads as the bottom shadow of
        the glass relief
      - Hairline white text-stroke on the rim
    No cyan glow / halo — explicitly removed.

    Single dark drop-shadow on filter for legibility against the
    photo (the photo behind starts at 28 % brightness, fully
    revealed by the time the wordmark is gone).

    Always lowercase via text-transform as a guard plus the
    lowercase string in the markup.
  */
  .image-grid-section .grid-intro__wordmark {
    position: relative;
    display: block;
    max-width: 92vw;
    margin: 0;
    font-family: var(--font-wordmark);
    font-weight: 700;
    /* Half-the-section size on desktop ("hodně větší, klidně přes půl
       sekce"). On phones the 30 vw multiplier was rendering the
       lowercase "melveo" wider than the screen — the 2.5 px text-stroke
       extends every glyph and the bold weight is wide. Tighter mobile
       cap so it stays within the safe inset. */
    font-size: clamp(4rem, 22vw, 26rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    color: var(--color-accent-primary);
    /* Faux extra-bold via cyan-on-cyan text-stroke (Quicksand caps at
       700 on Google Fonts; user 2026-05-01 asked for chunkier glyphs).
       Stroke extends ~half its width outside the glyph outline, so a
       2.5 px cyan stroke matched to the fill effectively thickens
       every limb of the 700 weight by ~1.2 px. paint-order keeps the
       stroke under the fill so the inner glyph stays sharp at the
       brand-cyan it should be. */
    -webkit-text-stroke: 2.5px var(--color-accent-primary);
    paint-order: stroke fill;
    /* Glass relief: tiny white catch on the top edge + tiny dark
       on the bottom. Reads as a curved glass face without any halo. */
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.35),
      0 -1px 0 rgba(0, 0, 0, 0.35),
      0 2px 0 rgba(255, 255, 255, 0.08);
    /* Dark drop-shadow only — separation from the photo. */
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.55));
  }

  /* Scroll-hint pill anchored to the bottom-centre of the overlay
     (was below the wordmark — moved per user request 2026-05-01).
     Pointer-events re-enabled here only; the rest of .grid-intro
     ignores clicks so the user can keep scrolling through it. */
  .image-grid-section .grid-intro__pill {
    position: absolute;
    bottom: clamp(2rem, 7vh, 5rem);
    left: 50%;
    transform: translateX(-50%);
    pointer-events: auto;
    padding-inline: 1.75rem;
    border: none;
    cursor: pointer;
    font: inherit;
  }

  .image-grid-section .grid-intro__chevron {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
    color: var(--color-accent-primary);
    /* Bobbing animation hints "scroll downward" without copy. The
       motion is small (3 px) and slow (1.4 s) so it reads as a
       subtle nudge, not a distraction. */
    animation: grid-intro-chevron-bob 1.4s ease-in-out infinite;
  }

  @keyframes grid-intro-chevron-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-grid-section .grid-intro__chevron {
      animation: none;
    }
  }

  .image-grid-section .content {
    /*
      Mobile browser chrome changes the visible viewport while the
      user scrolls. This section locks to a stable viewport variable
      in JS so the honeycomb cell size, sticky area and smoke layer do
      not resize mid-morph when the URL bar collapses.
    */
    min-height: 100vh;
    min-height: 100svh;
    min-height: var(--grid-stable-vh, 100svh);
    width: 100vw;
    position: sticky;
    top: 0;
    overflow: hidden;
    overflow-anchor: none;
    display: flex;
    place-items: center;
    align-content: center;
  }

  .image-grid-section .grid {
    /*
      Final state is a real point-top honeycomb, not a rectangular
      grid. Hex coordinates follow the same geometry as the reference
      CodePens:

        - same-row neighbours: one full hex width apart;
        - next row: half a hex width sideways and 75% hex height down.

      With 14 surrounding cells + the scaler this becomes a symmetric
      diamond: 1 / 4 / 5 / 4 / 1. The main photo is the centre hex.
    */
    --gutter: clamp(0.125rem, 0.35vw, 0.5rem);
    --hex-clip: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    --hex-gap: clamp(4px, 0.28vw, 8px);
    --hex-w: clamp(6.6rem, min(calc(var(--available-w) * 0.126), calc(var(--available-h) * 0.218)), 18.5rem);
    --hex-h: calc(var(--hex-w) / 0.8660254038);
    --available-w: calc(100vw - (2 * var(--gutter)));
    --available-h: calc(100vh - (2 * var(--gutter)));
    --available-h: calc(100svh - (2 * var(--gutter)));
    --available-h: calc(var(--grid-stable-vh, 100svh) - (2 * var(--gutter)));
    /* True honeycomb adjacency: resize the hexagons themselves, never
       fake the fill by pushing cells apart. Horizontal neighbours share
       vertical sides; the next row shifts by half a cell and 75% height. */
    --hex-x-step: calc(var(--hex-w) + var(--hex-gap));
    --hex-y-step: calc((var(--hex-h) * 0.75) + var(--hex-gap));
    --honeycomb-width: calc((var(--hex-x-step) * 7) + var(--hex-w));
    --honeycomb-height: calc((var(--hex-y-step) * 4) + var(--hex-h));

    width: var(--honeycomb-width);
    height: var(--honeycomb-height);
    max-width: var(--available-w);
    max-height: var(--available-h);
    margin: 0 auto;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    overflow: visible;
    contain: layout style;
    overflow-anchor: none;
  }

  /*
    Layer opacity driven by a single CSS variable (--reveal-progress
    set by JS via Motion on the section). Each layer has its own
    --reveal-offset; the opacity is clamped 0..1 from progress
    advancing past the offset. One scroll observer in JS now
    drives all 5 layer reveals — was 5 observers each ticking the
    main thread every scroll frame.
  */
  @property --reveal-progress {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .image-grid-section .grid > .layer {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    opacity: clamp(0, calc((var(--reveal-progress, 0) - var(--reveal-offset, 0)) * 6), 1);
    /*
      Perf 2026-05-17: will-change: opacity moved to JS — applied
      only while the section is within one viewport of the user.
      Static CSS hint kept all 5 layers on the GPU compositor for
      the whole page and added a measurable per-scroll cost
      everywhere else on the site.
    */
  }
  .image-grid-section .grid > .layer:nth-of-type(5) { --reveal-offset: 0; }
  .image-grid-section .grid > .layer:nth-of-type(4) { --reveal-offset: 0.04; }
  .image-grid-section .grid > .layer:nth-of-type(3) { --reveal-offset: 0.08; }
  .image-grid-section .grid > .layer:nth-of-type(2) { --reveal-offset: 0.12; }
  .image-grid-section .grid > .layer:nth-of-type(1) { --reveal-offset: 0.14; }

  .image-grid-section .grid > .layer > div,
  .image-grid-section .grid > .scaler {
    position: absolute;
    left: calc(50% + (var(--hx, 0) * var(--hex-x-step)));
    top: calc(50% + (var(--hr, 0) * var(--hex-y-step)));
    width: var(--hex-w);
    height: var(--hex-h);
    min-height: 0;
    min-width: 0;
    translate: -50% -50%;
    /*
      Perf 2026-05-17: dropped `will-change: transform, opacity`.
      Each cell would otherwise hold a permanent GPU layer for
      the page lifetime. The translate is static after layout —
      no need to hint, and the IntersectionObserver in script
      below promotes only what's animating, only when near view.
    */
    backface-visibility: hidden;
  }

  .image-grid-section .grid > .layer > div {
    opacity: 0;
    transform-origin: 50% 50%;
    contain: layout paint;
  }

  .image-grid-section .grid > .scaler {
    contain: layout style;
  }

  /* Landscape/default map: wider 5-row honeycomb, 7 / 8 / 7 / 8 / 7.
     This fills desktop and tablet landscape viewports far better than
     the old tall diamond while keeping every hex adjacent. */
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(1) { --hx: -3; --hr: 0; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(2) { --hx: -2.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(3) { --hx: -1.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(4) { --hx: 1.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(5) { --hx: 2.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(6) { --hx: 3; --hr: 0; }

  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(1) { --hx: -0.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(2) { --hx: 0.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(3) { --hx: -2; --hr: 0; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(4) { --hx: -0.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(5) { --hx: 0.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(6) { --hx: 2; --hr: 0; }

  .image-grid-section .grid > .layer:nth-of-type(3) > div:first-of-type { --hx: -1; --hr: 0; }
  .image-grid-section .grid > .layer:nth-of-type(3) > div:last-of-type { --hx: 1; --hr: 0; }

  .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(1) { --hx: -2.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(2) { --hx: -1.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(3) { --hx: 1.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(4) { --hx: 2.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(5) { --hx: -3.5; --hr: 1; }
  .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(6) { --hx: 3.5; --hr: 1; }

  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(1) { --hx: -3; --hr: -2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(2) { --hx: -2; --hr: -2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(3) { --hx: -1; --hr: -2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(4) { --hx: 0; --hr: -2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(5) { --hx: 1; --hr: -2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(6) { --hx: 2; --hr: -2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(7) { --hx: 3; --hr: -2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(8) { --hx: -3.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(9) { --hx: 3.5; --hr: -1; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(10) { --hx: -3; --hr: 2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(11) { --hx: -2; --hr: 2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(12) { --hx: -1; --hr: 2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(13) { --hx: 0; --hr: 2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(14) { --hx: 1; --hr: 2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(15) { --hx: 2; --hr: 2; }
  .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(16) { --hx: 3; --hr: 2; }

  @media (max-width: 1024px) {
    .image-grid-section .grid {
      --gutter: clamp(0.125rem, 0.45vw, 0.5rem);
      --hex-gap: clamp(3px, 0.3vw, 6px);
    }
  }

  @media (max-width: 900px) {
    .image-grid-section .grid {
      --gutter: clamp(0.125rem, 0.5vw, 0.45rem);
      --hex-gap: clamp(2.5px, 0.34vw, 5px);
    }
  }

  @media (max-width: 1200px) and (max-height: 690px) {
    .image-grid-section .grid {
      --hex-gap: clamp(2px, 0.3vw, 4px);
      --hex-w: clamp(4.35rem, min(10.2vw, 12.8vh), 5.65rem);
    }
  }

  @media (max-width: 640px) {
    .image-grid-section .grid {
      --hex-gap: clamp(2px, 0.55vw, 4px);
      --hex-w: clamp(3.65rem, min(calc(var(--available-w) * 0.128), calc(var(--available-h) * 0.218)), 5rem);
    }
  }

  @media (orientation: portrait) {
    /*
      Portrait pattern 2026-05-16: strict 3-4-3-4-3-4-3-4-3 honeycomb
      per user direction ("maximálně 4 vedle sebe, střídat 3 a 4,
      vždy zabíralo celý viewport"). The 4-row spans the full available
      width on phone — hex-w sized so 4 cells + gaps reach 100 % of
      viewport. Six layer-5 outer-ring icons hidden so the 30 visible
      cards + scaler fit the new pattern.

      Hidden on portrait: mood, symptoms, rotation, notes, alerts,
      team — the least product-defining icons. All 14 photos kept,
      all core feature icons (wellness, sessions, coach board, RPE,
      etc.) kept.
    */
    .image-grid-section .grid {
      /*
        9 portrait rows = ~7×hex-h tall (with gaps). User feedback
        2026-05-16 ("hexagony tak velké aby byly od okraje obrazovky
        po okraj"): pump width multiplier to 0.244 so a 4-row fully
        fills viewport on tall modern phones. Height multiplier
        0.117 keeps the 9-row stack inside viewport without overflow
        on the short ones; the min() picks whichever constraint
        binds (width-edge-to-edge on tall phones, height-fit on
        short phones / foldables).
      */
      --hex-w: clamp(3rem, min(calc(var(--available-w) * 0.244), calc(var(--available-h) * 0.117)), 18.5rem);
      --honeycomb-width: calc((var(--hex-x-step) * 3) + var(--hex-w));
      --honeycomb-height: calc((var(--hex-y-step) * 8) + var(--hex-h));
    }

    /* 6 layer-5 outer-ring icons hidden on portrait — keeps card
       count at 30 + scaler = 31, matching 3-4-3-4-3-4-3-4-3 grid. */
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(2),
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(6),
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(8),
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(12),
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(14),
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(16) {
      display: none;
    }

    /* Row -4: 3 cards (3 player portrait photos for top-row punch) */
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(1)  { --hx: -1;   --hr: -4; }
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(3)  { --hx:  0;   --hr: -4; }
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(5)  { --hx:  1;   --hr: -4; }

    /* Row -3: 4 cards */
    .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(1)  { --hx: -1.5; --hr: -3; }
    .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(1)  { --hx: -0.5; --hr: -3; }
    .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(2)  { --hx:  0.5; --hr: -3; }
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(7)  { --hx:  1.5; --hr: -3; }

    /* Row -2: 3 cards */
    .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(2)  { --hx: -1;   --hr: -2; }
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(9)  { --hx:  0;   --hr: -2; }
    .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(3)  { --hx:  1;   --hr: -2; }

    /* Row -1: 4 cards */
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(11) { --hx: -1.5; --hr: -1; }
    .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(3)  { --hx: -0.5; --hr: -1; }
    .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(1)  { --hx:  0.5; --hr: -1; }
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(4)  { --hx:  1.5; --hr: -1; }

    /* Row 0: scaler at centre + 2 cards flanking */
    .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(4)  { --hx: -1;   --hr:  0; }
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(13) { --hx:  1;   --hr:  0; }
    /* scaler at 0,0 default */

    /* Row 1: 4 cards */
    .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(2)  { --hx: -1.5; --hr:  1; }
    .image-grid-section .grid > .layer:nth-of-type(3) > div:first-of-type { --hx: -0.5; --hr:  1; }
    .image-grid-section .grid > .layer:nth-of-type(3) > div:last-of-type  { --hx:  0.5; --hr:  1; }
    .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(4)  { --hx:  1.5; --hr:  1; }

    /* Row 2: 3 cards */
    .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(5)  { --hx: -1;   --hr:  2; }
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(15) { --hx:  0;   --hr:  2; }
    .image-grid-section .grid > .layer:nth-of-type(4) > div:nth-child(6)  { --hx:  1;   --hr:  2; }

    /* Row 3: 4 cards */
    .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(5)  { --hx: -1.5; --hr:  3; }
    .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(3)  { --hx: -0.5; --hr:  3; }
    .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(5)  { --hx:  0.5; --hr:  3; }
    .image-grid-section .grid > .layer:nth-of-type(2) > div:nth-child(6)  { --hx:  1.5; --hr:  3; }

    /* Row 4: 3 cards (bottom) */
    .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(4)  { --hx: -1;   --hr:  4; }
    .image-grid-section .grid > .layer:nth-of-type(1) > div:nth-child(6)  { --hx:  0;   --hr:  4; }
    .image-grid-section .grid > .layer:nth-of-type(5) > div:nth-child(10) { --hx:  1;   --hr:  4; }
  }

  @media (max-height: 430px) and (max-width: 900px) {
    .image-grid-section .grid {
      --hex-w: clamp(2.1rem, min(10.2vw, 8.1vh), 2.9rem);
    }
  }

  @media (max-height: 460px) {
    .image-grid-section .grid {
      --hex-gap: 2px;
      --hex-w: clamp(2.55rem, min(12.6vw, 22vh), 5rem);
    }
  }

  @media (max-height: 300px) {
    .image-grid-section .grid {
      --hex-gap: 1px;
      --hex-w: clamp(1.15rem, min(6.5vw, 12vh), 2.5rem);
    }
  }

  /* ─── Mobile light-touch overrides ──────────────────────────────
     User feedback 2026-05-16: smoke field + premium glass effect
     should match pricing on every viewport (was previously stripped
     on phone for perf). Now that the global glass recipe has
     dropped the SVG displacement filter (the actual Chrome killer)
     and reduced backdrop-blur to 10px, the remaining cost is
     manageable on modern phones too. Keep just the cyan drop-shadow
     touch-ups for icons so they pop, but no longer kill the
     smoke canvas or backdrop-blur.
  */
  @media (max-width: 900px), (pointer: coarse) {
    .image-grid-section .grid-photo,
    .image-grid-section .tech-card {
      filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.32));
    }
    .image-grid-section .tech-card__icon {
      filter: drop-shadow(0 0 6px rgba(0, 240, 255, 0.4));
    }
  }

  /* Both photos and tech cards are now .glass-card hosts → identical
     recipe (4 layers + dual drop shadow + specular rim). The radius
     is inherited from .glass-card (1.75 rem, same as pricing cards)
     per user request 2026-05-01: "úplně stejně jako v pricingu".
     The cell-fitting rules just give them their grid aspect ratio.

     NB: do NOT override `display` here. The global .glass-card rule
     sets `display: flex; flex-direction: column` so .glass-content
     (flex: 1) can fill the card and centre its children. An earlier
     `display: block` here clobbered that and pinned the icon+title
     to the top of the card (user feedback 2026-05-01: "není to na
     středu"). */
  /* All cells fill their grid track at every viewport — track height
     is now driven by 1fr (grid is height-capped to viewport). The old
     aspect-ratio: 4/5 baked the cell intrinsic height into the row
     track, overflowing top + bottom rows past viewport. */
  .image-grid-section .grid-photo,
  .image-grid-section .tech-card {
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: 0;
    clip-path: var(--hex-clip);
    -webkit-clip-path: var(--hex-clip);
    --card-pad: clamp(0.7rem, 1.3vw, 1.15rem);
    --card-gap: clamp(0.45rem, 0.8vw, 0.85rem);
    --card-icon: clamp(3.1rem, min(4.8vw, 7.2vh), 4.9rem);
    --card-label: clamp(0.82rem, min(1.23vw, 1.8vh), 1.28rem);
    --card-label-width: 100%;
    /*
      Perf 2026-05-17 (Chrome jank): collapsed two drop-shadows
      into a single combined shadow. Each drop-shadow forces a
      filter-graph rasterization pass; with 30 cells and parent
      .layer opacity animating per scroll frame, Chrome was
      re-rasterizing 60 filter outputs every frame. One shadow
      with a moderate radius gives the same visual depth at half
      the cost. Was:
        drop-shadow(0 14px 34px rgba(0,0,0,0.38))
        drop-shadow(0 0 22px rgba(0,240,255,0.11));
    */
    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.44));
    contain: layout paint;
    backface-visibility: hidden;
    /*
      Perf 2026-05-17 (post-morph site-wide jank): dropped the
      static `transform: translateZ(0)`. Each of the 30 cells
      would otherwise hold a permanent GPU composite layer for
      the page lifetime — even when the morph section was
      nowhere near the viewport — and the cumulative composite
      cost is what made the rest of the site stutter after
      passing through the section. The IntersectionObserver in
      the script block now sets `will-change: opacity` on these
      elements only while the section is within one viewport,
      and clears it once we're past — the cells get their layer
      promotion exactly when the parent .layer opacity reveal
      needs it, and not a moment longer.
    */
  }

  /*
    User feedback 2026-05-16: restore the premium glass effect on
    hexagons (was previously killed unconditionally for Chrome perf).
    The actual Chrome killer was filter: url(#glass-lens) with SVG
    feDisplacementMap — that's gone now (removed from global
    .glass-card .glass-filter). The remaining backdrop-blur(10px) is
    cheap enough to keep here, restoring the pricing-card feel
    in the hexagons.
  */
  .image-grid-section .glass-overlay {
    background:
      radial-gradient(circle at 50% 28%, rgba(0, 240, 255, 0.16), transparent 48%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0.018) 48%, rgba(0, 240, 255, 0.04) 100%),
      rgba(4, 12, 15, 0.48);
  }

  /* No hover lift in this section. The global .glass-card hover
     recipe is useful elsewhere, but here it breaks the calm
     honeycomb composition and creates uneven gaps between cells. */
  .image-grid-section .grid-photo.glass-card,
  .image-grid-section .tech-card.glass-card {
    transition: none;
  }

  .image-grid-section .grid-photo.glass-card:hover,
  .image-grid-section .tech-card.glass-card:hover {
    transform: none;
    box-shadow:
      0 6px 6px rgba(0, 0, 0, 0.28),
      0 0 24px rgba(0, 0, 0, 0.18);
  }

  .image-grid-section .grid-photo.glass-card:hover .glass-specular,
  .image-grid-section .tech-card.glass-card:hover .glass-specular {
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 0 8px rgba(255, 255, 255, 0.12),
      inset -1px -1px 0 rgba(255, 255, 255, 0.05);
  }

  /* Photo content is the <img> filling the .glass-content. Inherit
     border-radius so the image clips exactly to the card rim, and
     the .glass-content has no padding (photo is the frame). */
  .image-grid-section .grid-photo .glass-content {
    padding: 0;
    overflow: hidden;
    border-radius: inherit;
  }
  .image-grid-section .grid-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Crop slightly above centre — the photos are 1122 × 1402 portrait
       with subjects' faces in the upper third. Default object-position
       (50% 50%) cropped portrait photos to the chest area when cells
       become landscape-shaped (5 × 3 layout on desktop). 50% 30% keeps
       heads in frame on every viewport while still showing some torso
       context (user feedback 2026-05-01: "ať jsou vidět hlavy"). */
    object-position: 50% 30%;
    display: block;
    /*
      Perf 2026-05-17: dropped translateZ(0) + will-change. The
      grid-photo <img> elements (one per photo cell) are static
      after layout — no animation, no transform changes. Forcing
      each to its own GPU layer kept ~12 composite layers alive
      for the whole page lifetime, contributing to the post-morph
      scroll jank.
    */
    contain: paint;
  }

  /* Tech card content layout — icon-first. The icon is the focal
     element (no chip/frame around it); the heading sits below as a
     bold display label. Body copy was dropped per user request — the
     card reads as a feature glyph instead of a paragraph. */
  .image-grid-section .tech-card .glass-content {
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--card-gap);
    padding: var(--card-pad);
  }

  /* Soft cyan radial behind the icon area — emulates the icon "emitting
     light into the glass". Sits inside the .glass-content stacking
     context (z:3 on the parent), with z-index:0 so the icon + heading
     (default static) draw on top. Anchored to the upper third where
     the icon naturally lands. */
  .image-grid-section .tech-card .glass-content::before {
    content: '';
    position: absolute;
    top: 8%;
    left: 50%;
    width: 85%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    /*
      Perf 2026-05-17 (Chrome jank): dropped `filter: blur(14px)`.
      The radial-gradient stops already taper softly (0.22→0.08→
      transparent), so the blur was adding ~zero visual gain at
      high per-cell paint cost (~24 cells × 14 px blur). Removed.
    */
    background: radial-gradient(
      circle,
      rgba(0, 240, 255, 0.18) 0%,
      rgba(0, 240, 255, 0.07) 38%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  /*
    Icon — standalone, no chip/frame around it. Sits as the focal
    element of the card (per user feedback 2026-05-01: the small
    chip felt boxy, the icon should breathe). Heavy multi-layer glow
    chain so it reads as cyan emission — paired with the radial
    behind it (.glass-content::before) for a "glass lit from within"
    feel.
  */
  .image-grid-section .tech-card__icon {
    position: relative;
    z-index: 1;
    width: var(--card-icon);
    height: var(--card-icon);
    overflow: visible;
    fill: none;
    stroke: var(--color-accent-primary);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--color-accent-primary);
    /* Layered glow: tight inner halo (close cyan), broad outer halo
       (atmospheric cyan), and a dark drop-shadow for separation
       against the bright cyan radial behind. */
    filter:
      drop-shadow(0 0 4px rgba(0, 240, 255, 0.6))
      drop-shadow(0 0 14px rgba(0, 240, 255, 0.42))
      drop-shadow(0 0 28px rgba(0, 240, 255, 0.22))
      drop-shadow(0 6px 14px rgba(0, 0, 0, 0.35));
  }

  @media (prefers-reduced-motion: no-preference) and (pointer: fine) and (min-width: 901px) and (min-height: 461px) {
    .image-grid-section .grid-photo img {
      animation: gridPhotoBreathe 13s ease-in-out infinite alternate;
    }

    .image-grid-section .grid > .layer:nth-of-type(2) .grid-photo img {
      animation-delay: -2.2s;
    }

    .image-grid-section .grid > .layer:nth-of-type(3) .grid-photo img {
      animation-delay: -4.4s;
    }

    .image-grid-section .grid > .layer:nth-of-type(4) .grid-photo img {
      animation-delay: -6.1s;
    }

    .image-grid-section .grid > .layer:nth-of-type(5) .grid-photo img {
      animation-delay: -7.8s;
    }

    .image-grid-section .tech-card__icon {
      animation: gridIconPulse 5.6s ease-in-out infinite;
      animation-delay: 0s;
    }

    .image-grid-section .grid > .layer:nth-of-type(2) .tech-card__icon {
      animation-delay: 0.45s;
    }

    .image-grid-section .grid > .layer:nth-of-type(3) .tech-card__icon {
      animation-delay: 0.9s;
    }

    .image-grid-section .grid > .layer:nth-of-type(4) .tech-card__icon {
      animation-delay: 1.25s;
    }

    .image-grid-section .grid > .layer:nth-of-type(5) .tech-card__icon {
      animation-delay: 1.7s;
    }
  }

  /* Keep this morph section deterministic while scrolling. Continuous
     per-card breathe/pulse animations made Chrome repaint clipped
     hexagons during the width/height/clip-path morph and caused visible
     stutter. Other sections keep their decorative motion. */
  .image-grid-section .grid-photo img,
  .image-grid-section .tech-card__icon {
    animation: none;
  }

  @keyframes gridIconPulse {
    0%, 100% {
      opacity: 0.86;
      transform: translateZ(0) scale(0.985);
    }
    48% {
      opacity: 1;
      transform: translateZ(0) scale(1.025);
    }
  }

  @keyframes gridPhotoBreathe {
    0% {
      transform: translateZ(0) scale(1.01);
    }
    100% {
      transform: translateZ(0) scale(1.055);
    }
  }

  /* Filled icon (stats bars) — same stroke for any outline paths
     plus a fill on the rects. Defined per-icon by adding the
     --filled modifier on the <svg>. */
  .image-grid-section .tech-card__icon--filled rect {
    fill: var(--color-accent-primary);
    stroke: none;
  }

  /* Subtle cyan-tinted body for the lock so it doesn't look hollow */
  .image-grid-section .security-lock__body {
    fill: rgba(0, 240, 255, 0.1);
  }

  .image-grid-section .security-lock__pin {
    fill: var(--color-accent-primary);
    stroke: none;
  }

  /* Heading — display weight, tight tracking, soft cyan tint to echo
     the icon glow without overpowering it. The card now reads as
     icon → label, no body copy. */
  .image-grid-section .tech-card h3 {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--card-label);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-align: center;
    color: var(--color-text-primary);
    text-shadow: 0 1px 12px rgba(0, 240, 255, 0.18);
    max-width: var(--card-label-width);
    text-wrap: balance;
    overflow-wrap: anywhere;
    word-break: break-word;
    hyphens: none;
  }

  @media (max-width: 640px) {
    /* Smoke field now stays visible on phone (user feedback 2026-05-16
       — "na menších devices je jen černé pozadí, proč?"). Cyan smoke
       reads as the same premium background as the pricing section. */

    .image-grid-section .tech-card {
      --card-pad: 0.34rem;
      --card-gap: 0.16rem;
      --card-icon: clamp(1.12rem, 5.8vw, 1.65rem);
      --card-label: clamp(0.42rem, 1.78vw, 0.56rem);
      --card-label-width: 100%;
    }

    .image-grid-section .tech-card h3 {
      /* Tighter clamp on phones — longer EN/CS labels (Attendance,
         Statistiky, Bezpečnost, Komunikace) need to fit a ~67 px
         inner content area on a 320 px viewport without clipping.
         User feedback 2026-05-01: Communication on the bottom-right
         card was getting cut off at the right edge. */
      line-height: 1;
      letter-spacing: -0.035em;
      /* Safety net: if a label is ever longer than the cell can fit,
         allow the browser to wrap mid-word rather than silently
         clipping. With line-height 1.05 a 2-line wrap stays within
         the icon+label flex layout. */
      word-break: break-word;
      overflow-wrap: anywhere;
      hyphens: none;
    }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .image-grid-section .tech-card {
      --card-pad: clamp(0.3rem, 0.74vw, 0.5rem);
      --card-gap: clamp(0.16rem, 0.36vw, 0.28rem);
      --card-icon: clamp(1.75rem, min(4.3vw, 4.6vh), 2.8rem);
      --card-label: clamp(0.62rem, min(1.55vw, 1.45vh), 0.88rem);
      --card-label-width: 90%;
    }

    .image-grid-section .tech-card h3 {
      max-width: var(--card-label-width);
    }
  }

  @media (max-height: 460px) {
    .image-grid-section .tech-card {
      --card-pad: 0.2rem;
      --card-gap: 0;
      --card-icon: clamp(0.9rem, 6.6vh, 1.35rem);
    }

    .image-grid-section .tech-card h3 {
      display: none;
    }
  }

  @media (max-height: 300px) {
    .image-grid-section .tech-card {
      --card-pad: 0.2rem;
      --card-gap: 0;
      --card-icon: clamp(0.85rem, 7.4vh, 1.25rem);
    }

    .image-grid-section .tech-card h3 {
      display: none;
    }
  }

  /* Scaler container occupies the centre honeycomb cell; its <img>
     is absolutely positioned so we can animate width/height in pixels
     while keeping the image perfectly centred.

     IMPORTANT: must sit at the GEOMETRIC CENTRE of the honeycomb so the
     full-bleed start state (img at 100 vw × 100 vh, centred on the
     scaler container) actually fills the viewport. The grid itself
     is absolute-centred inside the sticky 100 vh content, so when
     the scaler container is at the grid centre, the img centre =
     viewport centre.
     Geometric centre is the only place this morph mathematically works. */
  .image-grid-section .grid .scaler {
    z-index: 2;
    --hx: 0;
    --hr: 0;
  }

  /*
    Scaler 2026-05-17 v3 — back to width/height animation per
    user feedback ("vrat zpět" — square end shape + pixelation).

    Why width/height (not transform): the aspect ratio changes
    from landscape (viewport) at start to hex (1:1.155 portrait)
    at end. Transform: scale is uniform → it can't change aspect
    without distorting. Non-uniform scaleX/scaleY would stretch
    the photo's content. Width/height animation keeps object-fit:
    cover re-cropping the source per frame to maintain aspect.

    Sharpness: img is set to viewport size at mount, so the
    browser decodes at full resolution. Width/height animates
    DOWN — browser keeps the high-res texture and downsamples for
    smaller renders. Sharp at every frame.

    Perf: width/height triggers layout, but the element has
    contain: layout paint + position: absolute so layout is
    isolated. Only the layer-reveal optimisation (single CSS
    variable for all 5 layers instead of 5 observers) is kept
    from the earlier perf pass.
  */
  .image-grid-section .scaler img {
    position: absolute;
    top: 50%;
    left: 50%;
    /*
      Perf 2026-05-17 (phone morph jank): split centering off
      `transform` into the `translate` CSS longhand so Motion can
      animate `transform: scale()` without overwriting the
      centering. translateZ(0) stays in `transform` to force the
      Chrome composite layer; the scale animation then composes
      on top via JS. transform-origin defaults to 50 % 50 % which
      is what we want — scaling shrinks the image toward its own
      centre, which sits at the centre of the grid (= centre of
      the destination hex cell).
    */
    translate: -50% -50%;
    transform: translateZ(0);
    object-fit: cover;
    object-position: center;
    width: 100vw;
    height: 100vh;
    height: 100svh;
    height: var(--grid-stable-vh, 100svh);
    clip-path: polygon(0% 0%, 100% 0%, 100% 50%, 100% 100%, 0% 100%, 0% 50%);
    -webkit-clip-path: polygon(0% 0%, 100% 0%, 100% 50%, 100% 100%, 0% 100%, 0% 50%);
    border-radius: 28px;
    max-width: none;
    max-height: none;
    /*
      Perf 2026-05-17: will-change is now applied dynamically from
      JS via an IntersectionObserver — only while the section is
      within one viewport of the user. Keeping it in CSS would
      hold the GPU composite layer for the entire page lifetime
      and cause the whole site to scroll-jank after passing
      through the morph (user-reported regression). The JS path
      sets `transform` as the will-change hint on mount, clears
      it on unmount.
    */
    backface-visibility: hidden;
    overflow-anchor: none;
    /*
      Transition for the phone morph clip-path swap. Lives on the
      BASE rule (not on the .phone-morph-* class rules) because
      transitions need to be "already applied" to the element
      BEFORE the property value changes — otherwise the browser
      sees `transition` and the new value arrive at the same
      moment and refuses to animate (no start value recorded).
      Empirically verified 2026-05-18 that this placement is the
      one that actually triggers the morph. Desktop uses Motion's
      WAAPI animation which overrides this transition anyway.
    */
    transition: clip-path 0.35s cubic-bezier(0.65, 0, 0.35, 1),
      -webkit-clip-path 0.35s cubic-bezier(0.65, 0, 0.35, 1),
      border-radius 0.35s ease;
  }

  /*
    Containment note 2026-05-17: must NOT include `paint`. The img
    inside .scaler starts at 100 vw × 100 dvh (way bigger than the
    cell) and gradually shrinks to fit. `contain: paint` clips
    overflow to the padding box, which would hide the full-bleed
    starting frame entirely (user-visible bug: "hlavní fotka tam
    neni vidět vůbec" on desktop). `contain: layout` alone is safe
    — it isolates layout work without clipping rendering.
  */
  .image-grid-section .scaler {
    contain: layout;
  }

  /*
    Phone-only clip-path strategy (2026-05-18). On mobile the
    scroll-driven polygon interpolation was the residual jank
    source after the v4 geometry fix — the GPU re-rasterizes the
    polygon every scroll tick across hundreds of frames. The JS
    swaps these two classes ONCE at the crossover scroll point,
    so the polygon interpolation only runs through the brief CSS
    transition window (~24 frames) instead of the whole morph.

    Transition lives on the BASE `.scaler img` rule above (search
    `transition:`) — not on the class selectors. Putting transition
    on the class rule meant the transition was first applied AT
    THE SAME TIME as the target value change, which browsers
    refuse to animate (no recorded start value at the moment the
    transition becomes applicable). Symptom: class toggled but
    clip-path snapped without animation AND the new value didn't
    even paint — stayed at base. Empirically verified 2026-05-18.
  */
  /*
    `!important` is required here because the production CSS bundle
    ends up with another rule for `.scaler img` clip-path at the
    same specificity that wins the cascade order. Both .phone-morph-
    rect and .phone-morph-hex need to GUARANTEE they apply, not
    just have higher specificity than the base rule — empirically
    verified 2026-05-18 that without !important the hex polygon
    never paints. The rules are scoped tightly to the morph image
    so the !important doesn't leak.
  */
  .image-grid-section .scaler img.phone-morph-rect {
    clip-path: polygon(0% 0%, 100% 0%, 100% 50%, 100% 100%, 0% 100%, 0% 50%) !important;
    -webkit-clip-path: polygon(0% 0%, 100% 0%, 100% 50%, 100% 100%, 0% 100%, 0% 50%) !important;
    border-radius: 28px !important;
  }
  .image-grid-section .scaler img.phone-morph-hex {
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%) !important;
    -webkit-clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%) !important;
    border-radius: 0 !important;
  }

  .image-grid-section .scaler img.mobile-morph-lite {
    transition:
      transform 0.78s cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 0.42s cubic-bezier(0.65, 0, 0.35, 1),
      -webkit-clip-path 0.42s cubic-bezier(0.65, 0, 0.35, 1),
      border-radius 0.42s ease;
  }

  /*
    Native CSS scroll-driven animations — TEMPORARILY DISABLED
    2026-05-17. The combination of position:sticky inside an
    `overflow: clip` parent broke view-timeline tracking in
    Chrome (timeline.currentTime returned null even when the
    section was clearly in view). Falling back to Motion JS path
    until this can be revisited. Block deleted because @supports
    only checks property syntax, not whether the timeline name
    exists — the dead-code block was actually applying and putting
    the scaler in its end state at page load.
  */

  /* Reduced-motion: drop the sticky/scroll dance. Show every cell in
     its final position, statically. */
  @media (prefers-reduced-motion: reduce) {
    .image-grid-section {
      min-height: auto;
    }
    .image-grid-section .content {
      position: relative;
      min-height: 80vh;
    }
    .image-grid-section .grid {
      position: relative;
      top: auto;
      left: auto;
      translate: none;
    }
    .image-grid-section .grid > .layer,
    .image-grid-section .grid > .layer > div {
      opacity: 1;
    }
    .image-grid-section .scaler img {
      width: 100%;
      height: 100%;
      border-radius: 0;
      clip-path: var(--hex-clip);
      -webkit-clip-path: var(--hex-clip);
    }
  }
</style>

<script>
  /*
    Diagnostic switches — 2026-05-17. The morph section was
    accused of janking the whole site after passing through it,
    and the standard fixes (IntersectionObserver mount/unmount,
    content-visibility:auto, capturing Motion scroll cleanup
    functions, stripping static will-change) didn't fully solve
    it. Adding URL-based kill-switches so the source of jank can
    be isolated by elimination:

      ?morph=off          → skip every JS subsystem of this
                            section. Renders as a static black
                            box (CSS-only). If the site is still
                            janky, the morph is not the source.
      ?morph=no-scroll    → no Motion scroll() animations. Image
                            stays at its CSS-default full-bleed
                            and cells at their initial opacity.
      ?morph=no-anim-cancel → keep the current behaviour where
                            unmount only detaches scroll() observers
                            without cancelling the underlying WAAPI
                            animations. Default: animations get
                            cancelled too.

    Combine with commas, e.g. `?morph=no-scroll`.
  */
  const morphFlags = new Set(
    new URLSearchParams(window.location.search)
      .get('morph')
      ?.split(',')
      .map((s) => s.trim()) ?? [],
  );
  const MORPH_OFF = morphFlags.has('off');
  const MORPH_NO_SCROLL = MORPH_OFF || morphFlags.has('no-scroll');
  if (morphFlags.size > 0) {
    // eslint-disable-next-line no-console
    console.info('[morph] diagnostic flags:', [...morphFlags]);
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const compactMotion = window.matchMedia('(max-width: 900px), (max-height: 460px) and (max-width: 950px), (pointer: coarse)').matches;

  /*
    Mobile browsers fire resize events while the URL bar collapses.
    If the honeycomb uses dynamic viewport units during that scroll,
    every hexagon gets re-sized mid-animation and the smoke canvas
    appears to drift independently from the grid. Lock this section
    to a stable visual viewport height and only refresh it on real
    layout changes (rotation / major viewport change), not browser
    chrome movement.
  */
  function lockGridViewport(section: HTMLElement) {
    const read = () => ({
      width: Math.round(window.visualViewport?.width ?? window.innerWidth),
      height: Math.round(window.visualViewport?.height ?? window.innerHeight),
    });
    let stable = read();

    const apply = () => {
      section.style.setProperty('--grid-stable-vh', `${stable.height}px`);
      section.style.setProperty('--grid-stable-vw', `${stable.width}px`);
    };

    const maybeRefresh = () => {
      const next = read();
      const widthChanged = Math.abs(next.width - stable.width) > 24;
      const majorHeightChanged =
        Math.abs(next.height - stable.height) > Math.max(180, stable.height * 0.25);

      if (!widthChanged && !majorHeightChanged) return false;

      stable = next;
      apply();
      return true;
    };

    apply();

    return {
      maybeRefresh,
      getHeight: () => stable.height,
    };
  }

  if (!reduceMotion && !MORPH_NO_SCROLL) {
    const section = document.querySelector<HTMLElement>('[data-grid-section]');
    const image = section?.querySelector<HTMLImageElement>('.scaler img');
    const layers = section?.querySelectorAll<HTMLElement>('.grid > .layer');
    const cells = section?.querySelectorAll<HTMLElement>('.grid > .layer > div');

    if (section && image && layers && layers.length > 0 && cells && cells.length > 0) {
      const viewportLock = lockGridViewport(section);
      // Wait one frame so layout has settled and we can measure the
      // .scaler container itself — its offsetWidth/Height equal the
      // grid cell size after layout commits.
      requestAnimationFrame(() => {
        const scalerEl = section.querySelector<HTMLElement>('.scaler');
        if (!scalerEl) return;

        /*
          Re-narrow `image` to a non-null reference inside the rAF
          callback. The outer-scope variable is HTMLImageElement |
          null | undefined; we already proved it non-null in the
          enclosing `else if`, but the type system can't carry that
          narrowing into the rAF closure. Renamed to `img` (was
          `image` previously) to avoid a const-shadowing temporal
          dead zone — re-using the name `image` here threw
          "Cannot access 'image' before initialization" when the
          willChangeEls array (built earlier in this callback)
          referenced the outer `image`, which silently killed the
          entire mount() + IntersectionObserver setup. (Bug found
          2026-05-17 after the lifecycle refactor.)
        */
        const img = section.querySelector<HTMLImageElement>('.scaler img')!;

        const willChangeEls: HTMLElement[] = [
          img,
          ...Array.from(layers),
        ];

        /*
          Scaler 2026-05-17 v3 — animate width/height (aspect ratio
          changes from viewport landscape → hex portrait).

          Sharpness: image starts at viewport size, animates DOWN to
          hex cell. Browser decodes at the largest size = source
          resolution, downsamples gracefully when smaller.

          .scaler container has contain: layout paint so the per-
          frame layout work is isolated to this element.
        */
        const contentEl = section.querySelector<HTMLElement>('.content');
        const viewportWidth = contentEl?.offsetWidth || window.innerWidth;
        const viewportHeight = contentEl?.offsetHeight || window.innerHeight;

        const naturalWidth = scalerEl.offsetWidth || 92;
        const naturalHeight = scalerEl.offsetHeight || naturalWidth / 0.8660254038;

        const sourceMaxW = 1672;
        const sourceMaxH = 941;
        const desktopCardAspect = 16 / 9;
        const desktopCardMaxW = Math.min(viewportWidth * 0.88, sourceMaxW);
        const desktopCardMaxH = Math.min(viewportHeight * 0.82, sourceMaxH);
        const desktopCardWidth = Math.min(desktopCardMaxW, desktopCardMaxH * desktopCardAspect);
        const desktopCardHeight = desktopCardWidth / desktopCardAspect;
        const displayWidth = compactMotion
          ? Math.min(viewportWidth, sourceMaxW)
          : desktopCardWidth;
        const displayHeight = compactMotion
          ? Math.min(viewportHeight, sourceMaxH)
          : desktopCardHeight;

        /*
          Desktop card + mobile scale morph.

          Desktop now starts as a large centred 16:9 card instead
          of a full-bleed viewport image. It then morphs via
          width/height down to the centre hex cell. Desktop can
          afford the isolated layout work and width/height keeps the
          photo content undistorted while the aspect ratio changes.

          Mobile keeps the scale-based path below because it avoids
          per-scroll width/height layout on phone GPUs.

          Scale-based morph v4 — element rendered at LARGE size
          with cell aspect ratio, scale DOWN to 1 at end.

          Why v4 (vs v3): v3 sized the element at the tiny hex
          cell itself and scaled UP to cover the viewport. That
          looked geometrically right but the browser decoded the
          IMG at the small element box, then nearest-sampled up
          when composited — pixelated mess on every device.
          User: "v plne kvalite a ne rozpixelovane".

          v4 sizes the element so it covers the viewport at
          scale = 1 while still preserving the hex cell aspect:
          elementWidth = max(displayW, displayH * cellAspect),
          elementHeight = elementWidth / cellAspect.
          The browser decodes the IMG at this large element box
          (sharp at full bleed) and we only scale DOWN to the
          cell size at end — downscaling never adds pixelation.

          Because elementAspect ≡ cellAspect, a uniform scale
          fits the cell exactly: scaleEnd = naturalW / elementW.
          No overflow past the cell outline at end, no axis
          distortion, and the clip-path hex (at 100 % of a
          cell-aspect element) renders as a clean regular hex
          throughout the morph.

          User also said "ve velkem ta fotka nema byt hexagon, má
          se na hexagon menit" — start state must read as a
          full-bleed rectangle and morph INTO the hex. Initial
          clip-path is the rectangle polygon; the scroll-driven
          animation morphs it to the hex polygon (on both phone
          and desktop now — the previous phone-skip was tied to
          the v3 geometry and isn't needed with the cleaner v4
          coordinate system).
        */
        const cellAspect = naturalWidth / naturalHeight; // ~ 0.866
        const elementWidth = compactMotion
          ? Math.max(displayWidth, displayHeight * cellAspect)
          : displayWidth;
        const elementHeight = compactMotion
          ? elementWidth / cellAspect
          : displayHeight;

        img.style.width = `${elementWidth}px`;
        img.style.height = `${elementHeight}px`;

        // Uniform scale END value — fits the cell exactly on both
        // axes because the element is already at cell aspect.
        const scaleEnd = compactMotion ? naturalWidth / elementWidth : 1;

        // Initial transform: scale=1 so the first render frame
        // shows the full-bleed view (Motion's scroll observer hasn't
        // ticked yet at this point). Motion then drives scale from
        // 1 → scaleEnd.
        img.style.transform = 'scale(1)';
        // NOTE: do NOT set img.style.clipPath here. Inline styles
        // override class-based CSS, which silently broke the
        // mobile clip-path swap — the phone-morph-hex class never
        // visually applied because the inline `rect` won the
        // cascade. (Bug found 2026-05-18.) The CSS default on
        // .scaler img already declares the rectangle clip-path;
        // mobile then class-toggles to hex (CSS transition handles
        // the morph) and desktop's Motion WAAPI animation
        // interpolates clip-path through its own keyframe track
        // (WAAPI overrides inline styles, so neither path needs
        // the inline reset).

        Array.from(cells).forEach((cell) => {
          cell.style.opacity = '1';
          cell.style.scale = '';
          cell.style.y = '';
        });

        const intro = section.querySelector<HTMLElement>('[data-grid-intro]');
        const darken = section.querySelector<HTMLElement>('[data-grid-intro-darken]');

        const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
        const easeInOut = (value: number) => {
          const t = clamp01(value);
          return t * t * (3 - 2 * t);
        };
        const easeOut = (value: number) => 1 - Math.pow(1 - clamp01(value), 3);

        let isHex = false;
        let compactShrunk = false;
        let sectionActive = false;
        let lastProgress = -1;
        let lastIntroOpacity = '';
        let lastIntroTransform = '';
        let lastIntroPointerEvents = '';
        let lastDarkenOpacity = '';
        let lastReveal = '';
        let lastImgTransform = '';
        let lastImgWidth = '';
        let lastImgHeight = '';
        let lastObjectPosition = '';
        let targetProgress = 0;
        let renderedProgress = 0;
        let settleRaf = 0;

        img.classList.add('phone-morph-rect');
        if (compactMotion) img.classList.add('mobile-morph-lite');

        const readProgress = () => {
          const rect = section.getBoundingClientRect();
          const viewport =
            viewportLock.getHeight() ||
            window.innerHeight ||
            document.documentElement.clientHeight ||
            1;
          const scrollDistance = Math.max(1, section.offsetHeight - viewport);
          return clamp01(-rect.top / scrollDistance);
        };

        const renderProgress = (progress: number) => {
          if (Math.abs(progress - lastProgress) < 0.0008) return;
          lastProgress = progress;

          const introEnd = compactMotion ? 0.3 : 0.28;
          const introP = easeInOut(progress / introEnd);
          const introVisible = progress < introEnd;
          if (intro) {
            const nextOpacity = (1 - introP).toFixed(3);
            const nextTransform = `translate3d(0, ${(-24 * introP).toFixed(2)}px, 0)`;
            const nextPointerEvents = introVisible ? '' : 'none';
            if (nextOpacity !== lastIntroOpacity) {
              lastIntroOpacity = nextOpacity;
              intro.style.opacity = nextOpacity;
            }
            if (nextTransform !== lastIntroTransform) {
              lastIntroTransform = nextTransform;
              intro.style.transform = nextTransform;
            }
            if (nextPointerEvents !== lastIntroPointerEvents) {
              lastIntroPointerEvents = nextPointerEvents;
              intro.style.pointerEvents = nextPointerEvents;
            }
          }

          if (darken) {
            const nextDarkenOpacity = (1 - easeInOut(progress / (compactMotion ? 0.36 : 0.34))).toFixed(3);
            if (nextDarkenOpacity !== lastDarkenOpacity) {
              lastDarkenOpacity = nextDarkenOpacity;
              darken.style.opacity = nextDarkenOpacity;
            }
          }

          if (compactMotion) {
            /*
              Real-device mobile path: avoid per-scroll scaling of a
              fullscreen clipped image. Mobile GPUs were still janking
              even after removing Motion because every scroll frame
              repainted the large image. Instead, crossing a threshold
              starts one CSS transition into the final hex cell; scrolling
              only controls the lightweight reveal variable after that.
            */
            const shouldShrink = progress >= 0.28;
            if (shouldShrink !== compactShrunk) {
              compactShrunk = shouldShrink;
              const nextTransform = `translateZ(0) scale(${shouldShrink ? scaleEnd : 1})`;
              if (nextTransform !== lastImgTransform) {
                lastImgTransform = nextTransform;
                img.style.transform = nextTransform;
              }
            }

            const shouldHex = progress >= 0.42;
            if (shouldHex !== isHex) {
              isHex = shouldHex;
              img.classList.toggle('phone-morph-hex', isHex);
              img.classList.toggle('phone-morph-rect', !isHex);
            }
          } else {
            const morphStart = 0.12;
            const morphEnd = 0.76;
            const morphP = easeInOut((progress - morphStart) / (morphEnd - morphStart));
            const width = elementWidth + (naturalWidth - elementWidth) * morphP;
            const height = elementHeight + (naturalHeight - elementHeight) * morphP;
            const nextWidth = `${width.toFixed(2)}px`;
            const nextHeight = `${height.toFixed(2)}px`;
            const nextTransform = 'translateZ(0)';
            if (nextWidth !== lastImgWidth) {
              lastImgWidth = nextWidth;
              img.style.width = nextWidth;
            }
            if (nextHeight !== lastImgHeight) {
              lastImgHeight = nextHeight;
              img.style.height = nextHeight;
            }
            if (nextTransform !== lastImgTransform) {
              lastImgTransform = nextTransform;
              img.style.transform = nextTransform;
            }

            const objectY = 8 + (32 - 8) * morphP;
            const nextObjectPosition = `50% ${objectY.toFixed(2)}%`;
            if (nextObjectPosition !== lastObjectPosition) {
              lastObjectPosition = nextObjectPosition;
              img.style.objectPosition = nextObjectPosition;
            }

            const shouldHex = morphP >= 0.58;
            if (shouldHex !== isHex) {
              isHex = shouldHex;
              img.classList.toggle('phone-morph-hex', isHex);
              img.classList.toggle('phone-morph-rect', !isHex);
            }
          }

          const revealStart = compactMotion ? 0.52 : 0.68;
          const revealEnd = compactMotion ? 0.92 : 0.94;
          const reveal = easeOut((progress - revealStart) / (revealEnd - revealStart));
          const nextReveal = reveal.toFixed(3);
          if (nextReveal !== lastReveal) {
            lastReveal = nextReveal;
            section.style.setProperty('--reveal-progress', nextReveal);
          }
        };

        /*
          Single scroll controller for the entire morph section.
          It replaces Motion scroll timelines with one passive
          listener + requestAnimationFrame. Fast wheel/touch gestures
          can jump the browser scroll position by a large amount in a
          single frame; driving the visual state directly from that
          raw progress makes the morph appear to skip. We therefore
          keep raw scroll as a TARGET and let the rendered progress
          catch up over a few frames. The section still follows scroll
          tightly, but the image-to-hex crossover gets a visible
          transition even after aggressive flick scrolling.
        */
        const tick = () => {
          settleRaf = 0;

          const delta = targetProgress - renderedProgress;
          if (Math.abs(delta) < 0.0025) {
            renderedProgress = targetProgress;
            renderProgress(renderedProgress);
            return;
          }

          renderedProgress += delta * (compactMotion ? 0.3 : 0.24);
          renderProgress(renderedProgress);
          settleRaf = requestAnimationFrame(tick);
        };

        const requestUpdate = () => {
          targetProgress = readProgress();

          if (!sectionActive) {
            if (settleRaf) {
              cancelAnimationFrame(settleRaf);
              settleRaf = 0;
            }
            renderedProgress = targetProgress;
            renderProgress(renderedProgress);
            return;
          }

          if (!settleRaf) {
            settleRaf = requestAnimationFrame(tick);
          }
        };

        const setWillChange = (on: boolean) => {
          for (const el of willChangeEls) {
            el.style.willChange = on
              ? el === img
                ? 'transform'
                : 'opacity'
              : '';
          }
        };

        const onScroll = () => {
          if (
            !sectionActive &&
            (renderedProgress <= 0.001 || renderedProgress >= 0.999)
          ) {
            return;
          }
          requestUpdate();
        };
        const onResize = () => {
          /*
            Ignore mobile URL-bar resize noise. The section's stable
            viewport lock keeps the visible grid size fixed during
            scroll; only real viewport changes should invalidate the
            measured progress state.
          */
          if (!viewportLock.maybeRefresh()) return;
          lastProgress = -1;
          targetProgress = readProgress();
          renderedProgress = targetProgress;
          renderProgress(renderedProgress);
        };

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              sectionActive = entry.isIntersecting;
              setWillChange(sectionActive);
              requestUpdate();
            }
          },
          { rootMargin: '35% 0px 35% 0px', threshold: 0 },
        );
        io.observe(section);

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize, { passive: true });
        targetProgress = readProgress();
        renderedProgress = targetProgress;
        renderProgress(renderedProgress);
      });
    }
  }

  // Click handler for the scroll-hint pill — smooth-scroll past the
  // section so the user immediately sees the grid morph kick in.
  // Wired regardless of reduceMotion (the button is also a UX hint
  // about scroll direction, not just decorative).
  const introBtn = document.querySelector<HTMLButtonElement>('[data-grid-intro-scroll]');
  const sectionForBtn = document.querySelector<HTMLElement>('[data-grid-section]');
  if (introBtn && sectionForBtn) {
    introBtn.addEventListener('click', () => {
      // Scroll one viewport down — far enough that the scaler is well
      // into its shrink phase and the user can see "scrolling does
      // something". Don't jump to end-of-section: the user came here
      // to see the morph, not skip it.
      const targetY =
        sectionForBtn.getBoundingClientRect().top +
        window.scrollY +
        window.innerHeight * 1.2;
      window.scrollTo({
        top: targetY,
        behavior: 'smooth',
      });
    });
  }
</script>
