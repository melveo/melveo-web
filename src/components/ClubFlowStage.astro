---
/**
 * ClubFlowStage — sticky product workflow section.
 *
 * Native scroll-driven version of the "sticky media + stacked cards"
 * CodePen direction discussed with the user. No GSAP dependency: the
 * section pins one viewport, maps document scroll to card/image states,
 * and falls back to a normal stacked layout on smaller screens.
 */

import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/*
  Step copy — slimmed down from a 3-bullet table + metric row to
  just number + kicker + title + 1-line body (per user feedback
  2026-05-01: "hodně textů, je to nepřehledné... možná jenom
  jednoduché texty... ne ty tabulky"). The kicker carries the time
  / context tag; the body is a single confident sentence; the
  metric strip is gone — its data was already redundant with the
  kicker (e.g. "RÁNO · 30 SEKUND" + "typický vstup: 30 s").

  Keep the .image entries even though they're only rendered on
  mobile — the JS scroll handler still cycles between media slots
  by index.
*/
const copy = {
  cs: {
    eyebrow: 'JEDEN DEN V KLUBU',
    headline: 'Od check-inu k rozhodnutí.',
    body: 'Jeden tok od ranního signálu po rozhodnutí na hřišti.',
    mediaLabel: 'Živý klubový tok',
    progressLabel: 'Průběh dne',
    steps: [
      {
        number: '01',
        kicker: 'Ráno · 30 sekund',
        title: 'Pětiosý check-in',
        body: 'Hráč pošle stav těla i hlavy. Melveo z něj vytvoří týmový signál pro trenéra.',
        image: '/images/club-flow/check-in.webp',
        alt: 'Hráč v šatně vyplňuje týmový check-in v telefonu.',
      },
      {
        number: '02',
        kicker: 'Trénink · plán',
        title: 'Sessions',
        body: 'Plán, docházka a RPE drží celý trénink v jednom kontextu.',
        image: '/images/club-flow/sessions.webp',
        alt: 'Trenér sleduje trénink a drží tablet s analytikou týmu.',
      },
      {
        number: '03',
        kicker: 'Kontext · 1 minuta',
        title: 'Coach board',
        body: 'Check-iny, docházka a zátěž se spojí do přehledu pro realizační tým.',
        image: '/images/club-flow/coach-board.webp',
        alt: 'Dva trenéři na palubovce společně kontrolují týmový coach board na tabletu.',
      },
      {
        number: '04',
        kicker: 'Rozhodnutí · akce',
        title: 'Správné rozhodnutí',
        body: 'Trenér vidí souvislosti a může upravit zátěž, roli nebo regeneraci.',
        image: '/images/club-flow/decision.webp',
        alt: 'Trenér sleduje trénující tým a na tabletu kontroluje analytiku.',
      },
    ],
  },
  en: {
    eyebrow: 'ONE CLUB DAY',
    headline: 'From check-in to decision.',
    body: 'One flow, from the morning signal to the call on the pitch.',
    mediaLabel: 'Live club workflow',
    progressLabel: 'Day progress',
    steps: [
      {
        number: '01',
        kicker: 'Morning · 30 seconds',
        title: '5-axis check-in',
        body: 'Players send a body-and-mind signal. Melveo turns it into coach-ready context.',
        image: '/images/club-flow/check-in.webp',
        alt: 'A player in a locker room completes a team check-in on a phone.',
      },
      {
        number: '02',
        kicker: 'Training · plan',
        title: 'Sessions',
        body: 'Plan, attendance, and RPE keep the whole session in one context.',
        image: '/images/club-flow/sessions.webp',
        alt: 'A coach watches practice while holding a tablet with team analytics.',
      },
      {
        number: '03',
        kicker: 'Context · 1 minute',
        title: 'Coach board',
        body: 'Check-ins, attendance, and load become one view for the coaching staff.',
        image: '/images/club-flow/coach-board.webp',
        alt: 'Two coaches review a team coach board on a tablet courtside.',
      },
      {
        number: '04',
        kicker: 'Decision · action',
        title: 'The right decision',
        body: 'Coaches see the context and can adjust load, role, or recovery.',
        image: '/images/club-flow/decision.webp',
        alt: 'A coach watches the team train while checking analytics on a tablet.',
      },
    ],
  },
};

const content = copy[lang];
const steps = content.steps;
---

<section
  class="club-flow-stage"
  data-club-flow-stage
  data-glass-smoke
  data-glass-smoke-density="1"
  style={`--club-flow-count: ${steps.length};`}
>
  {/*
    Cyan smoke field — same recipe + same component as pricing /
    image-grid (per user request 2026-05-01: "by taky chtělo dát
    nějaké pozadí... aby více vyniknul ten liquid glass"). Sticky
    100 vh inside this 400+ vh section so the smoke covers the
    visible viewport across the whole sticky pin runway. Drives
    the .glass-card displacement filter on the media + cards —
    on the previous flat-black section, the SVG displacement had
    nothing to refract.
  */}
  <canvas class="glass-smoke" data-glass-smoke-canvas aria-hidden="true"></canvas>

  <div class="club-flow-stage__grid" aria-hidden="true"></div>
  <div class="club-flow-stage__halo club-flow-stage__halo--top" aria-hidden="true"></div>
  <div class="club-flow-stage__halo club-flow-stage__halo--bottom" aria-hidden="true"></div>

  <div class="club-flow-stage__intro">
    <p class="club-flow-stage__eyebrow">{content.eyebrow}</p>
    <h2>{content.headline}</h2>
    <p>{content.body}</p>
  </div>

  <div class="club-flow-stage__scroll" data-club-flow-scroll>
    <div class="club-flow-stage__pin">
      <div class="club-flow-stage__layout">
        <div class="club-flow-stage__media-shell" aria-label={content.mediaLabel}>
          <div class="club-flow-stage__media-glow" aria-hidden="true"></div>
          {/*
            Media frame uses the same .glass-card recipe as pricing
            cards + image-grid photos (per user request 2026-05-01:
            "stejný Liquid Glass design"). The 4 layer spans render
            the frame; the photo + HUD overlays sit inside
            .glass-content.
          */}
          <div class="club-flow-stage__media glass-card">
            <span class="glass-filter" aria-hidden="true" />
            <span class="glass-overlay" aria-hidden="true" />
            <span class="glass-specular" aria-hidden="true" />
            <div class="glass-content">
              {
                steps.map((step, index) => (
                  <img
                    class="club-flow-stage__image"
                    class:list={{ 'is-active': index === 0 }}
                    data-club-flow-image
                    src={step.image}
                    alt={step.alt}
                    width="1586"
                    height="992"
                    loading="lazy"
                    decoding="async"
                    style={`--image-index: ${index};`}
                  />
                ))
              }
              <div class="club-flow-stage__media-scrim" aria-hidden="true"></div>

              <div class="club-flow-stage__hud">
                <span class="club-flow-stage__hud-label">{content.mediaLabel}</span>
                <div class="club-flow-stage__hud-dots" aria-hidden="true">
                  {steps.map((_, index) => <span data-club-flow-dot class:list={{ 'is-active': index === 0 }}></span>)}
                </div>
              </div>

              <div class="club-flow-stage__mini-board" aria-hidden="true">
                <span>{content.progressLabel}</span>
                <div class="club-flow-stage__mini-lines">
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="club-flow-stage__right">
          <div class="club-flow-stage__progress" aria-hidden="true">
            <span></span>
          </div>

          <div class="club-flow-stage__cards" data-club-flow-cards>
            {
              steps.map((step, index) => (
                <article
                  class:list={[
                    'club-flow-stage__card glass-card',
                    { 'is-active': index === 0 },
                  ]}
                  data-club-flow-card
                  style={`--card-index: ${index};`}
                >
                  {/*
                    Same .glass-card recipe as pricing cards + image-
                    grid photos. The 4 layer spans render the frame;
                    the step content (number, title, bullets, metric)
                    sits inside .glass-content. The .__card-panel
                    class is kept on .glass-content so existing
                    .is-active modifiers + responsive overrides keep
                    targeting the right node.
                  */}
                  <span class="glass-filter" aria-hidden="true" />
                  <span class="glass-overlay" aria-hidden="true" />
                  <span class="glass-specular" aria-hidden="true" />
                  <div class="glass-content club-flow-stage__card-panel">
                    <img
                      class="club-flow-stage__card-photo"
                      src={step.image}
                      alt=""
                      width="1586"
                      height="992"
                      loading="lazy"
                      decoding="async"
                    />

                    <div class="club-flow-stage__card-topline">
                      <span class="club-flow-stage__card-number">{step.number}</span>
                      <p class="club-flow-stage__card-kicker">{step.kicker}</p>
                    </div>

                    <h3>{step.title}</h3>
                    <p class="club-flow-stage__card-body">{step.body}</p>
                  </div>
                </article>
              ))
            }
          </div>

          {/*
            Mobile-only carousel pagination — hidden on desktop where
            the sticky scroll-driven flow handles its own dots inside
            the media HUD. Below the carousel row so the user sees
            "card 1 of 4 · swipe →" feedback as they scroll horizontally.
            Active state is updated by JS via scroll-position observer
            on the cards rail.
          */}
          <div class="club-flow-stage__mobile-dots" aria-hidden="true">
            {steps.map((_, index) => (
              <span data-club-flow-mobile-dot class:list={{ 'is-active': index === 0 }}></span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .club-flow-stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-top: 1px solid var(--color-stroke-base);
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--color-bg-tint) 64%, transparent), transparent 42rem),
      linear-gradient(180deg, var(--color-bg-canvas), color-mix(in srgb, var(--color-bg-surface) 44%, var(--color-bg-canvas)) 48%, var(--color-bg-canvas));
    color: var(--color-text-primary);
  }

  /* Smoke canvas — sticky 100 vh inside the 400+ vh section so the
     fog covers the visible viewport across the whole scroll runway
     instead of getting stretched into one giant canvas (and so the
     IntersectionObserver in glass-smoke.ts only paints while in
     view). Margin-bottom: -100vh removes the canvas from normal
     flow so .__intro / .__scroll sit where they would naturally. */
  .club-flow-stage .glass-smoke {
    position: sticky;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    margin-bottom: -100vh;
    pointer-events: none;
    z-index: -1;
    filter: saturate(120%) brightness(1.05);
    /* Soft fade at top + bottom so the fog doesn't hard-cut against
       the previous / next section borders. */
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  .club-flow-stage__grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse at center, black 18%, transparent 70%);
    pointer-events: none;
  }

  .club-flow-stage__halo {
    position: absolute;
    z-index: -2;
    width: 54rem;
    height: 54rem;
    border-radius: 999px;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-accent-primary) 20%, transparent),
      transparent 72%
    );
    filter: blur(36px);
    pointer-events: none;
  }

  .club-flow-stage__halo--top {
    top: -20rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .club-flow-stage__halo--bottom {
    right: -22rem;
    bottom: 10%;
    opacity: 0.55;
  }

  .club-flow-stage__intro {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(6rem, 11vw, 10rem) 1.5rem clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .club-flow-stage__eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-accent-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }

  .club-flow-stage__intro h2 {
    max-width: 58rem;
    margin: 0 auto;
    font-size: clamp(2.5rem, 7vw, 6.25rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .club-flow-stage__intro > p:last-child {
    max-width: 42rem;
    margin: 1.5rem auto 0;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .club-flow-stage__scroll {
    position: relative;
    height: calc((var(--club-flow-count) * 92vh) + 42vh);
    min-height: 260rem;
  }

  .club-flow-stage__pin {
    position: sticky;
    top: 0;
    display: grid;
    min-height: 100vh;
    align-items: center;
    padding: clamp(3rem, 7vh, 5rem) 1.5rem;
  }

  .club-flow-stage__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.72fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    width: min(100%, 82rem);
    min-height: min(680px, 70vh);
    margin: 0 auto;
    align-items: stretch;
  }

  .club-flow-stage__media-shell {
    position: relative;
    min-height: 100%;
  }

  .club-flow-stage__media-glow {
    position: absolute;
    inset: 8% 8% -8%;
    border-radius: 2rem;
    background:
      radial-gradient(circle at 26% 24%, color-mix(in srgb, var(--color-accent-primary) 34%, transparent), transparent 38%),
      radial-gradient(circle at 80% 82%, color-mix(in srgb, var(--color-accent-warm-dark) 20%, transparent), transparent 44%);
    filter: blur(34px);
    opacity: 0.72;
  }

  /* Inherits frame from .glass-card (4 layers + dual drop shadow +
     specular rim). Local rule only carries the sizing + sticky-cyan
     ring + content-clip needed for this specific surface. */
  .club-flow-stage__media {
    height: 100%;
    min-height: 31rem;
  }
  .club-flow-stage__media .glass-content {
    position: relative;
    overflow: hidden;
    border-radius: inherit;
    padding: 0;
  }

  .club-flow-stage__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.05);
    filter: saturate(0.92) contrast(1.06);
    transition:
      opacity 260ms linear,
      transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 520ms ease;
    will-change: opacity, transform;
  }

  .club-flow-stage__image.is-active {
    opacity: 1;
    transform: scale(1);
    filter: saturate(1.03) contrast(1.05);
  }

  .club-flow-stage__media-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 6, 8, 0.1), rgba(5, 6, 8, 0.28)),
      linear-gradient(180deg, transparent 46%, rgba(5, 6, 8, 0.54));
    pointer-events: none;
  }

  .club-flow-stage__hud,
  .club-flow-stage__mini-board {
    position: absolute;
    left: clamp(1rem, 2vw, 1.5rem);
    right: clamp(1rem, 2vw, 1.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(5, 6, 8, 0.46);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .club-flow-stage__hud {
    top: clamp(1rem, 2vw, 1.5rem);
    border-radius: 999px;
    padding: 0.7rem 0.8rem 0.7rem 1rem;
  }

  .club-flow-stage__hud-label {
    color: var(--color-text-primary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .club-flow-stage__hud-dots {
    display: inline-flex;
    gap: 0.45rem;
  }

  .club-flow-stage__hud-dots span {
    width: 0.52rem;
    height: 0.52rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
    transition:
      width 260ms ease,
      background 260ms ease,
      box-shadow 260ms ease;
  }

  .club-flow-stage__hud-dots span.is-active {
    width: 1.5rem;
    background: var(--color-accent-primary);
    box-shadow: 0 0 22px color-mix(in srgb, var(--color-accent-primary) 70%, transparent);
  }

  .club-flow-stage__mini-board {
    bottom: clamp(1rem, 2vw, 1.5rem);
    align-items: flex-start;
    border-radius: 1.25rem;
    padding: 1rem;
  }

  .club-flow-stage__mini-board span {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .club-flow-stage__mini-lines {
    display: grid;
    width: min(48%, 15rem);
    gap: 0.55rem;
  }

  .club-flow-stage__mini-lines i {
    display: block;
    height: 0.45rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-accent-primary), rgba(255, 255, 255, 0.16));
    transform-origin: left center;
  }

  .club-flow-stage__mini-lines i:nth-child(2) {
    width: 76%;
    opacity: 0.72;
  }

  .club-flow-stage__mini-lines i:nth-child(3) {
    width: 54%;
    opacity: 0.44;
  }

  .club-flow-stage__right {
    position: relative;
    display: grid;
    grid-template-columns: 0.2rem minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-self: center;
    min-height: min(400px, 50vh);
  }

  .club-flow-stage__progress {
    position: relative;
    width: 0.2rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }

  .club-flow-stage__progress span {
    position: absolute;
    inset: 0 0 auto;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(180deg, var(--color-accent-primary), var(--color-accent-primary-subtle));
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-accent-primary) 64%, transparent);
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 80ms linear;
  }

  .club-flow-stage__cards {
    position: relative;
    min-height: min(400px, 50vh);
  }

  .club-flow-stage__card {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: var(--card-opacity, 0);
    transform: translate3d(0, var(--card-y, 72%), 0) scale(var(--card-scale, 0.92));
    transition:
      opacity 120ms linear,
      transform 120ms linear;
    will-change: opacity, transform;
    pointer-events: none;
  }

  .club-flow-stage__card.is-active {
    pointer-events: auto;
  }

  /* Card panel = .glass-content host. Frame (border / blur / shadow)
     comes from .glass-card. Local rule only carries the inner padding
     so the step content sits comfortably inside the glass. */
  .club-flow-stage__card-panel {
    width: 100%;
    padding: clamp(1.1rem, 1.55vw, 1.5rem);
  }

  /* Active state — glass-layer overrides instead of full-rule rewrite.
     Each layer takes a cyan-tinted variant so the active card looks
     "lit from inside" while preserving the .glass-card recipe. */
  .club-flow-stage__card.is-active {
    box-shadow:
      0 6px 6px rgba(0, 0, 0, 0.32),
      0 24px 60px -16px rgba(0, 240, 255, 0.32),
      0 0 32px rgba(0, 0, 0, 0.18);
  }
  .club-flow-stage__card.is-active .glass-overlay {
    background: linear-gradient(
      180deg,
      rgba(0, 240, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.02) 55%,
      rgba(0, 240, 255, 0.025) 100%
    );
  }
  .club-flow-stage__card.is-active .glass-specular {
    box-shadow:
      inset 1px 1px 0 rgba(0, 240, 255, 0.45),
      inset 0 0 12px rgba(0, 240, 255, 0.18),
      inset -1px -1px 0 rgba(255, 255, 255, 0.06);
  }

  .club-flow-stage__card-photo {
    display: none;
  }

  /* Hidden on desktop — only the mobile carousel needs pagination dots
     (desktop uses the sticky scroll-driven flow + HUD dots inside the
     media frame). The block below the breakpoint un-hides + styles
     them for the horizontal swipe layout. */
  .club-flow-stage__mobile-dots {
    display: none;
  }

  /*
    Premium step layout — number + kicker top row, then a hairline
    cyan divider, then title, then a single confident sentence.
    Generous breathing room between blocks; no list of bullets, no
    metric strip (those got cut per user feedback 2026-05-01:
    "hodně textů... možná i ne ty tabulky").
  */
  .club-flow-stage__card-topline {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 1.6vw, 1.5rem);
    margin-bottom: clamp(1.15rem, 2.2vh, 1.75rem);
    padding-bottom: clamp(0.9rem, 1.8vh, 1.3rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent-primary) 28%, transparent);
  }

  .club-flow-stage__card-number {
    color: var(--color-accent-primary);
    font-size: clamp(1.9rem, 3.8vw, 3.35rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    /* Subtle cyan glow to match the card backdrop. */
    text-shadow: 0 0 24px color-mix(in srgb, var(--color-accent-primary) 30%, transparent);
  }

  .club-flow-stage__card-kicker {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: clamp(0.78rem, 1vw, 0.92rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .club-flow-stage__card h3 {
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 3.45rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .club-flow-stage__card-body {
    max-width: 25rem;
    margin: clamp(0.9rem, 1.8vh, 1.25rem) 0 0;
    color: color-mix(in srgb, var(--color-text-secondary) 90%, var(--color-text-primary));
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (min-width: 1180px) and (max-width: 1280px) {
    .club-flow-stage__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(19rem, 0.72fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 1179px) {
    .club-flow-stage {
      overflow: hidden;
    }

    /*
      Mobile redesign per user feedback 2026-05-01: each step card is
      the photo surface; the copy sits in a bottom shadow instead of a
      separate text block under a framed image.
    */
    .club-flow-stage__intro {
      /* Centred on mobile too — the rest of the page is centred so
         keeping ClubFlow left-aligned on phones broke the rhythm
         (user feedback 2026-05-01: "všechno na střed"). */
      text-align: center;
      padding: clamp(4rem, 10vw, 6rem) clamp(1rem, 4vw, 1.5rem) clamp(1.5rem, 4vw, 2.5rem);
    }

    .club-flow-stage__intro h2 {
      max-width: none;
      margin: 0 auto;
      font-size: clamp(2.25rem, 9vw, 3.25rem);
      line-height: 1.02;
      letter-spacing: -0.035em;
    }

    .club-flow-stage__intro > p:last-child {
      max-width: none;
      margin: 1rem auto 0;
      font-size: 1rem;
      line-height: 1.55;
    }

    .club-flow-stage__scroll {
      height: auto;
      min-height: 0;
      /* Carousel needs the rail to bleed to the screen edges so cards
         can snap with peek; padding handled INSIDE the rail via
         scroll-padding + per-card flex-basis math. Section keeps a
         small bottom pad for the dots. */
      padding: 0 0 clamp(3rem, 10vw, 5rem);
    }

    .club-flow-stage__pin {
      position: relative;
      min-height: 0;
      padding: 0;
    }

    .club-flow-stage__layout {
      display: block;
      width: 100%;
      margin: 0 auto;
      min-height: 0;
    }

    .club-flow-stage__media-shell,
    .club-flow-stage__progress {
      display: none;
    }

    .club-flow-stage__right {
      display: block;
      min-height: 0;
    }

    /*
      Apple-style horizontal snap carousel (user request 2026-05-01:
      "slidovani doprava a doleva mezi těmi kartami... vždy jedna karta
      vidět celá a té další třeba 1/4"). Rail bleeds to screen edges so
      cards can fully fill the viewport while the next card peeks on
      the right edge.

      Layout math:
        - Rail padding-inline: 1rem on each side
        - Card flex-basis: 78% of rail content-box
        - Gap: 1rem between cards
        - Result at 100vw: visible card ≈ 78vw - 1.5rem,
          next card peeks ≈ 22vw - 0.4rem (the "there's more" cue)
        - scroll-snap-align: start + scroll-padding-inline-start: 1rem
          so each card snaps with the leading edge at 1rem from the
          screen edge — same visual rest position whichever card is
          centred. Apple App Store / Music featured shelf behaviour.
    */
    .club-flow-stage__cards {
      display: flex;
      flex-direction: row;
      gap: 1rem;
      min-height: 0;
      padding-inline: 1rem;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-padding-inline-start: 1rem;
      scroll-behavior: smooth;
      /* iOS momentum scrolling — without this the swipe feels stiff
         compared to native iOS carousels. */
      -webkit-overflow-scrolling: touch;
      /* Hide native scrollbar (App Store / Apple Music don't show one
         under the rail). */
      scrollbar-width: none;
      -ms-overflow-style: none;
      /* Rail still needs vertical headroom for the cards' shadow + the
         active-card cyan glow; without it the bottom shadow gets clipped
         by overflow:hidden. */
      padding-block: 0.5rem clamp(1.5rem, 4vw, 2rem);
    }
    .club-flow-stage__cards::-webkit-scrollbar {
      display: none;
    }

    .club-flow-stage__card {
      position: relative;
      inset: auto;
      flex: 0 0 78%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      border-radius: clamp(1.25rem, 5vw, 1.65rem);
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
      box-shadow:
        0 12px 36px rgba(0, 0, 0, 0.36),
        0 0 30px color-mix(in srgb, var(--color-accent-primary) 9%, transparent);
    }

    /* All step cards share the same baseline visual weight on mobile.
       The desktop active-card glow would make the image stack noisy. */
    .club-flow-stage__card.is-active {
      box-shadow:
        0 12px 36px rgba(0, 0, 0, 0.36),
        0 0 30px color-mix(in srgb, var(--color-accent-primary) 9%, transparent);
    }

    .club-flow-stage__card .glass-filter {
      backdrop-filter: blur(8px) saturate(160%);
      -webkit-backdrop-filter: blur(8px) saturate(160%);
      filter: url(#glass-lens) brightness(1.02);
    }

    .club-flow-stage__card.is-active .glass-overlay {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.02) 0%,
        rgba(255, 255, 255, 0.01) 55%,
        rgba(0, 240, 255, 0.02) 100%
      );
    }

    .club-flow-stage__card .glass-specular,
    .club-flow-stage__card.is-active .glass-specular {
      z-index: 6;
      box-shadow:
        inset 1px 1px 0 rgba(255, 255, 255, 0.26),
        inset 0 0 14px color-mix(in srgb, var(--color-accent-primary) 18%, transparent),
        inset -1px -1px 0 rgba(255, 255, 255, 0.06);
    }

    .club-flow-stage__card-panel {
      position: relative;
      min-height: clamp(25rem, 112vw, 34rem);
      justify-content: flex-end;
      overflow: hidden;
      padding: clamp(1rem, 4.2vw, 1.35rem);
      isolation: isolate;
    }

    .club-flow-stage__card-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        radial-gradient(
          circle at 72% 78%,
          color-mix(in srgb, var(--color-accent-primary) 28%, transparent),
          transparent 34%
        ),
        linear-gradient(
          180deg,
          rgba(5, 6, 8, 0.04) 0%,
          rgba(5, 6, 8, 0.12) 38%,
          rgba(5, 6, 8, 0.72) 70%,
          rgba(5, 6, 8, 0.95) 100%
        );
      pointer-events: none;
    }

    .club-flow-stage__card-panel::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      z-index: 1;
      height: 58%;
      background: linear-gradient(
        180deg,
        transparent 0%,
        color-mix(in srgb, var(--color-bg-tint) 34%, rgba(5, 6, 8, 0.9)) 100%
      );
      opacity: 0.72;
      pointer-events: none;
    }

    .club-flow-stage__card-photo {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      max-height: none;
      max-width: none;
      margin: 0;
      border-radius: inherit;
      object-fit: cover;
      filter: saturate(0.94) contrast(1.08) brightness(0.78);
      transform: scale(1.015);
    }

    .club-flow-stage__card-topline,
    .club-flow-stage__card h3,
    .club-flow-stage__card-body {
      position: relative;
      z-index: 2;
    }

    .club-flow-stage__card-topline {
      margin: 0 0 clamp(0.8rem, 2.5vw, 1rem);
      padding-bottom: clamp(0.75rem, 2.4vw, 0.95rem);
      gap: clamp(0.75rem, 2.6vw, 1rem);
    }

    .club-flow-stage__card-number {
      font-size: clamp(2rem, 8vw, 2.45rem);
      letter-spacing: -0.03em;
      text-shadow: 0 0 22px color-mix(in srgb, var(--color-accent-primary) 32%, transparent);
    }

    .club-flow-stage__card-kicker {
      font-size: clamp(0.76rem, 2.5vw, 0.86rem);
      letter-spacing: 0.02em;
      color: color-mix(in srgb, var(--color-text-secondary) 78%, var(--color-text-primary));
    }

    .club-flow-stage__card h3 {
      font-size: clamp(1.65rem, 7vw, 2.25rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
    }

    .club-flow-stage__card-body {
      max-width: none;
      margin-top: clamp(0.55rem, 2vw, 0.75rem);
      font-size: 0.95rem;
      line-height: 1.55;
      color: color-mix(in srgb, var(--color-text-secondary) 88%, var(--color-text-primary));
    }

    /*
      Mobile pagination dots — sit below the carousel rail. Each dot
      maps to one step. The active dot stretches into a cyan pill +
      glows; the rest are quiet white dots at low opacity. JS updates
      .is-active based on which card sits closest to the rail centre.
    */
    .club-flow-stage__mobile-dots {
      display: inline-flex;
      gap: 0.5rem;
      justify-content: center;
      align-items: center;
      width: 100%;
      margin-top: clamp(1rem, 3vw, 1.5rem);
      padding-inline: 1rem;
    }

    .club-flow-stage__mobile-dots span {
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.22);
      transition:
        width 260ms cubic-bezier(0.4, 0, 0.2, 1),
        background 260ms ease,
        box-shadow 260ms ease;
    }

    .club-flow-stage__mobile-dots span.is-active {
      width: 1.4rem;
      background: var(--color-accent-primary);
      box-shadow: 0 0 14px color-mix(in srgb, var(--color-accent-primary) 64%, transparent);
    }
  }

  @media (min-width: 700px) and (max-width: 1179px) {
    .club-flow-stage__intro {
      max-width: 78rem;
    }

    /*
      Tablet carousel — wider rail can fit a larger card at 60% with
      ~40% peek of the next, so two cards feel "almost both visible"
      while preserving the swipe-to-reveal motion. Inline rail padding
      bumped to 1.5rem so cards don't touch the screen edges on iPad
      portrait.
    */
    .club-flow-stage__cards {
      padding-inline: 1.5rem;
      scroll-padding-inline-start: 1.5rem;
      gap: 1.25rem;
    }

    .club-flow-stage__card {
      flex: 0 0 60%;
    }

    .club-flow-stage__card-panel {
      min-height: clamp(25rem, 56vw, 31rem);
    }

    .club-flow-stage__card h3 {
      font-size: clamp(1.55rem, 3.8vw, 2.05rem);
    }

    .club-flow-stage__card-body {
      font-size: clamp(0.9rem, 1.8vw, 0.98rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .club-flow-stage__image,
    .club-flow-stage__card,
    .club-flow-stage__progress span,
    .club-flow-stage__hud-dots span {
      transition: none;
    }
  }
</style>

<script>
  import { mountGlassSmoke } from '../scripts/glass-smoke';

  // Cyan smoke field behind the section. Deferred to idle so the
  // sticky-pin layout below can settle first. mountGlassSmoke is
  // idempotent (HANDLES WeakMap inside the module); calling it from
  // multiple sections is safe.
  function startSmoke() {
    mountGlassSmoke();
  }
  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(startSmoke, { timeout: 1500 });
  } else {
    setTimeout(startSmoke, 250);
  }

  const mountedClubFlowStages = new WeakSet<HTMLElement>();

  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  function mountClubFlowStage(stage: HTMLElement) {
    if (mountedClubFlowStages.has(stage)) return;
    mountedClubFlowStages.add(stage);

    const scrollArea = stage.querySelector<HTMLElement>('[data-club-flow-scroll]');
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('[data-club-flow-card]'));
    const images = Array.from(stage.querySelectorAll<HTMLElement>('[data-club-flow-image]'));
    const dots = Array.from(stage.querySelectorAll<HTMLElement>('[data-club-flow-dot]'));
    const mobileDots = Array.from(stage.querySelectorAll<HTMLElement>('[data-club-flow-mobile-dot]'));
    const cardsRail = stage.querySelector<HTMLElement>('[data-club-flow-cards]');
    const progressBar = stage.querySelector<HTMLElement>('.club-flow-stage__progress span');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 1180px)');

    if (!scrollArea || cards.length === 0) return;

    /*
      Mobile carousel pagination. Listen to the cards rail's horizontal
      scroll position and pick the card whose centre is closest to the
      rail's centre — that's the "active" one. Only runs while the
      mobile carousel layout is engaged (rail has overflow-x: auto on
      ≤ 1179 px). On desktop the rail is just a positioning context for
      the absolute-stacked cards and the scroll listener has nothing
      to do, so we cheaply early-exit when desktop matches.
    */
    let mobileFrame = 0;
    let mobileActiveIndex = 0;

    const updateMobileDots = () => {
      mobileFrame = 0;
      if (desktop.matches || !cardsRail || mobileDots.length === 0) return;

      const railRect = cardsRail.getBoundingClientRect();
      const railCentre = railRect.left + railRect.width / 2;

      let closestIndex = 0;
      let closestDistance = Infinity;
      cards.forEach((card, index) => {
        const cardRect = card.getBoundingClientRect();
        const cardCentre = cardRect.left + cardRect.width / 2;
        const distance = Math.abs(cardCentre - railCentre);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      if (closestIndex !== mobileActiveIndex) {
        mobileActiveIndex = closestIndex;
        mobileDots.forEach((dot, index) =>
          dot.classList.toggle('is-active', index === closestIndex),
        );
      }
    };

    const scheduleMobileDots = () => {
      if (mobileFrame) return;
      mobileFrame = window.requestAnimationFrame(updateMobileDots);
    };

    if (cardsRail) {
      cardsRail.addEventListener('scroll', scheduleMobileDots, { passive: true });
    }

    let frame = 0;
    let activeIndex = -1;

    const resetForStackedLayout = () => {
      cards.forEach((card, index) => {
        card.style.removeProperty('--card-y');
        card.style.removeProperty('--card-scale');
        card.style.removeProperty('--card-opacity');
        card.classList.toggle('is-active', index === 0);
      });

      images.forEach((image, index) => {
        image.style.removeProperty('opacity');
        image.style.removeProperty('transform');
        image.classList.toggle('is-active', index === 0);
      });

      dots.forEach((dot, index) => dot.classList.toggle('is-active', index === 0));
      progressBar?.style.setProperty('transform', 'scaleY(0)');
      activeIndex = 0;
    };

    const update = () => {
      frame = 0;

      if (!desktop.matches) {
        resetForStackedLayout();
        return;
      }

      const rect = scrollArea.getBoundingClientRect();
      const maxScroll = Math.max(1, scrollArea.offsetHeight - window.innerHeight);
      const progress = reduceMotion.matches ? 0 : clamp(-rect.top / maxScroll, 0, 1);
      const cursor = progress * (cards.length - 1);
      const nextActiveIndex = clamp(Math.round(cursor), 0, cards.length - 1);

      if (nextActiveIndex !== activeIndex) {
        activeIndex = nextActiveIndex;
        dots.forEach((dot, index) => dot.classList.toggle('is-active', index === activeIndex));
      }

      progressBar?.style.setProperty('transform', `scaleY(${progress})`);

      cards.forEach((card, index) => {
        const delta = index - cursor;
        const distance = Math.abs(delta);
        // Tighter Y travel + harder opacity falloff (per user feedback
        // 2026-05-01: "chtělo by to aby ty karty dříve disappear").
        // Previously cards faded gently (distance·0.54 with cliff at
        // 1.7) so 2 cards above + 2 below the active one were still
        // readable, making the stack look noisy. Now: linear fade
        // multiplied by 1.6 with a hard cliff at 0.7 distance — only
        // the active card and a brief crossfade with the next/prev
        // are visible at any moment.
        const y = clamp(delta * 52, -38, 64);
        const scale = 1 - Math.min(distance * 0.06, 0.14);
        const opacity = distance > 0.7 ? 0 : Math.max(0, 1 - distance * 1.6);

        card.style.setProperty('--card-y', `${y}%`);
        card.style.setProperty('--card-scale', `${scale}`);
        card.style.setProperty('--card-opacity', `${opacity}`);
        card.classList.toggle('is-active', distance < 0.48);
      });

      images.forEach((image, index) => {
        const distance = Math.abs(index - cursor);
        const opacity = Math.max(0, 1 - distance * 1.18);
        const scale = 1.035 + Math.min(distance * 0.025, 0.075);

        image.style.opacity = `${opacity}`;
        image.style.transform = `scale(${scale})`;
        image.classList.toggle('is-active', distance < 0.5);
      });
    };

    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('resize', scheduleMobileDots);
    reduceMotion.addEventListener?.('change', schedule);
    desktop.addEventListener?.('change', schedule);
    desktop.addEventListener?.('change', scheduleMobileDots);
    schedule();
    scheduleMobileDots();
  }

  function mountClubFlowStages() {
    document
      .querySelectorAll<HTMLElement>('[data-club-flow-stage]')
      .forEach((stage) => mountClubFlowStage(stage));
  }

  mountClubFlowStages();
  document.addEventListener('astro:page-load', mountClubFlowStages);
</script>
